<!-- ══ À PROPOS — EDIK SARL ══ -->
<section style="background:var(--t-bg2);padding:96px 48px;border-top:1px solid rgba(212,168,0,0.15);" id="a-propos" aria-label="À propos de EDIK SARL">
  <div style="max-width:900px;margin:0 auto;">
    <div class="section-tag reveal" data-fr="À propos" data-en="About">À propos</div>
    <h2 class="section-title reveal" data-fr="EDIK SARL — L'entreprise derrière CTL" data-en="EDIK SARL — The company behind CTL">EDIK SARL — L'entreprise derrière CTL</h2>
    <p class="section-sub reveal" style="max-width:800px;" data-fr="EDIK SARL est une entreprise camerounaise de droit OHADA basée à Yaoundé et représentée dans plusieurs régions du Cameroun. Il s'agit d'une société multiservices dont l'une des activités consiste à proposer des solutions numériques pour le transport interurbain au Cameroun et dans plusieurs pays voisins." data-en="EDIK SARL is a Cameroonian OHADA-registered company based in Yaoundé with representation across several regions of Cameroon. It is a multi-service company, one of whose activities is to provide digital solutions for intercity transport in Cameroon and several neighbouring countries.">EDIK SARL est une entreprise camerounaise de droit OHADA basée à Yaoundé et représentée dans plusieurs régions du Cameroun. Il s'agit d'une société multiservices dont l'une des activités consiste à proposer des solutions numériques pour le transport interurbain au Cameroun et dans plusieurs pays voisins.</p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:48px;" class="reveal">
      <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:28px;">
        <div style="font-size:28px;margin-bottom:14px;">🎯</div>
        <h3 style="font-size:16px;font-weight:700;margin-bottom:8px;" data-fr="Notre mission" data-en="Our mission">Notre mission</h3>
        <p style="font-size:13px;color:rgba(255,255,255,0.62);line-height:1.7;" data-fr="Digitaliser le transport interurbain au Cameroun et en Afrique Centrale. Offrir à chaque voyageur la sécurité, la traçabilité et la transparence qu'il mérite." data-en="Digitalize intercity transport in Cameroon and Central Africa. Offer every traveller the safety, traceability and transparency they deserve.">Digitaliser le transport interurbain au Cameroun et en Afrique Centrale. Offrir à chaque voyageur la sécurité, la traçabilité et la transparence qu'il mérite.</p>
      </div>
      <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:28px;">
        <div style="font-size:28px;margin-bottom:14px;">🌍</div>
        <h3 style="font-size:16px;font-weight:700;margin-bottom:8px;" data-fr="Notre vision" data-en="Our vision">Notre vision</h3>
        <p style="font-size:13px;color:rgba(255,255,255,0.62);line-height:1.7;" data-fr="Devenir la référence du transport numérique en Afrique subsaharienne — en connectant les 360 arrondissements du Cameroun et les pays de la zone CEMAC." data-en="Become the benchmark for digital transport in sub-Saharan Africa — connecting all 360 districts of Cameroon and the CEMAC zone countries.">Devenir la référence du transport numérique en Afrique subsaharienne — en connectant les 360 arrondissements du Cameroun et les pays de la zone CEMAC.</p>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:28px;" class="reveal">
      <div style="background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.25);border-radius:10px;padding:20px;text-align:center;">
        <div style="font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--or);">360</div>
        <div style="font-size:11px;color:rgba(255,255,255,0.5);margin-top:4px;text-transform:uppercase;letter-spacing:1px;" data-fr="Arrondissements" data-en="Districts">Arrondissements</div>
      </div>
      <div style="background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.25);border-radius:10px;padding:20px;text-align:center;">
        <div style="font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--or);">10</div>
        <div style="font-size:11px;color:rgba(255,255,255,0.5);margin-top:4px;text-transform:uppercase;letter-spacing:1px;" data-fr="Régions" data-en="Regions">Régions</div>
      </div>
      <div style="background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.25);border-radius:10px;padding:20px;text-align:center;">
        <div style="font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--or);">6</div>
        <div style="font-size:11px;color:rgba(255,255,255,0.5);margin-top:4px;text-transform:uppercase;letter-spacing:1px;" data-fr="Pays CEMAC" data-en="CEMAC Countries">Pays CEMAC</div>
      </div>
      <div style="background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.25);border-radius:10px;padding:20px;text-align:center;">
        <div style="font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--or);">24/7</div>
        <div style="font-size:11px;color:rgba(255,255,255,0.5);margin-top:4px;text-transform:uppercase;letter-spacing:1px;" data-fr="Disponibilité" data-en="Availability">Disponibilité</div>
      </div>
    </div>

    <div style="margin-top:28px;background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.2);border-radius:12px;padding:24px 28px;display:flex;gap:20px;align-items:center;flex-wrap:wrap;" class="reveal">
      <div style="font-size:36px;">🏢</div>
      <div style="flex:1;min-width:200px;">
        <div style="font-size:15px;font-weight:700;margin-bottom:4px;" data-fr="Siège social" data-en="Headquarters">Siège social</div>
        <p style="font-size:13px;color:rgba(255,255,255,0.55);line-height:1.6;" data-fr="EDIK SARL · Yaoundé, Cameroun · Registre de Commerce OHADA · Représentée dans plusieurs régions · Conforme à la loi n°2024/017 relative à la protection des données personnelles." data-en="EDIK SARL · Yaoundé, Cameroon · OHADA Trade Register · Represented in several regions · Compliant with Law No. 2024/017 on personal data protection.">EDIK SARL · Yaoundé, Cameroun · Registre de Commerce OHADA · Représentée dans plusieurs régions · Conforme à la loi n°2024/017 relative à la protection des données personnelles.</p>
      </div>
    </div>
  </div>
</section>

<section class="cta-section" id="contact" aria-label="Appel à l'action — Rejoindre CTL">
  <div class="section-tag" style="color:rgba(255,255,255,0.6)" data-fr="Rejoindre CTL" data-en="Join CTL">Rejoindre CTL</div>
  <h2 class="section-title" data-fr="Prêt à transformer le transport camerounais ?" data-en="Ready to transform Cameroonian transport?">Prêt à transformer<br>le transport camerounais ?</h2>
  <p class="section-sub" data-fr="Que vous soyez passager, agence de voyage ou chauffeur privé — CTL a une place pour vous." data-en="Whether you're a passenger, a travel agency or a private driver — CTL has a place for you.">Que vous soyez passager, agence de voyage ou chauffeur privé — CTL a une place pour vous.</p>
  <div class="cta-buttons">
    <a href="#corridors" class="btn-primary" onclick="event.preventDefault();(function(){var s=document.getElementById('corridors');if(s){s.scrollIntoView({behavior:'smooth',block:'start'});setTimeout(function(){var i=document.getElementById('departInput');if(i){i.focus();i.select();}},600);}})();" data-fr="Réserver un billet" data-en="Book a ticket">Réserver un billet</a>
    <a href="#" class="btn-secondary" onclick="event.preventDefault();ouvrirModalAgence()" data-fr="Devenir agence partenaire" data-en="Become a partner agency">Devenir agence partenaire</a>
    <a href="#" class="btn-secondary" onclick="event.preventDefault();ouvrirModalChauffeur()" data-fr="S'inscrire comme chauffeur" data-en="Register as a driver">S'inscrire comme chauffeur</a>
  </div>
</section>

