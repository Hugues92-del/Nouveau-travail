<!-- ══ DASHBOARD ESPACE PERSONNEL ══ -->
<div class="dashboard-overlay" id="dashboardOverlay">
  <nav class="dash-nav">
    <div class="dash-nav-brand">⚡ Mon Espace CTL</div>
    <div class="dash-nav-user">
      <div id="dashAvatar" class="dash-avatar">JP</div>
      <span id="dashNomNav">Jean-Pierre</span>
      <button class="dash-close" onclick="fermerDashboard()">← Retour au site</button>
    </div>
  </nav>
  <div class="dash-body">
    <div class="dash-welcome">
      <h2 id="dashWelcome">Bonjour, Jean-Pierre 👋</h2>
      <p id="dashSubWelcome">Votre espace personnel CTL — Gérez vos billets, votre profil et votre sécurité.</p>
    </div>
    <!-- KPIs -->
    <div class="dash-kpis">
      <div class="dash-kpi"><div class="dk-val" id="dk-billets">0</div><div class="dk-label">Billets réservés</div></div>
      <div class="dash-kpi"><div class="dk-val" id="dk-depenses">0 F</div><div class="dk-label">Total dépensé</div></div>
      <div class="dash-kpi"><div class="dk-val" id="dk-km">0 km</div><div class="dk-label">Kilomètres parcourus</div></div>
      <div class="dash-kpi"><div class="dk-val" id="dk-fidelite">Bronze</div><div class="dk-label">Niveau fidélité</div></div>
    </div>
    <!-- Tabs -->
    <div class="dash-tabs">
      <button class="dash-tab active" onclick="switchDashTab('billets',this)">🎫 Mes Billets</button>
      <button class="dash-tab" onclick="switchDashTab('profil',this)">👤 Mon Profil</button>
      <button class="dash-tab" onclick="switchDashTab('famille',this)">👨‍👩‍👧 CTL Family</button>
      <button class="dash-tab" onclick="switchDashTab('support',this)">💬 Support</button>
      <button class="dash-tab" onclick="switchDashTab('intl',this)">🌍 International</button>
      <button class="dash-tab" onclick="switchDashTab('fretDash',this)">📦 Marchandises</button>
      <button class="dash-tab" id="dash-tab-admin" onclick="switchDashTab('admin',this)" style="display:none;color:var(--rouge2);">🔐 Admin</button>
    </div>
    <!-- PANEL : BILLETS -->
    <div class="dash-panel active" id="dash-billets">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div style="font-size:15px;font-weight:700;">Historique de vos réservations</div>
        <button onclick="fermerDashboard();setTimeout(function(){var s=document.getElementById('corridors');if(s)s.scrollIntoView({behavior:'smooth'});},200)" style="background:var(--vert);border:none;color:#fff;padding:9px 18px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;">+ Nouvelle réservation</button>
      </div>
      <div id="dashBilletsList"></div>
    </div>
    <!-- PANEL : PROFIL -->
    <div class="dash-panel" id="dash-profil">
      <div class="profil-section">
        <div class="ps-title">Informations personnelles</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div class="form-field"><label class="dp-label">Prénom</label><input type="text" id="dp-prenom" class="dp-input"></div>
          <div class="form-field"><label class="dp-label">Nom</label><input type="text" id="dp-nom" class="dp-input"></div>
          <div class="form-field"><label class="dp-label">Téléphone</label><input type="tel" id="dp-tel" class="dp-input"></div>
          <div class="form-field"><label class="dp-label">E-mail</label><input type="email" id="dp-email" class="dp-input"></div>
          <div class="form-field"><label class="dp-label">Date de naissance</label><input type="date" id="dp-ddn" class="dp-input"></div>
          <div class="form-field"><label class="dp-label">Ville</label><input type="text" id="dp-ville" class="dp-input"></div>
        </div>
        <div style="margin-top:16px;display:flex;gap:10px;">
          <button onclick="sauvegarderProfilDash()" class="btn-vert">💾 Sauvegarder</button>
          <button onclick="changerMotDePasse()" class="btn-ghost">🔐 Changer le mot de passe</button>
        </div>
      </div>
      <div class="profil-section">
        <div class="ps-title">Préférences de voyage</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;">
          <div><label class="dp-label">Classe préférée</label>
            <select id="dp-classe" class="dp-input" style="font-size:13px;">
              <option value="classique">Classique</option><option value="vip">VIP</option>
            </select>
          </div>
          <div><label class="dp-label">Paiement préféré</label>
            <select id="dp-paiement" class="dp-input" style="font-size:13px;">
              <option value="mtn">MTN MoMo</option><option value="orange">Orange Money</option><option value="carte">Carte bancaire</option>
            </select>
          </div>
          <div><label class="dp-label">Notifications SMS</label>
            <select id="dp-sms" class="dp-input" style="font-size:13px;">
              <option value="oui">Activées</option><option value="non">Désactivées</option>
            </select>
          </div>
        </div>
        <div style="margin-top:16px;">
          <button onclick="sauvegarderPreferences()" class="btn-vert">💾 Sauvegarder les préférences</button>
        </div>
      </div>
      <div class="profil-section" style="border-color:rgba(175,2,11,0.2);">
        <div class="ps-title" style="color:var(--rouge2);">Zone de danger</div>
        <div style="display:flex;gap:10px;align-items:center;">
          <button onclick="demanderSuppression()" style="background:rgba(175,2,11,0.1);border:1px solid rgba(175,2,11,0.3);color:#e05050;padding:10px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">🗑 Supprimer mon compte</button>
          <button onclick="seDeconnecter()" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.5);padding:10px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">🚪 Se déconnecter</button>
        </div>
      </div>
    </div>
    <!-- PANEL : FAMILLE -->
    <div class="dash-panel" id="dash-famille">
      <div class="profil-section">
        <div class="ps-title">🛡 CTL Family Space — Contacts de sécurité</div>
        <p style="font-size:13px;color:rgba(255,255,255,0.5);margin-bottom:20px;line-height:1.6;">Vos contacts sont automatiquement notifiés à chaque départ, à chaque arrivée, et en cas d'alerte SOS sur votre trajet.</p>
        <div id="familleContacts"></div>
        <button onclick="ajouterContactDash()" style="background:rgba(26,107,58,0.15);border:1px solid rgba(26,107,58,0.3);color:var(--vert2);padding:10px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;margin-top:12px;">+ Ajouter un contact famille</button>
        <div style="margin-top:16px;">
          <button onclick="sauvegarderFamille()" style="background:var(--vert);border:none;color:#fff;padding:10px 22px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;">💾 Sauvegarder</button>
        </div>
      </div>
      <div class="profil-section" style="background:rgba(212,168,0,0.04);border-color:rgba(212,168,0,0.15);">
        <div class="ps-title">📍 Dernière position connue</div>
        <div style="font-size:13px;color:rgba(255,255,255,0.5);" id="dernierePosition">Aucun trajet actif pour le moment.</div>
      </div>
    </div>
    <!-- PANEL : SUPPORT -->
    <div class="dash-panel" id="dash-support">
      <div class="profil-section">
        <div class="ps-title">💬 Assistant CTL</div>
        <div class="support-chat" id="supportChat">
          <div class="sc-msg bot">👋 Bonjour ! Je suis l'assistant CTL. Comment puis-je vous aider ?</div>
        </div>
        <div class="sc-input-row">
          <input type="text" id="supportInput" class="sc-input" placeholder="Posez votre question..." onkeydown="if(event.key==='Enter') envoyerSupport()">
          <button class="sc-send" onclick="envoyerSupport()">Envoyer</button>
        </div>
      </div>
      <div class="profil-section">
        <div class="ps-title">📞 Contacts directs</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <a href="tel:+237690000000" style="display:flex;align-items:center;gap:12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:14px;text-decoration:none;color:#fff;transition:all 0.2s;" onmouseover="this.style.borderColor='rgba(212,168,0,0.3)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.08)'">
            <span style="font-size:24px;">📞</span><div><div style="font-weight:700;font-size:14px;">Urgences CTL</div><div style="font-size:12px;color:rgba(255,255,255,0.4);">+237 690 000 000</div></div>
          </a>
          <a href="https://wa.me/237690000000" target="_blank" style="display:flex;align-items:center;gap:12px;background:rgba(37,211,102,0.06);border:1px solid rgba(37,211,102,0.2);border-radius:8px;padding:14px;text-decoration:none;color:#