<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>

  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Outfit', sans-serif;
    background: var(--t-bg);
    color: var(--white);
    overflow-x: hidden;
  }

  /* ── THÈME VERT (défaut) ── */
  :root {
    --vert:    #1a6b3a;
    --vert2:   #2d9255;
    --rouge:   #af020b;
    --rouge2:  #ce1126;
    --or:      #d4a800;
    --cuivre:  #ab4901;
    --sable:   #f5f0e8;
    --dark:    #162b1c;
    --text:    #1c2a20;
    --muted:   #6b7d70;
    --white:   #ffffff;

    /* Variables thématiques — remplacées selon le thème actif */
    --t-bg:          #162b1c;   /* fond principal body — éclairci */
    --t-bg2:         #122418;   /* fond alternatif sections — éclairci */
    --t-bg3:         #19301e;   /* fond sections intermédiaires — éclairci */
    --t-nav:         rgba(22,43,28,0.94);
    --t-nav-border:  rgba(212,168,0,0.3);
    --t-card:        rgba(26,107,58,0.12);
    --t-card-border: rgba(26,107,58,0.28);
    --t-card-hover:  rgba(26,107,58,0.6);
    --t-card-feat:   rgba(26,107,58,0.18);
    --t-accent-low:  rgba(26,107,58,0.14);
    --t-accent-mid:  rgba(26,107,58,0.30);
    --t-accent-high: rgba(26,107,58,0.38);
    --t-vert2-low:   rgba(45,146,85,0.14);
    --t-vert2-mid:   rgba(45,146,85,0.20);
    --t-vert2-high:  rgba(45,146,85,0.45);
    --t-dropdown:    #213d28;
    --t-stat-bg:     rgba(22,43,28,0.85);
    --t-carousel-ov: rgba(16,30,18,0.90);
    --t-step-green:  rgba(26,107,58,0.35);
    --t-innov-bg:    linear-gradient(180deg, #162b1c 0%, #19301e 100%);
    --t-tarif-bg:    #122418;
    --t-howto-bg:    #162b1c;
    --t-famille-bg:  linear-gradient(135deg, #122418 0%, #1e1208 100%);
    --t-phone-bg:    linear-gradient(180deg,#162b1c,#0e1c12);
    --t-cta-bg:      linear-gradient(135deg,var(--vert) 0%,#145228 50%,#241408 100%);
    --t-footer-bg:   var(--dark);
    --t-ac-hover:    rgba(26,107,58,0.35);
    --t-primary-btn: var(--rouge);
    --t-primary-hover: var(--rouge2);
    --t-badge-pk:    linear-gradient(90deg, rgba(26,107,58,0.30), rgba(212,168,0,0.20));
  }

  /* ── THÈME ROUGE ── */
  body.theme-rouge {
    --t-bg:          #2a0c12;
    --t-bg2:         #20080d;
    --t-bg3:         #301219;
    --t-nav:         rgba(42,12,18,0.94);
    --t-nav-border:  rgba(212,168,0,0.3);
    --t-card:        rgba(175,2,11,0.12);
    --t-card-border: rgba(175,2,11,0.28);
    --t-card-hover:  rgba(206,17,38,0.55);
    --t-card-feat:   rgba(175,2,11,0.18);
    --t-accent-low:  rgba(175,2,11,0.14);
    --t-accent-mid:  rgba(175,2,11,0.30);
    --t-accent-high: rgba(175,2,11,0.40);
    --t-vert2-low:   rgba(206,17,38,0.16);
    --t-vert2-mid:   rgba(206,17,38,0.24);
    --t-vert2-high:  rgba(206,17,38,0.50);
    --t-dropdown:    #3d1218;
    --t-stat-bg:     rgba(42,12,18,0.88);
    --t-carousel-ov: rgba(30,8,12,0.90);
    --t-step-green:  rgba(175,2,11,0.35);
    --t-innov-bg:    linear-gradient(180deg, #2a0c12 0%, #301219 100%);
    --t-tarif-bg:    #20080d;
    --t-howto-bg:    #2a0c12;
    --t-famille-bg:  linear-gradient(135deg, #20080d 0%, #301219 100%);
    --t-phone-bg:    linear-gradient(180deg,#2a0c12,#180508);
    --t-cta-bg:      linear-gradient(135deg,var(--rouge) 0%,#7a0009 50%,#2a0404 100%);
    --t-footer-bg:   #180508;
    --t-ac-hover:    rgba(175,2,11,0.35);
    --t-primary-btn: #1a6b3a;
    --t-primary-hover: #2d9255;
    --t-badge-pk:    linear-gradient(90deg, rgba(175,2,11,0.30), rgba(212,168,0,0.20));
    --vert:          #af020b;
    --vert2:         #ce1126;
  }

  /* ── THÈME BLANC ── */
  body.theme-blanc {
    --t-bg:          #f5f2ec;
    --t-bg2:         #ede9e0;
    --t-bg3:         #e8e4db;
    --t-nav:         rgba(245,242,236,0.96);
    --t-nav-border:  rgba(171,73,1,0.25);
    --t-card:        rgba(171,73,1,0.06);
    --t-card-border: rgba(171,73,1,0.18);
    --t-card-hover:  rgba(171,73,1,0.45);
    --t-card-feat:   rgba(171,73,1,0.12);
    --t-accent-low:  rgba(171,73,1,0.08);
    --t-accent-mid:  rgba(171,73,1,0.2);
    --t-accent-high: rgba(171,73,1,0.3);
    --t-vert2-low:   rgba(171,73,1,0.1);
    --t-vert2-mid:   rgba(171,73,1,0.15);
    --t-vert2-high:  rgba(171,73,1,0.4);
    --t-dropdown:    #e8e4db;
    --t-stat-bg:     rgba(245,242,236,0.9);
    --t-carousel-ov: rgba(235,230,220,0.82);
    --t-step-green:  rgba(171,73,1,0.15);
    --t-innov-bg:    linear-gradient(180deg, #f5f2ec 0%, #e8e4db 100%);
    --t-tarif-bg:    #ede9e0;
    --t-howto-bg:    #f5f2ec;
    --t-famille-bg:  linear-gradient(135deg, #ede9e0 0%, #e0dbd0 100%);
    --t-phone-bg:    linear-gradient(180deg,#f5f2ec,#e8e4db);
    --t-cta-bg:      linear-gradient(135deg,#e8c89a 0%,#d4a870 50%,#c8956a 100%);
    --t-footer-bg:   #d8d4cb;
    --t-ac-hover:    rgba(171,73,1,0.15);
    --t-primary-btn: #ab4901;
    --t-primary-hover: #8a3a00;
    --t-badge-pk:    linear-gradient(90deg, rgba(171,73,1,0.2), rgba(212,168,0,0.15));
    --vert:          #ab4901;
    --vert2:         #c85a02;
    --or:            #8a3a00;
    --dark:          #2a1f0f;
    --white:         #1c1208;
  }
  /* Thème blanc — textes sombres sur fond clair */
  body.theme-blanc,
  body.theme-blanc nav .nav-links a,
  body.theme-blanc .hero-sub,
  body.theme-blanc .section-sub,
  body.theme-blanc p { color: #2a1f0f; }
  body.theme-blanc nav .nav-links a:hover { color: var(--or); }
  body.theme-blanc .hero-title,
  body.theme-blanc .section-title { color: #1a1008; }
  body.theme-blanc .hero-badge { color: var(--or); }
  body.theme-blanc .stat .label,
  body.theme-blanc .corridor-card .meta span,
  body.theme-blanc .price-note { color: rgba(42,31,15,0.5); }
  body.theme-blanc .ac-item { color: rgba(42,31,15,0.85); }
  body.theme-blanc .footer-brand p,
  body.theme-blanc .footer-col a { color: rgba(42,31,15,0.55); }
  body.theme-blanc .footer-col h4 { color: #1a1008; }
  body.theme-blanc .innov-card p,
  body.theme-blanc .tarif-feature,
  body.theme-blanc .corridor-card .price-val { color: rgba(42,31,15,0.8); }
  body.theme-blanc .field input,
  body.theme-blanc .field select,
  body.theme-blanc .city-input-wrap input {
    background: rgba(0,0,0,0.06); color: #1a1008;
    border-color: rgba(42,31,15,0.2);
  }
  body.theme-blanc .field input::placeholder,
  body.theme-blanc .city-input-wrap input::placeholder { color: rgba(42,31,15,0.35); }
  body.theme-blanc .corridor-card,
  body.theme-blanc .innov-card,
  body.theme-blanc .tarif-card { color: #2a1f0f; }
  body.theme-blanc .step p,
  body.theme-blanc .step h4 { color: #2a1f0f; }
  body.theme-blanc .tarif-feature { color: rgba(42,31,15,0.75); }
  body.theme-blanc .pay-card p { color: rgba(42,31,15,0.6); }
  body.theme-blanc .pay-card h3 { color: #1a1008; }
  body.theme-blanc .corridor-card .route { color: #1a1008; }


  /* ── NAVBAR ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 999;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 48px;
    background: var(--t-nav);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--t-nav-border);
  }

  .nav-logo {
    display: flex; align-items: center; gap: 14px;
  }
  .nav-logo .logo-icon {
    width: 44px; height: 44px;
    background: var(--cuivre);
    clip-path: polygon(0 100%, 15% 0, 50% 30%, 85% 0, 100% 100%);
    position: relative;
  }
  .nav-logo-text { line-height: 1; }
  .nav-logo-text .brand { font-family:'Playfair Display',serif; font-size:18px; color:var(--white); font-weight:700; letter-spacing:1px; }
  .nav-logo-text .sub { font-size:10px; color:var(--or); letter-spacing:3px; text-transform:uppercase; }

  .nav-links { display:flex; gap:16px; flex-wrap:nowrap; align-items:center; }
  .nav-links a { color:rgba(255,255,255,0.82); text-decoration:none; font-size:13px; font-weight:500; letter-spacing:0.3px; transition:color 0.2s; }
  .nav-links a:hover { color:var(--or); }
  .nav-links a.nav-link-driver {
    color: var(--or); font-weight: 600;
    border: 1px solid rgba(212,168,0,0.35);
    padding: 5px 12px; border-radius: 4px;
    transition: all 0.2s; white-space:nowrap; font-size:13px;
  }
  .nav-links a.nav-link-driver:hover { background: rgba(212,168,0,0.1); border-color: var(--or); }

  .nav-right {
    display: flex; align-items: center; gap: 0;
  }

  .nav-edik-logo {
    display: flex; align-items: center;
    opacity: 0.9; transition: opacity 0.2s; cursor: default;
  }
  .nav-edik-logo:hover { opacity: 1; }

  .edik-divider {
    width: 1px; height: 28px; background: rgba(255,255,255,0.15);
    margin: 0 20px;
  }

  .nav-cta-outline {
    background: transparent; color: var(--or);
    border: 1px solid rgba(212,168,0,0.5); padding: 10px 20px;
    border-radius: 4px; font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 600;
    cursor: pointer; letter-spacing: 0.5px; transition: all 0.2s; white-space: nowrap;
  }
  .nav-cta-outline:hover { background: rgba(212,168,0,0.12); border-color: var(--or); }

  .nav-cta {
    background: var(--rouge); color:var(--white); border:none; padding:10px 24px;
    border-radius:4px; font-family:'Outfit',sans-serif; font-size:14px; font-weight:600;
    cursor:pointer; letter-spacing:0.5px; transition:background 0.2s;
  }
  .nav-cta:hover { background:var(--rouge2); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex; flex-direction:column; justify-content:center;
    padding: 120px 48px 140px;
    overflow: hidden;
  }

  /* ── CARROUSEL PHOTOS TOURISTIQUES ── */
  .hero-carousel {
    position: absolute; inset: 0; z-index: 0;
  }
  .carousel-slide {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    opacity: 0; transition: opacity 1.8s ease;
  }
  .carousel-slide.active { opacity: 1; }
  /* Overlay foncé pour lisibilité du texte */
  .carousel-overlay {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(90deg, var(--t-carousel-ov) 0%, rgba(10,18,9,0.55) 45%, rgba(10,18,9,0.2) 100%),
      linear-gradient(180deg, rgba(10,18,9,0.3) 0%, transparent 40%, transparent 70%, var(--t-carousel-ov) 100%);
  }
  /* Indicateurs carrousel */
  .carousel-dots {
    position: absolute; bottom: 160px; right: 56px; z-index: 4;
    display: flex; gap: 8px; align-items: center;
  }
  .carousel-dot {
    width: 6px; height: 6px; border-radius: 3px;
    background: rgba(255,255,255,0.3); transition: all 0.4s; cursor: pointer;
  }
  .carousel-dot.active { background: var(--or); width: 24px; }
  /* Légende photo */
  .carousel-caption {
    position: absolute; bottom: 168px; left: 48px; z-index: 4;
    font-size: 11px; color: rgba(255,255,255,0.35); letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* Animated road lines */
  .road-lines {
    position:absolute; inset:0;
    overflow:hidden; z-index:2; pointer-events:none;
  }
  .road-lines::before {
    content:'';
    position:absolute; inset:0;
    background: repeating-linear-gradient(
      175deg,
      transparent 0px, transparent 40px,
      rgba(212,168,0,0.04) 40px, rgba(212,168,0,0.04) 41px
    );
    animation: roadMove 8s linear infinite;
  }
  @keyframes roadMove {
    from { transform:translateY(-100px); }
    to   { transform:translateY(100px); }
  }

  /* Map dot grid — agrandi et plus visible */
  .map-dots {
    position:absolute; right:40px; top:50%; transform:translateY(-52%);
    width:620px; height:480px; z-index:3; opacity:0.75;
  }
  .map-dot {
    position:absolute; border-radius:50%;
    background:var(--or);
    box-shadow: 0 0 8px rgba(212,168,0,0.6);
    animation: pulse 3s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,100% { transform:scale(1); opacity:0.7; box-shadow:0 0 8px rgba(212,168,0,0.4); }
    50% { transform:scale(1.6); opacity:1; box-shadow:0 0 18px rgba(212,168,0,0.8); }
  }
  .map-line {
    position:absolute; background:rgba(212,168,0,0.35);
    transform-origin:left center;
    height:1px;
  }
  /* Nom des villes plus lisibles */
  .map-city-label {
    position:absolute; white-space:nowrap;
    text-shadow: 0 1px 6px rgba(0,0,0,0.8);
  }

  .hero-content { position:relative; z-index:3; max-width:640px; }

  .hero-badge {
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(212,168,0,0.12); border:1px solid rgba(212,168,0,0.4);
    border-radius:100px; padding:6px 16px; margin-bottom:32px;
    font-size:12px; font-weight:600; color:var(--or); letter-spacing:2px; text-transform:uppercase;
    animation: fadeUp 0.8s ease both;
  }
  .hero-badge .dot { width:6px; height:6px; border-radius:50%; background:var(--or); animation:blink 1.5s infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }

  .hero-title {
    font-family:'Playfair Display',serif;
    font-size:clamp(22px,2.8vw,38px);
    font-weight:900;
    line-height:1.05;
    margin-bottom:24px;
    animation: fadeUp 0.8s 0.1s ease both;
  }
  .hero-title .accent { color:var(--or); display:block; }
  .hero-title .rouge { color:var(--rouge); }

  .hero-sub {
    font-size:18px; font-weight:300; color:rgba(255,255,255,0.75);
    line-height:1.7; max-width:520px; margin-bottom:48px;
    animation: fadeUp 0.8s 0.2s ease both;
  }

  .hero-actions {
    display:flex; gap:16px; flex-wrap:wrap;
    animation: fadeUp 0.8s 0.3s ease both;
  }

  .btn-primary {
    background:var(--t-primary-btn); color:var(--white);
    padding:16px 36px; border-radius:4px; font-weight:700; font-size:15px;
    text-decoration:none; letter-spacing:0.5px; transition:all 0.2s;
    border:2px solid var(--t-primary-btn);
  }
  .btn-primary:hover { background:transparent; color:var(--t-primary-btn); }

  .btn-secondary {
    background:transparent; color:var(--white);
    padding:16px 36px; border-radius:4px; font-weight:500; font-size:15px;
    text-decoration:none; letter-spacing:0.5px; transition:all 0.2s;
    border:2px solid rgba(255,255,255,0.25);
  }
  .btn-secondary:hover { border-color:var(--or); color:var(--or); }

  .hero-stats {
    position:absolute; bottom:48px; left:48px; right:48px; z-index:3;
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    background:rgba(255,255,255,0.08); border-radius:8px; overflow:hidden;
    animation: fadeUp 0.8s 0.5s ease both;
  }
  .stat {
    padding:20px 24px;
    background:var(--t-stat-bg);
    backdrop-filter:blur(8px);
  }
  .stat .val { font-family:'Playfair Display',serif; font-size:28px; font-weight:700; color:var(--or); }
  .stat .label { font-size:12px; color:rgba(255,255,255,0.62); margin-top:4px; letter-spacing:0.5px; }

  @keyframes fadeUp {
    from { opacity:0; transform:translateY(24px); }
    to   { opacity:1; transform:translateY(0); }
  }

  /* ── SECTION STYLES ── */
  section { padding:100px 48px; }

  .section-tag {
    font-size:11px; font-weight:700; letter-spacing:4px; text-transform:uppercase;
    color:var(--or); margin-bottom:16px;
  }
  .section-title {
    font-family:'Playfair Display',serif; font-size:clamp(32px,4vw,52px);
    font-weight:700; line-height:1.1; margin-bottom:20px;
  }
  .section-sub {
    font-size:17px; color:rgba(255,255,255,0.68); line-height:1.7; max-width:600px;
  }

  /* ── CORRIDOR SECTION ── */
  .corridors { background:var(--t-bg); }
  .corridor-search {
    background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1);
    border-radius:12px; padding:32px 36px; margin:48px 0;
    display:grid; grid-template-columns:1fr auto 1fr 1fr auto; gap:16px; align-items:end;
  }
  .field label { font-size:12px; color:var(--or); letter-spacing:2px; text-transform:uppercase; margin-bottom:8px; display:block; }
  .field select, .field input {
    width:100%; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.15);
    border-radius:6px; padding:14px 16px; color:var(--white); font-family:'Outfit',sans-serif;
    font-size:15px; outline:none; transition:border-color 0.2s;
    appearance:none; cursor:pointer;
  }
  .field select:focus, .field input:focus { border-color:var(--or); }

  /* ── AUTOCOMPLETE CITY SEARCH ── */
  .city-input-wrap { position:relative; }
  .city-input-wrap input {
    width:100%; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.15);
    border-radius:6px; padding:14px 40px 14px 16px; color:var(--white); font-family:'Outfit',sans-serif;
    font-size:15px; outline:none; transition:border-color 0.2s;
  }
  .city-input-wrap input:focus { border-color:var(--or); }
  .city-input-wrap input::placeholder { color:rgba(255,255,255,0.35); }
  .city-input-wrap .input-icon {
    position:absolute; right:14px; top:50%; transform:translateY(-50%);
    color:rgba(255,255,255,0.3); font-size:16px; pointer-events:none;
  }
  .autocomplete-dropdown {
    position:absolute; top:calc(100% + 6px); left:0; right:0; z-index:500;
    background:var(--t-dropdown); border:1px solid rgba(212,168,0,0.35);
    border-radius:8px; overflow:hidden;
    max-height:280px; overflow-y:auto;
    box-shadow:0 16px 40px rgba(0,0,0,0.6);
    display:none;
  }
  .autocomplete-dropdown.open { display:block; }
  .autocomplete-dropdown::-webkit-scrollbar { width:4px; }
  .autocomplete-dropdown::-webkit-scrollbar-thumb { background:rgba(212,168,0,0.3); border-radius:4px; }
  .ac-region {
    padding:8px 16px; font-size:10px; font-weight:700; letter-spacing:3px;
    text-transform:uppercase; color:var(--or); background:rgba(212,168,0,0.07);
    border-bottom:1px solid rgba(255,255,255,0.05); position:sticky; top:0; z-index:1;
  }
  .ac-item {
    padding:10px 16px; font-size:14px; color:rgba(255,255,255,0.8);
    cursor:pointer; transition:background 0.15s; display:flex; align-items:center; gap:10px;
    border-bottom:1px solid rgba(255,255,255,0.03);
  }
  .ac-item:hover, .ac-item.highlighted { background:var(--t-ac-hover); color:var(--white); }
  .ac-item .ac-dept { font-size:11px; color:rgba(255,255,255,0.35); margin-left:auto; }
  .ac-empty { padding:20px 16px; text-align:center; color:rgba(255,255,255,0.3); font-size:13px; }

  /* ── CHAMP DATE — calendrier visible ── */
  #dateVoyage {
    appearance:auto !important;
    -webkit-appearance:auto !important;
    color-scheme:dark;
    color:var(--white);
    background:rgba(255,255,255,0.07);
    border:1px solid rgba(255,255,255,0.15);
    border-radius:6px;
    padding:12px 16px;
    font-family:'Outfit',sans-serif;
    font-size:15px;
    cursor:pointer;
    width:100%;
  }
  #dateVoyage::-webkit-calendar-picker-indicator {
    filter:invert(1) brightness(1.5) sepia(1) saturate(5) hue-rotate(5deg);
    cursor:pointer;
    opacity:0.85;
    width:18px; height:18px;
  }
  #dateVoyage:focus { border-color:var(--or); outline:none; }

  /* ── CHAMPS QUARTIER ── */
  .quartier-wrap { margin-top:8px; }
  .quartier-wrap input {
    width:100%;
    background:rgba(255,255,255,0.04);
    border:1px dashed rgba(255,255,255,0.12);
    border-radius:6px;
    padding:9px 14px;
    color:var(--white);
    font-family:'Outfit',sans-serif;
    font-size:13px;
    outline:none;
    transition:border-color 0.2s;
  }
  .quartier-wrap input:focus { border-color:rgba(212,168,0,0.5); border-style:solid; }
  .quartier-wrap input::placeholder { color:rgba(255,255,255,0.28); font-size:12px; }
  .quartier-label {
    font-size:10px; color:rgba(255,255,255,0.3);
    letter-spacing:1.5px; text-transform:uppercase;
    margin-bottom:5px; display:block;
  }

  /* ── SWAP BUTTON ── */
  .swap-btn {
    display:flex; align-items:center; justify-content:center;
    width:40px; height:40px; border-radius:50%;
    background:rgba(212,168,0,0.12); border:1px solid rgba(212,168,0,0.3);
    color:var(--or); font-size:18px; cursor:pointer; transition:all 0.2s;
    align-self:flex-end; margin-bottom:0; flex-shrink:0;
  }
  .swap-btn:hover { background:rgba(212,168,0,0.25); transform:rotate(180deg); }

  /* ── BADGE CHAUFFEUR ── */
  .badge-partenaire {
    display: inline-flex; align-items: center; gap: 5px;
    background: var(--t-badge-pk);
    border: 1px solid rgba(212,168,0,0.5);
    color: var(--or); font-size: 10px; font-weight: 800;
    letter-spacing: 1.5px; text-transform: uppercase;
    padding: 3px 10px 3px 8px; border-radius: 100px;
    vertical-align: middle;
  }
  .badge-partenaire .bp-shield {
    font-size: 11px;
  }
  .badge-partenaire .bp-check {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--vert2); color: var(--white);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 8px; font-weight: 900; flex-shrink: 0;
  }

  .badge-occasionnel {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.45); font-size: 10px; font-weight: 600;
    letter-spacing: 1px; text-transform: uppercase;
    padding: 3px 10px; border-radius: 100px;
    vertical-align: middle;
  }

  /* Profil chauffeur dans la carte résultat */
  .driver-row {
    display: flex; align-items: center; gap: 10px; margin-top: 10px;
    padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.06);
  }
  .driver-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 13px; flex-shrink: 0;
  }
  .driver-avatar.partenaire {
    background: rgba(26,107,58,0.3);
    border: 1.5px solid var(--vert2);
    color: var(--vert2);
  }
  .driver-avatar.occasionnel {
    background: rgba(255,255,255,0.07);
    border: 1.5px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.5);
  }
  .driver-info { flex: 1; }
  .driver-name {
    font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px;
  }
  .driver-meta {
    font-size: 11px; color: rgba(255,255,255,0.35); margin-top: 2px;
  }
  .driver-note {
    font-size: 12px; font-weight: 700; color: var(--or);
    display: flex; align-items: center; gap: 3px;
  }

  /* Card partenaire a une bordure gauche verte */
  .result-card.is-partenaire {
    border-color: var(--t-vert2-high);
    background: linear-gradient(135deg, var(--t-accent-low) 0%, rgba(255,255,255,0.02) 100%);
  }
  .result-card.is-partenaire:hover { border-color: rgba(212,168,0,0.5); }
  .result-card.is-occasionnel {
    border-color: rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.02);
  }
  .result-card.is-occasionnel:hover { border-color: rgba(255,255,255,0.2); }

  /* ── SAUVEGARDE PROFIL ── */
  .profil-banner {
    margin: 0 28px 4px;
    display: flex; align-items: center; gap: 14px;
    background: rgba(45,146,85,0.1); border: 1px solid rgba(45,146,85,0.3);
    border-radius: 8px; padding: 12px 16px;
  }
  .pb-ico { font-size: 22px; flex-shrink: 0; }
  .pb-text { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .pb-text strong { font-size: 13px; color: var(--white); }
  .pb-text span   { font-size: 12px; color: rgba(255,255,255,0.45); }
  .pb-change {
    background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.6); font-size: 12px; padding: 6px 14px;
    border-radius: 5px; cursor: pointer; white-space: nowrap;
    font-family: 'Outfit', sans-serif; transition: all 0.2s; flex-shrink: 0;
  }
  .pb-change:hover { background: rgba(255,255,255,0.12); color: var(--white); }

  .save-profil-block {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px; padding: 18px; margin-top: 4px;
  }
  .save-toggle {
    display: flex; align-items: flex-start; gap: 14px; cursor: pointer;
  }
  .save-toggle input[type="checkbox"] { display: none; }
  .save-toggle-box {
    width: 42px; height: 24px; border-radius: 100px; flex-shrink: 0; margin-top: 2px;
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);
    position: relative; transition: background 0.2s;
  }
  .save-toggle-box::after {
    content: ''; position: absolute; top: 3px; left: 3px;
    width: 16px; height: 16px; border-radius: 50%;
    background: rgba(255,255,255,0.5); transition: transform 0.2s, background 0.2s;
  }
  .save-toggle input:checked + .save-toggle-box {
    background: var(--vert2); border-color: var(--vert2);
  }
  .save-toggle input:checked + .save-toggle-box::after {
    transform: translateX(18px); background: var(--white);
  }
  .save-toggle-text { display: flex; flex-direction: column; gap: 4px; }
  .save-toggle-text strong { font-size: 14px; color: var(--white); font-weight: 600; }
  .save-toggle-text span   { font-size: 12px; color: rgba(255,255,255,0.4); line-height: 1.5; }

  .save-details {
    margin-top: 14px; padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .save-what {
    display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;
  }
  .save-what span {
    font-size: 12px; color: var(--vert2);
    background: rgba(45,146,85,0.1); border: 1px solid rgba(45,146,85,0.2);
    border-radius: 100px; padding: 3px 12px;
  }
  .btn-delete-profil {
    background: rgba(175,2,11,0.08); border: 1px solid rgba(175,2,11,0.25);
    color: rgba(206,17,38,0.8); font-size: 12px; padding: 8px 16px;
    border-radius: 6px; cursor: pointer; font-family: 'Outfit', sans-serif;
    transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;
  }
  .btn-delete-profil:hover { background: rgba(175,2,11,0.15); color: var(--rouge2); }

  .search-results {
    margin-top:0; overflow:hidden;
    max-height:0; transition:max-height 0.5s ease, opacity 0.4s ease;
    opacity:0;
  }
  .search-results.open { max-height:900px; opacity:1; margin-top:24px; }
  .results-header {
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 0; border-bottom:1px solid rgba(255,255,255,0.08); margin-bottom:16px;
  }
  .results-header .rh-title { font-weight:700; font-size:16px; }
  .results-header .rh-count { font-size:12px; color:rgba(255,255,255,0.4); }
  .result-card {
    background:linear-gradient(135deg, rgba(26,107,58,0.1) 0%, rgba(255,255,255,0.02) 100%);
    border:1px solid rgba(26,107,58,0.2); border-radius:10px; padding:20px 24px;
    display:grid; grid-template-columns:1fr auto auto; gap:20px; align-items:center;
    margin-bottom:12px; cursor:pointer; transition:all 0.2s;
  }
  .result-card:hover { border-color:rgba(212,168,0,0.4); transform:translateX(4px); }
  .result-card .rc-route { font-size:17px; font-weight:700; }
  .result-card .rc-route .arr { color:var(--or); }
  .result-card .rc-meta { font-size:12px; color:rgba(255,255,255,0.4); margin-top:4px; }
  .result-card .rc-price { font-family:'Playfair Display',serif; font-size:22px; font-weight:700; color:var(--or); text-align:right; }
  .result-card .rc-price small { display:block; font-family:'Outfit',sans-serif; font-size:11px; color:rgba(255,255,255,0.3); font-weight:400; }
  .btn-book { background:var(--rouge); color:var(--white); border:none; padding:10px 22px; border-radius:6px; font-family:'Outfit',sans-serif; font-weight:700; font-size:13px; cursor:pointer; white-space:nowrap; transition:background 0.2s; }
  .btn-book:hover { background:var(--rouge2); }
  .no-direct-route {
    background:rgba(212,168,0,0.05); border:1px solid rgba(212,168,0,0.2);
    border-radius:10px; padding:20px 24px; text-align:center; margin-bottom:12px;
  }
  .no-direct-route p { color:rgba(255,255,255,0.5); font-size:14px; margin-bottom:8px; }
  .no-direct-route strong { color:var(--or); }
  .btn-search {
    background:var(--vert); color:var(--white); border:none; padding:14px 32px;
    border-radius:6px; font-family:'Outfit',sans-serif; font-weight:700; font-size:15px;
    cursor:pointer; white-space:nowrap; transition:background 0.2s;
  }
  .btn-search:hover { background:var(--vert2); }

  .corridors-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
  }
  .corridor-card {
    background:linear-gradient(135deg, var(--t-accent-low) 0%, rgba(255,255,255,0.03) 100%);
    border:1px solid var(--t-card-border);
    border-radius:10px; padding:28px; cursor:pointer;
    transition:all 0.25s; position:relative; overflow:hidden;
  }
  .corridor-card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg, var(--vert), var(--or));
    transform:scaleX(0); transform-origin:left; transition:transform 0.3s;
  }
  .corridor-card:hover { border-color:var(--t-card-hover); transform:translateY(-4px); }
  .corridor-card:hover::before { transform:scaleX(1); }
  .corridor-card .route { font-size:20px; font-weight:700; margin-bottom:8px; }
  .corridor-card .route span { color:var(--or); }
  .corridor-card .meta { display:flex; gap:20px; font-size:13px; color:rgba(255,255,255,0.62); margin-bottom:16px; }
  .corridor-card .price-block {
    display: flex; flex-direction: column; gap: 4px; margin-top: 12px;
  }
  .corridor-card .price-row {
    display: flex; align-items: center; justify-content: space-between;
  }
  .corridor-card .price-label {
    font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    color: rgba(255,255,255,0.4);
  }
  .corridor-card .price-label.vip { color: rgba(212,168,0,0.7); }
  .corridor-card .price-val {
    font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700;
    color: rgba(255,255,255,0.85);
  }
  .corridor-card .price-val.vip { color: var(--or); font-size: 22px; }
  .corridor-card .price-val small {
    font-family: 'Outfit', sans-serif; font-size: 11px; color: rgba(255,255,255,0.3); font-weight: 400;
  }
  .corridor-card .price-note {
    font-size: 10px; color: rgba(255,255,255,0.25); margin-top: 6px; font-style: italic;
  }
  .corridor-card .badge {
    position:absolute; top:20px; right:20px;
    background:rgba(212,168,0,0.15); border:1px solid rgba(212,168,0,0.4);
    color:var(--or); font-size:10px; font-weight:700; letter-spacing:1px;
    padding:3px 10px; border-radius:100px; text-transform:uppercase;
  }

  /* ── INNOVATIONS ── */
  .innovations { background:var(--t-innov-bg); }

  .innovations-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:56px;
  }
  .innov-card {
    background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07);
    border-radius:12px; padding:28px 24px; transition:all 0.25s;
    position:relative; overflow:hidden;
  }
  .innov-card:hover {
    background:var(--t-accent-low); border-color:var(--t-accent-high);
    transform:translateY(-6px);
  }
  .innov-card .icon {
    width:52px; height:52px; border-radius:12px; margin-bottom:20px;
    display:flex; align-items:center; justify-content:center;
    font-size:24px;
  }
  .innov-card .icon.green  { background:var(--t-accent-mid); }
  .innov-card .icon.gold   { background:rgba(212,168,0,0.2); }
  .innov-card .icon.red    { background:rgba(175,2,11,0.2); }
  .innov-card .icon.copper { background:rgba(171,73,1,0.25); }

  .innov-card h3 { font-size:16px; font-weight:700; margin-bottom:10px; color:var(--white); }
  .innov-card p  { font-size:13px; color:rgba(255,255,255,0.62); line-height:1.6; }
  .innov-card .num {
    position:absolute; top:20px; right:20px;
    font-family:'Playfair Display',serif; font-size:36px; font-weight:900;
    color:rgba(255,255,255,0.04);
  }

  /* ── TARIFS ── */
  .tarifs { background:var(--t-tarif-bg); }
  .tarifs-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:56px; }

  .tarif-card {
    border-radius:12px; overflow:hidden; position:relative;
  }
  .tarif-card .card-header {
    padding:32px 28px; background:rgba(255,255,255,0.04);
    border-bottom:1px solid rgba(255,255,255,0.06);
  }
  .tarif-card.featured .card-header { background:var(--vert); }
  .tarif-card.featured { border:2px solid var(--vert2); }
  .tarif-card:not(.featured) { border:1px solid rgba(255,255,255,0.08); }

  .tarif-card .type { font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:rgba(255,255,255,0.5); margin-bottom:12px; }
  .tarif-card.featured .type { color:rgba(255,255,255,0.7); }
  .tarif-card .amount { font-family:'Playfair Display',serif; font-size:48px; font-weight:700; color:var(--white); }
  .tarif-card .amount small { font-size:16px; font-weight:400; color:rgba(255,255,255,0.5); }
  .tarif-card .label { font-size:13px; color:rgba(255,255,255,0.5); margin-top:6px; }
  .tarif-card .card-body { padding:28px; background:rgba(255,255,255,0.02); }
  .tarif-card.featured .card-body { background:var(--t-card-feat); }
  .tarif-feature {
    display:flex; align-items:center; gap:12px; padding:10px 0;
    border-bottom:1px solid rgba(255,255,255,0.08); font-size:14px; color:rgba(255,255,255,0.78);
  }
  .tarif-feature:last-child { border-bottom:none; }
  .tarif-feature .check { color:var(--vert2); font-size:16px; }
  .tarif-feature .check.gold { color:var(--or); }
  .tarif-popular {
    position:absolute; top:20px; right:20px;
    background:var(--or); color:var(--dark); font-size:10px; font-weight:800;
    letter-spacing:1px; padding:4px 12px; border-radius:100px; text-transform:uppercase;
  }

  /* ── COMMENT ÇA MARCHE ── */
  .howto { background:var(--t-howto-bg); }
  .steps { display:grid; grid-template-columns:repeat(5,1fr); gap:0; margin-top:64px; position:relative; }
  .steps::before {
    content:''; position:absolute; top:36px; left:10%; right:10%;
    height:1px; background:linear-gradient(90deg,transparent,var(--vert2),var(--or),var(--vert2),transparent);
  }
  .step { text-align:center; padding:0 16px; }
  .step-num {
    width:72px; height:72px; border-radius:50%; margin:0 auto 24px;
    display:flex; align-items:center; justify-content:center;
    font-family:'Playfair Display',serif; font-size:24px; font-weight:700;
    position:relative; z-index:1;
  }
  .step-num.green  { background:var(--t-step-green); border:2px solid var(--vert2); color:var(--vert2); }
  .step-num.gold   { background:rgba(212,168,0,0.2); border:2px solid var(--or); color:var(--or); }
  .step-num.red    { background:rgba(175,2,11,0.2); border:2px solid var(--rouge); color:var(--rouge); }
  .step-icon { font-size:28px; }
  .step h4 { font-size:14px; font-weight:700; margin-bottom:8px; }
  .step p  { font-size:12px; color:rgba(255,255,255,0.58); line-height:1.6; }

  /* ── SÉCURITÉ / FAMILY SPACE ── */
  .famille { background:var(--t-famille-bg); padding:100px 48px; }
  .famille-inner {
    display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;
  }
  .famille-phone {
    background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1);
    border-radius:36px; overflow:hidden; padding:12px; max-width:320px; margin:auto;
    box-shadow: 0 40px 80px rgba(0,0,0,0.5);
  }
  .phone-screen {
    background:var(--t-phone-bg);
    border-radius:26px; padding:24px; min-height:520px;
  }
  .phone-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
  .phone-header .app-name { font-size:16px; font-weight:700; }
  .phone-header .live { font-size:10px; color:var(--vert2); font-weight:600; letter-spacing:1px;
    background:var(--t-vert2-mid); border:1px solid var(--t-vert2-high); border-radius:100px; padding:2px 10px; }

  .phone-map {
    background:var(--t-card); border:1px solid var(--t-card-border);
    border-radius:12px; height:180px; margin-bottom:16px; position:relative; overflow:hidden;
  }
  .phone-map .map-grid {
    position:absolute; inset:0;
    background-image: linear-gradient(var(--t-vert2-low) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(45,146,85,0.08) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .phone-map .bus-dot {
    position:absolute; top:50%; left:40%; transform:translate(-50%,-50%);
    width:20px; height:20px; border-radius:50%; background:var(--vert2);
    box-shadow: 0 0 0 6px rgba(45,146,85,0.25), 0 0 0 12px rgba(45,146,85,0.1);
    animation: moveBus 6s ease-in-out infinite;
  }
  @keyframes moveBus {
    0%,100% { left:35%; top:45%; }
    50%     { left:65%; top:60%; }
  }
  .phone-map .route-line {
    position:absolute; top:45%; left:20%; right:20%;
    height:2px; background:rgba(45,146,85,0.4);
    border-radius:2px;
  }
  .phone-map .city { position:absolute; font-size:10px; color:rgba(255,255,255,0.5); }
  .phone-map .city.douala { bottom:12px; left:16px; }
  .phone-map .city.yaounde { bottom:12px; right:16px; }

  .phone-status {
    background:rgba(212,168,0,0.08); border:1px solid rgba(212,168,0,0.25);
    border-radius:8px; padding:14px; margin-bottom:12px;
  }
  .phone-status .label { font-size:10px; color:var(--or); font-weight:700; letter-spacing:1px; margin-bottom:4px; }
  .phone-status .val { font-size:16px; font-weight:600; }

  .phone-notif {
    background:var(--t-card); border:1px solid var(--t-card-border);
    border-radius:8px; padding:12px; display:flex; gap:12px; align-items:flex-start;
    margin-bottom:8px;
  }
  .notif-icon { width:32px; height:32px; border-radius:8px; background:var(--vert); display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; }
  .notif-text .title { font-size:12px; font-weight:700; margin-bottom:2px; }
  .notif-text .body { font-size:11px; color:rgba(255,255,255,0.5); }

  .famille-content .section-title { margin-bottom:32px; }
  .famille-points { display:flex; flex-direction:column; gap:20px; }
  .fam-point {
    display:flex; gap:20px; align-items:flex-start;
    padding:20px; border-radius:10px;
    background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);
    transition:border-color 0.2s;
  }
  .fam-point:hover { border-color:rgba(212,168,0,0.3); }
  .fam-point .fam-icon { font-size:28px; flex-shrink:0; margin-top:2px; }
  .fam-point h4 { font-size:15px; font-weight:700; margin-bottom:6px; }
  .fam-point p  { font-size:13px; color:rgba(255,255,255,0.62); line-height:1.6; }

  /* ── PAIEMENT ── */
  .paiement { background:var(--t-bg2); }
  .pay-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:56px; }
  .pay-card {
    background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07);
    border-radius:12px; padding:32px 24px; text-align:center; transition:all 0.25s;
  }
  .pay-card:hover { border-color:rgba(212,168,0,0.3); transform:translateY(-4px); }
  .pay-card .pay-logo { font-size:40px; margin-bottom:16px; }
  .pay-card h3 { font-size:16px; font-weight:700; margin-bottom:8px; }
  .pay-card p { font-size:13px; color:rgba(255,255,255,0.58); }
  .pay-card .tag {
    display:inline-block; margin-top:12px;
    font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase;
    color:var(--vert2); background:rgba(45,146,85,0.12); border:1px solid rgba(45,146,85,0.3);
    border-radius:100px; padding:3px 12px;
  }

  /* ── DASHBOARD ── */
  .dashboard-section { background:linear-gradient(180deg,var(--t-bg),var(--t-bg2)); }
  .dash-preview {
    margin-top:56px;
    background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);
    border-radius:16px; overflow:hidden;
  }
  .dash-topbar {
    background:rgba(255,255,255,0.04); border-bottom:1px solid rgba(255,255,255,0.07);
    padding:16px 24px; display:flex; align-items:center; gap:20px;
  }
  .dash-topbar .dtab {
    font-size:13px; font-weight:600; padding:8px 20px; border-radius:6px; cursor:pointer;
    transition:all 0.2s; color:rgba(255,255,255,0.5);
  }
  .dash-topbar .dtab.active { background:var(--vert); color:var(--white); }
  .dash-topbar .dtab:hover:not(.active) { color:var(--white); }

  .dash-body { padding:28px 24px; }
  .dash-kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px; }
  .dash-kpi {
    background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07);
    border-radius:10px; padding:20px;
  }
  .dash-kpi .k-label { font-size:11px; color:rgba(255,255,255,0.4); letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; }
  .dash-kpi .k-val { font-family:'Playfair Display',serif; font-size:32px; font-weight:700; }
  .dash-kpi .k-val.green { color:var(--vert2); }
  .dash-kpi .k-val.gold  { color:var(--or); }
  .dash-kpi .k-val.white { color:var(--white); }
  .dash-kpi .k-delta { font-size:12px; color:rgba(45,146,85,0.8); margin-top:4px; }

  .dash-tables { display:grid; grid-template-columns:1.4fr 1fr; gap:20px; }
  .dash-table-card {
    background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);
    border-radius:10px; overflow:hidden;
  }
  .dash-table-card .dt-header {
    padding:16px 20px; border-bottom:1px solid rgba(255,255,255,0.06);
    font-size:13px; font-weight:700; color:rgba(255,255,255,0.7);
    display:flex; justify-content:space-between; align-items:center;
  }
  .dt-export {
    font-size:11px; color:var(--or); background:rgba(212,168,0,0.1); border:1px solid rgba(212,168,0,0.3);
    border-radius:4px; padding:4px 12px; cursor:pointer; transition:all 0.2s;
  }
  .dt-export:hover { background:rgba(212,168,0,0.2); }
  table { width:100%; border-collapse:collapse; }
  th { font-size:11px; color:rgba(255,255,255,0.3); text-transform:uppercase; letter-spacing:1px; padding:12px 20px; text-align:left; border-bottom:1px solid rgba(255,255,255,0.05); }
  td { font-size:13px; padding:12px 20px; border-bottom:1px solid rgba(255,255,255,0.04); color:rgba(255,255,255,0.75); }
  tr:last-child td { border-bottom:none; }
  tr:hover td { background:rgba(255,255,255,0.02); }
  .status { font-size:10px; font-weight:700; letter-spacing:1px; padding:3px 10px; border-radius:100px; text-transform:uppercase; }
  .status.ok   { background:rgba(45,146,85,0.15); color:var(--vert2); border:1px solid rgba(45,146,85,0.3); }
  .status.enr  { background:rgba(212,168,0,0.12); color:var(--or); border:1px solid rgba(212,168,0,0.3); }
  .status.ann  { background:rgba(175,2,11,0.12); color:#ff6b6b; border:1px solid rgba(175,2,11,0.3); }

  /* ── CTA FINAL ── */
  .cta-section {
    background:var(--t-cta-bg);
    padding:100px 48px; text-align:center;
  }
  .cta-section .section-title { color:var(--white); margin-bottom:20px; }
  .cta-section .section-sub { color:rgba(255,255,255,0.65); margin:0 auto 48px; }
  .cta-buttons { display:flex; justify-content:center; gap:20px; flex-wrap:wrap; }

  /* ── FOOTER ── */
  footer {
    background:var(--t-footer-bg); border-top:1px solid rgba(255,255,255,0.06);
    padding:56px 48px 32px;
  }
  .footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:48px; margin-bottom:48px; }
  .footer-brand .fb-logo { font-family:'Playfair Display',serif; font-size:20px; font-weight:700; color:var(--white); margin-bottom:8px; }
  .footer-brand .fb-sub { font-size:11px; color:var(--or); letter-spacing:3px; text-transform:uppercase; margin-bottom:16px; }
  .footer-brand p { font-size:13px; color:rgba(255,255,255,0.55); line-height:1.7; }
  .footer-col h4 { font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.62); margin-bottom:16px; }
  .footer-col a { display:block; font-size:13px; color:rgba(255,255,255,0.55); text-decoration:none; margin-bottom:10px; transition:color 0.2s; }
  .footer-col a:hover { color:var(--or); }
  .footer-bottom { border-top:1px solid rgba(255,255,255,0.06); padding-top:24px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; }
  .footer-bottom p { font-size:12px; color:rgba(255,255,255,0.25); }
  .footer-flags { display:flex; gap:8px; font-size:20px; }

  /* Réseaux sociaux */
  .footer-social { display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
  .footer-social-label { font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.35); }
  .social-link {
    display:flex; align-items:center; justify-content:center;
    width:36px; height:36px; border-radius:8px;
    background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1);
    transition:all 0.2s; text-decoration:none;
  }
  .social-link:hover { background:rgba(212,168,0,0.15); border-color:rgba(212,168,0,0.4); transform:translateY(-2px); }
  .social-link svg { width:18px; height:18px; fill:rgba(255,255,255,0.6); transition:fill 0.2s; }
  .social-link:hover svg { fill:var(--or); }
  .footer-email {
    display:flex; align-items:center; gap:8px;
    font-size:13px; color:rgba(255,255,255,0.45);
    text-decoration:none; transition:color 0.2s;
  }
  .footer-email:hover { color:var(--or); }
  .footer-email svg { width:15px; height:15px; fill:rgba(255,255,255,0.35); flex-shrink:0; }

  /* ── TELECHARGER L'APPLICATION ── */
  .app-download-strip {
    background:linear-gradient(135deg,rgba(26,107,58,0.18) 0%,rgba(171,73,1,0.12) 100%);
    border-top:1px solid rgba(26,107,58,0.25);
    border-bottom:1px solid rgba(26,107,58,0.15);
    padding:36px 48px;
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:24px;
  }
  .app-download-text { flex:1; min-width:220px; }
  .app-download-text h3 {
    font-family:'Playfair Display',serif;
    font-size:22px; font-weight:700;
    color:var(--white); margin-bottom:6px;
  }
  .app-download-text p { font-size:13px; color:rgba(255,255,255,0.5); line-height:1.6; margin:0; }
  .app-download-buttons { display:flex; gap:14px; flex-wrap:wrap; align-items:center; }
  .app-store-btn {
    display:inline-flex; align-items:center; gap:12px;
    padding:11px 22px; border-radius:12px; text-decoration:none;
    border:1.5px solid rgba(255,255,255,0.2);
    background:rgba(255,255,255,0.07);
    backdrop-filter:blur(6px);
    transition:all 0.25s; min-width:160px;
  }
  .app-store-btn:hover {
    background:rgba(255,255,255,0.14);
    border-color:var(--or);
    transform:translateY(-2px);
    box-shadow:0 8px 24px rgba(0,0,0,0.3);
  }
  .app-store-btn svg { width:26px; height:26px; fill:rgba(255,255,255,0.9); flex-shrink:0; }
  .app-store-btn-text { display:flex; flex-direction:column; }
  .app-store-btn-label { font-size:10px; color:rgba(255,255,255,0.5); letter-spacing:0.5px; line-height:1; margin-bottom:3px; }
  .app-store-btn-name { font-size:15px; font-weight:700; color:var(--white); line-height:1.1; }
  .app-store-btn.playstore:hover { border-color:#34c759; }
  .app-store-btn.appstore:hover { border-color:rgba(200,200,255,0.7); }

  @media(max-width:900px) {
    .app-download-strip { padding:28px 20px; flex-direction:column; align-items:flex-start; }

  }


  /* ═══════════════════════════════════════════════════
     LABEL CTL CERTIFIÉ — POLITIQUE DE RÉCOMPENSE
     ═══════════════════════════════════════════════════ */
  .label-section { background:var(--t-bg); padding:96px 48px; }
  .label-intro { max-width:780px; margin:0 auto 60px; text-align:center; }
  .label-intro p { font-size:15px; color:rgba(255,255,255,0.55); line-height:1.8; margin-top:16px; }

  .label-tiers {
    display:grid; grid-template-columns:repeat(3,1fr); gap:28px;
    max-width:1060px; margin:0 auto 64px;
  }
  .label-card {
    border-radius:16px; padding:28px 24px;
    position:relative; overflow:hidden;
    border:1px solid rgba(255,255,255,0.08);
    transition:transform 0.25s, box-shadow 0.25s;
  }
  .label-card:hover { transform:translateY(-4px); box-shadow:0 20px 50px rgba(0,0,0,0.4); }
  .label-card.bronze { background:linear-gradient(145deg,#1a1208,#0d0b06); border-color:rgba(180,110,50,0.35); }
  .label-card.silver { background:linear-gradient(145deg,#111620,#080d14); border-color:rgba(160,180,200,0.35); }
  .label-card.gold   { background:linear-gradient(145deg,#1a1308,#0d0c04); border-color:rgba(212,168,0,0.5); }
  .label-card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:3px;
  }
  .label-card.bronze::before { background:linear-gradient(90deg,#b46e32,#d4904a); }
  .label-card.silver::before { background:linear-gradient(90deg,#8aacbc,#c8d8e8); }
  .label-card.gold::before   { background:linear-gradient(90deg,#d4a800,#f0c020); }

  .label-badge {
    display:inline-flex; align-items:center; gap:8px;
    padding:6px 14px; border-radius:100px;
    font-size:11px; font-weight:800; letter-spacing:2px; text-transform:uppercase;
    margin-bottom:18px;
  }
  .label-badge.bronze { background:rgba(180,110,50,0.15); color:#d4904a; border:1px solid rgba(180,110,50,0.35); }
  .label-badge.silver { background:rgba(160,180,200,0.12); color:#b8d0e0; border:1px solid rgba(160,180,200,0.3); }
  .label-badge.gold   { background:rgba(212,168,0,0.12);  color:var(--or); border:1px solid rgba(212,168,0,0.4); }

  .label-card h3 { font-family:'Playfair Display',serif; font-size:22px; font-weight:700; margin-bottom:6px; color:var(--white); }
  .label-card .label-sub { font-size:12px; color:rgba(255,255,255,0.4); margin-bottom:24px; }
  .label-critere {
    display:flex; align-items:flex-start; gap:10px;
    padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.05);
    font-size:13px;
  }
  .label-critere:last-child { border-bottom:none; }
  .label-critere .lc-icon { font-size:16px; flex-shrink:0; margin-top:1px; }
  .label-critere .lc-text { flex:1; color:rgba(255,255,255,0.7); line-height:1.5; }
  .label-critere .lc-val  { font-weight:700; font-size:12px; white-space:nowrap; padding:2px 8px; border-radius:100px; }
  .label-card.bronze .lc-val { background:rgba(180,110,50,0.15); color:#d4904a; }
  .label-card.silver .lc-val { background:rgba(160,180,200,0.12); color:#b8d0e0; }
  .label-card.gold   .lc-val { background:rgba(212,168,0,0.12);  color:var(--or); }

  .label-avantages {
    margin-top:24px; padding:16px; border-radius:10px;
    background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07);
  }
  .label-avantages h4 { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.35); margin-bottom:10px; }
  .label-avantage { font-size:12px; color:rgba(255,255,255,0.6); padding:4px 0; display:flex; align-items:center; gap:8px; }
  .label-avantage::before { content:'→'; color:rgba(255,255,255,0.25); font-size:10px; }

  .label-note {
    max-width:820px; margin:0 auto;
    background:rgba(26,107,58,0.08); border:1px solid rgba(26,107,58,0.25);
    border-radius:12px; padding:24px 32px;
    display:flex; gap:16px; align-items:flex-start;
  }
  .label-note-icon { font-size:24px; flex-shrink:0; }
  .label-note-text { font-size:13px; color:rgba(255,255,255,0.55); line-height:1.8; }
  .label-note-text strong { color:var(--vert2); }

  /* Responsive label */
  @media(max-width:900px) { .label-tiers { grid-template-columns:1fr; } }

  /* ═══════════════════════════════════════════════════
     PRIX DE L'ANNÉE — PROGRAMME FIDÉLITÉ PASSAGERS
     ═══════════════════════════════════════════════════ */
  .prix-section {
    background:linear-gradient(160deg,#06100a 0%,#0a1a10 40%,#0d1505 100%);
    padding:96px 48px;
    border-top:1px solid rgba(212,168,0,0.15);
    position:relative; overflow:hidden;
    display:flex; flex-direction:column; align-items:center;
  }
  .prix-section::before {
    content:'';
    position:absolute; top:-120px; right:-120px;
    width:500px; height:500px; border-radius:50%;
    background:radial-gradient(circle,rgba(212,168,0,0.06) 0%,transparent 70%);
    pointer-events:none;
  }
  .prix-header { text-align:center; margin-bottom:64px; max-width:900px; margin-left:auto; margin-right:auto; }
  .prix-trophy { font-size:56px; margin-bottom:16px; display:block; }
  .prix-header .section-title { color:var(--white); }
  .prix-header .section-sub   { color:rgba(255,255,255,0.5); max-width:620px; margin-left:auto; margin-right:auto; }

  .prix-paliers {
    display:grid; grid-template-columns:repeat(3,1fr); gap:28px;
    max-width:960px; margin:0 auto 56px;
  }
  .prix-palier {
    border-radius:14px; padding:28px 22px; text-align:center;
    border:1px solid rgba(255,255,255,0.08);
    background:rgba(255,255,255,0.03);
    position:relative; transition:transform 0.2s;
  }
  .prix-palier:hover { transform:translateY(-3px); }
  .prix-palier.featured {
    border-color:rgba(212,168,0,0.5);
    background:linear-gradient(145deg,rgba(212,168,0,0.08),rgba(171,73,1,0.06));
  }
  .prix-palier.featured::after {
    content:'👑 GRAND VOYAGEUR';
    position:absolute; top:-12px; left:50%; transform:translateX(-50%);
    background:linear-gradient(90deg,var(--cuivre),var(--or));
    color:#071009; font-size:9px; font-weight:900; letter-spacing:2px;
    padding:4px 12px; border-radius:100px; white-space:nowrap;
  }
  .pp-emoji  { font-size:36px; margin-bottom:12px; display:block; }
  .pp-titre  { font-family:'Playfair Display',serif; font-size:17px; font-weight:700; color:var(--white); margin-bottom:4px; }
  .pp-trajets { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:16px; }
  .prix-palier:nth-child(1) .pp-trajets { color:rgba(205,127,50,0.8); }
  .prix-palier:nth-child(2) .pp-trajets { color:rgba(192,192,192,0.8); }
  .prix-palier:nth-child(3) .pp-trajets { color:var(--or); }
  .pp-reward {
    background:rgba(255,255,255,0.06); border-radius:8px; padding:14px;
    font-size:13px; color:rgba(255,255,255,0.7); line-height:1.6; margin-bottom:12px;
  }
  .pp-bonus { font-size:11px; color:rgba(255,255,255,0.35); line-height:1.6; }

  .prix-calendrier {
    max-width:760px; margin:0 auto 48px;
    background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);
    border-radius:14px; padding:28px 36px;
  }
  .prix-calendrier h3 {
    font-size:13px; font-weight:700; letter-spacing:2px; text-transform:uppercase;
    color:var(--or); margin-bottom:20px;
  }
  .prix-timeline {
    display:grid; grid-template-columns:repeat(4,1fr); gap:0;
    position:relative;
  }
  .prix-timeline::before {
    content:''; position:absolute; top:20px; left:10%; right:10%; height:2px;
    background:linear-gradient(90deg,rgba(212,168,0,0.1),rgba(212,168,0,0.5),rgba(212,168,0,0.1));
  }
  .pt-item { text-align:center; padding:0 8px; position:relative; }
  .pt-dot {
    width:40px; height:40px; border-radius:50%; margin:0 auto 10px;
    display:flex; align-items:center; justify-content:center;
    font-size:16px; border:2px solid rgba(212,168,0,0.3);
    background:rgba(212,168,0,0.08); position:relative; z-index:1;
  }
  .pt-mois { font-size:11px; font-weight:700; color:var(--or); margin-bottom:4px; }
  .pt-desc { font-size:11px; color:rgba(255,255,255,0.4); line-height:1.5; }

  .prix-regles {
    max-width:760px; margin:0 auto;
    background:rgba(171,73,1,0.08); border:1px solid rgba(171,73,1,0.25);
    border-radius:12px; padding:24px 32px;
    display:flex; gap:16px; align-items:flex-start;
  }
  .prix-regles-text { font-size:13px; color:rgba(255,255,255,0.5); line-height:1.8; }
  .prix-regles-text strong { color:#d4904a; }

  @media(max-width:900px) {
    .prix-paliers { grid-template-columns:1fr 1fr; }
    .prix-timeline { grid-template-columns:1fr 1fr; gap:20px; }
    .prix-timeline::before { display:none; }
    .label-section, .prix-section { padding:64px 20px; }
  }
  @media(max-width:600px) { .prix-paliers { grid-template-columns:1fr; } }


  /* ── Modal Politique de Confidentialité — pleine largeur ── */
  #modalPrivacy .modal-box {
    max-width: min(920px, 94vw) !important;
    width: 94vw;
  }
  #modalPrivacy .pc-nav {
    padding: 0 4px;
  }
  #modalPrivacy .pc-nav-btn {
    flex: 1 0 auto;
  }

  /* ── SCROLL REVEAL ── */
  .reveal { opacity:0; transform:translateY(32px); transition:all 0.7s ease; }
  .reveal.visible { opacity:1; transform:none; }

  /* ── MENU HAMBURGER MOBILE ── */
  .hamburger {
    display:none; background:none; border:none; cursor:pointer;
    flex-direction:column; gap:5px; padding:8px; z-index:1001;
  }
  .hamburger span {
    display:block; width:24px; height:2px; background:var(--white);
    border-radius:2px; transition:all 0.3s;
  }
  .hamburger.active span:nth-child(1) { transform:rotate(45deg) translate(5px,5px); }
  .hamburger.active span:nth-child(2) { opacity:0; }
  .hamburger.active span:nth-child(3) { transform:rotate(-45deg) translate(5px,-5px); }

  /* ── RESPONSIVE ── */
  @media(max-width:900px){
    nav { padding:14px 20px; }
    .hamburger { display:flex; }
    .nav-links {
      display:none; position:fixed; top:0; left:0; right:0; bottom:0;
      background:var(--t-nav); backdrop-filter:blur(16px);
      flex-direction:column; align-items:center; justify-content:center;
      gap:24px; z-index:1000;
    }
    .nav-links.mobile-open { display:flex; }
    .nav-links a { font-size:18px; }
    section { padding:64px 20px; }
    .hero { padding:100px 20px 64px; }
    .hero-stats { grid-template-columns:repeat(2,1fr); position:relative; bottom:auto; left:auto; right:auto; margin-top:48px; }
    .corridors-grid, .innovations-grid { grid-template-columns:1fr 1fr; }
    .tarifs-grid, .pay-grid { grid-template-columns:1fr; }
    .famille-inner { grid-template-columns:1fr; }
    .steps { grid-template-columns:1fr 1fr; }
    .steps::before { display:none; }
    .dash-kpis { grid-template-columns:1fr 1fr; }
    .dash-tables { grid-template-columns:1fr; }
    .footer-grid { grid-template-columns:1fr 1fr; }
    .corridor-search { grid-template-columns:1fr; }
  }
  /* ── MODAL RÉSERVATION ── */

  /* ── CONSENTEMENT CTL — Loi n°2010/012 Cameroun ── */
  .ctl-consent-block {
    margin: 14px 0 10px;
    padding: 13px 15px;
    background: rgba(26,107,58,0.09);
    border: 1px solid rgba(26,107,58,0.25);
    border-left: 3px solid #1a6b3a;
    border-radius: 8px;
  }
  .ctl-consent-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 11.5px;
    color: rgba(255,255,255,0.72);
    line-height: 1.65;
  }
  .ctl-consent-item:last-child { margin-bottom: 0; }
  .ctl-consent-item input[type=checkbox] {
    width: 15px; height: 15px;
    flex-shrink: 0; margin-top: 2px;
    accent-color: #2d9255;
    cursor: pointer;
  }
  .ctl-consent-item label { cursor: pointer; }
  .ctl-consent-item strong { color: rgba(255,255,255,0.9); }
  .ctl-consent-link {
    color: #d4a800; text-decoration: underline;
    cursor: pointer; white-space: nowrap;
  }
  .ctl-consent-error {
    color: #ff6b6b; font-size: 11px;
    margin-top: 8px; display: none;
  }

  .modal-overlay {
    position: fixed; inset: 0; z-index: 2000;
    background: rgba(0,0,0,0.78); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.25s;
    padding: 20px;
  }
  .modal-overlay.open { opacity: 1; pointer-events: all; }

  .modal-box {
    background: #111e14; border: 1px solid rgba(212,168,0,0.2);
    border-radius: 16px; width: 100%; max-width: 620px;
    max-height: 90vh; overflow-y: auto;
    transform: translateY(28px); transition: transform 0.28s ease;
    box-shadow: 0 40px 80px rgba(0,0,0,0.6);
  }
  .modal-overlay.open .modal-box { transform: translateY(0); }
  .modal-box::-webkit-scrollbar { width: 4px; }
  .modal-box::-webkit-scrollbar-thumb { background: rgba(212,168,0,0.3); border-radius:4px; }

  .modal-header {
    padding: 24px 28px 0; display: flex; align-items: flex-start; justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.07); padding-bottom: 18px;
  }
  .modal-header .mh-title { font-family:'Playfair Display',serif; font-size:20px; font-weight:700; }
  .modal-header .mh-sub { font-size:12px; color:rgba(255,255,255,0.4); margin-top:4px; }
  .modal-close {
    width:32px; height:32px; border-radius:50%; border:1px solid rgba(255,255,255,0.12);
    background:transparent; color:rgba(255,255,255,0.5); font-size:16px; cursor:pointer;
    display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:all 0.2s;
  }
  .modal-close:hover { background:rgba(255,255,255,0.08); color:var(--white); }

  .modal-recap {
    margin: 18px 28px; padding: 14px 18px;
    background: rgba(26,107,58,0.1); border: 1px solid rgba(26,107,58,0.25); border-radius: 8px;
    display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,0.7);
  }
  .modal-recap strong { color: var(--white); }
  .modal-recap .mr-sep { color: rgba(255,255,255,0.2); }

  .modal-body { padding: 8px 28px 24px; }

  .modal-section-title {
    font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase;
    color: var(--or); margin: 20px 0 14px; display: flex; align-items: center; gap: 8px;
  }
  .modal-section-title::after {
    content:''; flex:1; height:1px; background:rgba(212,168,0,0.15);
  }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
  .form-row.single { grid-template-columns: 1fr; }
  .form-row.triple { grid-template-columns: 1fr 1fr 1fr; }

  .form-field { display: flex; flex-direction: column; gap: 6px; }
  .form-field label {
    font-size: 11px; color: rgba(255,255,255,0.5); letter-spacing: 1px; text-transform: uppercase;
  }
  .form-field label .req { color: var(--rouge2); margin-left: 2px; }
  .form-field input, .form-field select {
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
    border-radius: 6px; padding: 11px 14px; color: var(--white);
    font-family: 'Outfit', sans-serif; font-size: 14px; outline: none; transition: border-color 0.2s;
  }
  .form-field input:focus, .form-field select:focus { border-color: var(--or); }
  .form-field input::placeholder { color: rgba(255,255,255,0.25); }
  .form-field select option { background: #111e14; }
  .form-field .field-hint { font-size: 11px; color: rgba(255,255,255,0.3); margin-top: 2px; }

  /* Contact famille */
  .contact-famille-block {
    background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px; padding: 16px 18px; margin-bottom: 12px; position: relative;
  }
  .contact-famille-block .cfb-title {
    font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.7); margin-bottom: 12px;
    display: flex; align-items: center; gap: 8px;
  }
  .cfb-badge {
    font-size: 9px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    background: rgba(26,107,58,0.2); border: 1px solid rgba(26,107,58,0.3);
    color: var(--vert2); padding: 2px 8px; border-radius: 100px;
  }
  .cfb-badge.opt {
    background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.35);
  }
  .btn-add-contact {
    display: flex; align-items: center; gap: 8px; margin-top: 8px;
    background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.12);
    border-radius: 6px; padding: 10px 16px; color: rgba(255,255,255,0.4);
    font-size: 13px; cursor: pointer; transition: all 0.2s; width: 100%;
    font-family: 'Outfit', sans-serif;
  }
  .btn-add-contact:hover { border-color: rgba(212,168,0,0.3); color: var(--or); }

  .modal-footer {
    padding: 16px 28px 24px;
    border-top: 1px solid rgba(255,255,255,0.07);
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .mf-price { font-family:'Playfair Display',serif; font-size:22px; font-weight:700; color:var(--or); }
  .mf-price small { font-family:'Outfit',sans-serif; font-size:12px; color:rgba(255,255,255,0.35); font-weight:400; display:block; }
  .modal-footer .mf-actions { display:flex; gap:12px; }
  .btn-cancel-modal {
    background:transparent; border:1px solid rgba(255,255,255,0.12); color:rgba(255,255,255,0.5);
    padding:12px 24px; border-radius:6px; font-family:'Outfit',sans-serif; font-size:14px;
    cursor:pointer; transition:all 0.2s;
  }
  .btn-cancel-modal:hover { border-color:rgba(255,255,255,0.25); color:var(--white); }
  .btn-confirm-resa {
    background:var(--rouge); color:var(--white); border:none;
    padding:12px 32px; border-radius:6px; font-family:'Outfit',sans-serif;
    font-size:14px; font-weight:700; cursor:pointer; transition:background 0.2s;
  }
  .btn-confirm-resa:hover { background:var(--rouge2); }

  /* Confirmation success */
  .resa-success {
    text-align:center; padding:48px 28px;
  }
  .resa-success .rs-icon { font-size:56px; margin-bottom:16px; }
  .resa-success h3 { font-family:'Playfair Display',serif; font-size:24px; margin-bottom:8px; }
  .resa-success p { font-size:14px; color:rgba(255,255,255,0.5); line-height:1.6; }

  /* ── TUNNEL PAIEMENT ── */
  .pai-card { user-select:none; }
  .pai-card:hover { transform:translateY(-2px); filter:brightness(1.1); }
  #paiNumero:focus { border-color:rgba(212,168,0,0.5); }
  .resa-success .rs-ref {
    display:inline-block; margin:20px 0; background:rgba(212,168,0,0.1);
    border:1px solid rgba(212,168,0,0.3); border-radius:8px; padding:10px 24px;
    font-family:'Playfair Display',serif; font-size:20px; color:var(--or); letter-spacing:2px;
  }

  /* ── MODAL PUBLICATION TRAJET CHAUFFEUR ── */
  .lieu-rdv-wrap { position: relative; }
  .lieu-rdv-wrap input {
    padding-right: 44px;
  }
  .btn-geolocate {
    position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    background: rgba(212,168,0,0.15); border: 1px solid rgba(212,168,0,0.3);
    color: var(--or); width: 30px; height: 30px; border-radius: 6px;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    font-size: 15px; transition: all 0.2s; flex-shrink: 0;
  }
  .btn-geolocate:hover { background: rgba(212,168,0,0.25); }
  .btn-geolocate.loading { animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: translateY(-50%) rotate(360deg); } }

  .lieux-suggestions {
    background: #0e1a11; border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px; margin-top: 6px; overflow: hidden;
    display: none;
  }
  .lieux-suggestions.open { display: block; }
  .lieu-suggestion-title {
    font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
    color: var(--or); padding: 10px 14px 6px;
  }
  .lieu-item {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 11px 14px; cursor: pointer; transition: background 0.15s;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .lieu-item:hover { background: rgba(255,255,255,0.04); }
  .lieu-item-icon {
    font-size: 18px; flex-shrink: 0; margin-top: 1px;
  }
  .lieu-item-info { flex: 1; }
  .lieu-item-name {
    font-size: 14px; font-weight: 600; color: var(--white);
  }
  .lieu-item-desc {
    font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 2px; line-height: 1.4;
  }
  .lieu-item-dist {
    font-size: 11px; color: var(--vert2); font-weight: 600; flex-shrink: 0; margin-top: 2px;
  }
  .lieu-item-tags {
    display: flex; flex-wrap: wrap; gap: 4px; margin-top: 5px;
  }
  .lieu-tag {
    font-size: 9px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    padding: 2px 7px; border-radius: 100px;
  }
  .lieu-tag.parking { background: rgba(45,146,85,0.15); color: var(--vert2); border: 1px solid rgba(45,146,85,0.3); }
  .lieu-tag.public  { background: rgba(212,168,0,0.12); color: var(--or); border: 1px solid rgba(212,168,0,0.3); }
  .lieu-tag.marche  { background: rgba(171,73,1,0.15); color: #e07830; border: 1px solid rgba(171,73,1,0.3); }

  .lieu-selected-box {
    background: rgba(45,146,85,0.08); border: 1px solid rgba(45,146,85,0.3);
    border-radius: 8px; padding: 12px 16px; margin-top: 8px;
    display: none; align-items: center; gap: 12px;
  }
  .lieu-selected-box.show { display: flex; }
  .lsb-icon { font-size: 22px; flex-shrink: 0; }
  .lsb-info { flex: 1; }
  .lsb-name { font-size: 14px; font-weight: 700; color: var(--white); }
  .lsb-addr { font-size: 12px; color: rgba(255,255,255,0.45); margin-top: 2px; }
  .lsb-change {
    font-size: 12px; color: rgba(255,255,255,0.4); background: transparent;
    border: 1px solid rgba(255,255,255,0.12); border-radius: 5px; padding: 5px 12px;
    cursor: pointer; font-family: 'Outfit', sans-serif; transition: all 0.2s;
  }
  .lsb-change:hover { color: var(--white); border-color: rgba(255,255,255,0.3); }

  .geo-status {
    font-size: 12px; color: rgba(255,255,255,0.4); padding: 8px 0;
    display: flex; align-items: center; gap: 8px;
  }
  .geo-status.error { color: rgba(255,100,80,0.8); }


/* ══ ESPACE PERSONNEL — TABLEAU DE BORD PASSAGER ══ */
.dashboard-overlay { position:fixed;inset:0;z-index:2000;background:var(--t-bg);overflow-y:auto;display:none;animation:fadeInDash 0.3s ease; }
.dashboard-overlay.open { display:block; }
@keyframes fadeInDash { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
.dash-nav { background:rgba(10,18,9,0.97);border-bottom:1px solid rgba(26,107,58,0.25);padding:14px 32px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:10;backdrop-filter:blur(12px); }
.dash-nav-brand { font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:var(--or); }
.dash-nav-user { display:flex;align-items:center;gap:12px;font-size:13px;color:rgba(255,255,255,0.6); }
.dash-avatar { width:34px;height:34px;border-radius:50%;background:var(--vert);border:2px solid var(--vert2);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:#fff;flex-shrink:0; }
.dash-close { background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);padding:7px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;transition:all 0.2s; }
.dash-close:hover { background:rgba(255,255,255,0.12);color:#fff; }
.dash-body { max-width:1100px;margin:0 auto;padding:32px 24px; }
.dash-tabs { display:flex;gap:4px;border-bottom:1px solid rgba(255,255,255,0.08);margin-bottom:28px; }
.dash-tab { background:transparent;border:none;color:rgba(255,255,255,0.45);font-family:'Outfit',sans-serif;font-size:13px;font-weight:600;padding:10px 20px;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.2s; }
.dash-tab.active { color:var(--or);border-bottom-color:var(--or); }
.dash-panel { display:none; }
.dash-panel.active { display:block; }
.dash-welcome { margin-bottom:28px; }
.dash-welcome h2 { font-family:'Playfair Display',serif;font-size:24px;font-weight:700;margin-bottom:6px; }
.dash-welcome p { font-size:14px;color:rgba(255,255,255,0.5); }
.dash-kpis { display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:28px; }
.dash-kpi { background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:18px 20px; }
.dash-kpi .dk-val { font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--or); }
.dash-kpi .dk-label { font-size:11px;color:rgba(255,255,255,0.4);text-transform:uppercase;letter-spacing:1.5px;margin-top:4px; }
.billet-card { background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:20px 24px;margin-bottom:12px;display:flex;align-items:center;gap:20px;transition:all 0.2s; }
.billet-card:hover { border-color:rgba(212,168,0,0.3);background:rgba(212,168,0,0.04); }
.bc-ref { font-family:monospace;font-size:13px;color:var(--or);font-weight:700;min-width:110px; }
.bc-route { font-size:14px;font-weight:600;flex:1; }
.bc-meta { font-size:12px;color:rgba(255,255,255,0.4);margin-top:3px; }
.bc-statut { padding:4px 12px;border-radius:100px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px; }
.bc-statut.confirme { background:rgba(45,146,85,0.15);color:#2d9255;border:1px solid rgba(45,146,85,0.3); }
.bc-statut.en-route { background:rgba(50,120,220,0.15);color:#6ab0f5;border:1px solid rgba(50,120,220,0.3); }
.bc-statut.termine { background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.4);border:1px solid rgba(255,255,255,0.1); }
.bc-qr { width:40px;height:40px;background:rgba(255,255,255,0.06);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;cursor:pointer; }
.bc-actions { display:flex;gap:8px; }
.bc-btn { background:transparent;border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.55);padding:6px 14px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;cursor:pointer;transition:all 0.2s; }
.bc-btn:hover { border-color:var(--or);color:var(--or); }
.bc-btn.danger:hover { border-color:var(--rouge2);color:var(--rouge2); }
/* Suivi GPS billet */
.suivi-billet { background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.25);border-radius:12px;padding:18px 22px;margin-top:10px; }
.suivi-progress { display:flex;align-items:center;gap:0;margin:14px 0; }
.suivi-step { display:flex;flex-direction:column;align-items:center;flex:1; }
.suivi-dot { width:14px;height:14px;border-radius:50%;border:2px solid rgba(255,255,255,0.2);background:#0f1a13;z-index:1;transition:all 0.3s; }
.suivi-dot.done { background:var(--vert2);border-color:var(--vert2); }
.suivi-dot.active { background:var(--or);border-color:var(--or);box-shadow:0 0 0 4px rgba(212,168,0,0.2); }
.suivi-line { flex:1;height:2px;background:rgba(255,255,255,0.1);margin-top:-8px;transition:all 0.3s; }
.suivi-line.done { background:var(--vert2); }
.suivi-label { font-size:10px;color:rgba(255,255,255,0.4);margin-top:6px;text-align:center; }
/* Notifications */
.notif-badge { position:absolute;top:-4px;right:-4px;background:var(--rouge);color:#fff;font-size:9px;font-weight:700;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;display:none; }
.notif-badge.visible { display:flex; }
.notif-panel { position:fixed;top:64px;right:20px;width:340px;background:#0d1a10;border:1px solid rgba(26,107,58,0.3);border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.6);z-index:3000;display:none;overflow:hidden; }
.notif-panel.open { display:block;animation:fadeInDash 0.2s ease; }
.notif-header { padding:14px 18px;border-bottom:1px solid rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:space-between; }
.notif-title { font-size:14px;font-weight:700; }
.notif-list { max-height:320px;overflow-y:auto; }
.notif-item { padding:12px 18px;border-bottom:1px solid rgba(255,255,255,0.04);display:flex;gap:12px;cursor:pointer;transition:background 0.2s; }
.notif-item:hover { background:rgba(255,255,255,0.03); }
.notif-item.unread { background:rgba(212,168,0,0.04); }
.notif-ico { font-size:18px;flex-shrink:0;margin-top:2px; }
.notif-text { flex:1; }
.notif-msg { font-size:13px;color:rgba(255,255,255,0.85);line-height:1.4; }
.notif-time { font-size:11px;color:rgba(255,255,255,0.3);margin-top:3px; }
/* Nav bouton Mon Espace */
.nav-mon-espace { background:rgba(212,168,0,0.15);border:1px solid rgba(212,168,0,0.35);color:var(--or);padding:7px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:all 0.2s;position:relative;display:none; }
.nav-mon-espace:hover { background:rgba(212,168,0,0.25); }
.nav-mon-espace.visible { display:flex;align-items:center;gap:8px; }
/* Modal QR Code */
.qr-modal { text-align:center;padding:32px; }
.qr-code-svg { display:inline-block;padding:16px;background:#fff;border-radius:12px;margin:20px 0; }
/* Profil edit */
.profil-section { background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:22px 24px;margin-bottom:16px; }
.ps-title { font-size:13px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--or);margin-bottom:16px; }
/* Annulation billet */
.annul-reason { display:flex;flex-direction:column;gap:10px;margin:16px 0; }
.annul-option { display:flex;align-items:center;gap:10px;padding:12px 16px;border:1px solid rgba(255,255,255,0.1);border-radius:8px;cursor:pointer;transition:all 0.2s;font-size:13px; }
.annul-option:hover,.annul-option.selected { border-color:var(--or);background:rgba(212,168,0,0.06);color:var(--or); }
/* Support chat */
.support-chat { display:flex;flex-direction:column;gap:10px;max-height:300px;overflow-y:auto;padding:16px;background:rgba(0,0,0,0.2);border-radius:10px;margin-bottom:12px; }
.sc-msg { max-width:75%;padding:10px 14px;border-radius:12px;font-size:13px;line-height:1.5; }
.sc-msg.bot { background:rgba(26,107,58,0.2);border:1px solid rgba(26,107,58,0.2);align-self:flex-start; }
.sc-msg.user { background:rgba(212,168,0,0.15);border:1px solid rgba(212,168,0,0.2);align-self:flex-end;text-align:right; }
.sc-input-row { display:flex;gap:8px; }
.sc-input { flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:8px;padding:10px 14px;color:#fff;font-family:'Outfit',sans-serif;font-size:13px;outline:none; }
.sc-send { background:var(--vert);border:none;color:#fff;padding:10px 18px;border-radius:8px;font-family:'Outfit',sans-serif;font-weight:700;cursor:pointer;transition:background 0.2s; }
.sc-send:hover { background:var(--vert2); }
@media(max-width:768px) { .dash-kpis{grid-template-columns:repeat(2,1fr);} .billet-card{flex-direction:column;align-items:flex-start;} }


  /* ══ MODAL POLITIQUE DE CONFIDENTIALITÉ ══ */
  .pc-nav { display:flex; gap:0; border-bottom:1px solid rgba(255,255,255,0.08); margin-bottom:0; flex-wrap:wrap; }
  .pc-nav-btn {
    background:transparent; border:none; color:rgba(255,255,255,0.4);
    font-family:'Outfit',sans-serif; font-size:12px; font-weight:600;
    padding:10px 16px; cursor:pointer; border-bottom:2px solid transparent;
    transition:all 0.2s; white-space:nowrap;
  }
  .pc-nav-btn.active { color:var(--or); border-bottom-color:var(--or); }
  .pc-panel { display:none; padding:24px 28px; }
  .pc-panel.active { display:block; }
  .pc-art-title {
    font-family:'Playfair Display',serif; font-size:17px; font-weight:700;
    color:var(--white); margin-bottom:16px; padding-bottom:10px;
    border-bottom:1px solid rgba(212,168,0,0.2);
    display:flex; align-items:center; gap:10px;
  }
  .pc-art-title .pc-num {
    background:rgba(212,168,0,0.12); border:1px solid rgba(212,168,0,0.3);
    color:var(--or); font-size:11px; font-weight:700; font-family:'Outfit',sans-serif;
    padding:2px 8px; border-radius:100px; letter-spacing:1px;
  }
  .pc-text { font-size:13px; color:rgba(255,255,255,0.65); line-height:1.75; margin-bottom:14px; }
  .pc-text strong { color:var(--white); font-weight:700; }
  .pc-text em { color:var(--or); font-style:normal; }
  .pc-list { list-style:none; padding:0; margin:0 0 14px; }
  .pc-list li {
    font-size:13px; color:rgba(255,255,255,0.6); line-height:1.7;
    padding:5px 0 5px 20px; position:relative; border-bottom:1px solid rgba(255,255,255,0.04);
  }
  .pc-list li:last-child { border-bottom:none; }
  .pc-list li::before { content:'›'; position:absolute; left:4px; color:var(--or); font-weight:700; }
  .pc-list li strong { color:var(--white); }
  .pc-notice {
    background:rgba(212,168,0,0.07); border:1px solid rgba(212,168,0,0.2);
    border-radius:8px; padding:14px 16px; margin-bottom:16px;
    font-size:12px; color:rgba(255,255,255,0.6); line-height:1.65;
  }
  .pc-notice strong { color:var(--or); }
  .pc-notice-red {
    background:rgba(175,2,11,0.07); border:1px solid rgba(175,2,11,0.2);
    border-radius:8px; padding:14px 16px; margin-bottom:16px;
    font-size:12px; color:rgba(255,255,255,0.6); line-height:1.65;
  }
  .pc-notice-green {
    background:rgba(26,107,58,0.1); border:1px solid rgba(26,107,58,0.25);
    border-radius:8px; padding:14px 16px; margin-bottom:16px;
    font-size:12px; color:rgba(255,255,255,0.6); line-height:1.65;
  }
  .pc-table { width:100%; border-collapse:collapse; margin-bottom:16px; font-size:12px; }
  .pc-table th {
    background:rgba(212,168,0,0.1); color:var(--or); font-weight:700;
    padding:8px 12px; text-align:left; letter-spacing:0.5px;
    border:1px solid rgba(255,255,255,0.08);
  }
  .pc-table td {
    padding:8px 12px; color:rgba(255,255,255,0.6); line-height:1.5;
    border:1px solid rgba(255,255,255,0.06); vertical-align:top;
  }
  .pc-table tr:nth-child(even) td { background:rgba(255,255,255,0.02); }
  .pc-table td strong { color:rgba(255,255,255,0.85); }
  .pc-section-sub {
    font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase;
    color:var(--or); margin:18px 0 10px;
  }
  .pc-version-bar {
    background:rgba(26,107,58,0.08); border-bottom:1px solid rgba(26,107,58,0.2);
    padding:10px 28px; display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:8px;
  }
  .pc-version-bar span { font-size:11px; color:rgba(255,255,255,0.35); }
  .pc-version-bar strong { color:var(--or); font-size:11px; }
  .pc-droit-row {
    display:grid; grid-template-columns:1fr 1.8fr 1fr; gap:0;
    border-bottom:1px solid rgba(255,255,255,0.05); padding:10px 0;
  }
  .pc-droit-row:last-child { border-bottom:none; }
  .pc-droit-row .pdr-name { font-size:12px; font-weight:700; color:var(--white); }
  .pc-droit-row .pdr-desc { font-size:12px; color:rgba(255,255,255,0.55); padding:0 12px; }
  .pc-droit-row .pdr-how { font-size:11px; color:var(--or); }
  .pc-droit-header { display:grid; grid-template-columns:1fr 1.8fr 1fr; gap:0; margin-bottom:8px; }
  .pc-droit-header span { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.25); }
  .pc-contact-grid { display:grid; grid-template-columns:1fr 2fr; gap:0; margin-bottom:14px; }
  .pc-contact-grid .pcc-label { font-size:12px; font-weight:700; color:rgba(255,255,255,0.5); padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.05); }
  .pc-contact-grid .pcc-val { font-size:12px; color:var(--white); padding:8px 0 8px 16px; border-bottom:1px solid rgba(255,255,255,0.05); }
  .pc-contact-grid .pcc-val a { color:var(--or); text-decoration:none; }
  .pc-footer {
    padding:16px 28px 24px; border-top:1px solid rgba(255,255,255,0.07);
    display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
  }
  .pc-footer-note { font-size:11px; color:rgba(255,255,255,0.3); flex:1; }
  @media(max-width:600px){
    .pc-droit-row, .pc-droit-header { grid-template-columns:1fr; }
    .pc-droit-row .pdr-desc, .pc-droit-row .pdr-how { padding:0; margin-top:4px; }
    .pc-contact-grid { grid-template-columns:1fr; }
    .pc-contact-grid .pcc-val { padding-left:0; }
    .pc-nav-btn { font-size:11px; padding:8px 10px; }
    .pc-table th, .pc-table td { padding:6px 8px; font-size:11px; }
  }

  /* ══ MISES EN GARDE LÉGALES CTL ══ */
  .disclaimer-block {
    background: linear-gradient(135deg, rgba(10,18,9,0.95) 0%, rgba(13,26,16,0.95) 100%);
    border: 1px solid rgba(212,168,0,0.25);
    border-left: 3px solid var(--or);
    border-radius: 10px;
    padding: 18px 20px;
    margin: 18px 0 6px;
    position: relative;
    overflow: hidden;
  }
  .disclaimer-block::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, var(--or), transparent);
  }
  .disclaimer-header {
    display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
    cursor: pointer; user-select: none;
  }
  .disclaimer-header .dh-ico { font-size: 18px; flex-shrink: 0; }
  .disclaimer-header .dh-title {
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--or); flex: 1;
  }
  .disclaimer-header .dh-toggle {
    font-size: 11px; color: rgba(255,255,255,0.3); transition: transform 0.25s;
    flex-shrink: 0;
  }
  .disclaimer-header .dh-toggle.open { transform: rotate(180deg); }
  .disclaimer-body { font-size: 12px; color: rgba(255,255,255,0.58); line-height: 1.75; }
  .disclaimer-body p { margin-bottom: 10px; }
  .disclaimer-body p:last-child { margin-bottom: 0; }
  .disclaimer-body strong { color: rgba(255,255,255,0.85); }
  .disclaimer-body em { color: var(--or); font-style: normal; }
  .disclaimer-body .db-points { list-style: none; padding: 0; margin: 8px 0; }
  .disclaimer-body .db-points li {
    padding: 4px 0 4px 18px; position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .disclaimer-body .db-points li:last-child { border-bottom: none; }
  .disclaimer-body .db-points li::before { content: '›'; position: absolute; left: 4px; color: var(--or); font-weight: 700; }
  .disclaimer-check {
    display: flex; align-items: flex-start; gap: 10px;
    margin-top: 14px; padding-top: 12px;
    border-top: 1px solid rgba(212,168,0,0.15);
  }
  .disclaimer-check input[type=checkbox] { flex-shrink: 0; margin-top: 2px; accent-color: var(--or); cursor: pointer; }
  .disclaimer-check label {
    font-size: 11px; color: rgba(255,255,255,0.5); line-height: 1.6; cursor: pointer;
  }
  .disclaimer-check label strong { color: var(--or); }
  .disclaimer-collapsed { display: none; }
  .disclaimer-collapsed.open { display: block; }

  /* ── CLASSES UTILITAIRES (réduisent les styles inline) ── */
  .dp-label {
    font-size:11px; color:var(--or); font-weight:700; text-transform:uppercase;
    letter-spacing:1px; display:block; margin-bottom:6px;
  }
  .dp-input {
    width:100%; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.12);
    border-radius:6px; padding:10px 14px; color:#fff; font-family:'Outfit',sans-serif;
    font-size:14px; outline:none; transition:border-color 0.2s;
  }
  .dp-input:focus { border-color:var(--or); }
  .btn-ghost {
    background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12);
    color:rgba(255,255,255,0.6); padding:10px 22px; border-radius:6px;
    font-family:'Outfit',sans-serif; font-size:13px; cursor:pointer; transition:all 0.2s;
  }
  .btn-ghost:hover { background:rgba(255,255,255,0.12); color:var(--white); }
  .btn-vert {
    background:var(--vert); border:none; color:#fff; padding:10px 22px;
    border-radius:6px; font-family:'Outfit',sans-serif; font-size:13px;
    font-weight:700; cursor:pointer; transition:background 0.2s;
  }
  .btn-vert:hover { background:var(--vert2); }
</style>
</head>
<body>
<script>
// ══ SÉCURITÉ CTL — Domain Lock + Anti-copie + Protection ══
(function(){
  var _d=window.location.hostname;
  var _allowed=['cameroon-terre-line.web.app','cameroon-terre-line.firebaseapp.com','localhost','127.0.0.1',''];
  if(_allowed.indexOf(_d)===-1 && _d.indexOf('cameroon-terre-line')===-1 && _d.indexOf('cameroonterreline')===-1){
    document.documentElement.innerHTML='<div style="background:#0a0a0a;color:#af020b;display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;text-align:center;padding:40px;"><div><h1 style="font-size:48px;">⛔</h1><h2>Accès non autorisé</h2><p style="color:#888;margin-top:12px;">Cette plateforme est la propriété exclusive de EDIK SARL.<br>Toute utilisation non autorisée est interdite et passible de poursuites<br>conformément à la loi n°2010/012 du 21 décembre 2010.</p><p style="color:#555;margin-top:20px;">Domaine légitime : cameroon-terre-line.web.app</p></div></div>';
    throw new Error('CTL Domain Lock : domaine non autorisé — '+_d);
  }
  // ── Avertissement console (affiché une seule fois) ──
  console.log('%c⛔ CAMEROON TERRE LINE — EDIK SARL','font-size:24px;color:#af020b;font-weight:900;');
  console.log('%cCe code est la propriété exclusive de EDIK SARL.\nToute utilisation non autorisée est passible de poursuites\nconformément à la loi n°2010/012 du 21 décembre 2010.','font-size:12px;color:#888;');
})();
</script>
<a href="#main-content" class="skip-link" style="position:absolute;top:-100px;left:16px;background:var(--or);color:#0f1a13;padding:12px 24px;border-radius:0 0 8px 8px;font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;z-index:9999;transition:top 0.2s;text-decoration:none;" onfocus="this.style.top='0'" onblur="this.style.top='-100px'">Aller au contenu principal</a>
<noscript><div style="background:#af020b;color:#fff;padding:20px;text-align:center;font-family:sans-serif;font-size:14px;">JavaScript est nécessaire pour utiliser CAMEROON TERRE LINE. Veuillez activer JavaScript dans votre navigateur.</div></noscript>
<script>
if(typeof getSession==='undefined'){window.getSession=function(){try{return JSON.parse(localStorage.getItem('ctl_session')||'null');}catch(e){return null;}};}
if(typeof setSession==='undefined'){window.setSession=function(obj){try{localStorage.setItem('ctl_session',JSON.stringify(obj));}catch(e){}};}
// Utilitaire d'échappement HTML pour prévenir les injections XSS
window.escapeHtml=function(str){if(!str)return '';var div=document.createElement('div');div.appendChild(document.createTextNode(str));return div.innerHTML;};
// Menu hamburger mobile
function toggleMobileMenu(){
  var nav=document.getElementById('navLinks');
  var btn=document.getElementById('hamburgerBtn');
  if(!nav||!btn)return;
  var open=nav.classList.toggle('mobile-open');
  btn.classList.toggle('active',open);
  btn.setAttribute('aria-expanded',open?'true':'false');
  document.body.style.overflow=open?'hidden':'';
}
document.addEventListener('DOMContentLoaded',function(){
  var links=document.querySelectorAll('.nav-links a');
  links.forEach(function(a){a.addEventListener('click',function(){
    var nav=document.getElementById('navLinks');
    var btn=document.getElementById('hamburgerBtn');
    if(nav)nav.classList.remove('mobile-open');
    if(btn){btn.classList.remove('active');btn.setAttribute('aria-expanded','false');}
    document.body.style.overflow='';
  });});
});
</script>

<!-- NAV -->
<nav role="banner" aria-label="Barre de navigation principale">
  <div class="nav-logo" role="img" aria-label="Logo Cameroon Terre Line">
    <div class="logo-icon" aria-hidden="true"></div>
    <div class="nav-logo-text">
      <div class="brand">CAMEROON TERRE LINE</div>
      <div class="sub" data-fr="Transport Interurbain Numérique" data-en="Intercity Digital Transport">Transport Interurbain Numérique</div>
    </div>
  </div>
  <button class="hamburger" id="hamburgerBtn" aria-label="Menu de navigation" aria-expanded="false" onclick="toggleMobileMenu()">
    <span></span><span></span><span></span>
  </button>
  <div class="nav-links" id="navLinks" role="navigation" aria-label="Navigation principale">
    <a href="#corridors" data-fr="Réserver" data-en="Book">Réserver</a>
    <a href="#innovations" data-fr="Innovations" data-en="Innovations">Innovations</a>
    <a href="#tarifs" data-fr="Tarifs" data-en="Pricing">Tarifs</a>
    <a href="#famille" data-fr="Sécurité" data-en="Safety">Sécurité</a>
    <a href="#contact" data-fr="Contact" data-en="Contact">Contact</a>
    <a href="#international" data-fr="International" data-en="International">International</a>
    <a href="#marchandises" data-fr="Marchandises" data-en="Freight">Marchandises</a>
    <a href="#" onclick="event.preventDefault();ouvrirModalChauffeur()" class="nav-link-driver" data-fr="🚗 Proposer un trajet" data-en="🚗 Offer a ride">🚗 Proposer un trajet</a>
    <a href="#" onclick="event.preventDefault();var s=getSession();if(s&&(s.categorie==='chauffeur'||s.categorie==='Chauffeur')){ouvrirPanneauChauffeur(s.prenom+' '+s.nom);}else{alert('Connectez-vous en tant que chauffeur.');}" class="nav-link-driver" style="border-color:rgba(45,146,85,0.35);color:var(--vert2);display:none;" id="navPanneauCh" data-fr="📷 Mes passagers" data-en="📷 My passengers">📷 Mes passagers</a>
  </div>
  <div class="nav-right" style="display:flex;align-items:center;gap:10px;">

    <!-- Sélecteur de langue -->
    <div style="display:flex;align-items:center;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:100px;padding:3px 4px;font-family:'Outfit',sans-serif;">
      <button onclick="setLang('fr')" id="btn-lang-fr" style="padding:4px 11px;border-radius:100px;background:var(--or);color:#0f1a13;border:none;cursor:pointer;font-size:12px;font-weight:700;font-family:'Outfit',sans-serif;transition:all 0.2s;">FR</button>
      <button onclick="setLang('en')" id="btn-lang-en" style="padding:4px 11px;border-radius:100px;background:transparent;color:rgba(255,255,255,0.45);border:none;cursor:pointer;font-size:12px;font-weight:700;font-family:'Outfit',sans-serif;transition:all 0.2s;">EN</button>
    </div>

    <!-- Cloche notifications (visible si connecté) -->
    <div style="position:relative;display:none;" id="notifBtnWrap">
      <button onclick="toggleNotifs()" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.6);width:36px;height:36px;border-radius:50%;font-size:16px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;" onmouseover="this.style.background='rgba(255,255,255,0.12)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">🔔</button>
      <span class="notif-badge" id="notifBadge">0</span>
    </div>

    <!-- Bouton Mon Espace (visible si connecté) -->
    <button class="nav-mon-espace" id="btnMonEspace" onclick="ouvrirDashboard()">
      <span id="navAvatar" style="width:22px;height:22px;border-radius:50%;background:var(--vert);display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;">JP</span>
      <span id="navPrenom">Mon Espace</span>
    </button>

    <button class="nav-cta" id="btnCreerCompte" onclick="ouvrirModalCompte()" data-fr="Créer un compte" data-en="Sign up" aria-label="Créer un compte CTL">Créer un compte</button>
    <button class="nav-cta-outline" id="btnSeConnecter" onclick="ouvrirModalConnexion()" style="margin-left:6px;" data-fr="Se connecter" data-en="Log in" aria-label="Se connecter à votre espace">Se connecter</button>
  </div>
</nav>

<!-- HERO -->
<main id="main-content" role="main">
<section class="hero" aria-label="Accueil Cameroon Terre Line">

  <!-- ── CARROUSEL PHOTOS CAMEROUN ── -->
  <div class="hero-carousel" id="heroCarousel" role="region" aria-label="Carrousel de photos touristiques du Cameroun" aria-roledescription="carrousel">
    <div class="carousel-slide active" role="img" aria-label="Forêt tropicale du Cameroun" style="background-image:url('https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?w=1600&q=80')"></div>
    <div class="carousel-slide" role="img" aria-label="Côte Atlantique — Kribi" data-bg="https://images.unsplash.com/photo-1574482620819-27dd52e57b4c?w=1600&q=80"></div>
    <div class="carousel-slide" role="img" aria-label="Montagnes de l'Adamaoua" data-bg="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1600&q=80"></div>
    <div class="carousel-slide" role="img" aria-label="Savane du Grand Nord" data-bg="https://images.unsplash.com/photo-1547036967-23d11aacaee0?w=1600&q=80"></div>
    <div class="carousel-slide" role="img" aria-label="Lac Nyos — Nord-Ouest" data-bg="https://images.unsplash.com/photo-1589519160732-576f165b9aad?w=1600&q=80"></div>
  </div>
  <div class="carousel-overlay"></div>

  <!-- Indicateurs -->
  <div class="carousel-dots" id="carouselDots"></div>
  <div class="carousel-caption" id="carouselCaption"></div>

  <div class="road-lines"></div>

  <!-- Carte interactive stylisée — agrandie -->
  <div class="map-dots" id="mapDots"></div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="dot"></span>
      <span data-fr="Plateforme N°1 — Transport Interurbain Cameroun" data-en="Platform #1 — Intercity Transport Cameroon">Plateforme N°1 — Transport Interurbain Cameroun</span>
    </div>
    <h1 class="hero-title">
      <span data-fr="Fini les longues files d'attente en agence." data-en="No more long queues at the agency.">Fini les longues files d'attente en agence.</span><br>
      <span data-fr="Voyagez en toute" data-en="Travel with total">Voyagez en toute</span> <span class="rouge" data-fr="sécurité." data-en="safety.">sécurité.</span>
    </h1>
    <p class="hero-sub">
      <span data-fr="Réservez votre billet en 3 clics, payez par MoMo ou carte, suivez votre trajet en temps réel. Vos proches sont informés à chaque étape." data-en="Book your ticket in 3 clicks, pay by MoMo or card, track your journey live. Your family is notified at every step.">Réservez votre billet en 3 clics, payez par MoMo ou carte, suivez votre trajet en temps réel. Vos proches sont informés à chaque étape.</span>
    </p>
    <div class="hero-actions">
      <a href="#corridors" class="btn-primary" data-fr="Réserver maintenant" data-en="Book now">Réserver maintenant</a>
      <a href="#innovations" class="btn-secondary" data-fr="Découvrir CTL →" data-en="Discover CTL →">Découvrir CTL →</a>
    </div>
  </div>

  <div class="hero-stats">
    <div class="stat">
      <div class="val">16 F<small>/km</small></div>
      <div class="label" data-fr="Tarif réglementé officiel" data-en="Official regulated fare">Tarif réglementé officiel</div>
    </div>
    <div class="stat">
      <div class="val">360</div>
      <div class="label" data-fr="Arrondissements couverts" data-en="Districts covered">Arrondissements couverts</div>
    </div>
    <div class="stat">
      <div class="val" data-fr="3 clics" data-en="3 clicks">3 clics</div>
      <div class="label" data-fr="Pour réserver votre billet" data-en="To book your ticket">Pour réserver votre billet</div>
    </div>
    <div class="stat">
      <div class="val" data-fr="24h/24" data-en="24/7">24h/24</div>
      <div class="label" data-fr="Réservation en ligne" data-en="Online booking">Réservation en ligne</div>
    </div>
  </div>
</section>

<!-- CORRIDORS / RÉSERVATION -->
<section class="corridors" id="corridors" aria-label="Réservation de trajets">
  <div class="section-tag reveal" data-fr="Réservation" data-en="Booking">Réservation</div>
  <h2 class="section-title reveal" data-fr="Trouvez votre trajet" data-en="Find your journey">Trouvez votre trajet</h2>
  <p class="section-sub reveal" data-fr="Les 360 arrondissements du Cameroun connectés — de Kolofata à Ambam, de Mundemba à Moloundou. Saisissez n'importe quelle ville et trouvez votre trajet." data-en="All 360 districts of Cameroon connected — from Kolofata to Ambam, from Mundemba to Moloundou. Enter any city and find your journey.">Les 360 arrondissements du Cameroun connectés — de Kolofata à Ambam, de Mundemba à Moloundou. Saisissez n'importe quelle ville et trouvez votre trajet.</p>

  <div class="corridor-search reveal">
    <div class="field">
      <label data-fr="🛫 Ville de départ" data-en="🛫 Departure city">🛫 Ville de départ</label>
      <div class="city-input-wrap" id="departWrap">
        <input type="text" id="departInput" placeholder="Ex: Douala, Bafia, Ngaoundéré…" data-ph-fr="Ex: Douala, Bafia, Ngaoundéré…" data-ph-en="E.g.: Douala, Bafia, Ngaoundéré…" autocomplete="off">
        <span class="input-icon">📍</span>
        <div class="autocomplete-dropdown" id="departDropdown"></div>
      </div>
      <div class="quartier-wrap">
        <span class="quartier-label" data-fr="Quartier de départ (optionnel)" data-en="Departure district (optional)">Quartier de départ (optionnel)</span>
        <input type="text" id="quartierDepart" placeholder="Ex: Akwa, Bonanjo, Makepe, Bastos…" autocomplete="off">
      </div>
    </div>

    <div style="display:flex;align-items:flex-end;padding-bottom:0">
      <button class="swap-btn" id="swapBtn" title="Inverser départ/arrivée">⇄</button>
    </div>

    <div class="field">
      <label data-fr="🛬 Ville d'arrivée" data-en="🛬 Arrival city">🛬 Ville d'arrivée</label>
      <div class="city-input-wrap" id="arriveeWrap">
        <input type="text" id="arriveeInput" placeholder="Ex: Yaoundé, Kumba, Maroua…" data-ph-fr="Ex: Yaoundé, Kumba, Maroua…" data-ph-en="E.g.: Yaoundé, Kumba, Maroua…" autocomplete="off">
        <span class="input-icon">🏁</span>
        <div class="autocomplete-dropdown" id="arriveeDropdown"></div>
      </div>
      <div class="quartier-wrap">
        <span class="quartier-label" data-fr="Quartier d'arrivée (optionnel)" data-en="Arrival district (optional)">Quartier d'arrivée (optionnel)</span>
        <input type="text" id="quartierArrivee" placeholder="Ex: Melen, Nlongkak, Mvog-Beti, Omnisport…" autocomplete="off">
      </div>
    </div>

    <div class="field">
      <label data-fr="📅 Date de voyage" data-en="📅 Travel date">📅 Date de voyage</label>
      <input type="date" id="dateVoyage">
    </div>

    <button class="btn-search" id="searchBtn" onclick="rechercherTrajet()" data-fr="🔍 Rechercher" data-en="🔍 Search">Rechercher</button>
  </div>

  <!-- Résultats dynamiques -->
  <div class="search-results" id="searchResults" aria-live="polite"></div>

