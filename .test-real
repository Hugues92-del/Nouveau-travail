<!-- COMMENT ÇA MARCHE -->
<section class="howto" id="howto" aria-label="Comment ça marche">
  <div class="section-tag reveal" data-fr="Processus" data-en="Process">Processus</div>
  <h2 class="section-title reveal" data-fr="Réserver en 5 étapes simples" data-en="Book in 5 simple steps">Réserver en 5 étapes simples</h2>
  <p class="section-sub reveal" data-fr="Du choix du trajet à l'arrivée à destination, CTL accompagne chaque voyageur." data-en="From choosing your route to arriving at your destination, CTL is with you every step.">Du choix du trajet à l'arrivée à destination, CTL accompagne chaque voyageur.</p>

  <div class="steps">
    <div class="step reveal">
      <div class="step-num green"><span class="step-icon">🔍</span></div>
      <h4 data-fr="Rechercher" data-en="Search">Rechercher</h4>
      <p data-fr="Choisissez votre départ, destination et date. Résultats en temps réel." data-en="Choose your departure, destination and date. Results in real time.">Choisissez votre départ, destination et date. Résultats en temps réel.</p>
    </div>
    <div class="step reveal">
      <div class="step-num gold"><span class="step-icon">💳</span></div>
      <h4 data-fr="Payer" data-en="Pay">Payer</h4>
      <p data-fr="MoMo, Orange Money ou carte bancaire. Paiement sécurisé en 3 clics." data-en="MoMo, Orange Money or bank card. Secure payment in 3 clicks.">MoMo, Orange Money ou carte bancaire. Paiement sécurisé en 3 clics.</p>
    </div>
    <div class="step reveal">
      <div class="step-num green"><span class="step-icon">🎫</span></div>
      <h4 data-fr="Recevoir le billet" data-en="Get your ticket">Recevoir le billet</h4>
      <p data-fr="QR code sur votre téléphone. Valide même sans connexion internet." data-en="QR code on your phone. Valid even without internet connection.">QR code sur votre téléphone. Valide même sans connexion internet.</p>
    </div>
    <div class="step reveal">
      <div class="step-num gold"><span class="step-icon">📍</span></div>
      <h4 data-fr="Suivre le trajet" data-en="Track the journey">Suivre le trajet</h4>
      <p data-fr="GPS en direct. Vos proches reçoivent les notifications automatiquement." data-en="Live GPS. Your family receives automatic notifications.">GPS en direct. Vos proches reçoivent les notifications automatiquement.</p>
    </div>
    <div class="step reveal">
      <div class="step-num red"><span class="step-icon">✅</span></div>
      <h4 data-fr="Arriver serein" data-en="Arrive safely">Arriver serein</h4>
      <p data-fr="Confirmation d'arrivée envoyée à votre famille. Notez le trajet." data-en="Arrival confirmation sent to your family. Rate the journey.">Confirmation d'arrivée envoyée à votre famille. Notez le trajet.</p>
    </div>
  </div>
</section>

