    '</div>',
    '</div>',

    // PIED
    '<div style="background:linear-gradient(135deg,#1a6b3a,#0d3d1e);padding:10px 20px;display:flex;align-items:center;justify-content:space-between;">',
    '<div style="font-size:8px;color:rgba(255,255,255,0.4);letter-spacing:1px;">© CAMEROON TERRE LINE · EDIK SARL</div>',
    '<div style="display:flex;gap:5px;"><div style="width:7px;height:7px;border-radius:50%;background:#1a6b3a;border:2px solid #d4a800;"></div><div style="width:7px;height:7px;border-radius:50%;background:#d4a800;"></div><div style="width:7px;height:7px;border-radius:50%;background:#af020b;border:2px solid #d4a800;"></div></div>',
    '<div style="font-size:8px;color:rgba(255,255,255,0.4);">Valable uniquement pour le trajet indiqué</div>',
    '</div>',
    '</div>',

    // BOUTONS
    '<div style="padding:14px 18px;display:flex;gap:10px;justify-content:center;">',
    '<button onclick="imprimerBillet()" style="background:#1a6b3a;border:none;color:#fff;padding:11px 24px;border-radius:8px;font-family:Outfit,sans-serif;font-size:13px;font-weight:700;cursor:pointer;">🖨 Imprimer le billet</button>',
    '<button onclick="document.getElementById(\'modalQR\').classList.remove(\'open\');document.body.style.overflow=\'\'" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.6);padding:11px 24px;border-radius:8px;font-family:Outfit,sans-serif;font-size:13px;cursor:pointer;">Fermer</button>',
    '</div>'
  ].join('');

  document.getElementById('modalQR').classList.add('open');
