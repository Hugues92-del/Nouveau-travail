<!-- ══ VOYAGES INTERNATIONAUX ══ -->
<section class="corridors" id="international" aria-label="Voyages internationaux" style="background:var(--t-bg2);border-top:1px solid rgba(212,168,0,0.15);">
  <div class="section-tag reveal" data-fr="🌍 International" data-en="🌍 International">🌍 International</div>
  <h2 class="section-title reveal" data-fr="Voyages internationaux" data-en="International travel">Voyages internationaux</h2>
  <p class="section-sub reveal" data-fr="Voyagez depuis les 360 arrondissements du Cameroun vers les pays CEMAC et le Nigeria. Liaisons régulières assurées par les agences partenaires CTL." data-en="Travel from Cameroon's 360 districts to CEMAC countries and Nigeria. Regular services by CTL partner agencies.">Voyagez depuis les 360 arrondissements du Cameroun vers les pays CEMAC et le Nigeria. Liaisons régulières assurées par les agences partenaires CTL.</p>

  <!-- Recherche international -->
  <div class="corridor-search reveal" style="border-color:rgba(212,168,0,0.25);">
    <div class="field">
      <label data-fr="🛫 Ville de départ (Cameroun)" data-en="🛫 Departure city (Cameroon)">🛫 Ville de départ (Cameroun)</label>
      <div class="city-input-wrap" id="intlDepartWrap">
        <input type="text" id="intlDepartInput" placeholder="Ex: Douala, Yaoundé, Maroua…" autocomplete="off">
        <span class="input-icon">📍</span>
        <div class="autocomplete-dropdown" id="intlDepartDropdown"></div>
      </div>
    </div>

    <div style="display:flex;align-items:center;justify-content:center;padding:0 8px;font-size:20px;color:var(--or);">✈</div>

    <div class="field">
      <label data-fr="🌍 Destination internationale" data-en="🌍 International destination">🌍 Destination internationale</label>
      <select id="intlPaysSelect" onchange="updateIntlVilles()" style="width:100%;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:14px 16px;color:var(--white);font-family:'Outfit',sans-serif;font-size:15px;">
        <option value="">-- Choisir un pays --</option>
        <option value="Nigeria">🇳🇬 Nigeria</option>
        <option value="Tchad">🇹🇩 Tchad</option>
        <option value="Centrafrique">🇨🇫 Centrafrique (RCA)</option>
        <option value="Gabon">🇬🇦 Gabon</option>
        <option value="Guinée Équatoriale">🇬🇶 Guinée Équatoriale</option>
        <option value="Congo">🇨🇬 Congo-Brazzaville</option>
      </select>
    </div>

    <div class="field">
      <label data-fr="🏙 Ville d'arrivée" data-en="🏙 Arrival city">🏙 Ville d'arrivée</label>
      <select id="intlVilleSelect" style="width:100%;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:14px 16px;color:var(--white);font-family:'Outfit',sans-serif;font-size:15px;">
        <option value="">-- Choisir le pays d'abord --</option>
      </select>
    </div>

    <button class="btn-search" onclick="rechercherIntl()" style="background:linear-gradient(135deg,var(--vert),var(--cuivre));" data-fr="🔍 Rechercher" data-en="🔍 Search">🔍 Rechercher</button>
  </div>

  <!-- Résultats internationaux -->
  <div class="search-results" id="intlResults" aria-live="polite"></div>

  <!-- Corridors internationaux populaires -->
  <div style="margin-top:48px;">
    <h3 style="font-size:18px;font-weight:700;margin-bottom:24px;" data-fr="🌍 Corridors internationaux populaires" data-en="🌍 Popular international corridors">🌍 Corridors internationaux populaires</h3>
    <div class="corridors-grid">
      <div class="corridor-card reveal" style="border-color:rgba(212,168,0,0.3);">
        <div class="badge">🇳🇬 Nigeria</div>
        <div class="route">Douala <span>→</span> Lagos</div>
        <div class="meta"><span>⏱ 18-24h</span><span>📍 ~1 100 km</span></div>
        <div class="price-block"><div style="display:flex;flex-direction:column;gap:5px;"><span class="price-label">FOURCHETTE TARIFAIRE</span><div style="display:flex;align-items:baseline;gap:10px;"><span class="price-val" style="font-size:16px;">18 000 <small>FCFA</small></span><span style="color:rgba(255,255,255,0.4);">→</span><span class="price-val vip">30 000 <small>FCFA</small></span></div></div></div>
      </div>
      <div class="corridor-card reveal" style="border-color:rgba(212,168,0,0.3);">
        <div class="badge">🇹🇩 Tchad</div>
        <div class="route">Maroua <span>→</span> N'Djamena</div>
        <div class="meta"><span>⏱ 4-6h</span><span>📍 ~300 km</span></div>
        <div class="price-block"><div style="display:flex;flex-direction:column;gap:5px;"><span class="price-label">FOURCHETTE TARIFAIRE</span><div style="display:flex;align-items:baseline;gap:10px;"><span class="price-val" style="font-size:16px;">5 500 <small>FCFA</small></span><span style="color:rgba(255,255,255,0.4);">→</span><span class="price-val vip">9 000 <small>FCFA</small></span></div></div></div>
      </div>
      <div class="corridor-card reveal" style="border-color:rgba(212,168,0,0.3);">
        <div class="badge">🇨🇫 RCA</div>
        <div class="route">Yaoundé <span>→</span> Bangui</div>
        <div class="meta"><span>⏱ 18-24h</span><span>📍 ~950 km</span></div>
        <div class="price-block"><div style="display:flex;flex-direction:column;gap:5px;"><span class="price-label">FOURCHETTE TARIFAIRE</span><div style="display:flex;align-items:baseline;gap:10px;"><span class="price-val" style="font-size:16px;">17 000 <small>FCFA</small></span><span style="color:rgba(255,255,255,0.4);">→</span><span class="price-val vip">28 500 <small>FCFA</small></span></div></div></div>
      </div>
      <div class="corridor-card reveal" style="border-color:rgba(212,168,0,0.3);">
        <div class="badge">🇬🇦 Gabon</div>
        <div class="route">Yaoundé <span>→</span> Libreville</div>
        <div class="meta"><span>⏱ 14-20h</span><span>📍 ~950 km</span></div>
        <div class="price-block"><div style="display:flex;flex-direction:column;gap:5px;"><span class="price-label">FOURCHETTE TARIFAIRE</span><div style="display:flex;align-items:baseline;gap:10px;"><span class="price-val" style="font-size:16px;">17 000 <small>FCFA</small></span><span style="color:rgba(255,255,255,0.4);">→</span><span class="price-val vip">28 500 <small>FCFA</small></span></div></div></div>
      </div>
      <div class="corridor-card reveal" style="border-color:rgba(212,168,0,0.3);">
        <div class="badge">🇬🇶 G. Équatoriale</div>
        <div class="route">Yaoundé <span>→</span> Bata</div>
        <div class="meta"><span>⏱ 10-14h</span><span>📍 ~550 km</span></div>
        <div class="price-block"><div style="display:flex;flex-direction:column;gap:5px;"><span class="price-label">FOURCHETTE TARIFAIRE</span><div style="display:flex;align-items:baseline;gap:10px;"><span class="price-val" style="font-size:16px;">10 000 <small>FCFA</small></span><span style="color:rgba(255,255,255,0.4);">→</span><span class="price-val vip">16 500 <small>FCFA</small></span></div></div></div>
      </div>
      <div class="corridor-card reveal" style="border-color:rgba(212,168,0,0.3);">
        <div class="badge">🇨🇬 Congo</div>
        <div class="route">Yaoundé <span>→</span> Ouesso</div>
        <div class="meta"><span>⏱ 18-24h</span><span>📍 ~800 km</span></div>
        <div class="price-block"><div style="display:flex;flex-direction:column;gap:5px;"><span class="price-label">FOURCHETTE TARIFAIRE</span><div style="display:flex;align-items:baseline;gap:10px;"><span class="price-val" style="font-size:16px;">14 500 <small>FCFA</small></span><span style="color:rgba(255,255,255,0.4);">→</span><span class="price-val vip">24 000 <small>FCFA</small></span></div></div></div>
      </div>
    </div>
  </div>

  <!-- Info zone CEMAC -->
  <div style="margin-top:36px;background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.25);border-radius:12px;padding:24px 28px;display:flex;gap:16px;align-items:flex-start;" class="reveal">
    <div style="font-size:28px;flex-shrink:0;">🌍</div>
    <div>
      <div style="font-size:14px;font-weight:700;margin-bottom:6px;" data-fr="Zone CEMAC — Monnaie unique FCFA" data-en="CEMAC Zone — Unified CFA currency">Zone CEMAC — Monnaie unique FCFA</div>
      <p style="font-size:13px;color:rgba(255,255,255,0.55);line-height:1.7;" data-fr="Les voyages entre le Cameroun et le Tchad, la Centrafrique, le Gabon, la Guinée Équatoriale et le Congo utilisent la même devise (Franc CFA — XAF). Aucun change nécessaire. Pour le Nigeria, le paiement se fait en FCFA et la conversion en Naira est proposée à l'arrivée." data-en="Travel between Cameroon and Chad, CAR, Gabon, Equatorial Guinea and Congo uses the same currency (CFA Franc). No exchange needed. For Nigeria, payment is in FCFA with Naira conversion offered on arrival.">Les voyages entre le Cameroun et le Tchad, la Centrafrique, le Gabon, la Guinée Équatoriale et le Congo utilisent la même devise (Franc CFA — XAF). Aucun change nécessaire. Pour le Nigeria, le paiement se fait en FCFA et la conversion en Naira est proposée à l'arrivée.</p>
    </div>
  </div>
</section>

<!-- ══ TRANSPORT DE MARCHANDISES ══ -->
<section class="corridors" id="marchandises" aria-label="Transport de marchandises" style="background:var(--t-bg3);border-top:1px solid rgba(171,73,1,0.25);">
  <div class="section-tag reveal" data-fr="📦 Fret & Logistique" data-en="📦 Freight & Logistics">📦 Fret & Logistique</div>
  <h2 class="section-title reveal" data-fr="Transport de marchandises" data-en="Freight transport">Transport de marchandises</h2>
  <p class="section-sub reveal" data-fr="Envoyez vos colis et marchandises partout au Cameroun et vers les pays voisins. Suivi GPS en temps réel, assurance incluse, notifications SMS à chaque étape." data-en="Ship your parcels and goods anywhere in Cameroon and to neighboring countries. Real-time GPS tracking, insurance included, SMS notifications at every step.">Envoyez vos colis et marchandises partout au Cameroun et vers les pays voisins. Suivi GPS en temps réel, assurance incluse, notifications SMS à chaque étape.</p>

  <!-- Sélecteur National / International -->
  <div style="display:flex;gap:12px;margin:36px 0 24px;" class="reveal">
    <button id="fretNational" onclick="switchFretMode('national')" style="flex:1;padding:18px;border-radius:10px;border:2px solid var(--vert2);background:rgba(26,107,58,0.15);color:var(--white);font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:10px;">
      🇨🇲 National <span style="font-size:12px;color:rgba(255,255,255,0.5);font-weight:400;">— 360 arrondissements</span>
    </button>
    <button id="fretIntl" onclick="switchFretMode('international')" style="flex:1;padding:18px;border-radius:10px;border:2px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.03);color:rgba(255,255,255,0.6);font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:10px;">
      🌍 International <span style="font-size:12px;color:rgba(255,255,255,0.4);font-weight:400;">— CEMAC & Nigeria</span>
    </button>
  </div>

  <!-- Formulaire envoi -->
  <div class="corridor-search reveal" style="grid-template-columns:1fr auto 1fr 1fr 1fr auto;border-color:rgba(171,73,1,0.3);">
    <div class="field">
      <label data-fr="📍 Expédition depuis" data-en="📍 Ship from">📍 Expédition depuis</label>
      <div class="city-input-wrap" id="fretExpWrap">
        <input type="text" id="fretExpInput" placeholder="Ville de départ" autocomplete="off">
        <span class="input-icon">📦</span>
        <div class="autocomplete-dropdown" id="fretExpDropdown"></div>
      </div>
    </div>

    <div style="display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--cuivre);">→</div>

    <div class="field" id="fretDestField">
      <label data-fr="📍 Destination" data-en="📍 Destination">📍 Destination</label>
      <div class="city-input-wrap" id="fretDestWrap">
        <input type="text" id="fretDestInput" placeholder="Ville d'arrivée" autocomplete="off">
        <span class="input-icon">🏁</span>
        <div class="autocomplete-dropdown" id="fretDestDropdown"></div>
      </div>
    </div>

    <div class="field">
      <label data-fr="📦 Type de marchandise" data-en="📦 Goods type">📦 Type de marchandise</label>
      <select id="fretType" style="width:100%;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:14px 16px;color:var(--white);font-family:'Outfit',sans-serif;font-size:14px;">
        <option value="colis">📦 Colis standard (≤30 kg)</option>
        <option value="volumineux">📐 Colis volumineux</option>
        <option value="palette">🏗 Palette / Lot</option>
        <option value="fragile">🔮 Fragile</option>
        <option value="alimentaire">🥬 Denrées alimentaires</option>
        <option value="vehicule">🚗 Véhicule</option>
      </select>
    </div>

    <div class="field">
      <label data-fr="⚖ Poids estimé (kg)" data-en="⚖ Estimated weight (kg)">⚖ Poids (kg)</label>
      <input type="number" id="fretPoids" placeholder="Ex: 25" min="1" max="50000" style="width:100%;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:14px 16px;color:var(--white);font-family:'Outfit',sans-serif;font-size:15px;">
    </div>

    <button class="btn-search" onclick="rechercherFret()" style="background:linear-gradient(135deg,var(--cuivre),#8a3a00);" data-fr="📦 Estimer" data-en="📦 Estimate">📦 Estimer</button>
  </div>

  <!-- Résultats fret -->
  <div class="search-results" id="fretResults" aria-live="polite"></div>

  <!-- Avantages fret -->
  <div class="innovations-grid" style="margin-top:48px;">
    <div class="innov-card reveal">
      <div class="icon copper">📍</div>
      <h3 data-fr="Suivi GPS de bout en bout" data-en="End-to-end GPS tracking">Suivi GPS de bout en bout</h3>
      <p data-fr="Votre colis est géolocalisé en temps réel. Vous et le destinataire recevez des notifications SMS à chaque étape." data-en="Your parcel is geolocated in real time. You and the recipient receive SMS notifications at every step.">Votre colis est géolocalisé en temps réel. Vous et le destinataire recevez des notifications SMS à chaque étape.</p>
    </div>
    <div class="innov-card reveal">
      <div class="icon gold">🛡</div>
      <h3 data-fr="Assurance marchandise" data-en="Goods insurance">Assurance marchandise</h3>
      <p data-fr="Chaque envoi est couvert par une assurance transport. Déclaration de valeur et indemnisation en cas de dommage." data-en="Every shipment is covered by transport insurance. Value declaration and compensation in case of damage.">Chaque envoi est couvert par une assurance transport. Déclaration de valeur et indemnisation en cas de dommage.</p>
    </div>
    <div class="innov-card reveal">
      <div class="icon green">🤖</div>
      <h3 data-fr="Assistant IA CTL" data-en="CTL AI Assistant">Assistant IA CTL</h3>
      <p data-fr="Notre IA vous aide à choisir le meilleur itinéraire, estimer les coûts et optimiser vos envois de marchandises." data-en="Our AI helps you choose the best route, estimate costs and optimise your freight shipments.">Notre IA vous aide à choisir le meilleur itinéraire, estimer les coûts et optimiser vos envois de marchandises.</p>
    </div>
  </div>
</section>

<!-- ══ ASSISTANT IA CTL ══ -->
<div class="modal-overlay" id="modalIA" role="dialog" aria-modal="true" aria-label="Assistant IA CTL">
  <div class="modal-box" style="max-width:540px;max-height:85vh;display:flex;flex-direction:column;">
    <div class="modal-header">
      <div>
        <div class="mh-title">🤖 Assistant IA CTL</div>
        <div class="mh-sub">Voyages, marchandises, itinéraires — Je vous aide</div>
      </div>
      <button class="modal-close" onclick="document.getElementById('modalIA').classList.remove('open');document.body.style.overflow=''">✕</button>
    </div>
    <div id="iaChatBody" aria-live="polite" style="flex:1;overflow-y:auto;padding:16px 24px;display:flex;flex-direction:column;gap:10px;">
      <div class="sc-msg bot">👋 Bonjour ! Je suis l'assistant IA de Cameroon Terre Line. Je peux vous aider à :<br><br>🚌 <strong>Trouver un trajet</strong> national ou international<br>📦 <strong>Estimer un envoi</strong> de marchandises<br>🌍 <strong>Planifier un voyage</strong> vers les pays CEMAC ou le Nigeria<br>💰 <strong>Comparer les tarifs</strong><br><br>Posez-moi votre question !</div>
    </div>
    <div style="padding:12px 24px 20px;border-top:1px solid rgba(255,255,255,0.07);">
      <div class="sc-input-row">
        <input type="text" id="iaInput" class="sc-input" placeholder="Ex: Combien coûte un colis Douala → Libreville ?" onkeydown="if(event.key==='Enter') envoyerIA()">
        <button class="sc-send" onclick="envoyerIA()" style="background:linear-gradient(135deg,var(--vert),var(--cuivre));">Envoyer</button>
      </div>
    </div>
  </div>
</div>

<!-- Bouton flottant IA -->
<div id="iaBtnFloat" role="button" aria-label="Ouvrir l'assistant IA CTL" tabindex="0" onclick="document.getElementById('modalIA').classList.add('open');document.body.style.overflow='hidden'" onkeydown="if(event.key==='Enter')this.click()" style="position:fixed;bottom:24px;right:24px;z-index:998;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,var(--vert),var(--cuivre));border:2px solid rgba(212,168,0,0.5);display:flex;align-items:center;justify-content:center;font-size:26px;cursor:pointer;box-shadow:0 8px 32px rgba(0,0,0,0.4);transition:transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">🤖</div>

<!-- ══ MODAL FIREBASE — Accessible directement depuis n'importe où ══ -->
<div class="modal-overlay" id="modalFirebase" role="dialog" aria-modal="true" aria-label="Configuration Firebase">
  <div class="modal-box" style="max-width:640px;">
    <div class="modal-header">
      <div>
        <div class="mh-title">🔥 Base de Données — Firebase Firestore</div>
        <div class="mh-sub">Connectez votre projet Firebase pour stocker les données en permanence</div>
      </div>
      <button class="modal-close" onclick="document.getElementById('modalFirebase').classList.remove('open');document.body.style.overflow=''">✕</button>
    </div>
    <div class="modal-body">
      <!-- Status -->
      <div id="fbModalStatusBar" style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:14px 16px;margin-bottom:18px;">
        <span id="fbModalDot" style="width:12px;height:12px;border-radius:50%;background:#ff4444;flex-shrink:0;"></span>
        <span id="fbModalStatus" style="font-size:13px;color:rgba(255,255,255,0.6);">Firebase non connecté</span>
      </div>

      <!-- Formulaire -->
      <div class="modal-section-title">🔑 Clés de configuration</div>
      <div class="form-row">
        <div class="form-field"><label>API Key <span class="req">*</span></label><input type="text" id="fbm-apiKey" placeholder="AIzaSy..."></div>
        <div class="form-field"><label>Project ID <span class="req">*</span></label><input type="text" id="fbm-projectId" placeholder="cameroon-terre-line"></div>
      </div>
      <div class="form-row">
        <div class="form-field"><label>Auth Domain <span class="req">*</span></label><input type="text" id="fbm-authDomain" placeholder="cameroon-terre-line.firebaseapp.com"></div>
        <div class="form-field"><label>Storage Bucket</label><input type="text" id="fbm-storageBucket" placeholder="cameroon-terre-line.firebasestorage.app"></div>
      </div>

      <!-- Actions -->
      <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;">
        <button onclick="connecterFirebaseModal()" style="background:linear-gradient(135deg,#ff8800,#ff5500);border:none;color:#fff;padding:12px 28px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;cursor:pointer;">🔥 Connecter Firebase</button>
        <button onclick="syncFirebaseManuel();updateFbModalStatus()" style="background:rgba(26,107,58,0.15);border:1px solid rgba(26,107,58,0.3);color:var(--vert2);padding:12px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:600;cursor:pointer;">↑↓ Synchroniser</button>
        <button onclick="deconnecterFirebase();updateFbModalStatus()" style="background:rgba(175,2,11,0.08);border:1px solid rgba(175,2,11,0.25);color:rgba(206,17,38,0.8);padding:12px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">Déconnecter</button>
      </div>

      <!-- Guide -->
      <div class="modal-section-title" style="margin-top:24px;">📖 Guide rapide</div>
      <div style="font-size:12px;color:rgba(255,255,255,0.55);line-height:1.8;background:rgba(0,0,0,0.2);border-radius:8px;padding:14px 16px;">
        <strong>1.</strong> Allez sur <strong style="color:var(--or);">console.firebase.google.com</strong><br>
        <strong>2.</strong> Créez un projet (ex: <em>cameroon-terre-line</em>)<br>
        <strong>3.</strong> Activez <strong>Firestore Database</strong> (mode production, emplacement <code>eur3</code>)<br>
        <strong>4.</strong> Activez <strong>Authentication → Anonyme</strong><br>
        <strong>5.</strong> Paramètres du projet → Vos applications → icône <strong>&lt;/&gt;</strong> Web<br>
        <strong>6.</strong> Copiez les 4 clés ci-dessus et cliquez <strong>Connecter</strong><br>
        <strong>7.</strong> Dans Firestore → Règles, collez :<br>
        <code style="display:block;margin:6px 0;padding:8px 12px;background:rgba(0,0,0,0.3);border-radius:4px;font-size:11px;color:var(--or);line-height:1.6;">
          rules_version = '2';<br>
          service cloud.firestore {<br>
          &nbsp;&nbsp;match /databases/{database}/documents {<br>
          &nbsp;&nbsp;&nbsp;&nbsp;match /users/{userId}/{document=**} {<br>
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;allow read, write: if request.auth != null &amp;&amp; request.auth.uid == userId;<br>
          &nbsp;&nbsp;&nbsp;&nbsp;}<br>
          &nbsp;&nbsp;}<br>
          }
        </code>
      </div>
    </div>
  </div>
</div>

<!-- INNOVATIONS -->
<section class="innovations" id="innovations" aria-label="Innovations CTL">
  <div class="section-tag reveal" data-fr="Technologie" data-en="Technology">Technologie</div>
  <h2 class="section-title reveal" data-fr="8 innovations exclusives CTL" data-en="8 exclusive CTL innovations">8 innovations exclusives CTL</h2>
  <p class="section-sub reveal" data-fr="Conçues pour la réalité camerounaise — zones de faible connectivité, paiement mobile, sécurité familiale." data-en="Designed for Cameroonian reality — low connectivity zones, mobile payment, family safety.">Conçues pour la réalité camerounaise — zones de faible connectivité, paiement mobile, sécurité familiale.</p>

  <div class="innovations-grid">
    <div class="innov-card reveal">
      <div class="num">01</div>
      <div class="icon green">📍</div>
      <h3 data-fr="Suivi du trajet par GPS" data-en="Real-time GPS tracking">Suivi du trajet par GPS</h3>
      <p data-fr="Votre trajet est suivi en temps réel du départ jusqu'à l'arrivée. Visible par vous et vos proches à tout moment." data-en="Your journey is tracked in real time from departure to arrival. Visible to you and your family at all times.">Votre trajet est suivi en temps réel du départ jusqu'à l'arrivée. Visible par vous et vos proches à tout moment.</p>
    </div>
    <div class="innov-card reveal">
