<div class="modal-overlay" id="modalConnexion">
  <div class="modal-box" id="modalConnexionBox" style="max-width:460px;"></div>
</div>

<!-- ══ MODAL MOT DE PASSE OUBLIÉ ══ -->
<div class="modal-overlay" id="modalMdp">
  <div class="modal-box" id="modalMdpBox" style="max-width:460px;"></div>
</div>

<style>
/* ── STYLES SUPPLÉMENTAIRES ── */
.category-selector { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:20px; }
.cat-btn { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:16px 10px; text-align:center; cursor:pointer; transition:all 0.2s; }
.cat-btn.selected { border-color:var(--or); background:rgba(212,168,0,0.1); }
.cat-btn .cat-icon { font-size:26px; display:block; margin-bottom:6px; }
.cat-btn .cat-label { font-size:13px; font-weight:700; color:var(--white); }
.cat-btn .cat-desc { font-size:10px; color:rgba(255,255,255,0.4); margin-top:3px; line-height:1.4; }
.upload-zone { border:1px dashed rgba(255,255,255,0.2); border-radius:8px; padding:12px 16px; display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; cursor:pointer; transition:all 0.2s; gap:12px; }
.upload-zone:hover { border-color:var(--or); background:rgba(212,168,0,0.05); }
.upload-zone .uz-label { font-size:13px; color:rgba(255,255,255,0.65); flex:1; }
.upload-zone .uz-btn { background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.15); color:rgba(255,255,255,0.6); font-size:11px; padding:5px 12px; border-radius:5px; cursor:pointer; font-family:'Outfit',sans-serif; white-space:nowrap; flex-shrink:0; }
.upload-zone input[type=file] { display:none; }
.upload-zone.uploaded { border-color:rgba(45,146,85,0.5); background:rgba(45,146,85,0.06); }
.upload-zone.uploaded .uz-label { color:var(--vert2); }
.modal-form-tabs { display:flex; gap:0; margin-bottom:20px; border-bottom:1px solid rgba(255,255,255,0.1); }
.modal-tab-btn { background:transparent; border:none; color:rgba(255,255,255,0.45); font-family:'Outfit',sans-serif; font-size:13px; font-weight:600; padding:10px 18px; cursor:pointer; border-bottom:2px solid transparent; transition:all 0.2s; }
.modal-tab-btn.active { color:var(--or); border-bottom-color:var(--or); }
.modal-tab-content { display:none; }
.modal-tab-content.active { display:block; }
</style>

<script>
// ══ MODAL CRÉATION DE COMPTE ══
function ouvrirModalCompte() {
  document.getElementById('modalCompteBox').innerHTML = `
    <div class="modal-header">
      <div>
        <div class="mh-title">Créer un compte CTL</div>
        <div class="mh-sub">Rejoignez la plateforme de transport N°1 au Cameroun</div>
      </div>
      <button class="modal-close" onclick="document.getElementById('modalCompte').classList.remove('open');document.body.style.overflow=''">✕</button>
    </div>
    <div class="modal-body">
      <div class="modal-section-title">👤 Votre catégorie</div>
      <div class="category-selector">
        <div class="cat-btn selected" id="cat-passager" onclick="selectCategory('passager')">
          <span class="cat-icon">🧳</span>
          <div class="cat-label">Passager</div>
          <div class="cat-desc">Réserver des billets, suivre mes trajets</div>
        </div>
        <div class="cat-btn" id="cat-chauffeur" onclick="selectCategory('chauffeur')">
          <span class="cat-icon">🚗</span>
          <div class="cat-label">Chauffeur</div>
          <div class="cat-desc">Proposer des trajets, gérer mes courses</div>
        </div>
        <div class="cat-btn" id="cat-agence" onclick="selectCategory('agence')">
          <span class="cat-icon">🏢</span>
          <div class="cat-label">Agence de voyage</div>
          <div class="cat-desc">Gérer une agence et ses bus</div>
        </div>
        <div class="cat-btn" id="cat-employe" onclick="selectCategory('employe')">
          <span class="cat-icon">👔</span>
          <div class="cat-label">Employé CTL</div>
          <div class="cat-desc">Service client et accompagnement</div>
        </div>
        <div class="cat-btn" id="cat-admin" onclick="selectCategory('admin')">
          <span class="cat-icon">🔐</span>
          <div class="cat-label">Administrateur</div>
          <div class="cat-desc">Gestion complète de la plateforme</div>
        </div>
      </div>
      <div class="modal-section-title">📋 Informations personnelles</div>
      <div class="form-row">
        <div class="form-field"><label>Prénom <span class="req">*</span></label><input type="text" id="cc-prenom" placeholder="Ex: Jean-Pierre"></div>
        <div class="form-field"><label>Nom <span class="req">*</span></label><input type="text" id="cc-nom" placeholder="Ex: Mbarga"></div>
      </div>
      <div class="form-row triple">
