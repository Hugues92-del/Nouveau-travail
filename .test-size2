          <button onclick="seDeconnecter()" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.5);padding:10px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">🚪 Se déconnecter</button>
