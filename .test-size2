          <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:12px;text-align:center;"><div style="font-size:18px;">🇹🇩</div><div style="font-size:11px;font-weight:700;margin-top:4px;">Tchad</div><div style="font-size:10px;color:var(--or);margin-top:2px;" id="admin-stat-td">0 billets</div><div style="font-size:9px;color:rgba(255,255,255,0.35);">3 villes</div></div>
          <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:12px;text-align:center;"><div style="font-size:18px;">🇨🇫</div><div style="font-size:11px;font-weight:700;margin-top:4px;">RCA</div><div style="font-size:10px;color:var(--or);margin-top:2px;" id="admin-stat-cf">0 billets</div><div style="font-size:9px;color:rgba(255,255,255,0.35);">3 villes</div></div>
          <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:12px;text-align:center;"><div style="font-size:18px;">🇬🇦</div><div style="font-size:11px;font-weight:700;margin-top:4px;">Gabon</div><div style="font-size:10px;color:var(--or);margin-top:2px;" id="admin-stat-ga">0 billets</div><div style="font-size:9px;color:rgba(255,255,255,0.35);">3 villes</div></div>
          <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:12px;text-align:center;"><div style="font-size:18px;">🇬🇶</div><div style="font-size:11px;font-weight:700;margin-top:4px;">G. Éq.</div><div style="font-size:10px;color:var(--or);margin-top:2px;" id="admin-stat-gq">0 billets</div><div style="font-size:9px;color:rgba(255,255,255,0.35);">3 villes</div></div>
          <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:12px;text-align:center;"><div style="font-size:18px;">🇨🇬</div><div style="font-size:11px;font-weight:700;margin-top:4px;">Congo</div><div style="font-size:10px;color:var(--or);margin-top:2px;" id="admin-stat-cg">0 billets</div><div style="font-size:9px;color:rgba(255,255,255,0.35);">2 villes</div></div>
        </div>
        <!-- Tableau corridors internationaux -->
        <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:10px;overflow:hidden;margin-bottom:12px;">
          <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.06);font-size:12px;font-weight:700;color:rgba(255,255,255,0.6);display:flex;justify-content:space-between;"><span>Corridors internationaux actifs</span><span style="color:var(--or);">18 destinations · 6 pays</span></div>
          <table style="width:100%;border-collapse:collapse;font-size:12px;">
            <thead><tr><th style="padding:10px 14px;text-align:left;color:rgba(255,255,255,0.3);font-size:10px;letter-spacing:1px;">CORRIDOR</th><th>PAYS</th><th>DISTANCE</th><th>TARIF CLASSIQUE</th><th>TARIF VIP</th><th>STATUT</th></tr></thead>
            <tbody id="adminIntlTable"></tbody>
          </table>
        </div>
        <!-- Actions -->
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button onclick="alert('Ajout de corridor : fonctionnalité backend requise.')" style="background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);padding:8px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;">+ Ajouter un corridor</button>
          <button onclick="alert('Gestion des agences partenaires internationales : backend requis.')" style="background:rgba(26,107,58,0.1);border:1px solid rgba(26,107,58,0.3);color:var(--vert2);padding:8px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;">🏢 Agences partenaires</button>
          <button onclick="alert('Gestion des postes frontières : backend requis.')" style="background:rgba(171,73,1,0.1);border:1px solid rgba(171,73,1,0.3);color:#e07830;padding:8px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;">🛂 Postes frontières</button>
        </div>
      </div>

      <!-- Section Fret -->
      <div class="profil-section" style="border-color:rgba(171,73,1,0.25);">
        <div class="ps-title">📦 Transport Marchandises — Statistiques & Gestion</div>
        <!-- Stats fret -->
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px;">
          <div class="dash-kpi"><div class="dk-val" style="color:#e07830;" id="admin-fret-national">0</div><div class="dk-label">Envois nationaux</div></div>
          <div class="dash-kpi"><div class="dk-val" style="color:var(--or);" id="admin-fret-intl">0</div><div class="dk-label">Envois internationaux</div></div>
          <div class="dash-kpi"><div class="dk-val" style="color:var(--vert2);" id="admin-fret-encours">0</div><div class="dk-label">En transit (GPS actif)</div></div>
          <div class="dash-kpi"><div class="dk-val" style="color:var(--white);" id="admin-fret-livres">0</div><div class="dk-label">Livrés ce mois</div></div>
        </div>
        <!-- Grille tarifaire -->
        <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:10px;overflow:hidden;margin-bottom:12px;">
          <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.06);font-size:12px;font-weight:700;color:rgba(255,255,255,0.6);display:flex;justify-content:space-between;"><span>Grille tarifaire fret</span><span style="color:var(--cuivre);">6 catégories</span></div>
          <table style="width:100%;border-collapse:collapse;font-size:12px;">
            <thead><tr><th style="padding:10px 14px;text-align:left;color:rgba(255,255,255,0.3);font-size:10px;letter-spacing:1px;">TYPE</th><th>PRIX/KM</th><th>NATIONAL</th><th>INTERNATIONAL</th><th>ASSURANCE</th></tr></thead>
            <tbody>
              <tr><td style="padding:10px 14px;">📦 Colis standard</td><td>8 F/km</td><td>1 500+ F</td><td>2 000+ F</td><td>8%</td></tr>
              <tr><td style="padding:10px 14px;">📐 Volumineux</td><td>14 F/km</td><td>3 000+ F</td><td>4 000+ F</td><td>8%</td></tr>
              <tr><td style="padding:10px 14px;">🏗 Palette / Lot</td><td>22 F/km</td><td>5 000+ F</td><td>7 000+ F</td><td>10%</td></tr>
              <tr><td style="padding:10px 14px;">🔮 Fragile</td><td>18 F/km</td><td>3 500+ F</td><td>5 000+ F</td><td>12%</td></tr>
              <tr><td style="padding:10px 14px;">🥬 Alimentaire</td><td>12 F/km</td><td>2 500+ F</td><td>3 500+ F</td><td>10%</td></tr>
              <tr><td style="padding:10px 14px;">🚗 Véhicule</td><td>35 F/km</td><td>15 000+ F</td><td>25 000+ F</td><td>15%</td></tr>
            </tbody>
          </table>
        </div>
        <!-- Envois récents -->
        <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:10px;overflow:hidden;margin-bottom:12px;">
          <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.06);font-size:12px;font-weight:700;color:rgba(255,255,255,0.6);">Derniers envois</div>
          <div id="adminFretRecents" style="padding:16px;text-align:center;color:rgba(255,255,255,0.3);font-size:13px;">Aucun envoi enregistré pour le moment.</div>
        </div>
        <!-- Actions -->
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button onclick="alert('Modifier la grille tarifaire : backend requis.')" style="background:rgba(171,73,1,0.1);border:1px solid rgba(171,73,1,0.3);color:#e07830;padding:8px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;">💰 Modifier les tarifs</button>
          <button onclick="alert('Export des données fret : backend requis.')" style="background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);padding:8px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;">📊 Exporter CSV</button>
          <button onclick="alert('Suivi GPS des colis en transit : backend requis.')" style="background:rgba(26,107,58,0.1);border:1px solid rgba(26,107,58,0.3);color:var(--vert2);padding:8px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;">📍 Suivi GPS colis</button>
        </div>
      </div>

      <!-- ══ BASE DE DONNÉES FIREBASE ══ -->
      <div class="profil-section" style="border-color:rgba(255,160,0,0.35);background:linear-gradient(135deg,rgba(255,160,0,0.04),rgba(255,80,0,0.03));">
        <div class="ps-title" style="color:#ffaa00;">🔥 Base de Données — Firebase Firestore</div>
        <p style="font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:14px;line-height:1.6;">
          Connectez votre projet Firebase pour stocker les billets, comptes, fret et notifications de maniere permanente sur le cloud Google. Le localStorage reste actif comme cache local.
        </p>
        <!-- Status -->
        <div id="firebaseStatusBar" style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:12px 16px;margin-bottom:14px;">
          <span id="fbStatusDot" style="width:10px;height:10px;border-radius:50%;background:#ff4444;flex-shrink:0;"></span>
          <span id="fbStatusText" style="font-size:13px;color:rgba(255,255,255,0.6);">Firebase non connecte — Mode localStorage uniquement</span>
        </div>
        <!-- Formulaire de config -->
        <div id="firebaseConfigForm" style="display:none;">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
            <div><label class="dp-label">API Key <span style="color:var(--rouge2)">*</span></label><input type="text" id="fb-apiKey" class="dp-input" placeholder="AIzaSy..."></div>
            <div><label class="dp-label">Project ID <span style="color:var(--rouge2)">*</span></label><input type="text" id="fb-projectId" class="dp-input" placeholder="mon-projet-ctl"></div>
            <div><label class="dp-label">Auth Domain <span style="color:var(--rouge2)">*</span></label><input type="text" id="fb-authDomain" class="dp-input" placeholder="mon-projet-ctl.firebaseapp.com"></div>
            <div><label class="dp-label">Storage Bucket</label><input type="text" id="fb-storageBucket" class="dp-input" placeholder="mon-projet-ctl.appspot.com"></div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button onclick="connecterFirebase()" class="btn-vert" style="background:linear-gradient(135deg,#ff8800,#ff5500);">🔥 Connecter Firebase</button>
            <button onclick="document.getElementById('firebaseConfigForm').style.display='none'" class="btn-ghost">Annuler</button>
          </div>
        </div>
        <!-- Boutons actions -->
        <div id="firebaseActions" style="display:flex;gap:8px;flex-wrap:wrap;">
          <button onclick="ouvrirModalFirebase()" style="background:rgba(255,160,0,0.12);border:1px solid rgba(255,160,0,0.35);color:#ffaa00;padding:9px 18px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:700;cursor:pointer;">🔥 Configurer Firebase</button>
          <button onclick="syncFirebaseManuel()" style="background:rgba(26,107,58,0.12);border:1px solid rgba(26,107,58,0.3);color:var(--vert2);padding:9px 18px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;">↑↓ Synchroniser</button>
          <button onclick="deconnecterFirebase()" style="background:rgba(175,2,11,0.08);border:1px solid rgba(175,2,11,0.25);color:rgba(206,17,38,0.8);padding:9px 18px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;">Deconnecter</button>
        </div>
        <!-- Guide rapide -->
        <details style="margin-top:14px;">
          <summary style="cursor:pointer;font-size:12px;color:var(--or);font-weight:700;letter-spacing:1px;text-transform:uppercase;">Comment obtenir les cles Firebase ?</summary>
          <div style="margin-top:10px;font-size:12px;color:rgba(255,255,255,0.55);line-height:1.8;background:rgba(0,0,0,0.2);border-radius:8px;padding:14px 16px;">
            <strong>1.</strong> Allez sur <strong style="color:var(--or);">console.firebase.google.com</strong><br>
            <strong>2.</strong> Cliquez <strong>"Ajouter un projet"</strong> → nommez-le (ex: <em>cameroon-terre-line</em>)<br>
            <strong>3.</strong> Une fois cree, allez dans <strong>Parametres du projet</strong> (roue dentee)<br>
            <strong>4.</strong> Descendez a <strong>"Vos applications"</strong> → cliquez l'icone <strong>&lt;/&gt;</strong> (Web)<br>
            <strong>5.</strong> Donnez un nom (ex: <em>CTL Web</em>) → cliquez <strong>"Enregistrer l'application"</strong><br>
            <strong>6.</strong> Copiez les valeurs <code>apiKey</code>, <code>authDomain</code>, <code>projectId</code><br>
            <strong>7.</strong> Allez dans <strong>Firestore Database</strong> → <strong>"Creer une base de donnees"</strong><br>
            <strong>8.</strong> Choisissez <strong>"Mode test"</strong> (pour commencer rapidement)<br>
            <strong>9.</strong> Allez dans <strong>Authentication</strong> → <strong>Methodes de connexion</strong> → activez <strong>"Anonyme"</strong><br>
            <strong>10.</strong> Collez les cles ci-dessus et cliquez <strong>"Connecter Firebase"</strong>
          </div>
        </details>
      </div>

      <!-- ══ ASSISTANT DE CONFIGURATION CTL ══ -->
      <div class="profil-section" style="border-color:rgba(212,168,0,0.35);background:linear-gradient(135deg,rgba(26,107,58,0.06),rgba(171,73,1,0.04));">
        <div class="ps-title" style="color:var(--or);">🤖 Assistant de Configuration — Demandez, il exécute</div>
        <p style="font-size:12px;color:rgba(255,255,255,0.45);margin-bottom:4px;line-height:1.6;">Tapez une instruction et l'assistant modifie la plateforme en temps réel. Exemples :</p>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;">
          <span onclick="document.getElementById('adminCmdInput').value=this.textContent.trim();execAdminCmd()" style="font-size:11px;padding:4px 10px;border-radius:100px;background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.25);color:var(--or);cursor:pointer;">changer thème rouge</span>
          <span onclick="document.getElementById('adminCmdInput').value=this.textContent.trim();execAdminCmd()" style="font-size:11px;padding:4px 10px;border-radius:100px;background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.25);color:var(--or);cursor:pointer;">changer thème blanc</span>
          <span onclick="document.getElementById('adminCmdInput').value=this.textContent.trim();execAdminCmd()" style="font-size:11px;padding:4px 10px;border-radius:100px;background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.25);color:var(--or);cursor:pointer;">changer thème vert</span>
          <span onclick="document.getElementById('adminCmdInput').value=this.textContent.trim();execAdminCmd()" style="font-size:11px;padding:4px 10px;border-radius:100px;background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.25);color:var(--or);cursor:pointer;">combien de billets</span>
          <span onclick="document.getElementById('adminCmdInput').value=this.textContent.trim();execAdminCmd()" style="font-size:11px;padding:4px 10px;border-radius:100px;background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.25);color:var(--or);cursor:pointer;">chiffre d'affaires</span>
          <span onclick="document.getElementById('adminCmdInput').value=this.textContent.trim();execAdminCmd()" style="font-size:11px;padding:4px 10px;border-radius:100px;background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.25);color:var(--or);cursor:pointer;">purger les billets</span>
          <span onclick="document.getElementById('adminCmdInput').value=this.textContent.trim();execAdminCmd()" style="font-size:11px;padding:4px 10px;border-radius:100px;background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.25);color:var(--or);cursor:pointer;">langue anglais</span>
          <span onclick="document.getElementById('adminCmdInput').value=this.textContent.trim();execAdminCmd()" style="font-size:11px;padding:4px 10px;border-radius:100px;background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.25);color:var(--or);cursor:pointer;">liste des commandes</span>
        </div>
        <div id="adminCmdLog" style="background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:16px;max-height:320px;overflow-y:auto;margin-bottom:12px;font-size:13px;display:flex;flex-direction:column;gap:10px;" aria-live="polite">
          <div style="color:rgba(255,255,255,0.5);">🤖 Assistant prêt. Tapez une commande ou cliquez sur un exemple ci-dessus.</div>
        </div>
        <div style="display:flex;gap:8px;">
          <input type="text" id="adminCmdInput" class="dp-input" placeholder="Ex : changer thème rouge, combien de billets, purger les notifications..." style="flex:1;" onkeydown="if(event.key==='Enter')execAdminCmd()">
          <button onclick="execAdminCmd()" class="btn-vert" style="white-space:nowrap;">Exécuter</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ══ MODAL E-BILLET CTL ══ -->
