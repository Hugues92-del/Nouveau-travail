    '<div style="width:26px;height:26px;background:#d4a800;clip-path:polygon(0 100%,15% 0,50% 30%,85% 0,100% 100%);"></div>',
    '<div style="width:100%;"><div style="font-size:7px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#aaa;margin-bottom:2px;">Passager</div><div style="font-size:10px;font-weight:700;color:#0d1a10;line-height:1.3;">'+nom+'</div></div>',
    '<div style="width:100%;"><div style="font-size:7px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#aaa;margin-bottom:2px;">Trajet</div><div style="font-size:13px;font-weight:700;color:#1a6b3a;">'+depU+'</div><div style="font-size:11px;font-weight:700;color:#af020b;">→ '+arrU+'</div></div>',
    '<div style="width:100%;"><div style="font-size:7px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#aaa;margin-bottom:2px;">Heure · Date</div><div style="font-size:13px;font-weight:700;color:#0d1a10;">'+(heure||'—')+'</div><div style="font-size:10px;color:#666;">'+date+'</div></div>',
    '<div style="background:#fff;padding:8px;border-radius:8px;border:1px solid #e8e8e8;">'+qr+'</div>',
