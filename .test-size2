// ── ANNULATION BILLET ──
let refAnnulEnCours = null;
function ouvrirAnnulation(ref) {
  refAnnulEnCours = ref;
  const box = document.getElementById('modalAnnulBox');
  if(!box) return;
  box.innerHTML = `
    <div class="modal-header">
      <div><div class="mh-title">Annuler le billet ${ref}</div><div class="mh-sub">Cette action est irréversible</div></div>
      <button class="modal-close" onclick="document.getElementById('modalAnnul').classList.remove('open');document.body.style.overflow=''">✕</button>
    </div>
    <div class="modal-body">
      <p style="font-size:14px;color:rgba(255,255,255,0.55);margin-bottom:16px;">Pourquoi annulez-vous ce billet ?</p>
      <div class="annul-reason" id="annulReasons">
        <div class="annul-option" onclick="selectRaison(this,'Changement de plans')">📅 Changement de plans</div>
        <div class="annul-option" onclick="selectRaison(this,'Urgence familiale')">👨‍👩‍👧 Urgence familiale</div>
        <div class="annul-option" onclick="selectRaison(this,'Problème de paiement')">💳 Problème de paiement</div>
        <div class="annul-option" onclick="selectRaison(this,'Trajet annulé par CTL')">🚌 Trajet annulé par CTL</div>
        <div class="annul-option" onclick="selectRaison(this,'Autre raison')">✏️ Autre raison</div>
      </div>
      <div style="background:rgba(212,168,0,0.08);border:1px solid rgba(212,168,0,0.2);border-radius:8px;padding:12px 16px;font-size:13px;color:rgba(255,255,255,0.6);margin-top:12px;">
        ℹ️ Remboursement sous 48h sur votre moyen de paiement initial.
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:10px;padding:16px 28px 24px;">
      <button onclick="document.getElementById('modalAnnul').classList.remove('open');document.body.style.overflow=''" style="background:transparent;border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.55);padding:10px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">Retour</button>
      <button id="btnConfirmAnnul" onclick="confirmerAnnulation()" style="background:var(--rouge);border:none;color:#fff;padding:10px 22px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;opacity:0.5;pointer-events:none;">Confirmer l'annulation</button>
    </div>`;
  document.getElementById('modalAnnul').classList.add('open');
  document.body.style.overflow='hidden';
}
let raisonSelectionnee = '';
function selectRaison(el, raison) {
  document.querySelectorAll('.annul-option').forEach(o=>o.classList.remove('selected'));
  el.classList.add('selected');
  raisonSelectionnee = raison;
  const btn = document.getElementById('btnConfirmAnnul');
  if(btn) { btn.style.opacity='1'; btn.style.pointerEvents='auto'; }
}
function confirmerAnnulation() {
  const billets = getBillets();
  const idx = billets.findIndex(b=>b.ref===refAnnulEnCours);
  if(idx>=0) { billets[idx].statut='annule'; billets[idx].raisonAnnul=raisonSelectionnee; saveBillets(billets); }
  document.getElementById('modalAnnul').classList.remove('open');
  document.body.style.overflow='';
  addNotif('❌','Votre billet '+refAnnulEnCours+' a été annulé. Remboursement sous 48h.');
  const sess = getSession();
  if(sess) chargerDashboard(sess);
}

// ── PROFIL DASHBOARD ──
function sauvegarderProfilDash() {
  const sess = getSession();
  if(!sess) return;
  sess.prenom = document.getElementById('dp-prenom')?.value||sess.prenom;
  sess.nom    = document.getElementById('dp-nom')?.value||sess.nom;
  sess.tel    = document.getElementById('dp-tel')?.value||sess.tel;
  sess.email  = document.getElementById('dp-email')?.value||sess.email;
  sess.ddn    = document.getElementById('dp-ddn')?.value||sess.ddn;
  sess.ville  = document.getElementById('dp-ville')?.value||'';
  setSession(sess);
  try { const c=JSON.parse(localStorage.getItem('ctl_compte')||'{}'); Object.assign(c,sess); localStorage.setItem('ctl_compte',JSON.stringify(c)); } catch(e){}
  mettreAJourNav();
  addNotif('✅','Profil mis à jour avec succès.');
  showToast('✅ Profil sauvegardé !');
}
function sauvegarderPreferences() {
  const sess = getSession();
  if(!sess) return;
  sess.classePreferee  = document.getElementById('dp-classe')?.value||'classique';
  sess.paiementPrefere = document.getElementById('dp-paiement')?.value||'mtn';
  sess.smsNotifs       = document.getElementById('dp-sms')?.value||'oui';
  setSession(sess);
  showToast('✅ Préférences sauvegardées !');
  addNotif('⚙️','Vos préférences de voyage ont été mises à jour.');
}
function changerMotDePasse() {
  const box = document.getElementById('modalChangeMdpBox');
  if(!box) return;
  box.innerHTML = `
    <div class="modal-header">
      <div><div class="mh-title">🔐 Changer le mot de passe</div></div>
      <button class="modal-close" onclick="document.getElementById('modalChangeMdp').classList.remove('open');document.body.style.overflow=''">✕</button>
    </div>
    <div class="modal-body">
      <div style="display:flex;flex-direction:column;gap:14px;">
        <div><label style="font-size:11px;color:var(--or);font-weight:700;text-transform:uppercase;letter-spacing:1px;display:block;margin-bottom:6px;">Mot de passe actuel</label><input type="password" id="mdp-actuel" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:10px 14px;color:#fff;font-family:'Outfit',sans-serif;font-size:14px;outline:none;"></div>
        <div><label style="font-size:11px;color:var(--or);font-weight:700;text-transform:uppercase;letter-spacing:1px;display:block;margin-bottom:6px;">Nouveau mot de passe</label><input type="password" id="mdp-nouveau" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:10px 14px;color:#fff;font-family:'Outfit',sans-serif;font-size:14px;outline:none;"></div>
        <div><label style="font-size:11px;color:var(--or);font-weight:700;text-transform:uppercase;letter-spacing:1px;display:block;margin-bottom:6px;">Confirmer</label><input type="password" id="mdp-confirm" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:10px 14px;color:#fff;font-family:'Outfit',sans-serif;font-size:14px;outline:none;"></div>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:10px;padding:16px 28px 24px;">
      <button onclick="document.getElementById('modalChangeMdp').classList.remove('open');document.body.style.overflow=''" style="background:transparent;border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.55);padding:10px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">Annuler</button>
      <button onclick="validerChangeMdp()" style="background:var(--vert);border:none;color:#fff;padding:10px 22px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;">Changer →</button>
    </div>`;
  document.getElementById('modalChangeMdp').classList.add('open');
  document.body.style.overflow='hidden';
}
function validerChangeMdp() {
  const n = document.getElementById('mdp-nouveau')?.value;
  const c = document.getElementById('mdp-confirm')?.value;
  if(!n||n.length<8) { showToast('⚠️ Minimum 8 caractères.'); return; }
  if(n!==c) { showToast('⚠️ Les mots de passe ne correspondent pas.'); return; }
  try { const compte=JSON.parse(localStorage.getItem('ctl_compte')||'{}'); compte.mdp=n; localStorage.setItem('ctl_compte',JSON.stringify(compte)); } catch(e){}
  document.getElementById('modalChangeMdp').classList.remove('open');
  document.body.style.overflow='';
  addNotif('🔐','Mot de passe modifié avec succès.');
  showToast('✅ Mot de passe changé !');
}

// ── FAMILLE DASHBOARD ──
let nbContactsDash = 0;
function renderFamilleDash(sess) {
  const zone = document.getElementById('familleContacts');
  if(!zone) return;
  const contacts = sess.contacts || [];
  nbContactsDash = contacts.length;
  zone.innerHTML = '';
  for(let i=0;i<Math.max(contacts.length,1);i++) renderContactBlock(i, contacts[i]);
}
function renderContactBlock(i, data) {
  const zone = document.getElementById('familleContacts');
  if(!zone) return;
  const div = document.createElement('div');
  div.id = 'cfDash'+i;
  div.style.cssText='background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:16px;margin-bottom:12px;';
  div.innerHTML=`<div style="font-weight:700;font-size:13px;margin-bottom:12px;color:rgba(255,255,255,0.7);">Contact ${i+1}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
      <div><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1px;display:block;margin-bottom:5px;">Nom complet</label><input type="text" id="cfd${i}nom" value="${escapeHtml(data?data.nom:'')}" placeholder="Marie Ngo" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:9px 12px;color:#fff;font-family:'Outfit',sans-serif;font-size:13px;outline:none;"></div>
      <div><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1px;display:block;margin-bottom:5px;">Téléphone</label><input type="tel" id="cfd${i}tel" value="${escapeHtml(data?data.tel:'')}" placeholder="6XX XXX XXX" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:9px 12px;color:#fff;font-family:'Outfit',sans-serif;font-size:13px;outline:none;"></div>
      <div><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1px;display:block;margin-bottom:5px;">Lien</label><select id="cfd${i}lien" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;padding:9px 12px;color:#fff;font-family:'Outfit',sans-serif;font-size:13px;outline:none;"><option value="">-- Choisir --</option><option ${data&&data.lien==='Époux/Épouse'?'selected':''}>Époux/Épouse</option><option ${data&&data.lien==='Père/Mère'?'selected':''}>Père/Mère</option><option ${data&&data.lien==='Frère/Sœur'?'selected':''}>Frère/Sœur</option><option ${data&&data.lien==='Enfant'?'selected':''}>Enfant</option><option ${data&&data.lien==='Ami(e) proche'?'selected':''}>Ami(e) proche</option></select></div>
    </div>`;
  zone.appendChild(div);
}
function ajouterContactDash() {
  if(nbContactsDash>=3) { showToast('Maximum 3 contacts famille.'); return; }
  renderContactBlock(nbContactsDash, null);
  nbContactsDash++;
}
function sauvegarderFamille() {
  const sess = getSession();
  if(!sess) return;
  sess.contacts=[];
  for(let i=0;i<nbContactsDash;i++) {
    const nom=document.getElementById('cfd'+i+'nom')?.value.trim();
    const tel=document.getElementById('cfd'+i+'tel')?.value.trim();
    const lien=document.getElementById('cfd'+i+'lien')?.value;
    if(nom&&tel) sess.contacts.push({nom,tel,lien});
  }
  setSession(sess);
  showToast('✅ Contacts famille sauvegardés !');
  addNotif('👨‍👩‍👧','Vos contacts famille CTL ont été mis à jour.');
}

// ── SUPPORT CHAT ──
const supportResponses = {
  default: "Je comprends votre question. Pour une assistance immédiate, contactez notre équipe au +237 690 000 000 ou sur WhatsApp.",
  annul: "Pour annuler un billet, rendez-vous dans Mon Espace → Mes Billets → bouton Annuler. Le remboursement se fait sous 48h.",
  paiement: "Nous acceptons MTN MoMo, Orange Money et les cartes bancaires. En cas de problème, appelez le +237 690 000 000.",
  retard: "En cas de retard, votre famille sera automatiquement notifiée. Le chauffeur CTL doit signaler tout retard de plus de 30 min.",
  sos: "Pour une urgence pendant le trajet, le chauffeur peut déclencher une alerte SOS. Votre famille est notifiée immédiatement.",
  billet: "Vos billets sont disponibles dans Mon Espace → Mes Billets. Vous pouvez afficher le QR code pour la validation.",
};
function envoyerSupport() {
  const input = document.getElementById('supportInput');
  const chat = document.getElementById('supportChat');
  if(!input||!chat||!input.value.trim()) return;
  const msg = input.value.trim();
  chat.innerHTML += `<div class="sc-msg user">${escapeHtml(msg)}</div>`;
  input.value='';
  chat.scrollTop=chat.scrollHeight;
  setTimeout(()=>{
    const lower=msg.toLowerCase();
    let rep = supportResponses.default;
    if(lower.includes('annul')) rep=supportResponses.annul;
    else if(lower.includes('paiement')||lower.includes('pay')||lower.includes('momo')||lower.includes('orange')) rep=supportResponses.paiement;
    else if(lower.includes('retard')) rep=supportResponses.retard;
    else if(lower.includes('sos')||lower.includes('urgent')||lower.includes('danger')) rep=supportResponses.sos;
    else if(lower.includes('billet')||lower.includes('qr')||lower.includes('ticket')) rep=supportResponses.billet;
    chat.innerHTML+=`<div class="sc-msg bot">${rep}</div>`;
    chat.scrollTop=chat.scrollHeight;
  }, 600);
}

// ── DÉCONNEXION ──
function seDeconnecter() {
  if(!confirm('Confirmer la déconnexion ?')) return;
  clearSession();
  fermerDashboard();
  mettreAJourNav();
  showToast('👋 Vous êtes déconnecté.');
}
function demanderSuppression() {
  if(!confirm('⚠️ Supprimer définitivement votre compte CTL ? Cette action est irréversible.')) return;
  clearSession();
  try { localStorage.removeItem('ctl_compte'); localStorage.removeItem('ctl_billets'); } catch(e){}
  fermerDashboard();
  mettreAJourNav();
  showToast('Compte supprimé.');
}

// ── TOAST NOTIFICATION ──
function showToast(msg) {
  let toast = document.getElementById('ctlToast');
  if(!toast) {
    toast = document.createElement('div');
    toast.id='ctlToast';
    toast.style.cssText='position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:#0d1a10;border:1px solid rgba(45,146,85,0.4);color:#fff;padding:12px 24px;border-radius:8px;font-family:Outfit,sans-serif;font-size:14px;font-weight:600;z-index:9999;opacity:0;transition:all 0.3s;pointer-events:none;white-space:nowrap;';
    document.body.appendChild(toast);
  }
  toast.textContent=msg;
  toast.style.opacity='1'; toast.style.transform='translateX(-50%) translateY(0)';
  clearTimeout(toast._t);
  toast._t=setTimeout(()=>{toast.style.opacity='0';toast.style.transform='translateX(-50%) translateY(20px)';},3000);
}

// ── PATCH confirmerReservation — sauvegarder le billet ──
const _origConfirmerReservation = confirmerReservation;
confirmerReservation = function(dep, arr, heure, prix, chauffeur) {
  _origConfirmerReservation(dep, arr, heure, prix, chauffeur);
  const sess = getSession();
  if(sess) {
    const billets = getBillets();
    const distances = {
      'Douala':{'Yaoundé':240,'Bafoussam':330,'Garoua':750,'Maroua':1100,'Bamenda':300,'Bertoua':480,'Kribi':160,'Ngaoundéré':620},
      'Yaoundé':{'Douala':240,'Bafoussam':310,'Garoua':680,'Maroua':1000,'Bamenda':360,'Bertoua':340,'Kribi':270,'Ngaoundéré':500}
    };
    const km = (distances[dep]&&distances[dep][arr]) ? distances[dep][arr] : 200;
    billets.unshift({
      ref: genRef(), dep, arr, heure, prix: parseInt(prix)||0, km,
      chauffeur, date: new Date().toLocaleDateString('fr-FR'),
      statut: 'confirme', email: sess.email, etapeActuelle: 0
    });
    saveBillets(billets);
    addNotif('🎫','Billet '+dep+' → '+arr+' confirmé ! Départ à '+heure+'.');
  }
};

// ── PATCH validerConnexion — créer session ──
const _origValiderConnexion = validerConnexion;
validerConnexion = function() {
  const email = document.getElementById('cx-email')?.value.trim();
  const mdp   = document.getElementById('cx-mdp')?.value;
  if(!email||!mdp) { alert('⚠️ Veuillez remplir tous les champs.'); return; }
  const compte = JSON.parse(localStorage.getItem('ctl_compte')||'null');
  if(compte && compte.email===email) {
    setSession(compte);
    mettreAJourNav();
    document.getElementById('modalConnexionBox').innerHTML=`
      <div class="resa-success">
        <div class="rs-icon">👋</div>
        <h3>Connexion réussie !</h3>
        <p>Bonjour <strong style="color:var(--white)">${escapeHtml(compte.prenom)} ${escapeHtml(compte.nom)}</strong> !<br>
        Vous êtes connecté à votre espace ${escapeHtml(compte.categorie)} CTL.</p>
        <div style="margin-top:24px;display:flex;gap:10px;justify-content:center;">
          <button class="btn-confirm-resa" onclick="(function(){document.getElementById('modalConnexion').classList.remove('open');document.body.style.overflow='';ctlOuvrirInterface(compte.categorie||'passager');})()">Mon Espace →</button>
          <button onclick="document.getElementById('modalConnexion').classList.remove('open');document.body.style.overflow=''" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);padding:10px 20px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">Rester sur le site</button>
        </div>
      </div>`;
    addNotif('👋','Connexion réussie. Bienvenue '+compte.prenom+' !');
  } else {
    alert('⚠️ Identifiants incorrects.');
  }
};

// ── PATCH validerCreationCompte — auto-login ──
const _origValiderCreationCompte = validerCreationCompte;
validerCreationCompte = function() {
  _origValiderCreationCompte();
  setTimeout(()=>{
    try {
      const compte = JSON.parse(localStorage.getItem('ctl_compte')||'null');
      if(compte) { setSession(compte); mettreAJourNav(); addNotif('🎉','Bienvenue sur CTL, '+compte.prenom+' ! Votre compte est activé.'); }
    } catch(e){}
  }, 100);
};

// ── ADMIN PANEL — RENDU COMPLET ──
function renderAdminPanel() {
  var allBillets = getBillets();
  var billetsNat = allBillets.filter(function(b){ return !b.arr || b.arr.indexOf('(') === -1; });
  var billetsIntl = allBillets.filter(function(b){ return b.arr && b.arr.indexOf('(') !== -1; });
  var caTotal = allBillets.reduce(function(s,b){return s+(b.prix||0);},0);
  var caIntl = billetsIntl.reduce(function(s,b){return s+(b.prix||0);},0);

  var set = function(id,v){ var el=document.getElementById(id); if(el) el.textContent=v; };
  set('admin-billets-total', billetsNat.length);
  set('admin-intl-total', billetsIntl.length);
  set('admin-ca-total', caTotal.toLocaleString('fr-FR')+' F');
  set('admin-ca-intl', caIntl.toLocaleString('fr-FR')+' F');
  set('admin-ca-fret', '0 F');
  set('admin-fret-total', '0');

  // Tableau corridors internationaux
  var tbl = document.getElementById('adminIntlTable');
  if(tbl) {
    var rows = '';
    var intlData = typeof INTERNATIONAL !== 'undefined' ? INTERNATIONAL : {};
    for(var pays in intlData) {
      var p = intlData[pays];
      p.villes.forEach(function(v){
        var t = typeof getTarifsIntl==='function' ? getTarifsIntl(v.depuis,v.ville,v.km) : {classique:0,vip:0};
        rows += '<tr><td style="padding:8px 14px;font-weight:600;">'+escapeHtml(v.depuis)+' → '+escapeHtml(p.flag)+' '+escapeHtml(v.ville)+'</td>';
        rows += '<td>'+escapeHtml(pays)+'</td><td>~'+v.km+' km</td>';
        rows += '<td style="color:var(--or);">'+(typeof formatPrix==='function'?formatPrix(t.classique):t.classique)+' F</td>';
        rows += '<td style="color:var(--or);">'+(typeof formatPrix==='function'?formatPrix(t.vip):t.vip)+' F</td>';
        rows += '<td><span style="font-size:10px;padding:2px 8px;border-radius:100px;background:rgba(45,146,85,0.15);border:1px solid rgba(45,146,85,0.3);color:#2d9255;">Actif</span></td></tr>';
      });
    }
    tbl.innerHTML = rows;
  }
}

// ══════════════════════════════════════════════════════════════════
// WALLET ENTREPRISE + FLUX FINANCIER + CONFIRMATION DÉPART + SCANNER QR
// (Inlined pour garantir le chargement)
// ══════════════════════════════════════════════════════════════════

// (wallet + flux financier definis dans le bloc script precedent)

// ── CONFIRMATION DE DÉPART ──
function ouvrirConfirmationDepart(ref){
  var billets=getBillets();var b=billets.find(function(x){return x.ref===ref;});if(!b){alert('Billet introuvable.');return;}
  var ch=typeof CHAUFFEURS!=='undefined'?CHAUFFEURS.find(function(c){return c.nom===b.chauffeur;}):null;
  var init=ch?ch.initiales:'??';var veh=ch?ch.vehicule:'Véhicule CTL';var hr=b.heure||'—';
  var modal=document.getElementById('modalResa');var box=document.getElementById('modalBox');if(!modal||!box)return;
  box.innerHTML='<div class="modal-header"><div><div class="mh-title">✅ Confirmation de départ — '+ref+'</div><div class="mh-sub">'+b.dep+' → '+b.arr+' · Départ prévu : '+hr+'</div></div><button class="modal-close" onclick="fermerModal()">✕</button></div><div class="modal-body"><div class="modal-section-title">🔍 Étape 1 — Vérification d\'identité</div><p style="font-size:13px;color:rgba(255,255,255,0.55);margin-bottom:16px;">Vérifiez que le chauffeur et le véhicule correspondent à votre réservation.</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;"><div style="background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.25);border-radius:10px;padding:18px;text-align:center;"><div style="width:64px;height:64px;border-radius:50%;background:rgba(26,107,58,0.3);border:2px solid var(--vert2);margin:0 auto 10px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;">'+init+'</div><div style="font-size:14px;font-weight:700;">'+(b.chauffeur||'Chauffeur CTL')+'</div><div style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:4px;">Chauffeur assigné</div></div><div style="background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.2);border-radius:10px;padding:18px;text-align:center;"><div style="font-size:36px;margin-bottom:8px;">🚗</div><div style="font-size:14px;font-weight:700;">'+veh+'</div><div style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:4px;">Véhicule enregistré</div></div></div><div style="font-size:13px;font-weight:700;margin-bottom:12px;">La personne et le véhicule correspondent-ils ?</div><div style="display:flex;gap:12px;margin-bottom:20px;" id="identBtns"><button onclick="confirmerIdentite(\''+ref+'\',true)" style="flex:1;padding:16px;border-radius:10px;border:2px solid rgba(45,146,85,0.4);background:rgba(45,146,85,0.1);color:var(--vert2);font-family:Outfit,sans-serif;font-size:14px;font-weight:700;cursor:pointer;">✅ Oui, ça correspond</button><button onclick="confirmerIdentite(\''+ref+'\',false)" style="flex:1;padding:16px;border-radius:10px;border:2px solid rgba(175,2,11,0.4);background:rgba(175,2,11,0.1);color:var(--rouge2);font-family:Outfit,sans-serif;font-size:14px;font-weight:700;cursor:pointer;">🚨 Non</button></div><div id="identResultZone"></div><div class="modal-section-title">🚌 Étape 2 — Confirmation du départ</div><div id="departConfirmZone" style="opacity:0.4;pointer-events:none;"><p style="font-size:13px;color:rgba(255,255,255,0.5);margin-bottom:12px;">Le chauffeur confirme le départ. Les fonds seront débloqués.</p><div style="background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.2);border-radius:8px;padding:12px 16px;margin-bottom:12px;font-size:12px;color:rgba(255,255,255,0.5);">⏰ Départ prévu : <strong style="color:var(--or)">'+hr+'</strong></div><button onclick="confirmerDepartChauffeur(\''+ref+'\',\''+hr+'\',\''+(b.chauffeur||'').replace(/'/g,"\\'")+'\')" style="width:100%;padding:16px;border-radius:10px;border:none;background:linear-gradient(135deg,var(--vert),var(--vert2));color:#fff;font-family:Outfit,sans-serif;font-size:15px;font-weight:700;cursor:pointer;">🚌 Confirmer le départ & débloquer les fonds</button></div></div>';
  modal.classList.add('open');document.body.style.overflow='hidden';
}

function confirmerIdentite(ref,ok){
  var z=document.getElementById('identResultZone');if(!z)return;
  var billets=getBillets();var b=billets.find(function(x){return x.ref===ref;});
  if(ok){
    z.innerHTML='<div style="background:rgba(45,146,85,0.1);border:1px solid rgba(45,146,85,0.3);border-radius:8px;padding:12px 16px;font-size:13px;color:var(--vert2);margin-bottom:12px;">✅ <strong>Identité confirmée.</strong></div>';
    var dz=document.getElementById('departConfirmZone');if(dz){dz.style.opacity='1';dz.style.pointerEvents='auto';}
    if(b){b.identiteVerifiee=true;saveBillets(billets);}
  } else {
    z.innerHTML='<div style="background:rgba(175,2,11,0.1);border:1px solid rgba(175,2,11,0.3);border-radius:8px;padding:14px 16px;font-size:13px;color:var(--rouge2);margin-bottom:12px;">🚨 <strong>ALERTE — Identité non conforme</strong><br><br>Alerte envoyée à CTL. Un agent vous contactera.<br>📞 Urgence : <strong>+237 690 000 000</strong><br><br><strong>Ne montez pas dans le véhicule.</strong></div>';
    if(typeof addNotif==='function')addNotif('🚨','ALERTE IDENTITÉ — '+ref+' : chauffeur/véhicule non conforme');
    if(b){b.alerteIdentite=true;b.identiteVerifiee=false;saveBillets(billets);}
  }
  var btns=document.getElementById('identBtns');if(btns)btns.style.cssText='opacity:0.4;pointer-events:none;display:flex;gap:12px;margin-bottom:20px;';
}

function confirmerDepartChauffeur(ref,heurePrevue,chauffeur){
  var now=new Date();var hh=parseInt(heurePrevue)||0;var mm=parseInt((heurePrevue.split('h')[1]||'0'))||0;
  if(now.getHours()*60+now.getMinutes()<hh*60+mm-5){alert('⏰ Départ impossible avant l\'heure prévue ('+heurePrevue+').');return;}
  debloquerFondsChauffeur(ref,chauffeur);
  var billets=getBillets();var b=billets.find(function(x){return x.ref===ref;});
  if(b){b.statut='en-route';b.departConfirme=true;b.heureDepart=now.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});b.etapeActuelle=2;b.position='Départ confirmé';saveBillets(billets);}
  if(typeof addNotif==='function')addNotif('🚌','Départ confirmé — '+ref+' · Fonds débloqués pour '+chauffeur);
  var box=document.getElementById('modalBox');
  if(box)box.innerHTML='<div class="resa-success"><div style="font-size:48px;margin-bottom:8px;">🚌✅</div><h3>Départ confirmé !</h3><div class="rs-ref">'+ref+'</div><p style="text-align:left;">✅ Identité vérifiée<br>🚌 Départ confirmé à '+now.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})+'<br>💰 Fonds débloqués pour '+chauffeur+'<br>📍 GPS activé<br>👨‍👩‍👧 SMS envoyé aux contacts famille<br>🆘 SOS disponible</p><div style="display:flex;gap:10px;justify-content:center;margin-top:22px;"><button onclick="fermerModal()" style="background:var(--vert);border:none;color:#fff;padding:12px 22px;border-radius:8px;font-family:Outfit,sans-serif;font-size:13px;font-weight:700;cursor:pointer;">Fermer</button></div></div>';
}

// ── SCANNER QR CHAUFFEUR + LISTE PASSAGERS ──
function getPassagersList(cid){try{return JSON.parse(localStorage.getItem('ctl_passagers_'+cid)||'[]');}catch(e){return[];}}
function savePassagersList(cid,l){try{localStorage.setItem('ctl_passagers_'+cid,JSON.stringify(l));}catch(e){}}

function ouvrirPanneauChauffeur(chauffeurNom){
  var cid=chauffeurNom.replace(/\s/g,'_').toLowerCase();
  var modal=document.getElementById('modalResa');var box=document.getElementById('modalBox');if(!modal||!box)return;
  var billets=getBillets();var mes=billets.filter(function(b){return b.chauffeur===chauffeurNom&&(b.statut==='confirme'||b.statut==='Confirmé'||b.statut==='en-route');});
  var pass=getPassagersList(cid);
  mes.forEach(function(b){if(!pass.find(function(p){return p.ref===b.ref;})){var s=getSession();pass.push({ref:b.ref,nom:b.nomPassager||(s?s.prenom+' '+s.nom:'Passager'),tel:b.tel||'',dep:b.dep,arr:b.arr,heure:b.heure,statut:'attente',qrScanne:false});}});
  savePassagersList(cid,pass);
  var emb=pass.filter(function(p){return p.statut==='embarque';}).length;var tot=pass.length;
  var ph=pass.length===0?'<div style="text-align:center;padding:32px;color:rgba(255,255,255,0.3);">Aucun passager.</div>':pass.map(function(p,i){
    var bg=p.statut==='embarque'?'rgba(45,146,85,0.15)':p.statut==='absent'?'rgba(175,2,11,0.1)':'rgba(255,255,255,0.03)';
    var bd=p.statut==='embarque'?'rgba(45,146,85,0.3)':p.statut==='absent'?'rgba(175,2,11,0.3)':'rgba(255,255,255,0.08)';
    var sl=p.statut==='embarque'?'<span style="color:var(--vert2);font-weight:700;">✅ Embarqué</span>':p.statut==='absent'?'<span style="color:var(--rouge2);">👤 Absent</span>'+(p.raisonLabel?' <span style="font-size:10px;color:rgba(255,100,100,0.6);">· '+p.raisonLabel+'</span>':''):p.statut==='retard'?'<span style="color:var(--or);">⏰ En retard</span>':p.statut==='annule'?'<span style="color:var(--rouge2);">🚫 Trajet annulé</span>':'<span style="color:rgba(255,255,255,0.4);">⏳ En attente</span>';
    return '<div style="background:'+bg+';border:1px solid '+bd+';border-radius:10px;padding:14px 16px;margin-bottom:8px;display:flex;align-items:center;gap:12px;"><div style="width:36px;height:36px;border-radius:50%;background:rgba(212,168,0,0.15);border:1px solid rgba(212,168,0,0.3);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:var(--or);">'+(i+1)+'</div><div style="flex:1;"><div style="font-size:14px;font-weight:700;">'+p.nom+'</div><div style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:2px;">'+p.ref+' · '+p.dep+' → '+p.arr+' · '+p.heure+'</div><div style="margin-top:4px;">'+sl+(p.qrScanne?' · <span style="font-size:11px;color:var(--vert2);">QR validé ✓</span>':'')+'</div></div><div style="display:flex;gap:6px;">'+(p.statut!=='embarque'?'<button onclick="scanQR(\''+cid+'\','+i+')" style="background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);width:36px;height:36px;border-radius:8px;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;" title="Scanner QR">'+(p.qrScanne?'✅':'📷')+'</button>':'')+(p.statut==='attente'?'<button onclick="marqEmb(\''+cid+'\','+i+')" style="background:rgba(45,146,85,0.15);border:1px solid rgba(45,146,85,0.3);color:var(--vert2);padding:6px 12px;border-radius:6px;font-family:Outfit,sans-serif;font-size:11px;font-weight:700;cursor:pointer;">Embarqué</button><button onclick="marqAbs(\''+cid+'\','+i+')" style="background:rgba(175,2,11,0.08);border:1px solid rgba(175,2,11,0.2);color:rgba(255,100,100,0.7);padding:6px 12px;border-radius:6px;font-family:Outfit,sans-serif;font-size:11px;cursor:pointer;">Absent</button>':'')+'<button onclick="ouvrirMsgBillet(\''+p.ref+'\',\''+p.nom.replace(/'/g,"\\'")+'\')" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);width:36px;height:36px;border-radius:8px;font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;">💬</button></div></div>';}).join('');
  box.innerHTML='<div class="modal-header"><div><div class="mh-title">🚗 Panneau Chauffeur — '+chauffeurNom+'</div><div class="mh-sub">Scanner QR · Validation embarquement</div></div><button class="modal-close" onclick="fermerModal()">✕</button></div><div style="padding:12px 28px;background:rgba(26,107,58,0.08);border-bottom:1px solid rgba(26,107,58,0.2);display:flex;align-items:center;justify-content:space-between;"><div style="font-size:13px;color:rgba(255,255,255,0.6);">Passagers : <strong style="color:var(--or);">'+emb+'/'+tot+'</strong> embarqués</div><button onclick="scanCam(\''+cid+'\')" style="background:linear-gradient(135deg,var(--or),var(--cuivre));border:none;color:#0a1209;padding:8px 16px;border-radius:6px;font-family:Outfit,sans-serif;font-size:12px;font-weight:700;cursor:pointer;">📷 Scanner un QR</button></div><div class="modal-body" style="max-height:50vh;overflow-y:auto;"><div style="font-size:11px;font-weight:700;letter-spacing:2px;color:var(--or);margin-bottom:12px;">LISTE DES PASSAGERS ('+tot+')</div>'+ph+'</div><div style="padding:16px 28px 24px;border-top:1px solid rgba(255,255,255,0.07);display:flex;gap:10px;"><button onclick="fermerModal()" style="flex:1;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);padding:12px;border-radius:8px;font-family:Outfit,sans-serif;font-size:13px;cursor:pointer;">Fermer</button><button onclick="genererPreuveChauffeur(\''+chauffeurNom.replace(/'/g,"\\'")+'\')" style="background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);padding:12px;border-radius:8px;font-family:Outfit,sans-serif;font-size:12px;font-weight:600;cursor:pointer;">🖨️ Preuve</button>'+(emb>0&&pass[0]?'<button onclick="fermerModal();setTimeout(function(){ouvrirConfirmationDepart(\''+pass[0].ref+'\');},200)" style="flex:2;background:linear-gradient(135deg,var(--vert),var(--vert2));border:none;color:#fff;padding:12px;border-radius:8px;font-family:Outfit,sans-serif;font-size:14px;font-weight:700;cursor:pointer;">🚌 Confirmer le départ ('+emb+'/'+tot+')</button>':'')+'</div>';
  modal.classList.add('open');document.body.style.overflow='hidden';
}
// ── SCAN QR INDIVIDUEL (bouton par passager) ──
function scanQR(cid,idx){
  var p=getPassagersList(cid);if(!p[idx])return;
  // Ouvrir le scanner caméra pour ce passager
  window._scanCid=cid;window._scanIdx=idx;
  ouvrirScannerChauffeur(cid,p[idx].nom,p[idx].ref);
}

// ── SCAN CAMÉRA CHAUFFEUR (ouvre la caméra dans le panneau) ──
function scanCam(cid){
  window._scanCid=cid;window._scanIdx=-1;
  ouvrirScannerChauffeur(cid,null,null);
}

// ── SCANNER QR CHAUFFEUR — ouvre la caméra via html5-qrcode ──
function ouvrirScannerChauffeur(cid,nomAttendu,refAttendu){
  var modal=document.getElementById('modalResa');var box=document.getElementById('modalBox');
  if(!modal||!box)return;
  var chNom=cid.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});
  box.innerHTML=
    '<div class="modal-header">'+
    '<div><div class="mh-title">📷 Scanner le billet'+(nomAttendu?' de '+escapeHtml(nomAttendu):'')+'</div>'+
    '<div class="mh-sub">Pointez la caméra vers le QR code du passager</div></div>'+
    '<button class="modal-close" onclick="arreterScannerCh();ouvrirPanneauChauffeur(\''+escapeHtml(chNom)+'\')">✕</button></div>'+
    '<div class="modal-body">'+
    '<div id="qr-reader-ch" style="width:100%;border-radius:12px;overflow:hidden;"></div>'+
    '<div id="scanResultatCh" style="margin-top:16px;"></div>'+
    '</div>'+
    '<div class="modal-footer">'+
    '<div style="font-size:12px;color:rgba(255,255,255,0.4);">Caméra active — En attente de scan...</div>'+
    '<button class="btn-cancel-modal" onclick="arreterScannerCh();ouvrirPanneauChauffeur(\''+escapeHtml(chNom)+'\')">Retour</button></div>';
  modal.classList.add('open');document.body.style.overflow='hidden';

  setTimeout(function(){
    if(typeof Html5Qrcode==='undefined'){
      document.getElementById('scanResultatCh').innerHTML=
        '<div style="background:rgba(175,2,11,0.1);border:1px solid rgba(175,2,11,0.3);border-radius:8px;padding:16px;color:#ff6b6b;text-align:center;">'+
        '⚠️ Bibliothèque scanner non chargée.<br><br>'+
        '<strong>Saisie manuelle :</strong><br>'+
        '<input type="text" id="manualRefCh" placeholder="CTL-2025-XXXXXX" style="margin-top:10px;width:100%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px;color:#fff;font-family:monospace;font-size:16px;text-align:center;outline:none;">'+
        '<button onclick="verifierManuelCh(\''+cid+'\')" style="margin-top:10px;background:var(--vert);border:none;color:#fff;padding:10px 24px;border-radius:6px;font-family:Outfit,sans-serif;font-weight:700;cursor:pointer;">Vérifier</button></div>';
      return;
    }
    window._ctlScannerCh=new Html5Qrcode("qr-reader-ch");
    window._ctlScannerCh.start(
      {facingMode:"environment"},
      {fps:10,qrbox:{width:250,height:250}},
      function(decoded){onQRScanneChauffeur(decoded,cid);},
      function(){}
    ).catch(function(err){
      document.getElementById('scanResultatCh').innerHTML=
        '<div style="background:rgba(175,2,11,0.1);border:1px solid rgba(175,2,11,0.3);border-radius:8px;padding:16px;color:#ff6b6b;text-align:center;">'+
        '⚠️ Caméra indisponible.<br><br>'+
        '<strong>Saisie manuelle :</strong><br>'+
        '<input type="text" id="manualRefCh" placeholder="CTL-2025-XXXXXX" style="margin-top:10px;width:100%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px;color:#fff;font-family:monospace;font-size:16px;text-align:center;outline:none;">'+
        '<button onclick="verifierManuelCh(\''+cid+'\')" style="margin-top:10px;background:var(--vert);border:none;color:#fff;padding:10px 24px;border-radius:6px;font-family:Outfit,sans-serif;font-weight:700;cursor:pointer;">Vérifier</button></div>';
    });
  },300);
}

function arreterScannerCh(){
  if(window._ctlScannerCh){try{window._ctlScannerCh.stop();}catch(e){}window._ctlScannerCh=null;}
}

function verifierManuelCh(cid){
  var ref=(document.getElementById('manualRefCh')?.value||'').trim();
  if(!ref){alert('Entrez une référence de billet.');return;}
  onQRScanneChauffeur(ref,cid);
}

function onQRScanneChauffeur(decoded,cid){
  arreterScannerCh();
  var chNom=cid.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});

  // Extraire la référence du QR (JSON ou texte brut)
  var ref='';var nomPassager='';
  try{var data=JSON.parse(decoded);ref=data.r;nomPassager=data.n||'';}catch(e){ref=decoded.trim();}

  // FAILLE 2 : Vérifier d'abord dans le cloud (Firestore) si le billet est déjà scanné
  var zone=document.getElementById('scanResultatCh');if(!zone)return;
  zone.innerHTML='<div style="text-align:center;padding:20px;color:rgba(255,255,255,0.5);">⏳ Vérification en cours...</div>';

  // Vérification cloud puis locale
  var cloudCheck = (window.CTL_Firebase && CTL_Firebase.ready)
    ? CTL_Firebase.checkBilletScanne(ref || decoded.trim())
    : Promise.resolve(null);

  cloudCheck.then(function(cloudResult) {
    // Si le cloud dit "déjà scanné", bloquer immédiatement
    if (cloudResult && cloudResult.existe && cloudResult.scanne) {
      zone.innerHTML=
        '<div style="background:rgba(175,2,11,0.12);border:2px solid var(--rouge2);border-radius:12px;padding:24px;text-align:center;">'+
        '<div style="font-size:48px;margin-bottom:8px;">🔒</div>'+
        '<div style="font-family:Playfair Display,serif;font-size:24px;font-weight:700;color:var(--rouge2);margin-bottom:12px;">BILLET DÉJÀ UTILISÉ</div>'+
        '<div style="font-size:15px;color:rgba(255,255,255,0.7);margin-bottom:8px;">Ce billet a été scanné et verrouillé dans le serveur.</div>'+
        '<div style="font-size:12px;color:rgba(255,255,255,0.4);">Scanné le '+(cloudResult.data.scanneDate||'?')+' à '+(cloudResult.data.scanneA||'?')+'</div></div>'+
        '<div style="display:flex;gap:10px;justify-content:center;margin-top:16px;">'+
        '<button onclick="ouvrirScannerChauffeur(\''+cid+'\',null,null)" style="background:var(--rouge);border:none;color:#fff;padding:12px 24px;border-radius:8px;font-family:Outfit,sans-serif;font-weight:700;cursor:pointer;">📷 Scanner un autre</button>'+
        '<button onclick="arreterScannerCh();ouvrirPanneauChauffeur(\''+escapeHtml(chNom)+'\')" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);padding:12px 24px;border-radius:8px;font-family:Outfit,sans-serif;cursor:pointer;">Retour</button></div>';
      return;
    }

    // Sinon, vérification locale classique
    var resultat=verifierBillet(decoded);

  if(resultat.valide){
    // Marquer le billet comme scanné dans la base globale + cloud
    marquerBilletScanne(resultat.ref);

    // Mettre à jour la liste passagers du chauffeur
    var pass=getPassagersList(cid);
    var idx=pass.findIndex(function(p){return p.ref===resultat.ref;});
    if(idx!==-1){
      pass[idx].qrScanne=true;
      pass[idx].statut='embarque';
      savePassagersList(cid,pass);
    }

    zone.innerHTML=
      '<div style="background:rgba(26,107,58,0.15);border:2px solid var(--vert2);border-radius:12px;padding:24px;text-align:center;">'+
      '<div style="font-size:48px;margin-bottom:8px;">✅</div>'+
      '<div style="font-family:Playfair Display,serif;font-size:24px;font-weight:700;color:var(--vert2);margin-bottom:12px;">VALIDE</div>'+
      '<div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:4px;">'+escapeHtml(resultat.nomPassager)+'</div>'+
      '<div style="font-size:15px;color:var(--or);margin-bottom:8px;">'+escapeHtml(resultat.dep)+' → '+escapeHtml(resultat.arr)+'</div>'+
      '<div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;font-size:13px;color:rgba(255,255,255,0.6);">'+
      '<span>🎫 '+escapeHtml(resultat.ref)+'</span>'+
      '<span>⏰ '+escapeHtml(resultat.heure||'')+'</span>'+
      '<span>💺 Siège '+(resultat.billet&&resultat.billet.siege?resultat.billet.siege:'—')+'</span>'+
      '<span>💰 '+escapeHtml(String(resultat.prix||''))+' FCFA</span></div>'+
      (resultat.billet&&resultat.billet.immatriculation?'<div style="margin-top:10px;font-size:12px;color:rgba(255,255,255,0.5);">🚌 Véhicule : <strong style="color:var(--or);">'+escapeHtml(resultat.billet.immatriculation)+'</strong></div>':'')+
      '<div style="margin-top:16px;padding-top:12px;border-top:1px solid rgba(45,146,85,0.3);font-size:12px;color:var(--vert2);">Passager <strong>EMBARQUÉ</strong> — Billet marqué comme utilisé</div>'+
      '</div>'+
      '<div style="display:flex;gap:10px;justify-content:center;margin-top:16px;">'+
      '<button onclick="ouvrirScannerChauffeur(\''+cid+'\',null,null)" style="background:var(--vert);border:none;color:#fff;padding:12px 24px;border-radius:8px;font-family:Outfit,sans-serif;font-weight:700;cursor:pointer;">📷 Scanner suivant</button>'+
      '<button onclick="arreterScannerCh();ouvrirPanneauChauffeur(\''+escapeHtml(chNom)+'\')" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);padding:12px 24px;border-radius:8px;font-family:Outfit,sans-serif;cursor:pointer;">Retour liste</button></div>';
  } else {
    zone.innerHTML=
      '<div style="background:rgba(175,2,11,0.12);border:2px solid var(--rouge2);border-radius:12px;padding:24px;text-align:center;">'+
      '<div style="font-size:48px;margin-bottom:8px;">❌</div>'+
      '<div style="font-family:Playfair Display,serif;font-size:24px;font-weight:700;color:var(--rouge2);margin-bottom:12px;">INVALIDE</div>'+
      '<div style="font-size:15px;color:rgba(255,255,255,0.7);margin-bottom:8px;">'+escapeHtml(resultat.raison)+'</div>'+
      (resultat.ref?'<div style="font-size:12px;color:rgba(255,255,255,0.4);">Réf : '+escapeHtml(resultat.ref)+'</div>':'')+
      '</div>'+
      '<div style="display:flex;gap:10px;justify-content:center;margin-top:16px;">'+
      '<button onclick="ouvrirScannerChauffeur(\''+cid+'\',null,null)" style="background:var(--rouge);border:none;color:#fff;padding:12px 24px;border-radius:8px;font-family:Outfit,sans-serif;font-weight:700;cursor:pointer;">📷 Réessayer</button>'+
      '<button onclick="arreterScannerCh();ouvrirPanneauChauffeur(\''+escapeHtml(chNom)+'\')" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);padding:12px 24px;border-radius:8px;font-family:Outfit,sans-serif;cursor:pointer;">Retour liste</button></div>';
  }

  }); // fin cloudCheck.then
}
function marqEmb(cid,i){var p=getPassagersList(cid);if(p[i]){p[i].statut='embarque';savePassagersList(cid,p);var n=cid.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});ouvrirPanneauChauffeur(n);}}

// ── MARQUER INVALIDE — avec choix de raison ──
function marqAbs(cid,i){
  var p=getPassagersList(cid);if(!p[i])return;
  var nom=p[i].nom;var ref=p[i].ref;
  // Ouvrir le sélecteur de raison dans la modale
  var modal=document.getElementById('modalResa');var box=document.getElementById('modalBox');
  if(!modal||!box)return;
  var chNom=cid.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});
  box.innerHTML=
    '<div class="modal-header">'+
    '<div><div class="mh-title">❌ Marquer le billet comme invalide</div>'+
    '<div class="mh-sub">'+escapeHtml(nom)+' — '+escapeHtml(ref)+'</div></div>'+
    '<button class="modal-close" onclick="ouvrirPanneauChauffeur(\''+escapeHtml(chNom)+'\')">✕</button></div>'+
    '<div class="modal-body">'+
    '<div style="font-size:13px;color:rgba(255,255,255,0.6);margin-bottom:16px;">Sélectionnez la raison :</div>'+
    '<div class="annul-reason">'+
    '<div class="annul-option" onclick="confirmerInvalide(\''+cid+'\','+i+',\'absent\',this)">'+
    '<span style="font-size:20px;">👤</span><div style="flex:1;"><strong>Passager absent</strong><br><span style="font-size:12px;color:rgba(255,255,255,0.4);">Le passager ne s\'est pas présenté au point de rendez-vous</span></div></div>'+
    '<div class="annul-option" onclick="confirmerInvalide(\''+cid+'\','+i+',\'retard\',this)">'+
    '<span style="font-size:20px;">⏰</span><div style="flex:1;"><strong>Passager en retard</strong><br><span style="font-size:12px;color:rgba(255,255,255,0.4);">Le passager n\'est pas arrivé à l\'heure prévue, le bus doit partir</span></div></div>'+
    '<div class="annul-option" onclick="confirmerInvalide(\''+cid+'\','+i+',\'annule\',this)">'+
    '<span style="font-size:20px;">🚫</span><div style="flex:1;"><strong>Trajet annulé</strong><br><span style="font-size:12px;color:rgba(255,255,255,0.4);">Le trajet est annulé (panne, conditions météo, force majeure)</span></div></div>'+
    '<div class="annul-option" onclick="confirmerInvalide(\''+cid+'\','+i+',\'qr_invalide\',this)">'+
    '<span style="font-size:20px;">❌</span><div style="flex:1;"><strong>QR Code invalide / falsifié</strong><br><span style="font-size:12px;color:rgba(255,255,255,0.4);">Le billet présenté n\'est pas valide ou a déjà été utilisé</span></div></div>'+
    '<div class="annul-option" onclick="confirmerInvalide(\''+cid+'\','+i+',\'identite\',this)">'+
    '<span style="font-size:20px;">🪪</span><div style="flex:1;"><strong>Identité non conforme</strong><br><span style="font-size:12px;color:rgba(255,255,255,0.4);">Le passager ne correspond pas au nom sur le billet</span></div></div>'+
    '</div></div>'+
    '<div class="modal-footer">'+
    '<div style="font-size:12px;color:rgba(255,255,255,0.35);">Cette action est irréversible</div>'+
    '<button class="btn-cancel-modal" onclick="ouvrirPanneauChauffeur(\''+escapeHtml(chNom)+'\')">Annuler</button></div>';
  modal.classList.add('open');document.body.style.overflow='hidden';
}

function confirmerInvalide(cid,idx,raison,el){
  // Sélectionner visuellement
  document.querySelectorAll('.annul-option').forEach(function(o){o.classList.remove('selected');});
  if(el)el.classList.add('selected');

  var raisonLabels={
    'absent':'Passager absent','retard':'Passager en retard','annule':'Trajet annulé',
    'qr_invalide':'QR Code invalide','identite':'Identité non conforme'
  };
  var raisonIcons={'absent':'👤','retard':'⏰','annule':'🚫','qr_invalide':'❌','identite':'🪪'};

  var p=getPassagersList(cid);
  if(!p[idx])return;
  var nom=p[idx].nom;var ref=p[idx].ref;

  // Mettre à jour la liste passagers
  p[idx].statut=raison==='annule'?'annule':'absent';
  p[idx].raison=raison;
  p[idx].raisonLabel=raisonLabels[raison]||raison;
  p[idx].raisonDate=new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
  savePassagersList(cid,p);

  // Mettre à jour le billet dans la base globale
  var billets=getBillets();
  var billet=billets.find(function(b){return b.ref===ref;});
  if(billet){
    if(raison==='annule'){billet.statut='Annulé';billet.raisonAnnulation='Trajet annulé par le chauffeur';}
    else{billet.statut='Non embarqué';billet.raisonRefus=raisonLabels[raison];}
    billet.raisonDate=new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
    saveBillets(billets);
  }

  addNotif(raisonIcons[raison]||'❌', raisonLabels[raison]+' — '+nom+' ('+ref+')');

  // Afficher la confirmation
  var chNom=cid.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});
  var box=document.getElementById('modalBox');
  if(box) box.innerHTML=
    '<div class="resa-success">'+
    '<div style="font-size:48px;margin-bottom:8px;">'+(raisonIcons[raison]||'❌')+'</div>'+
    '<h3>'+escapeHtml(raisonLabels[raison]||'Invalide')+'</h3>'+
    '<div class="rs-ref">'+escapeHtml(ref)+'</div>'+
    '<p>'+escapeHtml(nom)+' — <strong style="color:var(--rouge2)">'+escapeHtml(raisonLabels[raison])+'</strong><br><br>'+
    (raison==='annule'?'Tous les passagers du trajet seront notifiés. Le remboursement sera traité automatiquement.':
     raison==='retard'?'Le passager sera notifié par SMS de son retard. Le billet reste valide pour un prochain trajet.':
     raison==='absent'?'Le passager sera notifié. Le billet est marqué comme non utilisé.':
     raison==='qr_invalide'?'Le billet a été signalé. L\'équipe CTL sera alertée pour vérification.':
     'L\'identité du passager ne correspond pas au billet. Accès refusé.')+
    '</p>'+
    '<div style="display:flex;gap:10px;justify-content:center;margin-top:22px;">'+
    '<button onclick="ouvrirPanneauChauffeur(\''+escapeHtml(chNom)+'\')" style="background:var(--vert);border:none;color:#fff;padding:12px 24px;border-radius:8px;font-family:Outfit,sans-serif;font-weight:700;cursor:pointer;">Retour à la liste</button></div></div>';
}

// ── INIT AU CHARGEMENT ──
document.addEventListener('DOMContentLoaded', function() {
  const sess = getSession();
  if(sess) mettreAJourNav();
  // Fermer notifs au clic
  document.querySelectorAll('.modal-overlay').forEach(m=>{
    m.addEventListener('click',function(e){ if(e.target===this){ this.classList.remove('open'); document.body.style.overflow=''; } });
  });
});

</script>

<!-- ══════════════════════════════════════════════════════════════════
     CTL — PORTEFEUILLE, FICHE DE RENSEIGNEMENT, BILLET TIERS
══════════════════════════════════════════════════════════════════ -->

<!-- Modal Portefeuille -->
<div class="modal-overlay" id="modalWallet">
  <div class="modal-box" id="modalWalletBox" style="max-width:680px;max-height:90vh;overflow-y:auto;"></div>
</div>

<!-- Modal Fiche Renseignement -->
<div class="modal-overlay" id="modalFiche">
  <div class="modal-box" id="modalFicheBox" style="max-width:700px;max-height:90vh;overflow-y:auto;"></div>
</div>

<!-- Modal Achat Billet Tiers -->
<div class="modal-overlay" id="modalBilletTiers">
  <div class="modal-box" id="modalBilletTiersBox" style="max-width:620px;max-height:90vh;overflow-y:auto;"></div>
</div>

<style>
.wallet-balance-card {
  background: linear-gradient(135deg, #1a6b3a 0%, #0d3d1e 50%, #1a0a00 100%);
  border-radius: 16px; padding: 28px; margin-bottom: 20px;
  position: relative; overflow: hidden;
}
.wallet-balance-card::before {
  content: ''; position: absolute; top: -40px; right: -40px;
  width: 160px; height: 160px; border-radius: 50%;
  background: rgba(212,168,0,0.1);
}
.wallet-logo-small { width:36px;height:36px;border-radius:50%;object-fit:cover;position:absolute;top:16px;right:16px; }
.wallet-amount { font-family:'Playfair Display',serif; font-size:42px; font-weight:900; color:#fff; margin:8px 0 4px; }
.wallet-actions-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-bottom:20px; }
.wallet-action-btn {
  background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.12);
  border-radius:12px; padding:16px 8px; text-align:center; cursor:pointer;
  transition:all 0.2s; display:flex; flex-direction:column; align-items:center; gap:8px;
}
.wallet-action-btn:hover { background:rgba(26,107,58,0.2); border-color:rgba(26,107,58,0.5); }
.wallet-action-btn .wa-icon { font-size:24px; }
.wallet-action-btn .wa-label { font-size:11px; font-weight:700; color:rgba(255,255,255,0.7); letter-spacing:0.5px; }
.wallet-tx-list { display:flex; flex-direction:column; gap:8px; }
.wallet-tx-item {
  display:flex; align-items:center; gap:12px;
  padding:12px 14px; border-radius:8px;
  background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);
}
.wallet-tx-icon { font-size:20px; flex-shrink:0; }
.wallet-tx-info { flex:1; }
.wallet-tx-label { font-size:13px; font-weight:600; }
.wallet-tx-date { font-size:11px; color:rgba(255,255,255,0.4); margin-top:2px; }
.wallet-tx-amount { font-family:'JetBrains Mono',monospace; font-size:14px; font-weight:700; }
.wallet-tx-amount.credit { color:#4ade80; }
.wallet-tx-amount.debit  { color:#f87171; }
.wallet-method-item {
  display:flex; align-items:center; justify-content:space-between;
  padding:12px 16px; border-radius:8px; cursor:pointer;
  border:2px solid rgba(255,255,255,0.08); transition:all 0.2s; margin-bottom:8px;
}
.wallet-method-item.selected { border-color:var(--or); background:rgba(212,168,0,0.07); }
.wallet-method-item:hover { border-color:rgba(212,168,0,0.4); }
.fiche-header {
  background:linear-gradient(135deg,#0d1a10 0%,#071009 100%);
  border-bottom:3px solid var(--or); padding:28px 32px;
  display:flex; align-items:center; gap:20px; position:relative;
}
.fiche-logo { width:60px; height:60px; border-radius:50%; object-fit:cover; flex-shrink:0; }
.fiche-brand { flex:1; }
.fiche-brand-name { font-family:'Playfair Display',serif; font-size:18px; font-weight:900; color:#fff; letter-spacing:1px; }
.fiche-brand-sub { font-size:10px; color:var(--or); letter-spacing:3px; text-transform:uppercase; margin-top:2px; }
.fiche-avatar {
  width:80px; height:80px; border-radius:50%; border:3px solid var(--or); overflow:hidden;
  background:rgba(26,107,58,0.3); display:flex; align-items:center;
  justify-content:center; font-size:28px; font-weight:700; flex-shrink:0;
}
.fiche-avatar img { width:100%; height:100%; object-fit:cover; }
.fiche-body { padding:24px 32px; }
.fiche-section-title {
  font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase;
  color:var(--or); margin:20px 0 10px; padding-bottom:6px;
  border-bottom:1px solid rgba(212,168,0,0.2);
}
.fiche-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
.fiche-item { background:rgba(255,255,255,0.03); border-radius:8px; padding:10px 14px; }
.fiche-item-label { font-size:10px; color:rgba(255,255,255,0.4); letter-spacing:1px; text-transform:uppercase; margin-bottom:3px; }
.fiche-item-value { font-size:14px; font-weight:600; color:#fff; }
.fiche-stats-row { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:16px; }
.fiche-stat {
  background:rgba(26,107,58,0.1); border:1px solid rgba(26,107,58,0.25);
  border-radius:10px; padding:14px; text-align:center;
}
.fiche-stat .v { font-family:'Playfair Display',serif; font-size:24px; font-weight:700; color:var(--or); }
.fiche-stat .l { font-size:10px; color:rgba(255,255,255,0.45); margin-top:4px; text-transform:uppercase; letter-spacing:1px; }
.fiche-trajet-item {
  display:flex; align-items:center; gap:12px; padding:10px 14px; border-radius:8px;
  background:rgba(255,255,255,0.03); margin-bottom:6px; border:1px solid rgba(255,255,255,0.05);
}
.fiche-wallet-badge {
  display:inline-flex; align-items:center; gap:8px;
  background:linear-gradient(90deg,rgba(212,168,0,0.15),rgba(26,107,58,0.15));
  border:1px solid rgba(212,168,0,0.35); border-radius:8px;
  padding:10px 16px; font-size:14px; font-weight:700; color:var(--or);
}
@media print {
  nav, .modal-overlay:not(#modalFiche) { display:none !important; }
  #modalFiche { position:static !important; background:white !important; }
  .fiche-header { background:white !important; color:#000 !important; }
}
</style>

<script>
// ══════════════════════════════════════════════════════════════════
// CTL — MODULE PORTEFEUILLE + FICHE + BILLET TIERS
// ══════════════════════════════════════════════════════════════════

var CTL_LOGO_URI = '';

function getWallet(email) {
  try {
    var key = 'ctl_wallet_' + btoa(unescape(encodeURIComponent(email||'guest'))).replace(/=/g,'');
    return JSON.parse(localStorage.getItem(key) || 'null') || { solde: 0, transactions: [] };
  } catch(e) { return { solde: 0, transactions: [] }; }
}
function saveWallet(email, wallet) {
  try {
    var key = 'ctl_wallet_' + btoa(unescape(encodeURIComponent(email||'guest'))).replace(/=/g,'');
    localStorage.setItem(key, JSON.stringify(wallet));
  } catch(e) {}
}
function getWalletId(email) {
  if(!email) return '';
  var hash = 0;
  for(var i=0;i<email.length;i++) hash = ((hash<<5)-hash)+email.charCodeAt(i)|0;
  return 'CTL' + Math.abs(hash).toString(36).toUpperCase().padStart(8,'0');
}

// ── OUVRIR PORTEFEUILLE ──
function ouvrirWallet() {
  var sess = getSession();
  if(!sess) { ouvrirModalConnexion(); return; }
  renderWalletMain(sess);
  document.getElementById('modalWallet').classList.add('open');
  document.body.style.overflow='hidden';
}
function fermerWallet() {
  document.getElementById('modalWallet').classList.remove('open');
  document.body.style.overflow='';
}

function renderWalletMain(sess) {
  var wallet = getWallet(sess.email);
  var wid = getWalletId(sess.email);
  var txs = wallet.transactions || [];
  var txHtml = txs.length === 0
    ? '<div style="text-align:center;padding:32px;color:rgba(255,255,255,0.3);font-size:13px;">Aucune transaction pour le moment.</div>'
    : txs.slice(0,15).map(function(tx){
        var ico = tx.type==='credit'?'⬆️':'⬇️';
        var cls = tx.type==='credit'?'credit':'debit';
        var sign = tx.type==='credit'?'+':'-';
        return '<div class="wallet-tx-item"><span class="wallet-tx-icon">'+ico+'</span><div class="wallet-tx-info"><div class="wallet-tx-label">'+tx.label+'</div><div class="wallet-tx-date">'+tx.date+(tx.mode?' · '+tx.mode:'')+'</div></div><span class="wallet-tx-amount '+cls+'">'+sign+(tx.montant||0).toLocaleString('fr-FR')+' F</span></div>';
      }).join('');

  document.getElementById('modalWalletBox').innerHTML = [
    '<div style="padding:0;">',
    '<div class="wallet-balance-card">',
      
      '<div style="font-size:11px;color:rgba(255,255,255,0.5);letter-spacing:2px;text-transform:uppercase;">Portefeuille CTL</div>',
      '<div style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:2px;">ID : <span style="color:var(--or);font-family:JetBrains Mono,monospace;letter-spacing:2px;">'+wid+'</span></div>',
      '<div class="wallet-amount">'+wallet.solde.toLocaleString('fr-FR')+' <span style="font-size:18px;font-weight:400;color:rgba(255,255,255,0.6);">FCFA</span></div>',
      '<div style="font-size:12px;color:rgba(255,255,255,0.5);">'+sess.prenom+' '+sess.nom+' · '+sess.email+'</div>',
    '</div>',
    '<div style="padding:0 24px;">',
      '<div class="wallet-actions-grid">',
        '<div class="wallet-action-btn" onclick="walletRecharger()"><span class="wa-icon">💰</span><span class="wa-label">Recharger</span></div>',
        '<div class="wallet-action-btn" onclick="walletRetirer()"><span class="wa-icon">🏦</span><span class="wa-label">Retirer</span></div>',
        '<div class="wallet-action-btn" onclick="walletTransferer()"><span class="wa-icon">↔️</span><span class="wa-label">Transférer</span></div>',
        '<div class="wallet-action-btn" onclick="fermerWallet();setTimeout(function(){window.scrollTo({top:0,behavior:&quot;smooth&quot;});},200)"><span class="wa-icon">🎫</span><span class="wa-label">Acheter billet</span></div>',
      '</div>',
      '<div style="font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:12px;">Historique des transactions</div>',
      '<div class="wallet-tx-list">'+txHtml+'</div>',
      '<div style="padding:20px 0;"><button onclick="fermerWallet()" style="width:100%;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);padding:12px;border-radius:8px;font-family:Outfit,sans-serif;font-size:13px;cursor:pointer;">Fermer</button></div>',
    '</div></div>'
  ].join('');
}

function walletRecharger() {
  var sess = getSession(); if(!sess) return;
  window._walletMethod = 'mtn';
  document.getElementById('modalWalletBox').innerHTML = [
    '<div style="padding:28px;">',
    '<div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">',
      '<button onclick="ouvrirWallet()" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:18px;cursor:pointer;">←</button>',
      '<div><div style="font-size:18px;font-weight:700;">💰 Recharger le portefeuille</div><div style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:2px;">Choisissez votre méthode et le montant</div></div>',
    '</div>',
    '<div style="margin-bottom:20px;">',
      '<label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:10px;">MÉTHODE DE RECHARGE</label>',
      '<div class="wallet-method-item selected" id="wm-mtn" onclick="selectWalletMethod(\'mtn\')"><span style="display:flex;align-items:center;gap:10px;font-weight:700;">📱 MTN Mobile Money</span><span id="wm-mtn-chk" style="font-size:18px;color:var(--or);">✓</span></div>',
      '<div class="wallet-method-item" id="wm-orange" onclick="selectWalletMethod(\'orange\')"><span style="display:flex;align-items:center;gap:10px;font-weight:700;">🟠 Orange Money</span><span id="wm-orange-chk" style="font-size:18px;color:transparent;">✓</span></div>',
      '<div class="wallet-method-item" id="wm-visa" onclick="selectWalletMethod(\'visa\')"><span style="display:flex;align-items:center;gap:10px;font-weight:700;">💳 Visa / Mastercard</span><span id="wm-visa-chk" style="font-size:18px;color:transparent;">✓</span></div>',
    '</div>',
    '<div style="margin-bottom:20px;">',
      '<label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:8px;">MONTANT RAPIDE (FCFA)</label>',
      '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;">',
        '[5000,10000,25000,50000].map(m => btn)',
      '</div>',
      '<input type="number" id="wRechargeAmt" placeholder="Autre montant…" min="500" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px 14px;color:#fff;font-family:Outfit,sans-serif;font-size:16px;outline:none;">',
    '</div>',
    '<div id="wm-numero-zone" style="margin-bottom:20px;">',
      '<label id="wm-num-label" style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:8px;">NUMÉRO MTN MOMO</label>',
      '<input type="tel" id="wRechargeNum" placeholder="6XX XXX XXX" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px 14px;color:#fff;font-family:Outfit,sans-serif;font-size:16px;outline:none;">',
    '</div>',
    '<button onclick="confirmerRecharge()" style="width:100%;background:linear-gradient(135deg,var(--vert),var(--vert2));border:none;color:#fff;padding:14px;border-radius:8px;font-family:Outfit,sans-serif;font-size:14px;font-weight:700;cursor:pointer;">Confirmer la recharge →</button>',
    '</div>'
  ].join('');

  // Boutons montants rapides
  var btnsZone = document.querySelector('#wRechargeAmt').previousElementSibling;
  btnsZone.innerHTML = [5000,10000,25000,50000].map(function(m){
    return '<button onclick="document.getElementById(\'wRechargeAmt\').value='+m+'" style="background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);padding:8px 14px;border-radius:6px;font-family:Outfit,sans-serif;font-size:13px;cursor:pointer;">'+m.toLocaleString('fr-FR')+' F</button>';
  }).join('');
}

function selectWalletMethod(m) {
  window._walletMethod = m;
  ['mtn','orange','visa'].forEach(function(k){
    var el = document.getElementById('wm-'+k);
    var chk = document.getElementById('wm-'+k+'-chk');
    if(el) el.classList.toggle('selected', k===m);
    if(chk) chk.style.color = k===m ? 'var(--or)' : 'transparent';
  });
  var lbl = document.getElementById('wm-num-label');
  if(lbl) lbl.textContent = m==='mtn'?'NUMÉRO MTN MOMO':m==='orange'?'NUMÉRO ORANGE MONEY':'NUMÉRO DE CARTE';
}

function confirmerRecharge() {
  var sess = getSession(); if(!sess) return;
  var amt = parseInt(document.getElementById('wRechargeAmt')?.value||0);
  var num = (document.getElementById('wRechargeNum')?.value||'').trim();
  if(!amt || amt < 500) { alert('⚠️ Montant minimum : 500 FCFA'); return; }
  if(amt > 5000000) { alert('⚠️ Montant maximum : 5 000 000 FCFA'); return; }
  if(!num) { alert('⚠️ Veuillez saisir votre numéro.'); return; }
  if(window._walletMethod!=='visa'){var wNumClean=num.replace(/[\s\-\.]/g,'');if(!/^(\+237)?[26][0-9]{7,8}$/.test(wNumClean)){alert('⚠️ Numéro de téléphone invalide.');return;}}
  var wallet = getWallet(sess.email);
  wallet.solde += amt;
  var modeLabel = window._walletMethod==='mtn'?'MTN MoMo':window._walletMethod==='orange'?'Orange Money':'Carte bancaire';
  wallet.transactions.unshift({ type:'credit', label:'Recharge via '+modeLabel, montant:amt, mode:modeLabel, date:new Date().toLocaleDateString('fr-FR') });
  saveWallet(sess.email, wallet);
  showToast('✅ Recharge de '+amt.toLocaleString('fr-FR')+' FCFA effectuée !');
  if(typeof addNotif==='function') addNotif('💰','Recharge de '+amt.toLocaleString('fr-FR')+' FCFA via '+modeLabel+'.');
  renderWalletMain(sess);
}

function walletRetirer() {
  var sess = getSession(); if(!sess) return;
  var wallet = getWallet(sess.email);
  window._retraitMethod = 'mtn';
  document.getElementById('modalWalletBox').innerHTML = [
    '<div style="padding:28px;">',
    '<div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">',
      '<button onclick="ouvrirWallet()" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:18px;cursor:pointer;">←</button>',
      '<div><div style="font-size:18px;font-weight:700;">🏦 Retirer des fonds</div><div style="font-size:12px;color:rgba(255,255,255,0.4);">Solde disponible : <strong style="color:var(--or)">'+wallet.solde.toLocaleString('fr-FR')+' FCFA</strong></div></div>',
    '</div>',
    '<div style="margin-bottom:20px;">',
      '<label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:10px;">VERS</label>',
      '<div class="wallet-method-item selected" id="wr-mtn" onclick="selectRetrait(\'mtn\')"><span>📱 MTN Mobile Money</span><span id="wr-mtn-chk" style="color:var(--or);">✓</span></div>',
      '<div class="wallet-method-item" id="wr-orange" onclick="selectRetrait(\'orange\')"><span>🟠 Orange Money</span><span id="wr-orange-chk" style="color:transparent;">✓</span></div>',
      '<div class="wallet-method-item" id="wr-visa" onclick="selectRetrait(\'visa\')"><span>💳 Compte bancaire</span><span id="wr-visa-chk" style="color:transparent;">✓</span></div>',
    '</div>',
    '<div style="margin-bottom:16px;"><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:8px;">NUMÉRO / COMPTE</label><input type="tel" id="wRetraitNum" placeholder="6XX XXX XXX" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px 14px;color:#fff;font-family:Outfit,sans-serif;font-size:16px;outline:none;"></div>',
    '<div style="margin-bottom:20px;"><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:8px;">MONTANT (FCFA)</label><input type="number" id="wRetraitAmt" placeholder="Montant à retirer" min="500" max="'+wallet.solde+'" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px 14px;color:#fff;font-family:Outfit,sans-serif;font-size:16px;outline:none;"><div style="font-size:11px;color:rgba(255,255,255,0.3);margin-top:6px;">Frais de retrait : 100 FCFA</div></div>',
    '<button onclick="confirmerRetrait()" style="width:100%;background:linear-gradient(135deg,#af020b,#ce1126);border:none;color:#fff;padding:14px;border-radius:8px;font-family:Outfit,sans-serif;font-size:14px;font-weight:700;cursor:pointer;">Confirmer le retrait →</button>',
    '</div>'
  ].join('');
}
function selectRetrait(m) {
  window._retraitMethod = m;
  ['mtn','orange','visa'].forEach(function(k){
    var el=document.getElementById('wr-'+k);
    var chk=document.getElementById('wr-'+k+'-chk');
    if(el) el.classList.toggle('selected',k===m);
    if(chk) chk.style.color = k===m?'var(--or)':'transparent';
  });
}
function confirmerRetrait() {
  var sess = getSession(); if(!sess) return;
  var amt = parseInt(document.getElementById('wRetraitAmt')?.value||0);
  var num = (document.getElementById('wRetraitNum')?.value||'').trim();
  if(!amt || amt < 500) { alert('⚠️ Montant minimum : 500 FCFA'); return; }
  if(!num) { alert('⚠️ Veuillez saisir le numéro destinataire.'); return; }
  var wallet = getWallet(sess.email);
  var total = amt + 100;
  if(wallet.solde < total) { alert('⚠️ Solde insuffisant ('+wallet.solde.toLocaleString('fr-FR')+' FCFA disponible).'); return; }
  wallet.solde -= total;
  var modeLabel = window._retraitMethod==='mtn'?'MTN MoMo':window._retraitMethod==='orange'?'Orange Money':'Compte bancaire';
  wallet.transactions.unshift({type:'debit',label:'Retrait vers '+modeLabel,montant:total,mode:modeLabel,date:new Date().toLocaleDateString('fr-FR')});
  saveWallet(sess.email, wallet);
  showToast('✅ Retrait de '+amt.toLocaleString('fr-FR')+' FCFA effectué !');
  renderWalletMain(sess);
}

function walletTransferer() {
  var sess = getSession(); if(!sess) return;
  var wallet = getWallet(sess.email);
  document.getElementById('modalWalletBox').innerHTML = [
    '<div style="padding:28px;">',
    '<div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">',
      '<button onclick="ouvrirWallet()" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:18px;cursor:pointer;">←</button>',
      '<div><div style="font-size:18px;font-weight:700;">↔️ Transfert entre comptes CTL</div><div style="font-size:12px;color:rgba(255,255,255,0.4);">Solde : <strong style="color:var(--or)">'+wallet.solde.toLocaleString('fr-FR')+' FCFA</strong></div></div>',
    '</div>',
    '<div style="background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.2);border-radius:8px;padding:14px 16px;margin-bottom:20px;font-size:12px;color:rgba(255,255,255,0.5);">💡 Entrez le <strong style="color:var(--or)">numéro de téléphone</strong> ou l&#39;<strong style="color:var(--or)">identifiant CTL</strong> du destinataire.</div>',
    '<div style="margin-bottom:16px;"><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:8px;">DESTINATAIRE (N° tél ou ID CTL)</label><input type="text" id="wTransfertDest" placeholder="Ex: 691234567 ou CTL-XXXXXXXX" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px 14px;color:#fff;font-family:Outfit,sans-serif;font-size:15px;outline:none;"></div>',
    '<div style="margin-bottom:16px;"><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:8px;">MONTANT (FCFA)</label><input type="number" id="wTransfertAmt" placeholder="Montant à transférer" min="100" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px 14px;color:#fff;font-family:Outfit,sans-serif;font-size:16px;outline:none;"></div>',
    '<div style="margin-bottom:20px;"><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1.5px;display:block;margin-bottom:8px;">MOTIF (optionnel)</label><input type="text" id="wTransfertMotif" placeholder="Ex: Billet Bamenda" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:12px 14px;color:#fff;font-family:Outfit,sans-serif;font-size:14px;outline:none;"></div>',
    '<button onclick="confirmerTransfert()" style="width:100%;background:linear-gradient(135deg,var(--vert),var(--vert2));border:none;color:#fff;padding:14px;border-radius:8px;font-family:Outfit,sans-serif;font-size:14px;font-weight:700;cursor:pointer;">Envoyer →</button>',
    '</div>'
  ].join('');
}
function confirmerTransfert() {
  var sess = getSession(); if(!sess) return;
  var dest = (document.getElementById('wTransfertDest')?.value||'').trim();
  var amt = parseInt(document.getElementById('wTransfertAmt')?.value||0);
  var motif = (document.getElementById('wTransfertMotif')?.value||'').trim()||'Transfert CTL';
  if(!dest) { alert('⚠️ Veuillez saisir un destinataire.'); return; }
  if(!amt || amt < 100) { alert('⚠️ Montant minimum : 100 FCFA'); return; }
  var wallet = getWallet(sess.email);
  if(wallet.solde < amt) { alert('⚠️ Solde insuffisant.'); return; }
  wallet.solde -= amt;
  wallet.transactions.unshift({type:'debit',label:'Transfert vers '+dest+' · '+motif,montant:amt,mode:'CTL Transfer',date:new Date().toLocaleDateString('fr-FR')});
  saveWallet(sess.email, wallet);
  showToast('✅ Transfert de '+amt.toLocaleString('fr-FR')+' FCFA envoyé vers '+dest+' !');
  if(typeof addNotif==='function') addNotif('↔️','Transfert de '+amt.toLocaleString('fr-FR')+' FCFA vers '+dest+'.');
  renderWalletMain(sess);
}

// ══════════════════════════════════════════════════════════════════
// CTL — FICHE DE RENSEIGNEMENT
// ══════════════════════════════════════════════════════════════════
function ouvrirFiche() {
  var sess = getSession();
  if(!sess) { ouvrirModalConnexion(); return; }
  var billets = getBillets().filter(function(b){return b.email===sess.email;});
  var wallet = getWallet(sess.email);
  var wid = getWalletId(sess.email);
  var totalDep = billets.reduce(function(s,b){return s+(b.prix||0);},0);
  var totalKm  = billets.reduce(function(s,b){return s+(b.km||0);},0);
  var initiales = ((sess.prenom||'?')[0]+(sess.nom||'?')[0]).toUpperCase();
  var photoHtml = sess.photo
    ? '<img src="'+sess.photo+'" alt="Photo" style="width:80px;height:80px;object-fit:cover;">'
    : '<span style="font-size:28px;font-weight:700;">'+initiales+'</span>';

  var trajetsHtml = billets.length===0
    ? '<div style="text-align:center;padding:24px;color:rgba(255,255,255,0.3);">Aucun trajet enregistré.</div>'
    : billets.slice(0,10).map(function(b){
        return '<div class="fiche-trajet-item"><span style="font-size:18px;">🎫</span><div style="flex:1;"><div style="font-size:13px;font-weight:700;">'+escapeHtml(b.dep)+' → '+escapeHtml(b.arr)+'</div><div style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:2px;">'+escapeHtml(b.date)+' · '+escapeHtml(b.heure)+' · '+escapeHtml(b.nomPassager||b.chauffeur||'')+'</div></div><div style="text-align:right;"><div style="font-size:13px;font-weight:700;color:var(--or)">'+(b.prix||0).toLocaleString('fr-FR')+' F</div><span style="font-size:10px;padding:2px 8px;border-radius:100px;background:rgba(45,146,85,0.15);border:1px solid rgba(45,146,85,0.3);color:#2d9255;">'+escapeHtml(b.statut||'Confirmé')+'</span></div></div>';
      }).join('');

  document.getElementById('modalFicheBox').innerHTML = [
    '<div>',
    '<div class="fiche-header">',
      
      '<div class="fiche-brand"><div class="fiche-brand-name">CAMEROON TERRE LINE</div><div class="fiche-brand-sub">Fiche de renseignement officielle</div><div style="font-size:11px;color:rgba(255,255,255,0.35);margin-top:4px;">ID : <span style="color:var(--or);font-family:JetBrains Mono,monospace;">'+wid+'</span></div></div>',
      '<div class="fiche-avatar">'+photoHtml+'</div>',
      '<button onclick="document.getElementById(\'modalFiche\').classList.remove(\'open\');document.body.style.overflow=\'\'" style="position:absolute;top:16px;right:20px;background:transparent;border:none;color:rgba(255,255,255,0.4);font-size:20px;cursor:pointer;">✕</button>',
    '</div>',
    '<div class="fiche-body">',
      '<div class="fiche-wallet-badge" style="margin-bottom:18px;">💰 Solde portefeuille : <strong>'+wallet.solde.toLocaleString('fr-FR')+' FCFA</strong></div>',
      '<div class="fiche-section-title">Informations personnelles</div>',
      '<div class="fiche-grid">',
        '<div class="fiche-item"><div class="fiche-item-label">Prénom</div><div class="fiche-item-value">'+escapeHtml(sess.prenom||'—')+'</div></div>',
        '<div class="fiche-item"><div class="fiche-item-label">Nom</div><div class="fiche-item-value">'+escapeHtml(sess.nom||'—')+'</div></div>',
        '<div class="fiche-item"><div class="fiche-item-label">Date de naissance</div><div class="fiche-item-value">'+escapeHtml(sess.ddn||'—')+'</div></div>',
        '<div class="fiche-item"><div class="fiche-item-label">Téléphone</div><div class="fiche-item-value">'+escapeHtml(sess.tel||'—')+'</div></div>',
        '<div class="fiche-item"><div class="fiche-item-label">Email</div><div class="fiche-item-value" style="font-size:12px;">'+escapeHtml(sess.email||'—')+'</div></div>',
        '<div class="fiche-item"><div class="fiche-item-label">Ville</div><div class="fiche-item-value">'+escapeHtml(sess.ville||'—')+'</div></div>',
        '<div class="fiche-item"><div class="fiche-item-label">Catégorie</div><div class="fiche-item-value">'+escapeHtml(sess.categorie||'Passager')+'</div></div>',
        '<div class="fiche-item"><div class="fiche-item-label">Membre depuis</div><div class="fiche-item-value">'+(sess.createdAt||new Date().toLocaleDateString('fr-FR'))+'</div></div>',
      '</div>',
      '<div class="fiche-section-title">Statistiques de voyage</div>',
      '<div class="fiche-stats-row">',
        '<div class="fiche-stat"><div class="v">'+billets.length+'</div><div class="l">Trajets effectués</div></div>',
        '<div class="fiche-stat"><div class="v">'+totalKm.toLocaleString('fr-FR')+'</div><div class="l">Kilomètres parcourus</div></div>',
        '<div class="fiche-stat"><div class="v">'+totalDep.toLocaleString('fr-FR')+'</div><div class="l">FCFA dépensés</div></div>',
      '</div>',
      '<div class="fiche-section-title">Historique des trajets ('+billets.length+')</div>',
      trajetsHtml,
      '<div class="fiche-section-title">Photo de profil</div>',
      '<div style="display:flex;align-items:center;gap:16px;">',
        '<div style="width:64px;height:64px;border-radius:50%;border:2px solid var(--or);overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:22px;background:rgba(26,107,58,0.3);">'+photoHtml+'</div>',
        '<div><input type="file" id="fichePhotoInput" accept="image/*" style="display:none" onchange="uploadFichePhoto(this)"><button onclick="document.getElementById(\'fichePhotoInput\').click()" style="background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.35);color:var(--or);padding:10px 18px;border-radius:6px;font-family:Outfit,sans-serif;font-size:13px;font-weight:600;cursor:pointer;">📷 Changer la photo</button><div style="font-size:11px;color:rgba(255,255,255,0.3);margin-top:6px;">Format : JPG, PNG — Max 2 Mo</div></div>',
      '</div>',
      '<div style="padding:20px 0 4px;">',
        '<button onclick="imprimerFiche()" style="background:rgba(26,107,58,0.15);border:1px solid rgba(26,107,58,0.4);color:#2d9255;padding:11px 20px;border-radius:6px;font-family:Outfit,sans-serif;font-size:13px;font-weight:600;cursor:pointer;margin-right:10px;">🖨️ Imprimer la fiche</button>',
        '<button onclick="document.getElementById(\'modalFiche\').classList.remove(\'open\');document.body.style.overflow=\'\'" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);padding:11px 20px;border-radius:6px;font-family:Outfit,sans-serif;font-size:13px;cursor:pointer;">Fermer</button>',
      '</div>',
    '</div></div>'
  ].join('');

  document.getElementById('modalFiche').classList.add('open');
  document.body.style.overflow='hidden';
}
function uploadFichePhoto(input) {
  var file = input.files[0]; if(!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var sess = getSession(); if(!sess) return;
    sess.photo = e.target.result;
    setSession(sess);
    showToast('✅ Photo de profil mise à jour !');
    ouvrirFiche();
  };
  reader.readAsDataURL(file);
}
function imprimerFiche() { window.print(); }

// ══════════════════════════════════════════════════════════════════
// CTL — ACHAT BILLET POUR UN TIERS
// ══════════════════════════════════════════════════════════════════
var _billetTiersData = {};

function ouvrirBilletTiers(dep, arr, heure, prix, chauffeur) {
  _billetTiersData = { dep:dep, arr:arr, heure:heure, prix:prix, chauffeur:chauffeur };
  var sess = getSession();
  if(!sess) { alert("⚠️ Connectez-vous d&#39;abord pour acheter un billet pour un tiers."); ouvrirModalConnexion(); return; }
  var wallet = getWallet(sess.email);
  document.getElementById('modalBilletTiersBox').innerHTML = [
    '<div style="padding:28px;">',
    '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;">',
      '<div><div style="font-size:18px;font-weight:700;">🎫 Acheter un billet pour un tiers</div><div style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:3px;">'+escapeHtml(dep)+' → '+escapeHtml(arr)+' · '+escapeHtml(heure)+' · <strong style="color:var(--or)">'+parseInt(prix).toLocaleString('fr-FR')+' FCFA</strong></div></div>',
      '<button onclick="document.getElementById(\'modalBilletTiers\').classList.remove(\'open\');document.body.style.overflow=\'\'" style="background:transparent;border:none;color:rgba(255,255,255,0.5);font-size:20px;cursor:pointer;">✕</button>',
    '</div>',
    '<div style="background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.22);border-radius:10px;padding:14px 16px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;">',
      '<span style="font-size:13px;color:rgba(255,255,255,0.6);">💰 Votre solde portefeuille</span>',
      '<span style="font-size:18px;font-weight:700;color:var(--or)">'+wallet.solde.toLocaleString('fr-FR')+' FCFA</span>',
    '</div>',
    '<div style="font-size:11px;font-weight:700;color:var(--or);letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;">INFORMATIONS DU BÉNÉFICIAIRE</div>',
    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">',
      '<div><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1px;display:block;margin-bottom:6px;">PRÉNOM *</label><input type="text" id="tiers-prenom" placeholder="Prénom du passager" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:11px 12px;color:#fff;font-family:Outfit,sans-serif;font-size:14px;outline:none;"></div>',
      '<div><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1px;display:block;margin-bottom:6px;">NOM *</label><input type="text" id="tiers-nom" placeholder="Nom du passager" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:11px 12px;color:#fff;font-family:Outfit,sans-serif;font-size:14px;outline:none;"></div>',
    '</div>',
    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">',
      '<div><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1px;display:block;margin-bottom:6px;">TÉLÉPHONE *</label><input type="tel" id="tiers-tel" placeholder="6XX XXX XXX" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:11px 12px;color:#fff;font-family:Outfit,sans-serif;font-size:14px;outline:none;"></div>',
      '<div><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1px;display:block;margin-bottom:6px;">EMAIL</label><input type="email" id="tiers-email" placeholder="email@exemple.com" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:11px 12px;color:#fff;font-family:Outfit,sans-serif;font-size:14px;outline:none;"></div>',
    '</div>',
    '<div style="margin-bottom:20px;"><label style="font-size:11px;color:var(--or);font-weight:700;letter-spacing:1px;display:block;margin-bottom:6px;">DATE DE NAISSANCE</label><input type="date" id="tiers-ddn" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:11px 12px;color:#fff;font-family:Outfit,sans-serif;font-size:14px;outline:none;"></div>',
    '<div style="background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.2);border-radius:8px;padding:12px 14px;margin-bottom:20px;font-size:12px;color:rgba(255,255,255,0.5);">ℹ️ Si le bénéficiaire n&#39;a pas de compte CTL, un compte sera automatiquement créé avec les informations saisies.</div>',
    '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding:14px 16px;background:rgba(255,255,255,0.03);border-radius:8px;"><span style="font-size:14px;font-weight:700;">Total à débiter</span><span style="font-size:22px;font-weight:900;color:var(--or);font-family:Playfair Display,serif;">'+parseInt(prix).toLocaleString('fr-FR')+' FCFA</span></div>',
    '<div style="display:flex;gap:10px;">',
      '<button onclick="document.getElementById(\'modalBilletTiers\').classList.remove(\'open\');document.body.style.overflow=\'\'" style="flex:1;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);padding:13px;border-radius:8px;font-family:Outfit,sans-serif;font-size:13px;cursor:pointer;">Annuler</button>',
      '<button onclick="confirmerBilletTiers()" style="flex:2;background:linear-gradient(135deg,var(--vert),var(--vert2));border:none;color:#fff;padding:13px;border-radius:8px;font-family:Outfit,sans-serif;font-size:14px;font-weight:700;cursor:pointer;">💳 Payer depuis mon portefeuille</button>',
    '</div>',
    '</div>'
  ].join('');
  document.getElementById('modalBilletTiers').classList.add('open');
  document.body.style.overflow='hidden';
}

function confirmerBilletTiers() {
  var sess = getSession(); if(!sess) return;
  var prenom = (document.getElementById('tiers-prenom')?.value||'').trim();
  var nom    = (document.getElementById('tiers-nom')?.value||'').trim();
  var tel    = (document.getElementById('tiers-tel')?.value||'').trim();
  var email  = (document.getElementById('tiers-email')?.value||'').trim();
  var ddn    = document.getElementById('tiers-ddn')?.value||'';
  if(!prenom||!nom||!tel){alert('⚠️ Prénom, Nom et Téléphone sont obligatoires.');return;}
  var d = _billetTiersData;
  var prix = parseInt(d.prix)||0;
  var wallet = getWallet(sess.email);
  if(wallet.solde < prix){
    alert('⚠️ Solde insuffisant ('+wallet.solde.toLocaleString('fr-FR')+' FCFA). Rechargez votre portefeuille.');
    document.getElementById('modalBilletTiers').classList.remove('open');
    document.body.style.overflow='';
    setTimeout(ouvrirWallet,300);
    return;
  }
  wallet.solde -= prix;
  wallet.transactions.unshift({type:'debit',label:'Billet tiers — '+prenom+' '+nom+' · '+d.dep+' → '+d.arr,montant:prix,mode:'Portefeuille CTL',date:new Date().toLocaleDateString('fr-FR')});
  saveWallet(sess.email, wallet);
  // Créer compte tiers si email fourni et non existant
  if(email){
    var tiersKey = 'ctl_compte_'+email.replace(/[^a-z0-9]/gi,'_');
    if(!localStorage.getItem(tiersKey)){
      var tiers = {prenom:prenom,nom:nom,tel:tel,email:email,ddn:ddn,categorie:'Passager',createdAt:new Date().toLocaleDateString('fr-FR'),createdBy:sess.email};
      try{localStorage.setItem(tiersKey,JSON.stringify(tiers));}catch(e){}
    }
  }
  // Générer le billet
  var ref = 'CTL-T-'+Math.random().toString(36).substr(2,6).toUpperCase();
  var billets = getBillets();
  billets.unshift({ref:ref,dep:d.dep,arr:d.arr,heure:d.heure,prix:prix,chauffeur:d.chauffeur||'',date:new Date().toLocaleDateString('fr-FR'),statut:'confirme',email:email||sess.email+'_tiers',nomPassager:prenom+' '+nom,tel:tel,achetePar:sess.email,km:200});
  saveBillets(billets);
  if(typeof addNotif==='function') addNotif('🎫','Billet acheté pour '+prenom+' '+nom+' — '+d.dep+' → '+d.arr+' (Ref: '+ref+')');
  document.getElementById('modalBilletTiersBox').innerHTML = [
    '<div style="padding:40px 28px;text-align:center;">',
    '<div style="font-size:60px;margin-bottom:16px;">✅</div>',
    '<div style="font-size:20px;font-weight:800;color:#fff;margin-bottom:8px;">Billet confirmé !</div>',
    '<div style="font-size:14px;color:rgba(255,255,255,0.5);margin-bottom:24px;">Billet acheté pour <strong style="color:#fff">'+prenom+' '+nom+'</strong><br>Ref : <span style="color:var(--or);font-family:JetBrains Mono,monospace;">'+ref+'</span></div>',
    '<div style="background:rgba(26,107,58,0.1);border:1px solid rgba(26,107,58,0.25);border-radius:10px;padding:18px;margin-bottom:24px;text-align:left;">',
      '<div style="font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:4px;">'+d.dep+' → '+d.arr+' · '+d.heure+'</div>',
      '<div style="font-size:16px;font-weight:700;">Passager : '+prenom+' '+nom+'</div>',
      '<div style="font-size:12px;color:rgba(255,255,255,0.5);margin-top:4px;">Téléphone : '+tel+'</div>',
      '<div style="font-size:18px;font-weight:700;color:var(--or);margin-top:8px;">'+prix.toLocaleString('fr-FR')+' FCFA</div>',
    '</div>',
    (email?'<div style="font-size:12px;color:rgba(255,255,255,0.4);margin-bottom:20px;">📧 Un compte CTL a été créé / associé pour '+email+'</div>':''),
    '<button onclick="document.getElementById(\'modalBilletTiers\').classList.remove(\'open\');document.body.style.overflow=\'\'" style="background:linear-gradient(135deg,var(--vert),var(--vert2));border:none;color:#fff;padding:13px 32px;border-radius:8px;font-family:Outfit,sans-serif;font-size:14px;font-weight:700;cursor:pointer;">Fermer</button>',
    '</div>'
  ].join('');
}

// ══════════════════════════════════════════════════════════════════
// CTL — INTÉGRATION DANS LA NAVBAR ET LE DASHBOARD
// ══════════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', function() {
  // Bouton portefeuille dans la nav
  var navRight = document.querySelector('.nav-right');
  if(navRight) {
    var wBtn = document.createElement('button');
    wBtn.id = 'navWalletBtn';
    wBtn.style.cssText = 'background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);padding:8px 14px;border-radius:4px;font-family:Outfit,sans-serif;font-size:12px;font-weight:700;cursor:pointer;margin-right:8px;display:none;';
    wBtn.innerHTML = '💰 Portefeuille';
    wBtn.onclick = ouvrirWallet;
    navRight.insertBefore(wBtn, navRight.firstChild);

    var fBtn = document.createElement('button');
    fBtn.id = 'navFicheBtn';
    fBtn.style.cssText = 'background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);padding:8px 14px;border-radius:4px;font-family:Outfit,sans-serif;font-size:12px;font-weight:600;cursor:pointer;margin-right:8px;display:none;';
    fBtn.innerHTML = '📋 Ma Fiche';
    fBtn.onclick = ouvrirFiche;
    navRight.insertBefore(fBtn, wBtn);
  }

  var sessInit = getSession();
  if(sessInit) {
    var wb=document.getElementById('navWalletBtn'); if(wb) wb.style.display='';
    var fb=document.getElementById('navFicheBtn');  if(fb) fb.style.display='';
  }

  // Patcher mettreAJourNav
  var _origNav = window.mettreAJourNav;
  if(_origNav) {
    window.mettreAJourNav = function() {
      _origNav();
      var s = getSession();
      var wb2=document.getElementById('navWalletBtn'); if(wb2) wb2.style.display=s?'':'none';
      var fb2=document.getElementById('navFicheBtn');  if(fb2) fb2.style.display=s?'':'none';
    };
  }

  // Patcher ouvrirDashboard pour ajouter onglets Portefeuille & Fiche
  var _origDash = window.ouvrirDashboard;
  if(_origDash) {
    window.ouvrirDashboard = function() {
      _origDash();
      setTimeout(function() {
        var tabs = document.querySelector('.dash-tabs');
        if(tabs && !document.getElementById('dash-tab-wallet')) {
          tabs.insertAdjacentHTML('beforeend',
            '<button class="dash-tab" id="dash-tab-wallet" onclick="switchDashTab(\'wallet\',this)">💰 Portefeuille</button>'+
            '<button class="dash-tab" id="dash-tab-fiche"  onclick="switchDashTab(\'fiche\',this)">📋 Ma Fiche</button>'
          );
        }
        var panels = document.querySelector('.dash-panels');
        if(!panels) {
          var existing = document.getElementById('dash-billets');
          if(existing) panels = existing.parentNode;
        }
        if(panels && !document.getElementById('dash-wallet')) {
          panels.insertAdjacentHTML('beforeend',
            '<div class="dash-panel" id="dash-wallet"><div id="dash-wallet-inner"></div></div>'+
            '<div class="dash-panel" id="dash-fiche"><div id="dash-fiche-inner"></div></div>'
          );
        }
      }, 150);
    };
  }

  // Patcher switchDashTab pour les nouveaux onglets
  var _origSwitch = window.switchDashTab;
  if(_origSwitch) {
    window.switchDashTab = function(name, btn) {
      _origSwitch(name, btn);
      var sess = getSession(); if(!sess) return;
      if(name==='wallet') {
        var z = document.getElementById('dash-wallet-inner'); if(!z) return;
        var w = getWallet(sess.email);
        var wid2 = getWalletId(sess.email);
        var txs = (w.transactions||[]).slice(0,8);
        var txsHtml = txs.length===0
          ? '<div style="text-align:center;padding:24px;color:rgba(255,255,255,0.3);">Aucune transaction.</div>'
          : txs.map(function(tx){
              var cls=tx.type==='credit'?'credit':'debit';
              var sign=tx.type==='credit'?'+':'-';
              var ico=tx.type==='credit'?'⬆️':'⬇️';
              return '<div class="wallet-tx-item"><span class="wallet-tx-icon">'+ico+'</span><div class="wallet-tx-info"><div class="wallet-tx-label">'+tx.label+'</div><div class="wallet-tx-date">'+tx.date+'</div></div><span class="wallet-tx-amount '+cls+'">'+sign+(tx.montant||0).toLocaleString('fr-FR')+' F</span></div>';
            }).join('');
        z.innerHTML = '<div style="padding:8px 0;"><div class="wallet-balance-card" style="margin-bottom:16px;"><img src="'+CTL_LOGO_URI+'" alt="CTL" class="wallet-logo-small"><div style="font-size:10px;color:rgba(255,255,255,0.5);letter-spacing:2px;text-transform:uppercase;">ID : <span style="color:var(--or);font-family:JetBrains Mono,monospace;">'+wid2+'</span></div><div class="wallet-amount">'+w.solde.toLocaleString('fr-FR')+' <span style="font-size:16px;font-weight:400;color:rgba(255,255,255,0.6);">FCFA</span></div></div><div class="wallet-actions-grid"><div class="wallet-action-btn" onclick="fermerDashboard();setTimeout(ouvrirWallet,300)"><span class="wa-icon">💰</span><span class="wa-label">Recharger</span></div><div class="wallet-action-btn" onclick="fermerDashboard();setTimeout(walletRetirer,300)"><span class="wa-icon">🏦</span><span class="wa-label">Retirer</span></div><div class="wallet-action-btn" onclick="fermerDashboard();setTimeout(walletTransferer,300)"><span class="wa-icon">↔️</span><span class="wa-label">Transférer</span></div><div class="wallet-action-btn" onclick="fermerDashboard();setTimeout(function(){window.scrollTo({top:0,behavior:"smooth"});},300)"><span class="wa-icon">🎫</span><span class="wa-label">Nouveau billet</span></div></div><div style="font-size:11px;font-weight:700;letter-spacing:2px;color:rgba(255,255,255,0.35);margin:16px 0 8px;">TRANSACTIONS RÉCENTES</div><div class="wallet-tx-list">'+txsHtml+'</div></div>';
      }
      if(name==='fiche') {
        var zf = document.getElementById('dash-fiche-inner'); if(!zf) return;
        var billets2 = getBillets().filter(function(b){return b.email===sess.email;});
        var w2 = getWallet(sess.email);
        var wid3 = getWalletId(sess.email);
        var td2 = billets2.reduce(function(s,b){return s+(b.prix||0);},0);
        var tk2 = billets2.reduce(function(s,b){return s+(b.km||0);},0);
        var init2 = ((sess.prenom||'?')[0]+(sess.nom||'?')[0]).toUpperCase();
        var ph2 = sess.photo?'<img src="'+sess.photo+'" style="width:60px;height:60px;border-radius:50%;object-fit:cover;">':'<span style="font-size:22px;font-weight:700;">'+init2+'</span>';
        zf.innerHTML = '<div style="padding:8px 0;"><div style="display:flex;align-items:center;gap:16px;margin-bottom:20px;padding:16px;background:rgba(26,107,58,0.1);border:1px solid rgba(26,107,58,0.25);border-radius:12px;"><div style="width:60px;height:60px;border-radius:50%;border:2px solid var(--or);overflow:hidden;display:flex;align-items:center;justify-content:center;background:rgba(26,107,58,0.3);">'+ph2+'</div><div style="flex:1;"><div style="font-size:18px;font-weight:700;">'+sess.prenom+' '+sess.nom+'</div><div style="font-size:12px;color:rgba(255,255,255,0.5);">'+(sess.categorie||'Passager')+' · ID '+wid3+'</div><div class="fiche-wallet-badge" style="margin-top:8px;font-size:12px;padding:6px 12px;">💰 '+w2.solde.toLocaleString('fr-FR')+' FCFA</div></div><button onclick="ouvrirFiche()" style="background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);padding:10px 14px;border-radius:6px;font-family:Outfit,sans-serif;font-size:12px;font-weight:600;cursor:pointer;">Voir fiche complète</button></div><div class="fiche-stats-row"><div class="fiche-stat"><div class="v">'+billets2.length+'</div><div class="l">Trajets</div></div><div class="fiche-stat"><div class="v">'+tk2.toLocaleString('fr-FR')+'</div><div class="l">Km parcourus</div></div><div class="fiche-stat"><div class="v">'+td2.toLocaleString('fr-FR')+'</div><div class="l">FCFA dépensés</div></div></div></div>';
      }
    };
  }
});

// ══ PATCH confirmerReservation — débit du portefeuille si soldé ══
// On patche pour proposer le paiement par portefeuille
var _origConfirmResa2 = window.confirmerReservation;
if(_origConfirmResa2) {
  window.confirmerReservation = function(dep, arr, heure, prix, chauffeur) {
    var sess = getSession();
    if(sess) {
      var wallet = getWallet(sess.email);
      if(wallet.solde >= parseInt(prix||0)) {
        if(confirm('💰 Payer '+parseInt(prix).toLocaleString('fr-FR')+' FCFA depuis votre portefeuille CTL (solde : '+wallet.solde.toLocaleString('fr-FR')+' FCFA) ?\n\nCliquez OK pour payer par portefeuille, Annuler pour payer autrement.')) {
          wallet.solde -= parseInt(prix);
          wallet.transactions.unshift({type:'debit',label:'Billet '+dep+' → '+arr,montant:parseInt(prix),mode:'Portefeuille CTL',date:new Date().toLocaleDateString('fr-FR')});
          saveWallet(sess.email, wallet);
          _origConfirmResa2(dep, arr, heure, prix, chauffeur);
          return;
        }
      }
    }
    _origConfirmResa2(dep, arr, heure, prix, chauffeur);
  };
}
</script>

  <!-- ══ CTL API CLIENT v6 ══ -->
  <script>
    window.CTL_API_URL = window.location.hostname === 'localhost' ? "http://localhost:3000/api" : "https://" + window.location.hostname + "/api";
    window.CTL_WS_URL  = window.location.hostname === 'localhost' ? "ws://localhost:3000/ws/gps" : "wss://" + window.location.hostname + "/ws/gps";
  </script>
  <!-- Scripts chargés de façon non-bloquante -->
  <script>
  (function() {
    var exts = [
      "js/ctl-api-client.js",
      "js/ctl-camera.js",
      "js/ctl-payments.js",
      "js/ctl-fcm.js",
      "js/ctl-auth-refresh.js",
      "js/ctl-sync.js",
      "js/ctl-offline.js",
      "js/ctl-client-api.js",
      "js/ctl-i18n.js",
      "js/ctl-transactions.js"
    ];
    exts.forEach(function(src) {
      var s = document.createElement("script");
      s.src = src;
      s.async = true;
      s.onerror = function() {};
      document.body.appendChild(s);
    });
  })();
  </script>
<script>
// ── Consentement CTL — Loi n°2010/012 Cameroun ──
// Dans la politique de confidentialité, les cases sont informatives
// La validation bloque le bouton "J'ai compris" si non cochées
(function(){
  var origClose = window._closePrivacy;
  // Intercepter le clic "J'ai compris"
  document.addEventListener('click', function(e){
    var btn = e.target;
    if(btn && btn.textContent && btn.textContent.trim() === "J'ai compris ✓") {
      var c1=document.getElementById('cc-cgu'), c2=document.getElementById('cc-consent'), er=document.getElementById('cc-consent-err');
      if(c1&&c2&&(!c1.checked||!c2.checked)){
        if(er)er.style.display='block';
        if(c1&&!c1.checked)c1.style.outline='2px solid #ff6b6b';
        if(c2&&!c2.checked)c2.style.outline='2px solid #ff6b6b';
        e.stopImmediatePropagation();
        e.preventDefault();
        return false;
      }
    }
  }, true);
})();
</script>
<!-- ══ MODAL MESSAGERIE CHAUFFEUR-PASSAGER ══ -->
<div class="modal-overlay" id="modalMsg">
  <div class="modal-box" style="max-width:480px;max-height:85vh;display:flex;flex-direction:column;">
    <div class="modal-header" id="msgHeader">
      <div>
        <div class="mh-title">💬 Messagerie</div>
        <div class="mh-sub" id="msgSub">Chauffeur CTL</div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;">
        <button id="msgCallBtn" onclick="appelerDepuisMsg()" style="background:rgba(45,146,85,0.2);border:1px solid rgba(45,146,85,0.4);color:var(--vert2);width:36px;height:36px;border-radius:50%;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;" title="Appeler">📞</button>
        <button class="modal-close" onclick="fermerMsg()">✕</button>
      </div>
    </div>
    <div id="msgRefBanner" style="padding:8px 28px;background:rgba(212,168,0,0.06);border-bottom:1px solid rgba(212,168,0,0.15);font-size:11px;color:rgba(255,255,255,0.45);display:flex;align-items:center;gap:8px;">
      <span>🎫</span> <span id="msgRefText">Réf: —</span>
    </div>
    <div id="msgChat" style="flex:1;overflow-y:auto;padding:16px 24px;display:flex;flex-direction:column;gap:10px;min-height:200px;">
      <div class="sc-msg bot">👋 Bienvenue dans la messagerie CTL. Vous pouvez échanger avec votre chauffeur concernant votre trajet.<br><br><em style="color:rgba(255,255,255,0.35);font-size:11px;">Messages conservés pour la durée du trajet.</em></div>
    </div>
    <div style="padding:12px 24px 20px;border-top:1px solid rgba(255,255,255,0.07);">
      <div class="sc-input-row">
        <input type="text" id="msgInput" class="sc-input" placeholder="Votre message..." onkeydown="if(event.key==='Enter') envoyerMsg()">
        <button class="sc-send" onclick="envoyerMsg()">Envoyer</button>
      </div>
    </div>
  </div>
</div>

<script>
// ══ MESSAGERIE CHAUFFEUR-PASSAGER ══
var _msgRef = '';
var _msgChauffeur = '';
var _msgTel = '';

function ouvrirMsgBillet(ref, chauffeur) {
  _msgRef = ref;
  _msgChauffeur = chauffeur;
  // Trouver le tel du chauffeur dans CHAUFFEURS
  var ch = typeof CHAUFFEURS!=='undefined' ? CHAUFFEURS.find(function(c){return c.nom===chauffeur;}) : null;
  _msgTel = ch ? ch.tel : '6XX XXX XXX';

  var sub = document.getElementById('msgSub');
  if(sub) sub.textContent = chauffeur + ' · Billet ' + ref;
  var refText = document.getElementById('msgRefText');
  if(refText) refText.textContent = 'Réf: ' + ref + ' · ' + chauffeur;

  // Charger l'historique
  var chat = document.getElementById('msgChat');
  if(chat) {
    var msgs = getMsgs(ref);
    if(msgs.length) {
      chat.innerHTML = msgs.map(function(m){
        return '<div class="sc-msg '+(m.from==='user'?'user':'bot')+'">'+(m.from!=='user'?'<strong style="font-size:11px;color:var(--or);">'+escapeHtml(chauffeur)+'</strong><br>':'')+escapeHtml(m.text)+'<div style="font-size:10px;color:rgba(255,255,255,0.25);margin-top:4px;">'+escapeHtml(m.time)+'</div></div>';
      }).join('');
    } else {
      chat.innerHTML = '<div class="sc-msg bot">👋 Bonjour ! Je suis <strong>'+escapeHtml(chauffeur)+'</strong>, votre chauffeur pour le trajet <strong>'+escapeHtml(ref)+'</strong>. N\'hésitez pas à me contacter pour toute question sur le trajet, le lieu de rendez-vous ou les bagages.</div>';
    }
    chat.scrollTop = chat.scrollHeight;
  }

  document.getElementById('modalMsg').classList.add('open');
  document.body.style.overflow = 'hidden';
  setTimeout(function(){var inp=document.getElementById('msgInput');if(inp)inp.focus();},200);
}

function fermerMsg() {
  document.getElementById('modalMsg').classList.remove('open');
  document.body.style.overflow = '';
}

document.getElementById('modalMsg')?.addEventListener('click', function(e){
  if(e.target===this) fermerMsg();
});

function getMsgs(ref) {
  try { return JSON.parse(localStorage.getItem('ctl_msg_'+ref) || '[]'); } catch(e) { return []; }
}
function saveMsgs(ref, msgs) {
  try { localStorage.setItem('ctl_msg_'+ref, JSON.stringify(msgs)); } catch(e) {}
}

function envoyerMsg() {
  var input = document.getElementById('msgInput');
  var chat = document.getElementById('msgChat');
  if(!input||!chat||!input.value.trim()) return;
  var text = input.value.trim();
  var time = new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});

  // Sauvegarder
  var msgs = getMsgs(_msgRef);
  msgs.push({from:'user',text:text,time:time});
  saveMsgs(_msgRef, msgs);

  // Afficher
  chat.innerHTML += '<div class="sc-msg user">'+escapeHtml(text)+'<div style="font-size:10px;color:rgba(255,255,255,0.25);margin-top:4px;">'+time+' ✓</div></div>';
  input.value = '';
  chat.scrollTop = chat.scrollHeight;

  // Réponse simulée du chauffeur
  setTimeout(function(){
    var rep = genReponseChauffeur(text, _msgChauffeur);
    var time2 = new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
    msgs.push({from:'chauffeur',text:rep,time:time2});
    saveMsgs(_msgRef, msgs);
    chat.innerHTML += '<div class="sc-msg bot"><strong style="font-size:11px;color:var(--or);">'+escapeHtml(_msgChauffeur)+'</strong><br>'+escapeHtml(rep)+'<div style="font-size:10px;color:rgba(255,255,255,0.25);margin-top:4px;">'+time2+'</div></div>';
    chat.scrollTop = chat.scrollHeight;
  }, 800 + Math.random()*1200);
}

function genReponseChauffeur(msg, nom) {
  var m = msg.toLowerCase();
  if(m.match(/bonjour|salut|bonsoir|hello/)) return 'Bonjour ! Je suis '+nom+', votre chauffeur. Comment puis-je vous aider ?';
  if(m.match(/heure|départ|part à|quand/)) return 'Le départ est prévu à l\'heure indiquée sur votre billet. Je vous enverrai un SMS 30 minutes avant. Soyez prêt(e) !';
  if(m.match(/lieu|point|rendez|adresse|où|gare|agence/)) return 'Le point de rendez-vous est à la gare routière principale. Je vous enverrai ma position GPS exacte 1h avant le départ. 📍';
  if(m.match(/bagage|valise|sac|kilo|kg/)) return 'Vous avez droit à 1 bagage en soute (max 25 kg) + 1 bagage cabine. Pour un excédent, comptez 500 FCFA/kg supplémentaire.';
  if(m.match(/retard|attendre|en retard/)) return 'Si vous avez du retard, prévenez-moi le plus tôt possible. J\'ai une marge de 15 minutes. Au-delà, le billet pourra être reporté selon disponibilité.';
  if(m.match(/annul|rembours/)) return 'Pour annuler, allez dans Mon Espace → Mes Billets → Annuler. Le remboursement est sous 48h. L\'annulation est possible jusqu\'à 2h avant le départ.';
  if(m.match(/climatisé|clim|chaud|froid|confort/)) return 'Mon véhicule est climatisé et entretenu régulièrement. Eau fraîche disponible à bord pour les trajets VIP. 😊';
  if(m.match(/arrêt|pause|toilette|manger/)) return 'Une pause de 15-20 minutes est prévue à mi-parcours (restauration et toilettes). Vous serez notifié(e) par SMS.';
  if(m.match(/sécurité|sos|urgence|accident/)) return 'Votre sécurité est ma priorité. Le bouton SOS est actif pendant tout le trajet. Vos proches suivent votre position en temps réel via CTL Family Space. 🛡';
  if(m.match(/merci|top|super|parfait|excellent/)) return 'Merci à vous ! À très bientôt pour le trajet. Bon voyage avec CTL ! 🙏';
  if(m.match(/place|siège|fenêtre|devant/)) return 'Les places sont attribuées par ordre d\'arrivée. Si vous avez une préférence, arrivez 15 min en avance et je ferai mon possible. 👍';
  if(m.match(/prix|payer|supplément|coût/)) return 'Le prix est celui indiqué sur votre billet, tout inclus (GPS, assurance, SMS famille). Pas de supplément caché.';
  if(m.match(/numéro|téléphone|appel|contact/)) return 'Vous pouvez m\'appeler au +237 '+_msgTel+'. Je suis joignable jusqu\'à 1h avant le départ et pendant tout le trajet.';
  return 'Bien noté ! Si vous avez d\'autres questions sur le trajet, n\'hésitez pas. Je reste disponible. 👍';
}

function appelerChauffeur(chauffeur) {
  var ch = typeof CHAUFFEURS!=='undefined' ? CHAUFFEURS.find(function(c){return c.nom===chauffeur;}) : null;
  var tel = ch ? ch.tel.replace(/\s/g,'') : '690000000';
  window.open('tel:+237'+tel, '_self');
}

function appelerDepuisMsg() {
  appelerChauffeur(_msgChauffeur);
}
</script>

