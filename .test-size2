        <div class="disclaimer-block" style="margin-bottom:12px;">
          <div class="disclaimer-header" onclick="(function(el){var b=el.querySelector('.disclaimer-collapsed');var t=el.querySelector('.dh-toggle');b.classList.toggle('open');t.classList.toggle('open');})(this.closest('.disclaimer-block'))">
            <span class="dh-ico">ℹ️</span>
            <span class="dh-title">Informations légales — À lire avant de vous engager</span>
            <span class="dh-toggle">▼</span>
          </div>
          <div class="disclaimer-body">
            <p><strong>CTL</strong>, exploitée par <strong>EDIK SARL</strong>, est une <em>plateforme de mise en relation</em>. CTL <strong>n'est pas transporteur</strong>.</p>
          </div>
          <div class="disclaimer-collapsed open">
            <div class="disclaimer-body">
              <ul class="db-points" style="list-style:none;padding:0;margin:6px 0;">
                <li>🪪 <strong>KYC chauffeurs</strong> — Pièces vérifiées avant toute mise en service</li>
                <li>📍 <strong>GPS temps réel</strong> — Partagé avec vos contacts famille</li>
                <li>🚨 <strong>Bouton SOS</strong> — Alerte immédiate CTL + contacts d'urgence</li>
                <li>🔒 <strong>Données protégées</strong> — Conformément à la loi n°2024/017 du 23 décembre 2024</li>
              </ul>
              <p style="margin-top:8px;font-size:11.5px;color:rgba(224,80,80,0.85);border-top:1px solid rgba(224,80,80,0.2);padding-top:8px;"><strong>⚖️</strong> En cas d'incident, CTL communique les données opérationnelles aux autorités compétentes (loi n°2010/012).</p>
            </div>
          </div>
        </div>
        <!-- Cases de consentement — pleine largeur -->
        <div class="ctl-consent-block" style="margin:0 0 14px;width:100%;">
          <div class="ctl-consent-item">
            <input type="checkbox" id="cc-cgu">
            <label for="cc-cgu">J'ai pris connaissance des <strong>CGU</strong> et de la <strong>Politique de Confidentialité</strong> de CTL — EDIK SARL, conformément à la <strong>loi n°2024/017 du 23 décembre 2024</strong> (art. 9 al.1) et à la <strong>loi n°2010/012 du 21 décembre 2010</strong>, et je les accepte.</label>
          </div>
          <div class="ctl-consent-item" style="margin-top:8px;">
            <input type="checkbox" id="cc-consent">
            <label for="cc-consent">Je consens à la collecte et au traitement de mes données personnelles (nom, prénom, photo, téléphone, e-mail, GPS…) par EDIK SARL, conformément aux <strong>art. 8, 9, 10, 11 et 19 de la loi n°2024/017</strong>. Révocable à : <strong>privacy@cameroonterreline.cm</strong>.</label>
          </div>
          <div class="ctl-consent-error" id="cc-consent-err" style="color:#ff6b6b;font-size:11px;margin-top:6px;display:none;">⚠️ Veuillez cocher les deux cases pour continuer.</div>
        </div>
      </div>
      <div class="mf-actions" style="padding:12px 24px 20px;display:flex;gap:12px;justify-content:flex-end;">
        <button class="btn-cancel-modal" onclick="document.getElementById('modalCompte').classList.remove('open');document.body.style.overflow=''">Annuler</button>
        <button class="btn-confirm-resa" onclick="validerCreationCompte()">Créer mon compte →</button>
      </div>
    </div>`;
  document.getElementById('modalCompte').classList.add('open');
  document.body.style.overflow = 'hidden';
}

let categorieSelectionnee = 'passager';
function selectCategory(cat) {
  categorieSelectionnee = cat;
  ['passager','chauffeur','agence','employe','admin'].forEach(c => {
    const el = document.getElementById('cat-'+c);
    if (el) el.classList.toggle('selected', c===cat);
  });
}


// ── switchPrivacyTab — Navigation dans la Politique de Confidentialité ──
function switchPrivacyTab(idx, btn) {
  document.querySelectorAll('.pc-panel').forEach(function(p){ p.classList.remove('active'); });
  document.querySelectorAll('.pc-nav-btn').forEach(function(b){ b.classList.remove('active'); });
  var panel = document.getElementById('pc-panel-' + idx);
  if (panel) panel.classList.add('active');
  if (btn) btn.classList.add('active');
  var body = document.querySelector('#modalPrivacy .modal-box');
  if (body) body.scrollTop = 0;
}

function validerCreationCompte() {
  const prenom = document.getElementById('cc-prenom')?.value.trim();
  const nom    = document.getElementById('cc-nom')?.value.trim();
  const ddn    = document.getElementById('cc-ddn')?.value;
  const tel    = document.getElementById('cc-tel')?.value.trim();
  const email  = document.getElementById('cc-email')?.value.trim();
  const mdp    = document.getElementById('cc-mdp')?.value;
  const mdp2   = document.getElementById('cc-mdp2')?.value;
  const cgu    = document.getElementById('cc-cgu')?.checked;
  const consent= document.getElementById('cc-consent')?.checked;
  if (!prenom||!nom||!ddn||!tel||!email||!mdp) { alert('⚠️ Veuillez remplir tous les champs obligatoires.'); return; }
  // Validation e-mail stricte
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { alert('⚠️ Adresse e-mail invalide. Format attendu : exemple@domaine.com'); return; }
  // Validation téléphone camerounais (6XXXXXXXX ou +2376XXXXXXXX)
  var telClean = tel.replace(/[\s\-\.]/g,'');
  if (!/^(\+237)?[26][0-9]{7,8}$/.test(telClean)) { alert('⚠️ Numéro de téléphone invalide. Format attendu : 6XX XXX XXX (9 chiffres commençant par 6 ou 2).'); return; }
  // Validation âge minimum 18 ans
  var dateNais = new Date(ddn);
  var today = new Date();
  var age = today.getFullYear() - dateNais.getFullYear();
  var m = today.getMonth() - dateNais.getMonth();
  if (m < 0 || (m === 0 && today.getDate() < dateNais.getDate())) age--;
  if (isNaN(age) || age < 18) { alert('⚠️ Vous devez avoir au moins 18 ans pour créer un compte CTL.'); return; }
  if (age > 120) { alert('⚠️ Date de naissance invalide.'); return; }
  // Validation mot de passe robuste
  if (mdp.length < 8) { alert('⚠️ Le mot de passe doit contenir au moins 8 caractères.'); return; }
  if (!/[A-Z]/.test(mdp) || !/[0-9]/.test(mdp)) { alert('⚠️ Le mot de passe doit contenir au moins une majuscule et un chiffre.'); return; }
  if (mdp !== mdp2) { alert('⚠️ Les mots de passe ne correspondent pas.'); return; }
  // Validation consentement
  if (!cgu || !consent) { var errEl=document.getElementById('cc-consent-err'); if(errEl)errEl.style.display='block'; return; }
  try { localStorage.setItem('ctl_compte', JSON.stringify({prenom,nom,ddn,tel:telClean,email,categorie:categorieSelectionnee,createdAt:new Date().toLocaleDateString('fr-FR')})); } catch(e){}
  document.getElementById('modalCompteBox').innerHTML = `
    <div class="resa-success">
      <div class="rs-icon">✅</div>
      <h3>Compte créé avec succès !</h3>
      <p>Bienvenue <strong style="color:var(--white)">${escapeHtml(prenom)} ${escapeHtml(nom)}</strong> !<br>
      Votre compte <strong style="color:var(--or)">${escapeHtml(categorieSelectionnee)}</strong> CTL est activé.<br><br>
      Connectez-vous avec : <strong style="color:var(--or)">${escapeHtml(email)}</strong></p>
      <div style="margin-top:24px;">
        <button class="btn-confirm-resa" onclick="(function(){document.getElementById('modalCompte').classList.remove('open');document.body.style.overflow='';try{var c=JSON.parse(localStorage.getItem('ctl_compte')||'null');ctlOuvrirInterface(c&&c.categorie?c.categorie:'passager');}catch(e){ouvrirDashboard();}})()">Accéder à mon espace</button>
      </div>
    </div>`;
}

