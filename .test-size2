      <button class="modal-close" onclick="fermerModalChauffeur()">✕</button>
    </div>
    <div class="modal-form-tabs">
      <button class="modal-tab-btn active" onclick="switchTabCh('trajet',this)">🗺️ Proposer un trajet</button>
      <button class="modal-tab-btn" onclick="switchTabCh('inscription',this)">📋 S'inscrire chauffeur</button>
    </div>
    <div class="modal-body">
      <div id="ch-tab-trajet" class="modal-tab-content active">
        <div class="modal-section-title">📍 Détails du trajet</div>
        <div class="form-row">
          <div class="form-field"><label>Date du trajet <span class="req">*</span></label><input type="date" id="ch-date"></div>
          <div class="form-field"><label>Heure de départ <span class="req">*</span></label><input type="time" id="ch-heure" value="06:00"></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label>Ville de départ <span class="req">*</span></label><input type="text" id="ch-dep-ville" placeholder="Ex: Douala"></div>
          <div class="form-field"><label>Quartier/lieu de départ <span class="req">*</span></label><input type="text" id="ch-dep-quartier" placeholder="Ex: Akwa, Gare Centrale"></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label>Ville d'arrivée <span class="req">*</span></label><input type="text" id="ch-arr-ville" placeholder="Ex: Yaoundé"></div>
          <div class="form-field"><label>Quartier/arrêt final <span class="req">*</span></label><input type="text" id="ch-arr-quartier" placeholder="Ex: Mvan, Centre-ville"></div>
        </div>
        <div class="form-row single">
          <div class="form-field"><label>Escales et arrêts intermédiaires</label><input type="text" id="ch-escales" placeholder="Ex: Edéa, Nanga Eboko (séparer par des virgules)"></div>
        </div>
        <div class="form-row triple">
          <div class="form-field"><label>Nombre de places <span class="req">*</span></label><input type="number" id="ch-places" min="1" max="60" placeholder="Ex: 8"></div>
          <div class="form-field"><label>Type de trajet</label>
            <select id="ch-type" style="width:100%;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:14px 16px;color:var(--white);font-family:Outfit,sans-serif;font-size:14px;appearance:none;">
              <option>🚌 Classique</option>
              <option>🌟 VIP</option>
              <option>🚐 Location individuelle</option>
              <option>🚌 Location groupe</option>
            </select>
          </div>
          <div class="form-field"><label>Prix proposé (FCFA)</label><input type="number" id="ch-prix" placeholder="Ex: 5000"></div>
        </div>
      </div>
      <div id="ch-tab-inscription" class="modal-tab-content">
        <div class="modal-section-title">👤 Informations personnelles</div>
        <div class="form-row">
          <div class="form-field"><label>Prénom <span class="req">*</span></label><input type="text" id="ch-prenom" placeholder="Ex: Jean-Pierre"></div>
          <div class="form-field"><label>Nom <span class="req">*</span></label><input type="text" id="ch-nom" placeholder="Ex: Mbarga"></div>
        </div>
        <div class="form-row triple">
          <div class="form-field"><label>Date de naissance <span class="req">*</span></label><input type="date" id="ch-ddn"></div>
          <div class="form-field"><label>Lieu de naissance</label><input type="text" id="ch-lieu-nais" placeholder="Ex: Douala"></div>
          <div class="form-field"><label>Téléphone <span class="req">*</span></label><input type="tel" id="ch-tel" placeholder="6XX XXX XXX"></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label>E-mail <span class="req">*</span></label><input type="email" id="ch-email" placeholder="exemple@mail.com"></div>
          <div class="form-field"><label>Adresse de résidence</label><input type="text" id="ch-adresse" placeholder="Ex: Makepe, Douala"></div>
        </div>
        <div class="modal-section-title" style="margin-top:16px;">🚗 Véhicule</div>
        <div class="form-row">
          <div class="form-field"><label>N° d'immatriculation <span class="req">*</span></label><input type="text" id="ch-immat" placeholder="Ex: LT 1234 A"></div>
          <div class="form-field"><label>Marque & Modèle</label><input type="text" id="ch-vehicule" placeholder="Ex: Toyota HiAce 2021"></div>
        </div>
        <div class="form-row">
          <div class="form-field"><label>Nombre de places</label><input type="number" id="ch-veh-places" min="1" max="60" placeholder="Ex: 8"></div>
          <div class="form-field"><label>Photo du véhicule</label>
            <label class="upload-zone" id="uz-photo-vehicule" style="margin-bottom:0;">
              <span class="uz-label">📷 Joindre ou prendre une photo</span>
              <input type="file" accept="image/*" capture="environment" onchange="marquerUpload('uz-photo-vehicule',this)">
              <span class="uz-btn">Photo</span>
            </label>
          </div>
        </div>
        <div class="modal-section-title" style="margin-top:16px;">📎 Pièces à fournir</div>
        <label class="upload-zone" id="uz-cni"><span class="uz-label">🪪 Pièce d'identité valide (CNI, Passeport, Titre de séjour...)</span><input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="marquerUpload('uz-cni',this)"><span class="uz-btn">Joindre</span></label>
        <label class="upload-zone" id="uz-permis"><span class="uz-label">🚗 Permis de conduire</span><input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="marquerUpload('uz-permis',this)"><span class="uz-btn">Joindre</span></label>
        <label class="upload-zone" id="uz-carte-grise"><span class="uz-label">📄 Carte grise du véhicule</span><input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="marquerUpload('uz-carte-grise',this)"><span class="uz-btn">Joindre</span></label>
        <label class="upload-zone" id="uz-visite-tech"><span class="uz-label">🔧 Visite technique automobile</span><input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="marquerUpload('uz-visite-tech',this)"><span class="uz-btn">Joindre</span></label>
        <label class="upload-zone" id="uz-assurance"><span class="uz-label">🛡 Assurance du véhicule</span><input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="marquerUpload('uz-assurance',this)"><span class="uz-btn">Joindre</span></label>
      </div>
    </div>

    <div class="disclaimer-block">
      <div class="disclaimer-header" onclick="(function(el){var b=el.querySelector('.disclaimer-collapsed');var t=el.querySelector('.dh-toggle');b.classList.toggle('open');t.classList.toggle('open');})(this.closest('.disclaimer-block'))">
        <span class="dh-ico">⚖️</span>
        <span class="dh-title">Informations légales importantes — À lire avant de vous engager</span>
        <span class="dh-toggle">▼</span>
      </div>
      <div class="disclaimer-body">
        <p><strong>CAMEROON TERRE LINE (CTL)</strong>, exploitée par <strong>EDIK SARL</strong>, agit exclusivement en qualité de <em>plateforme numérique de mise en relation</em>. CTL <strong>n'est pas partie au contrat de transport</strong> qui vous lie au passager et décline, à ce titre, toute responsabilité pour les dommages corporels, matériels ou moraux survenus lors d'un trajet résultant d'une faute ou d'une défaillance qui vous serait imputable.</p>
      </div>
      <div class="disclaimer-collapsed open">
        <div class="disclaimer-body">
          <li><p><strong>Vos responsabilités en tant que chauffeur :</strong></p><ul class="db-points"><li>Vous êtes personnellement responsable de votre véhicule, de votre conduite et du respect du <strong>Code de la Route camerounais (Loi n°96/07 du 8 avril 1996)</strong>, ainsi que des réglementations du Ministère des Transports (MINTRANSPORTS).</li><li>Vous garantissez la validité permanente de votre permis de conduire, de l'assurance et de la visite technique de votre véhicule, et assumez l'entière responsabilité de la sécurité des passagers à votre bord.</li><li>Tout manquement grave à vos obligations légales ou contractuelles entraînera la suspension ou la résiliation définitive de votre compte CTL, sans préjudice des poursuites judiciaires applicables.</li></ul></li><li><p><strong>Mesures de sécurité mises en place par CTL pour vous protéger et protéger vos passagers :</strong></p><ul class="db-points"><li>🪪 <strong>Vérification KYC obligatoire</strong> — CNI, permis de conduire, carte grise, assurance et visite technique vérifiés avant activation du compte</li><li>📍 <strong>Suivi GPS en temps réel</strong> — Position transmise toutes les 30 secondes au passager, à ses contacts famille et aux administrateurs CTL</li><li>🚨 <strong>Bouton SOS intégré</strong> — Alerte immédiate en cas d'incident, avec transmission des coordonnées GPS aux équipes CTL et aux contacts d'urgence</li><li>⚡ <strong>Alerte vitesse excessive</strong> — SMS automatique dès dépassement de 90 km/h pour la sécurité de tous</li><li>⭐ <strong>Système de notation à 5 critères</strong> — Évaluation après chaque trajet, suspension automatique en dessous de la note de 3/5</li><li>📋 <strong>Identification permanente</strong> — Votre photo et l'immatriculation de votre véhicule sont visibles par le passager avant embarquement</li><li>🔒 <strong>Paiements sécurisés et traçables</strong> — Transactions via Mobile Money certifié et portefeuille CTL à opérations atomiques infalsifiables</li></ul></li>
          <p style="margin-top:10px;padding-top:10px;border-top:1px solid rgba(224,80,80,0.2);color:rgba(224,80,80,0.85);"><strong>⚖️ Clause judiciaire :</strong> En cas de dérive grave (accidents corporels, agressions, fraudes, infractions au Code de la Route, comportements délictueux), CTL se réserve le droit, <em>dans le cadre d'une procédure judiciaire régulièrement initiée par les autorités camerounaises compétentes</em>, de communiquer à ces autorités l'intégralité des données personnelles et opérationnelles vous concernant (identité, coordonnées, historique GPS, enregistrements de trajets, données de paiement), conformément aux dispositions de la <strong>loi n°2010/012 du 21 décembre 2010</strong> relative à la cybersécurité et à la cybercriminalité au Cameroun.</p>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <div><div class="mf-price" style="font-size:12px;color:rgba(255,255,255,0.4);" id="ch-footer-hint">Remplissez les informations du trajet</div></div>
      <div class="mf-actions">
        <button class="btn-cancel-modal" onclick="fermerModalChauffeur()">Annuler</button>
        <button class="btn-confirm-resa" id="ch-btn-valider" onclick="validerChauffeur()">Publier →</button>
      </div>
    </div>`;
  document.getElementById('modalChauffeur').classList.add('open');
  document.body.style.overflow = 'hidden';
  document.getElementById('ch-date').value = new Date().toISOString().split('T')[0];
}

function switchTabCh(tab, btn) {
  document.querySelectorAll('#modalChauffeurBox .modal-tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('#modalChauffeurBox .modal-tab-content').forEach(c => c.classList.remove('active'));
  document.getElementById('ch-tab-'+tab).classList.add('active');
  const hint = document.getElementById('ch-footer-hint');
  const btnVal = document.getElementById('ch-btn-valider');
  if (hint) hint.textContent = tab==='trajet' ? 'Remplissez les informations du trajet' : 'Votre candidature sera examinée sous 48h';
  if (btnVal) btnVal.textContent = tab==='trajet' ? 'Publier →' : 'Soumettre →';
}

function validerChauffeur() {
  const activeTab = document.querySelector('#modalChauffeurBox .modal-tab-content.active');
  if (!activeTab) return;
  const isTrajet = activeTab.id === 'ch-tab-trajet';
  const box = document.getElementById('modalChauffeurBox');
  if (isTrajet) {
    const depVille = document.getElementById('ch-dep-ville')?.value.trim();
    const arrVille = document.getElementById('ch-arr-ville')?.value.trim();
    const date = document.getElementById('ch-date')?.value;
    const places = document.getElementById('ch-places')?.value;
    if (!depVille||!arrVille||!date||!places) { alert('⚠️ Veuillez remplir les champs obligatoires du trajet.'); return; }
    box.innerHTML = `<div class="resa-success"><div class="rs-icon">🚗</div><h3>Trajet publié !</h3>
      <p>Votre trajet <strong style="color:var(--white)">${escapeHtml(depVille)} → ${escapeHtml(arrVille)}</strong> est maintenant visible sur la plateforme CTL. Les passagers peuvent réserver des places.</p>
      <div style="margin-top:24px;"><button class="btn-confirm-resa" onclick="fermerModalChauffeur()">Fermer</button></div></div>`;
  } else {
    const prenom = document.getElementById('ch-prenom')?.value.trim();
    const nom = document.getElementById('ch-nom')?.value.trim();
    const tel = document.getElementById('ch-tel')?.value.trim();
    const email = document.getElementById('ch-email')?.value.trim();
    const immat = document.getElementById('ch-immat')?.value.trim();
    if (!prenom||!nom||!tel||!email||!immat) { alert('⚠️ Veuillez remplir tous les champs obligatoires.'); return; }
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){alert('⚠️ Adresse e-mail invalide.');return;}
    var chTelClean=tel.replace(/[\s\-\.]/g,'');
    if(!/^(\+237)?[26][0-9]{7,8}$/.test(chTelClean)){alert('⚠️ Numéro de téléphone invalide. Format : 6XX XXX XXX');return;}
    box.innerHTML = `<div class="resa-success"><div class="rs-icon">✅</div><h3>Candidature envoyée !</h3>
      <p>Bonjour <strong style="color:var(--white)">${escapeHtml(prenom)} ${escapeHtml(nom)}</strong> !<br>
      Votre dossier chauffeur partenaire CTL a bien été transmis à nos équipes.<br><br>
      Un responsable vous contactera à <strong style="color:var(--or)">${escapeHtml(email)}</strong> sous 48h.</p>
      <div style="margin-top:24px;"><button class="btn-confirm-resa" onclick="fermerModalChauffeur()">Fermer</button></div></div>`;
  }
}

function fermerModalChauffeur() {
  document.getElementById('modalChauffeur').classList.remove('open');
  document.body.style.overflow = '';
}

// Fermeture au clic overlay
['modalAgence','modalCompte','modalConnexion','modalMdp'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener('click', function(e) {
    if (e.target === this) { this.classList.remove('open'); document.body.style.overflow=''; }
  });
});
// Fermeture des modales avec la touche Escape
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    ['modalResa','modalChauffeur','modalPrivacy','modalIA','modalAgence','modalCompte','modalConnexion','modalMdp','modalWallet','modalFiche','modalBilletTiers','modalFirebase'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el && el.classList.contains('open')) {
        el.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
    // Fermer aussi le panneau notifications
    var notifPanel = document.getElementById('notifPanel');
    if (notifPanel) notifPanel.classList.remove('open');
    // Fermer le menu mobile
    var navLinks = document.getElementById('navLinks');
    var hamburger = document.getElementById('hamburgerBtn');
    if (navLinks && navLinks.classList.contains('mobile-open')) {
      navLinks.classList.remove('mobile-open');
      if (hamburger) { hamburger.classList.remove('active'); hamburger.setAttribute('aria-expanded','false'); }
      document.body.style.overflow = '';
    }
  }
});
// Focus trap pour les modales — empêche le Tab de sortir de la modale ouverte
document.addEventListener('keydown', function(e) {
  if (e.key !== 'Tab') return;
  var openModal = document.querySelector('.modal-overlay.open .modal-box') || document.querySelector('.dashboard-overlay.open .dash-body');
  if (!openModal) return;
  var focusable = openModal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
  if (!focusable.length) return;
  var first = focusable[0], last = focusable[focusable.length - 1];
  if (e.shiftKey) {
    if (document.activeElement === first) { e.preventDefault(); last.focus(); }
  } else {
    if (document.activeElement === last) { e.preventDefault(); first.focus(); }
  }
});
</script>

<script>
function ouvrirBackOffice() {
  var adminPwd = localStorage.getItem('ctl_admin_pwd');
  if (!adminPwd) { alert('⚠️ Aucun mot de passe admin défini. Veuillez configurer un mot de passe via le panneau de configuration.'); return; }
  var saisie = prompt('🔐 Mot de passe administrateur CTL :');
  if (!saisie) return;
  if (saisie !== adminPwd) { alert('❌ Mot de passe incorrect.'); return; }
  try{localStorage.setItem('ctl_role','admin');}catch(e){}
  ctlOuvrirInterface('admin');
}
function clearSession() {
  try { localStorage.removeItem('ctl_session'); } catch(e) {}
}

// ── BILLETS PERSISTANTS ──
function getBillets() {
  try { return JSON.parse(localStorage.getItem('ctl_billets') || '[]'); } catch(e) { return []; }
}
function saveBillets(billets) {
  try { localStorage.setItem('ctl_billets', JSON.stringify(billets)); } catch(e) {}
}

// ── GÉNÉRER REF BILLET CHIFFRÉE ──
function genRef() {
  var year = new Date().getFullYear();
  var rand = Math.random().toString(36).substr(2,6).toUpperCase();
  return 'CTL-' + year + '-' + rand;
}

// ── CLÉ DE VÉRIFICATION (hash simple pour empêcher la falsification) ──
function genBilletHash(ref, dep, arr, prix) {
  var secret = localStorage.getItem('ctl_billet_secret') || (function(){ var s='CTL-'+Date.now().toString(36)+'-'+Math.random().toString(36).substr(2,8); try{localStorage.setItem('ctl_billet_secret',s);}catch(e){} return s; })();
  var data = ref + '|' + dep + '|' + arr + '|' + prix + '|' + secret;
  var hash = 0;
  for (var i = 0; i < data.length; i++) {
    var chr = data.charCodeAt(i);
    hash = ((hash << 5) - hash) + chr;
    hash |= 0;
  }
  return Math.abs(hash).toString(36).toUpperCase().padStart(8, '0');
}

// ── DONNÉES QR CODE (JSON chiffré) ──
function genQRData(ref, dep, arr, prix, nomPassager, date, heure) {
  var hash = genBilletHash(ref, dep, arr, prix);
  return JSON.stringify({
    r: ref,
    d: dep,
    a: arr,
    p: prix,
    n: nomPassager,
    dt: date,
    h: heure,
    v: hash,
    t: Date.now()
  });
}

// ── GÉNÉRER VRAI QR CODE (scannable) ──
function genQRSVG(ref) {
  // Fallback SVG si la lib n'est pas chargée
  var seed = ref.split('').reduce(function(a,c){return a+c.charCodeAt(0);},0);
  var cells = '';
  for(var r=0;r<7;r++) for(var c=0;c<7;c++) {
    if((seed*(r+1)*(c+2))%5<2) cells += '<rect x="'+(8+c*9)+'" y="'+(8+r*9)+'" width="8" height="8" fill="#000"/>';
  }
  return '<svg width="80" height="80" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg"><rect width="80" height="80" fill="#fff"/>' + cells + '<rect x="4" y="4" width="26" height="26" fill="none" stroke="#000" stroke-width="3"/><rect x="50" y="4" width="26" height="26" fill="none" stroke="#000" stroke-width="3"/><rect x="4" y="50" width="26" height="26" fill="none" stroke="#000" stroke-width="3"/><rect x="10" y="10" width="14" height="14" fill="#000"/><rect x="56" y="10" width="14" height="14" fill="#000"/><rect x="10" y="56" width="14" height="14" fill="#000"/></svg>';
}

function genQRElement(containerId, qrData) {
  var el = document.getElementById(containerId);
  if (!el) return;
  el.innerHTML = '';
  if (typeof QRCode !== 'undefined') {
    new QRCode(el, {
      text: qrData,
      width: 180,
      height: 180,
      colorDark: '#000000',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.H
    });
  } else {
    el.innerHTML = '<div style="padding:16px;background:#fff;border-radius:12px;display:inline-block;">' + genQRSVG(qrData) + '</div>';
  }
}

// ── NOTIFICATIONS ──
const NOTIFS_KEY = 'ctl_notifs';
function getNotifs() {
  try { return JSON.parse(localStorage.getItem(NOTIFS_KEY) || '[]'); } catch(e) { return []; }
}
function addNotif(ico, msg) {
  const notifs = getNotifs();
  notifs.unshift({ ico, msg, time: new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}), lu: false });
  if(notifs.length > 20) notifs.pop();
  try { localStorage.setItem(NOTIFS_KEY, JSON.stringify(notifs)); } catch(e) {}
  updateNotifBadge();
  renderNotifList();
}
function updateNotifBadge() {
  const n = getNotifs().filter(x=>!x.lu).length;
  const badge = document.getElementById('notifBadge');
  if(badge) { badge.textContent = n; badge.classList.toggle('visible', n>0); }
}
function renderNotifList() {
  const list = document.getElementById('notifList');
  if(!list) return;
  const notifs = getNotifs();
  if(!notifs.length) { list.innerHTML='<div style="padding:20px;text-align:center;color:rgba(255,255,255,0.3);font-size:13px;">Aucune notification</div>'; return; }
  list.innerHTML = notifs.map((n,i)=>`
    <div class="notif-item ${n.lu?'':'unread'}" onclick="marquerLu(${i})">
      <span class="notif-ico">${n.ico}</span>
      <div class="notif-text">
        <div class="notif-msg">${escapeHtml(n.msg)}</div>
        <div class="notif-time">${n.time}</div>
      </div>
    </div>`).join('');
}
function marquerLu(idx) {
  const notifs = getNotifs();
  if(notifs[idx]) notifs[idx].lu = true;
  try { localStorage.setItem(NOTIFS_KEY, JSON.stringify(notifs)); } catch(e) {}
  updateNotifBadge();
  renderNotifList();
}
function marquerToutLu() {
  const notifs = getNotifs().map(n=>({...n,lu:true}));
  try { localStorage.setItem(NOTIFS_KEY, JSON.stringify(notifs)); } catch(e) {}
  updateNotifBadge();
  renderNotifList();
}
function toggleNotifs() {
  const panel = document.getElementById('notifPanel');
  if(!panel) return;
  renderNotifList();
  panel.classList.toggle('open');
}
function fermerNotifs() {
  document.getElementById('notifPanel')?.classList.remove('open');
}
document.addEventListener('click', function(e) {
  const panel = document.getElementById('notifPanel');
  const btn = document.getElementById('notifBtnWrap');
  if(panel && panel.classList.contains('open') && !panel.contains(e.target) && !btn?.contains(e.target)) {
    panel.classList.remove('open');
  }
});

// ── ÉTAT CONNEXION → mise à jour nav ──
function mettreAJourNav() {
  const sess = getSession();
  const btnCreer = document.getElementById('btnCreerCompte');
  const btnConn = document.getElementById('btnSeConnecter');
  const btnEspace = document.getElementById('btnMonEspace');
  const notifWrap = document.getElementById('notifBtnWrap');
  if(sess) {
    if(btnCreer) btnCreer.style.display='none';
    if(btnConn) btnConn.style.display='none';
    if(btnEspace) { btnEspace.classList.add('visible'); }
    if(notifWrap) notifWrap.style.display='flex';
    const initiales = (sess.prenom[0]+(sess.nom?sess.nom[0]:'')).toUpperCase();
    const navAv = document.getElementById('navAvatar');
    const navPr = document.getElementById('navPrenom');
    if(navAv) navAv.textContent = initiales;
    if(navPr) navPr.textContent = sess.prenom;
    updateNotifBadge();
    var panCh=document.getElementById('navPanneauCh');
    if(panCh) panCh.style.display=(sess.categorie==='chauffeur'||sess.categorie==='Chauffeur')?'':'none';
  } else {
    if(btnCreer) btnCreer.style.display='';
    if(btnConn) btnConn.style.display='';
    if(btnEspace) btnEspace.classList.remove('visible');
    if(notifWrap) notifWrap.style.display='none';
  }
}

// ── DASHBOARD ──
function ouvrirDashboard() {
  const sess = getSession();
  if(!sess) { ouvrirModalConnexion(); return; }
  const overlay = document.getElementById('dashboardOverlay');
  if(!overlay) return;
  overlay.classList.add('open');
  document.body.style.overflow='hidden';
  chargerDashboard(sess);
}
function fermerDashboard() {
  document.getElementById('dashboardOverlay')?.classList.remove('open');
  document.body.style.overflow='';
}
function chargerDashboard(sess) {
  // Welcome
  const initiales = (sess.prenom[0]+(sess.nom?sess.nom[0]:'')).toUpperCase();
  const av = document.getElementById('dashAvatar'); if(av) av.textContent=initiales;
  const wl = document.getElementById('dashWelcome'); if(wl) wl.textContent='Bonjour, '+sess.prenom+' 👋';
  const sw = document.getElementById('dashSubWelcome'); if(sw) sw.textContent='Votre espace personnel CTL — Gérez vos billets, votre profil et votre sécurité.';
  const nn = document.getElementById('dashNomNav'); if(nn) nn.textContent=sess.prenom;
  // KPIs
  const billets = getBillets().filter(b=>b.email===sess.email);
  const totalDep = billets.reduce((s,b)=>s+(b.prix||0),0);
  const totalKm = billets.reduce((s,b)=>s+(b.km||0),0);
  const niv = totalDep>=200000?'Or':totalDep>=80000?'Argent':'Bronze';
  const dk = id => document.getElementById(id);
  if(dk('dk-billets')) dk('dk-billets').textContent=billets.length;
  if(dk('dk-depenses')) dk('dk-depenses').textContent=totalDep.toLocaleString('fr-FR')+' F';
  if(dk('dk-km')) dk('dk-km').textContent=totalKm+' km';
  if(dk('dk-fidelite')) dk('dk-fidelite').textContent=niv;
  // Préremplir profil
  const set=(id,v)=>{const el=document.getElementById(id);if(el&&v!==undefined)el.value=v;};
  set('dp-prenom',sess.prenom); set('dp-nom',sess.nom); set('dp-tel',sess.tel);
  set('dp-email',sess.email); set('dp-ddn',sess.ddn); set('dp-ville',sess.ville||'');
  set('dp-classe',sess.classePreferee||'classique'); set('dp-paiement',sess.paiementPrefere||'mtn');
  set('dp-sms',sess.smsNotifs||'oui');
  // Charger billets
  renderBilletsDash(billets);
  // Famille
  renderFamilleDash(sess);
  // Admin tab visible si admin
  var adminTab = document.getElementById('dash-tab-admin');
  var isAdmin = (sess.categorie==='admin'||sess.categorie==='Administrateur');
  if(adminTab) adminTab.style.display = isAdmin ? '' : 'none';
  if(isAdmin) renderAdminPanel();
}
function switchDashTab(name, btn) {
  document.querySelectorAll('.dash-tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.dash-panel').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('dash-'+name)?.classList.add('active');
}

// ── RENDU BILLETS DANS DASHBOARD ──
function renderBilletsDash(billets) {
  const list = document.getElementById('dashBilletsList');
  if(!list) return;
  if(!billets.length) {
    list.innerHTML='<div style="text-align:center;padding:48px 20px;color:rgba(255,255,255,0.3);"><div style="font-size:40px;margin-bottom:12px;">🎫</div><div style="font-size:15px;">Aucune réservation pour le moment.</div><div style="font-size:13px;margin-top:8px;">Utilisez la recherche pour trouver votre prochain trajet.</div></div>';
    return;
  }
  const statutClass = {confirme:'confirme','en-route':'en-route',termine:'termine'};
  const statutLabel = {confirme:'Confirmé','en-route':'En route',termine:'Terminé'};
  list.innerHTML = billets.map(b=>`
    <div class="billet-card">
      <div class="bc-ref">${b.ref}</div>
      <div style="flex:1;">
        <div class="bc-route">${escapeHtml(b.dep)} → ${escapeHtml(b.arr)}</div>
        <div class="bc-meta">📅 ${escapeHtml(b.date)} · ⏰ ${escapeHtml(b.heure)} · 👤 ${escapeHtml(b.chauffeur)} · 💰 ${b.prix?b.prix.toLocaleString('fr-FR'):0} FCFA</div>
        ${b.statut==='en-route'?renderSuiviBillet(b):''}
      </div>
      <span class="bc-statut ${statutClass[b.statut]||'confirme'}">${statutLabel[b.statut]||'Confirmé'}</span>
      <div class="bc-qr" onclick="afficherQR('${b.ref}','${b.dep}','${b.arr}','${b.heure}')">📱</div>
      <div class="bc-actions">
        ${b.statut==='confirme'&&!b.departConfirme?`<button class="bc-btn" style="background:rgba(26,107,58,0.15);border-color:rgba(26,107,58,0.4);color:var(--vert2);" onclick="ouvrirConfirmationDepart('${b.ref}')">✅ Embarquer</button>`:''}
        ${b.statut==='confirme'||b.statut==='en-route'?`<button class="bc-btn" onclick="ouvrirMsgBillet('${b.ref}','${b.chauffeur||'Chauffeur CTL'}')">💬</button><button class="bc-btn" onclick="appelerChauffeur('${b.chauffeur||'Chauffeur CTL'}')">📞</button>`:''}
        ${b.statut==='confirme'?`<button class="bc-btn danger" onclick="ouvrirAnnulation('${b.ref}')">Annuler</button>`:''}
        ${b.statut!=='Annulé'&&!b.scanne?`<button class="bc-btn" onclick="ouvrirModificationBillet('${b.ref}')" title="Modifier le billet" style="color:var(--or);border-color:rgba(212,168,0,0.3);">✏️</button>`:''}
        <button class="bc-btn" onclick="afficherQR('${b.ref}','${b.dep}','${b.arr}','${b.heure}')">QR</button>
        <button class="bc-btn" onclick="genererBilletPDF('${b.ref}')" title="Télécharger le billet PDF">🖨️</button>
        <button class="bc-btn" onclick="envoyerBilletWhatsApp('${b.ref}')" title="Envoyer par WhatsApp">💬</button>
      </div>
    </div>`).join('');
}

function renderSuiviBillet(b) {
  const etapes = ['Réservé','Chauffeur assigné','En route','Arrivée'];
  const idx = b.etapeActuelle||2;
  return `<div class="suivi-billet" style="margin-top:10px;">
    <div style="font-size:12px;font-weight:700;color:var(--vert2);margin-bottom:10px;">📍 Suivi en temps réel — ${b.position||'En transit'}</div>
    <div class="suivi-progress">${etapes.map((e,i)=>`
      <div class="suivi-step">
        <div class="suivi-dot ${i<idx?'done':i===idx?'active':''}"></div>
        <div class="suivi-label">${e}</div>
      </div>${i<etapes.length-1?`<div class="suivi-line ${i<idx?'done':''}"></div>`:''}`).join('')}
    </div>
  </div>`;
}

// ── QR CODE ──
function genBarcode(ref) {
  var seed = ref.split('').reduce(function(a,c,i){return a+c.charCodeAt(0)*(i+1);},0);
  var bars = '', x = 0;
  for(var i=0;i<50;i++){
    var w = ((seed*(i+7)*13)%3)+1;
    bars += '<rect x="'+x+'" y="0" width="'+w+'" height="60" fill="#0d1a10"/>';
    x += w + ((seed*(i+3))%3) + 1;
    if(x > 280) break;
  }
  return '<svg viewBox="0 0 300 60" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:50px;"><rect width="300" height="60" fill="#fff"/>' + bars + '</svg>';
}

function imprimerBillet() {
  var billet = document.getElementById('billet-ctl');
  if(!billet) return;
  var win = window.open('','_blank','width=800,height=600');
  win.document.write('<html><head><title>E-Billet CTL</title><style>body{margin:0;padding:20px;background:#f0f0f0;} @media print{body{padding:0;background:#fff;}}</style></head><body>');
  win.document.write(billet.outerHTML);
  win.document.write('</body></html>');
  win.document.close();
  setTimeout(function(){win.print();}, 500);
}

function afficherQR(ref, dep, arr, heure) {
  var qrBox = document.getElementById('qrContent');
  if(!qrBox) return;
  var sess = getSession();
  var nom = sess ? (sess.prenom+' '+sess.nom).toUpperCase() : 'PASSAGER CTL';
  var date = new Date().toLocaleDateString('fr-FR');
  var qr = genQRSVG(ref);
  var barcode = genBarcode(ref);
  var depU = dep.toUpperCase();
  var arrU = arr.toUpperCase();

  qrBox.innerHTML = [
    '<div id="billet-ctl" style="font-family:Outfit,sans-serif;background:#fff;border-radius:14px;overflow:hidden;">',

    // EN-TETE
    '<div style="background:linear-gradient(135deg,#1a6b3a 0%,#0d3d1e 60%,#111f14 100%);padding:16px 22px 14px;display:flex;align-items:center;justify-content:space-between;">',
    '<div style="display:flex;align-items:center;gap:12px;">',
    '<div style="width:34px;height:34px;background:#d4a800;clip-path:polygon(0 100%,15% 0,50% 30%,85% 0,100% 100%);flex-shrink:0;"></div>',
    '<div>',
    '<div style="color:#d4a800;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;">Cameroon Terre Line</div>',
    '<div style="color:rgba(255,255,255,0.5);font-size:8px;letter-spacing:2px;text-transform:uppercase;margin-top:1px;">Billet Électronique Officiel</div>',
    '</div></div>',
    '<div style="text-align:right;">',
    '<div style="color:rgba(255,255,255,0.45);font-size:8px;letter-spacing:2px;text-transform:uppercase;">Réf.</div>',
    '<div style="color:#d4a800;font-family:monospace;font-size:14px;font-weight:700;letter-spacing:2px;">'+ref+'</div>',
    '</div></div>',

    // CORPS
    '<div style="display:flex;">',

    // GAUCHE
    '<div style="flex:1;padding:18px 20px;background:#fff;position:relative;">',
    '<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);opacity:0.04;font-size:100px;pointer-events:none;user-select:none;">🇨🇲</div>',
    '<div style="margin-bottom:12px;">',
    '<div style="font-size:8px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#999;margin-bottom:2px;">Nom du passager</div>',
    '<div style="font-size:22px;font-weight:900;color:#0d1a10;letter-spacing:1px;">'+nom+'</div>',
    '</div>',

    // TRAJET
    '<div style="display:flex;align-items:center;gap:14px;padding:14px 0;border-top:1px solid #ebebeb;border-bottom:1px solid #ebebeb;margin:0 0 14px;">',
    '<div style="text-align:center;">',
    '<div style="font-size:8px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#999;margin-bottom:3px;">Départ</div>',
    '<div style="font-size:28px;font-weight:900;color:#1a6b3a;">'+depU+'</div>',
    '</div>',
    '<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;">',
    '<div style="width:100%;height:2px;background:linear-gradient(90deg,#1a6b3a,#d4a800,#af020b);border-radius:2px;"></div>',
    '<svg viewBox="0 0 48 20" style="width:44px;height:18px;" xmlns="http://www.w3.org/2000/svg">',
    '<path d="M6 10 L22 4 L40 10 L34 10 L34 14 L28 14 L28 10 L20 10 L20 14 L14 14 L14 10 Z M20 5 L24 5 L26 8 L18 8 Z" fill="#0d3d1e"/>',
    '</svg>',
    '<div style="font-size:7px;color:#bbb;letter-spacing:1px;text-transform:uppercase;">Transport Interurbain CTL</div>',
    '</div>',
    '<div style="text-align:center;">',
    '<div style="font-size:8px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#999;margin-bottom:3px;">Arrivée</div>',
    '<div style="font-size:28px;font-weight:900;color:#af020b;">'+arrU+'</div>',
    '</div></div>',

    // INFOS
    '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:14px;">',
    '<div><div style="font-size:8px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#999;margin-bottom:2px;">Heure</div><div style="font-size:17px;font-weight:700;color:#0d1a10;">'+(heure||'—')+'</div></div>',
    '<div><div style="font-size:8px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#999;margin-bottom:2px;">Date</div><div style="font-size:15px;font-weight:700;color:#0d1a10;">'+date+'</div></div>',
    '<div><div style="font-size:8px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#999;margin-bottom:2px;">Statut</div><div style="font-size:11px;font-weight:700;color:#1a6b3a;background:rgba(26,107,58,0.1);padding:3px 10px;border-radius:20px;display:inline-block;">✓ Confirmé</div></div>',
    '</div>',

    // BARCODE
    '<div style="padding-top:10px;border-top:1px dashed #e0e0e0;">',
    barcode,
    '<div style="text-align:center;font-family:monospace;font-size:9px;color:#bbb;letter-spacing:3px;margin-top:2px;">'+ref+'</div>',
    '</div></div>',

    // SEPARATEUR
    '<div style="width:1px;background:repeating-linear-gradient(to bottom,#ccc 0,#ccc 7px,transparent 7px,transparent 14px);margin:14px 0;flex-shrink:0;"></div>',

    // TALON DROITE
