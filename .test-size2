function ouvrirModalConnexion() {
  document.getElementById('modalConnexionBox').innerHTML = `
    <div class="modal-header">
      <div><div class="mh-title">Se connecter</div><div class="mh-sub">Accédez à votre espace CTL</div></div>
      <button class="modal-close" onclick="document.getElementById('modalConnexion').classList.remove('open');document.body.style.overflow=''">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-row single">
        <div class="form-field"><label>Adresse e-mail <span class="req">*</span></label><input type="email" id="cx-email" placeholder="exemple@mail.com"></div>
      </div>
      <div class="form-row single">
        <div class="form-field"><label>Mot de passe <span class="req">*</span></label><input type="password" id="cx-mdp" placeholder="Votre mot de passe"></div>
      </div>
      <div style="text-align:right;margin-top:8px;">
        <a href="#" onclick="event.preventDefault();document.getElementById('modalConnexion').classList.remove('open');ouvrirModalMdpOublie()" style="font-size:13px;color:var(--or);text-decoration:none;">Mot de passe oublié ?</a>
      </div>
    </div>
    <div class="modal-footer">
      <div><div class="mf-price" style="font-size:12px;color:rgba(255,255,255,0.35);">Pas encore de compte ? <a href="#" onclick="event.preventDefault();document.getElementById('modalConnexion').classList.remove('open');ouvrirModalCompte()" style="color:var(--or);">Créer un compte</a></div></div>
      <div class="mf-actions">
        <button class="btn-cancel-modal" onclick="document.getElementById('modalConnexion').classList.remove('open');document.body.style.overflow=''">Annuler</button>
        <button class="btn-confirm-resa" onclick="validerConnexion()">Se connecter →</button>
      </div>
    </div>`;
  document.getElementById('modalConnexion').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function validerConnexion() {
  const email = document.getElementById('cx-email')?.value.trim();
  const mdp   = document.getElementById('cx-mdp')?.value;
  if (!email||!mdp) { alert('⚠️ Veuillez remplir tous les champs.'); return; }
  const compte = JSON.parse(localStorage.getItem('ctl_compte')||'null');
  if (compte && compte.email === email) {
    document.getElementById('modalConnexionBox').innerHTML = `
      <div class="resa-success">
        <div class="rs-icon">👋</div>
        <h3>Connexion réussie !</h3>
        <p>Bonjour <strong style="color:var(--white)">${escapeHtml(compte.prenom)} ${escapeHtml(compte.nom)}</strong> !<br>Vous êtes connecté à votre espace ${escapeHtml(compte.categorie)} CTL.</p>
        <div style="margin-top:24px;"><button class="btn-confirm-resa" onclick="document.getElementById('modalConnexion').classList.remove('open');document.body.style.overflow=''">Accéder à mon espace</button></div>
      </div>`;
  } else {
    alert('⚠️ Identifiants incorrects. Vérifiez votre e-mail et mot de passe.');
  }
}

