      <button onclick="document.getElementById('modalPrivacy').classList.remove('open');document.body.style.overflow=''" style="background:var(--vert);border:none;color:#fff;padding:11px 24px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;">J'ai compris ✓</button>
    </div>

  </div>
</div>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
// ── WALLET ENTREPRISE + FLUX FINANCIER (chargé avant le bloc principal) ──
function getWalletCTL(){try{return JSON.parse(localStorage.getItem('ctl_wallet_entreprise')||'null')||{solde:0,transactions:[]};}catch(e){return{solde:0,transactions:[]};}}
function saveWalletCTL(w){try{localStorage.setItem('ctl_wallet_entreprise',JSON.stringify(w));}catch(e){}}
function getWalletChauffeur(cid){try{return JSON.parse(localStorage.getItem('ctl_wallet_ch_'+cid)||'null')||{solde:0,transactions:[],bloque:0};}catch(e){return{solde:0,transactions:[],bloque:0};}}
function saveWalletChauffeur(cid,w){try{localStorage.setItem('ctl_wallet_ch_'+cid,JSON.stringify(w));}catch(e){}}
function enregistrerFluxFinancier(ref,prix,chauffeur,isIntl){
  var pn=parseInt(prix)||0;if(!pn)return;var comm=Math.round(pn*(isIntl?0.10:0.08));var rev=pn-comm;var d=new Date().toLocaleDateString('fr-FR');
  var wc=getWalletCTL();wc.solde+=pn;wc.transactions.unshift({type:'credit',label:'Billet '+ref+' — '+chauffeur,montant:pn,commission:comm,reversement:rev,date:d,statut:'en_attente'});saveWalletCTL(wc);
  var cid=chauffeur.replace(/\s/g,'_').toLowerCase();var wch=getWalletChauffeur(cid);wch.bloque=(wch.bloque||0)+rev;wch.transactions.unshift({type:'bloque',label:'Billet '+ref+' — en attente départ',montant:rev,date:d,ref:ref,statut:'bloque'});saveWalletChauffeur(cid,wch);
}
function debloquerFondsChauffeur(ref,chauffeur){
  var cid=chauffeur.replace(/\s/g,'_').toLowerCase();var wch=getWalletChauffeur(cid);
  var tx=wch.transactions.find(function(t){return t.ref===ref&&t.statut==='bloque';});
  if(tx){tx.statut='disponible';tx.label=tx.label.replace('en attente départ','débloqué ✓');wch.bloque=Math.max(0,(wch.bloque||0)-tx.montant);wch.solde+=tx.montant;saveWalletChauffeur(cid,wch);
  var wc=getWalletCTL();var tc=wc.transactions.find(function(t){return t.label&&t.label.includes(ref)&&t.statut==='en_attente';});if(tc)tc.statut='reversé';saveWalletCTL(wc);}
}
</script>
<script>
  // ══════════════════════════════════════════════════════════════════
  // BASE DE DONNÉES — 360 ARRONDISSEMENTS DU CAMEROUN
  // Organisés par Région → Département → Arrondissement
  // ══════════════════════════════════════════════════════════════════
  const CAMEROUN = {
    "Adamaoua": {
      "Djerem": ["Tibati","Nganha","Mbakaou","Koncha"],
      "Faro et Déo": ["Tignère","Galim-Tignère","Kontcha","Mayo-Baléo"],
      "Mayo-Banyo": ["Banyo","Bankim","Kimi","Ngan-Ha"],
      "Mbéré": ["Meiganga","Djohong","Ngaoui","Ngan-Ha"],
      "Vina": ["Ngaoundéré","Belel","Martap","Nyambaka","Mbe"]
    },
    "Centre": {
      "Haute-Sanaga": ["Nanga-Eboko","Bibey","Lembe-Yezoum","Minta","Nsem"],
      "Lékié": ["Monatélé","Batchenga","Bot-Makak","Elig-Mfomo","Evodoula","Lobo","Obala","Sa'a","Soa"],
      "Mbam-et-Inoubou": ["Bafia","Bokito","Deuk","Ina","Kiiki","Kon-Yambetta","Makénéné","Nitoukou","Ndikiniméki"],
      "Mbam-et-Kim": ["Ngambé-Tikar","Ntui","Mbangassina","Mbam","Yang"],
      "Méfou-et-Afamba": ["Mfou","Awaé","Esse","Méfou","Menguémé","Nkolafamba","Ottotomo","Soa"],
      "Méfou-et-Akono": ["Mbalmayo","Akono","Bikok","Ebebda","Ngoumou","Ngomedzap"],
      "Mfoundi": ["Yaoundé"],
      "Mvila": ["Ebolowa","Efoulan","Biwong-Bane","Biwong-Bulu","Mengong","Ngoulemakong","Mvangan"]
    },
    "Est": {
      "Boumba-et-Ngoko": ["Moloundou","Gari-Gombo","Nkan","Salapoumbé"],
      "Haut-Nyong": ["Abong-Mbang","Doumé","Lomié","Mboma","Messamena","Messaména","Mindourou","Nguelemendouka","Somalomo"],
      "Kadey": ["Batouri","Mbang","Kette","Ndelele","Ndélélé","Ouli"],
      "Lom-et-Djérem": ["Bertoua","Bélabo","Diang","Doumaintang","Mandjou","Ngoura"]
    },
    "Extrême-Nord": {
      "Diamaré": ["Maroua","Bogo","Gazawa","Méri","Moulvoudaye","Moutourwa","Ndoukoula"],
      "Logone-et-Chari": ["Kousseri","Blangoua","Darak","Fotokol","Goulfey","Hile-Alifa","Makary","Waza","Zina"],
      "Mayo-Danay": ["Yagoua","Kaïlé","Datcheka","Guéré","Kar-Hay","Maga","Naïbam","Vélé","Wina"],
      "Mayo-Kani": ["Kaélé","Guidiguis","Mindif","Moutourwa","Touloum"],
      "Mayo-Sava": ["Mora","Kolofata","Kossehone","Tokombéré"],
      "Mayo-Tsanaga": ["Mokolo","Bourha","Hina","Koza","Mogodé","Moukou","Roua","Soulédé-Roua"]
    },
    "Littoral": {
      "Moungo": ["Nkongsamba","Mbanga","Loum","Manjo","Melong","Njombé-Penja","Eboné"],
      "Nkam": ["Yabassi","Yingui","Ndom","Ngambe","Nkondjock","Pouma"],
      "Sanaga-Maritime": ["Édéa","Dibamba","Dizangué","Kellé","Mouanko","Ndom","Nyanon","Pouma"],
      "Wouri": ["Douala"]
    },
    "Nord": {
      "Bénoué": ["Garoua","Dembo","Pitoa","Tcheboa","Bibemi","Lagdo"],
      "Faro": ["Poli","Beka","Tchamba"],
      "Mayo-Louti": ["Guider","Mayo-Oulo","Figuil","Mousgoy"],
      "Mayo-Rey": ["Tcholliré","Madingring","Rey-Bouba","Touboro"]
    },
    "Nord-Ouest": {
      "Boyo": ["Fundong","Belo","Njinikom"],
      "Bui": ["Kumbo","Jakiri","Mbven","Nkum","Noni","Oku"],
      "Donga-Mantung": ["Nkambe","Ako","Misaje","Ndu","Nwa"],
      "Menchum": ["Wum","Benakuma","Furu-Awa","Menchum","Zhoa"],
      "Mezam": ["Bamenda","Bafut","Bali","Santa","Tubah"],
      "Momo": ["Mbengwi","Batibo","Fundong","Njikwa","Widikum"],
      "Ngokentunjia": ["Ndop","Babessi","Balikumbat"]
    },
    "Ouest": {
      "Bamboutos": ["Mbouda","Babadjou","Batcham","Galim","Pinyin"],
      "Hauts-Plateaux": ["Baham","Bamendjou","Bangou","Bangangté"],
      "Haut-Nkam": ["Bafang","Bakou","Bana","Kekem","Bandja"],
      "Koupé-Manengouba": ["Bangem","Nguti","Tombel"],
      "Menoua": ["Dschang","Foréké-Dschang","Fongo-Tongo","Nkong-Zem","Penka-Michel","Santchou"],
      "Mifi": ["Bafoussam"],
      "Ndé": ["Bangangté","Bazou","Tonga"],
      "Noun": ["Foumban","Foumbot","Koutaba","Kouoptamo","Magba","Malentouen","Massangam","Njimom"]
    },
    "Sud": {
      "Dja-et-Lobo": ["Sangmélima","Bengbis","Djoum","Meyomessala","Meyomessi","Mintom","Oveng","Zoétélé"],
      "Mvila": ["Ebolowa","Biwong-Bane","Biwong-Bulu","Efoulan","Mengong","Mvangan","Ngoulemakong"],
      "Océan": ["Kribi","Akom II","Campo","Lolodorf","Lokoundjé","Bipindi","Mvengue","Niété"],
      "Vallée-du-Ntem": ["Ambam","Cca","Djoum","Kyé-Ossi","Ma'an","Olamze","Mengong"]
    },
    "Sud-Ouest": {
      "Fako": ["Buéa","Limbe","Muyuka","Tiko","Idenau","West Coast"],
      "Koupé-Manengouba": ["Bangem","Nguti","Tombel"],
      "Lebialem": ["Menji","Alou","Fontem","Wabane"],
      "Manyu": ["Mamfe","Akwaya","Eyumojock","Tinto"],
      "Meme": ["Kumba","Mbonge","Konye"],
      "Ndian": ["Mundemba","Ekondo-Titi","Idabato","Isangele","Kombo-Abedimo","Kombo-Itindi","Toko"]
    }
  };

  // Aplatir en liste pour l'autocomplétion
  const ALL_VILLES = [];
  for (const [region, depts] of Object.entries(CAMEROUN)) {
    for (const [dept, arrs] of Object.entries(depts)) {
      for (const arr of arrs) {
        if (!ALL_VILLES.find(v => v.ville === arr)) {
          ALL_VILLES.push({ ville: arr, dept, region });
        }
      }
    }
  }
  ALL_VILLES.sort((a,b) => a.ville.localeCompare(b.ville, 'fr'));

  // ══════════════════════════════════════════════════════════════════
  // BASE DE DONNÉES — DESTINATIONS INTERNATIONALES
  // Pays limitrophes + CEMAC + Nigeria
  // Villes réellement desservies par les agences camerounaises
  // ══════════════════════════════════════════════════════════════════
  const INTERNATIONAL = {
    "Nigeria": {
      code:"NG", flag:"🇳🇬", devise:"NGN",
      frontiere:["Ekok","Amchidé","Mora","Mamfe"],
      villes:[
        {ville:"Calabar",region:"Cross River",km:400,depuis:"Douala",duree:"10-14h"},
        {ville:"Enugu",region:"Enugu State",km:550,depuis:"Douala",duree:"14-18h"},
        {ville:"Onitsha",region:"Anambra State",km:600,depuis:"Douala",duree:"15-19h"},
        {ville:"Aba",region:"Abia State",km:580,depuis:"Douala",duree:"14-18h"},
        {ville:"Lagos",region:"Lagos State",km:1100,depuis:"Douala",duree:"18-24h"},
        {ville:"Abuja",region:"FCT",km:1300,depuis:"Yaoundé",duree:"22-30h"},
      ]
    },
    "Tchad": {
      code:"TD", flag:"🇹🇩", devise:"XAF",
      frontiere:["Kousseri","Blangoua","Maltam"],
      villes:[
        {ville:"N'Djamena",region:"Capitale",km:300,depuis:"Maroua",duree:"4-6h"},
        {ville:"Moundou",region:"Logone Occidental",km:600,depuis:"Maroua",duree:"10-14h"},
        {ville:"Sarh",region:"Moyen-Chari",km:800,depuis:"Garoua",duree:"14-18h"},
      ]
    },
    "Centrafrique": {
      code:"CF", flag:"🇨🇫", devise:"XAF",
      frontiere:["Garoua-Boulaï","Kentzou","Ngaoui"],
      villes:[
        {ville:"Bouar",region:"Nana-Mambéré",km:550,depuis:"Yaoundé",duree:"12-16h"},
        {ville:"Berbérati",region:"Mambéré-Kadéï",km:650,depuis:"Yaoundé",duree:"14-18h"},
        {ville:"Bangui",region:"Capitale",km:950,depuis:"Yaoundé",duree:"18-24h"},
      ]
    },
    "Gabon": {
      code:"GA", flag:"🇬🇦", devise:"XAF",
      frontiere:["Ambam","Kyé-Ossi","Campo"],
      villes:[
        {ville:"Bitam",region:"Woleu-Ntem",km:350,depuis:"Yaoundé",duree:"6-8h"},
        {ville:"Oyem",region:"Woleu-Ntem",km:450,depuis:"Yaoundé",duree:"8-12h"},
        {ville:"Libreville",region:"Estuaire",km:950,depuis:"Yaoundé",duree:"14-20h"},
      ]
    },
    "Guinée Équatoriale": {
      code:"GQ", flag:"🇬🇶", devise:"XAF",
      frontiere:["Kyé-Ossi","Campo"],
      villes:[
        {ville:"Ebebiyín",region:"Kie-Ntem",km:350,depuis:"Yaoundé",duree:"6-8h"},
        {ville:"Mongomo",region:"Wele-Nzas",km:450,depuis:"Yaoundé",duree:"8-12h"},
        {ville:"Bata",region:"Litoral",km:550,depuis:"Yaoundé",duree:"10-14h"},
      ]
    },
    "Congo": {
      code:"CG", flag:"🇨🇬", devise:"XAF",
      frontiere:["Moloundou","Sangmélima"],
      villes:[
        {ville:"Ouesso",region:"Sangha",km:800,depuis:"Yaoundé",duree:"18-24h"},
        {ville:"Brazzaville",region:"Capitale",km:2000,depuis:"Douala",duree:"36-48h"},
      ]
    }
  };

  // Liste aplatie des destinations internationales
  const ALL_DESTINATIONS_INTL = [];
  for(const [pays, data] of Object.entries(INTERNATIONAL)) {
    data.villes.forEach(v => {
      ALL_DESTINATIONS_INTL.push({
        ville: v.ville, pays, region: v.region, km: v.km,
        depuis: v.depuis, duree: v.duree,
        flag: data.flag, code: data.code, devise: data.devise
      });
    });
  }

  // Distances internationales depuis les hubs camerounais
  const KM_INTL = {
    "Douala-Calabar":400,"Douala-Enugu":550,"Douala-Lagos":1100,"Douala-Onitsha":600,"Douala-Aba":580,"Douala-Abuja":1400,
    "Yaoundé-Calabar":500,"Yaoundé-Lagos":1200,"Yaoundé-Enugu":650,"Yaoundé-Abuja":1300,
    "Bamenda-Calabar":350,"Bamenda-Enugu":450,"Bamenda-Lagos":1000,
    "Maroua-N'Djamena":300,"Garoua-N'Djamena":550,"Yaoundé-N'Djamena":1450,"Douala-N'Djamena":1650,
    "Maroua-Moundou":600,"Garoua-Moundou":500,"Garoua-Sarh":800,
    "Yaoundé-Bangui":950,"Douala-Bangui":1150,"Bertoua-Bangui":500,
    "Yaoundé-Bouar":550,"Yaoundé-Berbérati":650,
    "Yaoundé-Bitam":350,"Yaoundé-Oyem":450,"Yaoundé-Libreville":950,
    "Douala-Libreville":1050,"Douala-Oyem":550,
    "Yaoundé-Ebebiyín":350,"Yaoundé-Bata":550,"Yaoundé-Mongomo":450,
    "Douala-Bata":650,"Douala-Ebebiyín":450,
    "Ebolowa-Bitam":150,"Ebolowa-Ebebiyín":150,"Ebolowa-Libreville":700,
    "Ambam-Bitam":50,"Ambam-Libreville":650,"Kyé-Ossi-Ebebiyín":5,
    "Yaoundé-Ouesso":800,"Douala-Ouesso":900,
    "Douala-Brazzaville":2000,"Yaoundé-Brazzaville":1900,
  };

  function getKmIntl(dep, dest) {
    const key1=dep+'-'+dest, key2=dest+'-'+dep;
    return KM_INTL[key1]||KM_INTL[key2]||null;
  }

  function getTarifsIntl(depVille, destVille, km) {
    if(!km) km=800;
    const classique=Math.max(3000,Math.round(km*18/500)*500);
    const vip=Math.max(5000,Math.round(km*30/500)*500);
    return {classique,vip,km};
  }

  // ══════════════════════════════════════════════════════════════════
  // TRANSPORT MARCHANDISES — BASE DE DONNÉES
  // ══════════════════════════════════════════════════════════════════
  const TYPES_MARCHANDISES = [
    {id:'colis',label:'📦 Colis standard',desc:'Jusqu\'à 30 kg',prixKm:8},
    {id:'volumineux',label:'📐 Colis volumineux',desc:'Meubles, électroménager',prixKm:14},
    {id:'palette',label:'🏗 Palette / Lot',desc:'Marchandises en gros',prixKm:22},
    {id:'fragile',label:'🔮 Fragile',desc:'Électronique, verrerie',prixKm:18},
    {id:'alimentaire',label:'🥬 Denrées alimentaires',desc:'Produits frais ou secs',prixKm:12},
    {id:'vehicule',label:'🚗 Véhicule',desc:'Voiture, moto',prixKm:35},
  ];

  // ══════════════════════════════════════════════════════════════════
  // AUTOCOMPLÉTION
  // ══════════════════════════════════════════════════════════════════
  let selectedDepart = null;
  let selectedArrivee = null;
  let activeDropdown = null;

  function normalize(str) {
    return str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[-\s]+/g,' ').trim();
  }

  function setupAutocomplete(inputId, dropdownId, onSelect) {
    const input = document.getElementById(inputId);
    const dropdown = document.getElementById(dropdownId);
    let highlighted = -1;

    input.addEventListener('input', () => {
      const q = normalize(input.value);
      highlighted = -1;
      if (q.length < 1) { dropdown.classList.remove('open'); return; }

      const matches = ALL_VILLES.filter(v =>
        normalize(v.ville).includes(q) || normalize(v.dept).includes(q) || normalize(v.region).includes(q)
      ).slice(0, 40);

      if (matches.length === 0) {
        dropdown.innerHTML = '';
        var emptyDiv = document.createElement('div');
        emptyDiv.className = 'ac-empty';
        emptyDiv.textContent = 'Aucune ville trouvée pour "' + input.value + '"';
        dropdown.appendChild(emptyDiv);
        dropdown.classList.add('open');
        return;
      }

      // Grouper par région
      const byRegion = {};
      matches.forEach(m => {
        if (!byRegion[m.region]) byRegion[m.region] = [];
        byRegion[m.region].push(m);
      });

      let html = '';
      for (const [region, items] of Object.entries(byRegion)) {
        html += `<div class="ac-region">${region}</div>`;
        items.forEach(item => {
          html += `<div class="ac-item" data-ville="${item.ville}" data-dept="${item.dept}" data-region="${item.region}">
            <span>${item.ville}</span>
            <span class="ac-dept">${item.dept}</span>
          </div>`;
        });
      }

      dropdown.innerHTML = html;
      dropdown.classList.add('open');

      dropdown.querySelectorAll('.ac-item').forEach(el => {
        el.addEventListener('mousedown', (e) => {
          e.preventDefault();
          const ville = el.dataset.ville;
          const dept = el.dataset.dept;
          const region = el.dataset.region;
          input.value = ville;
          dropdown.classList.remove('open');
          onSelect({ ville, dept, region });
        });
      });
    });

    input.addEventListener('keydown', (e) => {
      const items = dropdown.querySelectorAll('.ac-item');
      if (e.key === 'ArrowDown') { highlighted = Math.min(highlighted+1, items.length-1); updateHighlight(items, highlighted); e.preventDefault(); }
      if (e.key === 'ArrowUp')   { highlighted = Math.max(highlighted-1, 0); updateHighlight(items, highlighted); e.preventDefault(); }
      if (e.key === 'Enter' && highlighted >= 0) { items[highlighted].dispatchEvent(new MouseEvent('mousedown')); }
      if (e.key === 'Escape') dropdown.classList.remove('open');
    });

    input.addEventListener('focus', () => { if (input.value.length > 0) input.dispatchEvent(new Event('input')); });
    input.addEventListener('blur', () => setTimeout(() => dropdown.classList.remove('open'), 200));
  }

  function updateHighlight(items, idx) {
    items.forEach((el,i) => el.classList.toggle('highlighted', i===idx));
    if (items[idx]) items[idx].scrollIntoView({ block:'nearest' });
  }

  setupAutocomplete('departInput', 'departDropdown', (v) => { selectedDepart = v; });
  setupAutocomplete('arriveeInput', 'arriveeDropdown', (v) => { selectedArrivee = v; });

  // Swap
  document.getElementById('swapBtn').addEventListener('click', () => {
    const tmp = selectedDepart; selectedDepart = selectedArrivee; selectedArrivee = tmp;
    document.getElementById('departInput').value = selectedDepart ? selectedDepart.ville : '';
    document.getElementById('arriveeInput').value = selectedArrivee ? selectedArrivee.ville : '';
  });

  // ══════════════════════════════════════════════════════════════════
  // CALCUL TARIFAIRE (basé sur distance inter-régions)
  // ══════════════════════════════════════════════════════════════════
  // ══════════════════════════════════════════════════════════════════
  // CALCUL TARIFAIRE — Arrêté Mincommerce 26 fév. 2024
  // Base officielle : 16 FCFA/km (adulte)
  // Classique ≈ 16–18 F/km | VIP ≈ 26–30 F/km (climatisé + collation)
  // Tarifs indicatifs — négociation gré à gré possible
  // ══════════════════════════════════════════════════════════════════

  // Distances routières approximatives (km) entre chefs-lieux de régions
  const KM_REGIONS = {
    "Centre-Centre":       0,
    "Littoral-Littoral":   0,
    "Ouest-Ouest":         0,
    "Adamaoua-Adamaoua":   0,
    "Nord-Nord":           0,
    "Extrême-Nord-Extrême-Nord": 0,
    "Est-Est":             0,
    "Sud-Sud":             0,
    "Sud-Ouest-Sud-Ouest": 0,
    "Nord-Ouest-Nord-Ouest": 0,

    "Centre-Littoral":     240,   // Yaoundé–Douala
    "Centre-Ouest":        270,   // Yaoundé–Bafoussam
    "Centre-Nord-Ouest":   370,   // Yaoundé–Bamenda
    "Centre-Sud-Ouest":    390,   // Yaoundé–Buéa
    "Centre-Est":          330,   // Yaoundé–Bertoua
    "Centre-Sud":          150,   // Yaoundé–Ebolowa
    "Centre-Adamaoua":     450,   // Yaoundé–Ngaoundéré
    "Centre-Nord":         780,   // Yaoundé–Garoua
    "Centre-Extrême-Nord": 1100,  // Yaoundé–Maroua

    "Littoral-Ouest":      190,   // Douala–Bafoussam
    "Littoral-Nord-Ouest": 350,   // Douala–Bamenda
    "Littoral-Sud-Ouest":  80,    // Douala–Buéa
    "Littoral-Sud":        320,   // Douala–Ebolowa
    "Littoral-Est":        570,   // Douala–Bertoua
    "Littoral-Adamaoua":   610,   // Douala–Ngaoundéré
    "Littoral-Nord":       950,   // Douala–Garoua
    "Littoral-Extrême-Nord":1260, // Douala–Maroua

    "Ouest-Nord-Ouest":    160,   // Bafoussam–Bamenda
    "Ouest-Sud-Ouest":     240,   // Bafoussam–Buéa
    "Ouest-Adamaoua":      380,   // Bafoussam–Ngaoundéré
    "Ouest-Nord":          700,   // Bafoussam–Garoua
    "Ouest-Extrême-Nord":  1000,  // Bafoussam–Maroua
    "Ouest-Est":           500,   // Bafoussam–Bertoua
    "Ouest-Sud":           380,   // Bafoussam–Ebolowa

    "Nord-Ouest-Sud-Ouest":350,   // Bamenda–Buéa
    "Nord-Ouest-Adamaoua": 540,   // Bamenda–Ngaoundéré
    "Nord-Ouest-Est":      650,   // Bamenda–Bertoua

    "Sud-Ouest-Est":       600,   // Buéa–Bertoua
    "Sud-Ouest-Adamaoua":  650,   // Buéa–Ngaoundéré

    "Est-Adamaoua":        420,   // Bertoua–Ngaoundéré
    "Est-Nord":            750,   // Bertoua–Garoua
    "Est-Extrême-Nord":   1050,   // Bertoua–Maroua
    "Est-Sud":             450,   // Bertoua–Ebolowa

    "Adamaoua-Nord":       320,   // Ngaoundéré–Garoua
    "Adamaoua-Extrême-Nord":640,  // Ngaoundéré–Maroua
    "Adamaoua-Sud":        580,   // Ngaoundéré–Ebolowa

    "Nord-Extrême-Nord":   320,   // Garoua–Maroua
    "Nord-Sud":            920,
    "Extrême-Nord-Sud":   1240,

    "Sud-Ouest-Nord":      980,
    "Sud-Ouest-Extrême-Nord":1290,
    "Nord-Ouest-Nord":     780,
    "Nord-Ouest-Extrême-Nord":1080,
    "Sud-Est":             450,
  };

  function getKmDistance(r1, r2) {
    if (r1 === r2) return 60; // intra-région
    const key1 = `${r1}-${r2}`;
    const key2 = `${r2}-${r1}`;
    return KM_REGIONS[key1] || KM_REGIONS[key2] || 500; // 500 km par défaut
  }

  function arrondir(n, multiple) {
    return Math.round(n / multiple) * multiple;
  }

  function getTarifs(dep, arr) {
    if (!dep || !arr) return null;
    let km;
    if (dep.ville === arr.ville) return { classique: 0, vip: 0, km: 0 };
    if (dep.dept === arr.dept) km = 35;
    else if (dep.region === arr.region) km = 120;
    else km = getKmDistance(dep.region, arr.region);

    // Arrêté Mincommerce 2024 : 16 FCFA/km adulte (classique)
    // VIP : ~1.65× le classique (bus climatisé + collation)
    // Arrondi au 500 FCFA le plus proche (usage réel)
    const classique = Math.max(1000, arrondir(km * 16, 500));
    const vip       = Math.max(2000, arrondir(km * 27, 500));
    return { classique, vip, km };
  }

  // Garde l'ancienne signature pour getDuree
  function getDuree(km) {
    if (km <= 0)    return "< 5 min";
    if (km <= 50)   return "30–60 min";
    if (km <= 120)  return "1h30–2h30";
    if (km <= 250)  return "2h30–4h";
    if (km <= 400)  return "3h30–5h30";
    if (km <= 600)  return "5h–8h";
    if (km <= 900)  return "8h–12h";
    return "12h–16h";
  }

  function formatPrix(n) { return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " "); }

  // ══════════════════════════════════════════════════════════════════
  // BASE DE DONNÉES CHAUFFEURS (simulée — en prod: API backend)
  // TYPE A = Partenaire CTL validé | TYPE B = Occasionnel
  // ══════════════════════════════════════════════════════════════════
  const CHAUFFEURS = [
    { id:'C001', nom:'Jean-Pierre Mbarga', initiales:'JM', type:'partenaire',
      note:4.9, trajets:312, vehicule:'Toyota HiAce 2021', places:8,
      ligne:'Douala–Yaoundé', tel:'6XX XXX XXX' },
    { id:'C002', nom:'Alphonse Nkemdirim', initiales:'AN', type:'partenaire',
      note:4.7, trajets:187, vehicule:'Coaster 2020', places:12,
      ligne:'Douala–Bafoussam', tel:'6XX XXX XXX' },
    { id:'C003', nom:'Rodrigue Fon', initiales:'RF', type:'partenaire',
      note:4.8, trajets:94, vehicule:'Toyota Land Cruiser 2022', places:5,
      ligne:'Yaoundé–Bamenda', tel:'6XX XXX XXX' },
    { id:'C004', nom:'Paul Talla', initiales:'PT', type:'occasionnel',
      note:null, trajets:3, vehicule:'Toyota Camry 2018', places:4,
      ligne:null, tel:'6XX XXX XXX' },
    { id:'C005', nom:'Sylvie Bello', initiales:'SB', type:'occasionnel',
      note:null, trajets:1, vehicule:'Peugeot 301 2019', places:3,
      ligne:null, tel:'6XX XXX XXX' },
    { id:'C006', nom:'Ernest Ngo', initiales:'EN', type:'partenaire',
      note:4.6, trajets:58, vehicule:'Minibus Hiace 2020', places:10,
      ligne:'Garoua–Maroua', tel:'6XX XXX XXX' },
  ];

  // ══════════════════════════════════════════════════════════════════
  // MOTEUR DE RECHERCHE
  // ══════════════════════════════════════════════════════════════════
  function rechercherTrajet() {
    if (!selectedDepart) {
      const v = ALL_VILLES.find(x => normalize(x.ville) === normalize(document.getElementById('departInput').value));
      if (v) selectedDepart = v;
    }
    if (!selectedArrivee) {
      const v = ALL_VILLES.find(x => normalize(x.ville) === normalize(document.getElementById('arriveeInput').value));
      if (v) selectedArrivee = v;
    }

    const results = document.getElementById('searchResults');
    const date = document.getElementById('dateVoyage').value;
    const quartierDep = document.getElementById('quartierDepart')?.value?.trim() || '';
    const quartierArr = document.getElementById('quartierArrivee')?.value?.trim() || '';

    if (!selectedDepart && !selectedArrivee) {
      results.innerHTML = `<div class="no-direct-route"><p>⚠️ Veuillez saisir une ville de départ et d'arrivée.</p></div>`;
      results.classList.add('open'); return;
    }
    if (!selectedDepart) { alert("Veuillez sélectionner une ville de départ."); return; }
    if (!selectedArrivee) { alert("Veuillez sélectionner une ville d'arrivée."); return; }
    if (selectedDepart.ville === selectedArrivee.ville) {
      results.innerHTML = `<div class="no-direct-route"><p>⚠️ Les villes de départ et d'arrivée sont identiques.</p></div>`;
      results.classList.add('open'); return;
    }
    // Validation date : pas de date passée
    if (date) {
      var dateChoisie = new Date(date); var aujourdhui = new Date(); aujourdhui.setHours(0,0,0,0);
      if (dateChoisie < aujourdhui) {
        results.innerHTML = `<div class="no-direct-route"><p>⚠️ La date de voyage ne peut pas être dans le passé.</p></div>`;
        results.classList.add('open'); return;
      }
    }

    const tarifs  = getTarifs(selectedDepart, selectedArrivee);
    const { classique, vip, km } = tarifs;
    const duree   = getDuree(km);
    const kmStr   = km > 0 ? `~${km} km` : "même ville";
    const quartierDepStr = quartierDep ? ` · départ : ${quartierDep}` : '';
    const quartierArrStr = quartierArr ? ` · arrivée : ${quartierArr}` : '';
    const dateStr = date
      ? new Date(date).toLocaleDateString('fr-FR', {weekday:'long', day:'numeric', month:'long'})
      : "Date à confirmer";

    // Horaires variés pour chaque résultat
    const tousHoraires = ["05h30","06h00","07h30","08h00","10h00","11h30","14h00","15h30","16h00","20h00"];
    const shuffle = arr => arr.sort(() => Math.random() - 0.5);

    // Construire la liste des trajets disponibles
    // D'abord les partenaires, puis les occasionnels
    const TRAJETS = [
      // ── Partenaires CTL ──
      { chauffeur: CHAUFFEURS[0], horaire: shuffle([...tousHoraires])[0], classe: 'Classique', prix: classique, places: 8  },
      { chauffeur: CHAUFFEURS[1], horaire: shuffle([...tousHoraires])[0], classe: 'VIP',       prix: vip,       places: 5  },
      { chauffeur: CHAUFFEURS[2], horaire: shuffle([...tousHoraires])[0], classe: 'VIP',       prix: vip,       places: 2  },
      // ── Occasionnels ──
      { chauffeur: CHAUFFEURS[3], horaire: shuffle([...tousHoraires])[0], classe: 'Classique', prix: classique, places: 3  },
      { chauffeur: CHAUFFEURS[4], horaire: shuffle([...tousHoraires])[0], classe: 'Classique', prix: arrondir(classique * 0.9, 500), places: 2 },
    ].sort(() => Math.random() - 0.5)
     .sort((a, b) => {
       if (a.chauffeur.type === 'partenaire' && b.chauffeur.type !== 'partenaire') return -1;
       if (a.chauffeur.type !== 'partenaire' && b.chauffeur.type === 'partenaire') return 1;
       return 0;
     });

    const nbResultats = TRAJETS.length;

    let html = `
      <div class="results-header">
        <div class="rh-title">${selectedDepart.ville} <span style="color:var(--or)">→</span> ${selectedArrivee.ville}</div>
        <div class="rh-count">${nbResultats} trajet${nbResultats > 1 ? 's' : ''} disponible${nbResultats > 1 ? 's' : ''} · ${dateStr}${quartierDepStr}${quartierArrStr}</div>
      </div>`;

    // Bandeau info tarifaire
    html += `
      <div style="background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.18);border-radius:8px;padding:12px 18px;margin-bottom:16px;display:flex;gap:24px;flex-wrap:wrap;align-items:center;">
        <span style="font-size:11px;color:rgba(255,255,255,0.45);letter-spacing:1px;text-transform:uppercase;">Tarifs indicatifs · ${kmStr} · ${duree}</span>
        <span style="font-size:13px;color:rgba(255,255,255,0.75);">🚌 Classique&nbsp;<strong style="color:var(--or)">${formatPrix(classique)} FCFA</strong></span>
        <span style="font-size:13px;color:rgba(255,255,255,0.75);">🌟 VIP&nbsp;<strong style="color:var(--or)">${formatPrix(vip)} FCFA</strong></span>
        <span style="font-size:10px;color:rgba(255,255,255,0.3);">Base : 16 F/km · Arr. Mincommerce 26/02/2024</span>
      </div>`;

    // Légende badges
    html += `
      <div style="display:flex;gap:14px;margin-bottom:18px;flex-wrap:wrap;align-items:center;">
        <span style="font-size:11px;color:rgba(255,255,255,0.35);">Types de chauffeurs :</span>
        <span class="badge-partenaire" data-fr='<span class="bp-shield">🛡</span><span class="bp-check">✓</span> CTL Partenaire' data-en='<span class="bp-shield">🛡</span><span class="bp-check">✓</span> CTL Partner'><span class="bp-shield">🛡</span><span class="bp-check">✓</span> CTL Partenaire</span>
        <span class="badge-occasionnel" data-fr="● Occasionnel" data-en="● Occasional">● Occasionnel</span>
      </div>`;

    TRAJETS.forEach((t) => {
      const c = t.chauffeur;
      const isPartenaire = c.type === 'partenaire';
      const isVIP = t.classe === 'VIP';

      const badgeHTML = isPartenaire
        ? `<span class="badge-partenaire" data-fr='<span class="bp-shield">🛡</span><span class="bp-check">✓</span> CTL Partenaire' data-en='<span class="bp-shield">🛡</span><span class="bp-check">✓</span> CTL Partner'><span class="bp-shield">🛡</span><span class="bp-check">✓</span> CTL Partenaire</span>`
        : `<span class="badge-occasionnel" data-fr="● Occasionnel" data-en="● Occasional">● Occasionnel</span>`;

      const classeBadge = isVIP
        ? `<span style="font-size:10px;font-weight:700;background:rgba(212,168,0,0.15);border:1px solid rgba(212,168,0,0.4);color:var(--or);padding:2px 8px;border-radius:100px;letter-spacing:1px;text-transform:uppercase;">🌟 VIP</span>`
        : `<span style="font-size:10px;font-weight:600;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.45);padding:2px 8px;border-radius:100px;letter-spacing:1px;text-transform:uppercase;">🚌 Classique</span>`;

      const noteHTML = isPartenaire && c.note
        ? `<span class="driver-note">⭐ ${c.note} <span style="font-size:10px;color:rgba(255,255,255,0.3);font-weight:400">(${c.trajets} trajets)</span></span>`
        : `<span style="font-size:11px;color:rgba(255,255,255,0.3);">${c.trajets} trajet${c.trajets > 1 ? 's' : ''} effectué${c.trajets > 1 ? 's' : ''}</span>`;

      html += `
        <div class="result-card ${isPartenaire ? 'is-partenaire' : 'is-occasionnel'}">
          <div>
            <div class="rc-route">
              ${selectedDepart.ville} <span class="arr">→</span> ${selectedArrivee.ville}
              &nbsp;${badgeHTML}&nbsp;${classeBadge}
            </div>
            <div class="rc-meta" style="margin-top:6px;">
              ⏰ Départ ${t.horaire}
              &nbsp;·&nbsp; ⏱ ${duree}
              &nbsp;·&nbsp; 📍 ${kmStr}
              &nbsp;·&nbsp; 💺 ${t.places} place${t.places > 1 ? 's' : ''} restante${t.places > 1 ? 's' : ''}
            </div>
            <div class="driver-row">
              <div class="driver-avatar ${isPartenaire ? 'partenaire' : 'occasionnel'}">${c.initiales}</div>
              <div class="driver-info">
                <div class="driver-name">
                  ${c.nom}
                  ${isPartenaire ? `<span style="font-size:10px;color:var(--vert2);font-weight:600;">● Profil vérifié</span>` : ''}
                </div>
                <div class="driver-meta">${c.vehicule}${isPartenaire && c.ligne ? ` · Habitué ${c.ligne}` : ''}</div>
              </div>
              ${noteHTML}
            </div>
          </div>
          <div class="rc-price">${formatPrix(t.prix)} <small>FCFA / pers.</small></div>
          <div style="display:flex;flex-direction:column;gap:6px;">
          <button class="btn-book" onclick="reserverBillet('${selectedDepart.ville}','${selectedArrivee.ville}','${t.horaire}','${t.prix}','${c.nom}','${isPartenaire}')" data-fr="Réserver" data-en="Book">Réserver</button>
          <button style="background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);padding:8px 16px;border-radius:6px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;" onclick="ouvrirBilletTiers('${selectedDepart.ville}','${selectedArrivee.ville}','${t.horaire}','${t.prix}','${c.nom}')">🎫 Pour un tiers</button>
        </div>
        </div>`;
    });

    results.innerHTML = html;
    results.classList.add('open');
    results.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }

  function getCityHub(r1, r2) {
    const hubs = {
      "Centre":"Yaoundé","Littoral":"Douala","Ouest":"Bafoussam","Nord-Ouest":"Bamenda",
      "Adamaoua":"Ngaoundéré","Nord":"Garoua","Extrême-Nord":"Maroua","Est":"Bertoua",
      "Sud":"Ebolowa","Sud-Ouest":"Buéa"
    };
    return `<strong style="color:var(--or)">${hubs[r1] || r1}</strong> ou <strong style="color:var(--or)">${hubs[r2] || r2}</strong>`;
  }

  // ══════════════════════════════════════════════════════════════════
  // PROFIL SAUVEGARDÉ (localStorage)
  // ══════════════════════════════════════════════════════════════════
  const PROFIL_KEY = 'ctl_profil_voyageur';

  function chargerProfil() {
    try { return JSON.parse(localStorage.getItem(PROFIL_KEY)) || null; }
    catch(e) { return null; }
  }

  function sauvegarderProfil(data) {
    try { localStorage.setItem(PROFIL_KEY, JSON.stringify(data)); } catch(e) {}
  }

  function supprimerProfil() {
    try { localStorage.removeItem(PROFIL_KEY); } catch(e) {}
  }

  // ── CONTACTS FAMILLE ──
  let nbContacts = 1;

  function ajouterContact() {
    if (nbContacts >= 3) return;
    nbContacts++;
    const zone = document.getElementById('contactsZone');
    const div  = document.createElement('div');
    div.id = `contactBloc${nbContacts}`;
    div.className = 'contact-famille-block';
    div.innerHTML = `
      <div class="cfb-title">Contact ${nbContacts} <span class="cfb-badge opt">Optionnel</span></div>
      <div class="form-row">
        <div class="form-field">
          <label>Prénom & Nom</label>
          <input type="text" placeholder="Ex: Marie Ngo" id="cf${nbContacts}nom">
        </div>
        <div class="form-field">
          <label>Téléphone</label>
          <input type="tel" placeholder="Ex: 6XX XXX XXX" id="cf${nbContacts}tel">
        </div>
      </div>
      <div class="form-row single">
        <div class="form-field">
          <label>Lien de parenté</label>
          <select id="cf${nbContacts}lien">
            <option value="">-- Choisir --</option>
            <option>Époux/Épouse</option><option>Père/Mère</option>
            <option>Frère/Sœur</option><option>Enfant</option>
            <option>Ami(e) proche</option><option>Autre</option>
          </select>
        </div>
      </div>`;
    zone.appendChild(div);
    const btn = document.getElementById('btnAjouterContact');
    if (nbContacts >= 3) { btn.style.display = 'none'; }
    else { btn.innerHTML = `＋ Ajouter un contact (${nbContacts}/3)`; }
  }

  // ── PRÉREMPLISSAGE depuis profil sauvegardé ──
  function preremplirFormulaire(profil) {
    if (!profil) return;
    const set = (id, val) => { const el = document.getElementById(id); if (el && val) el.value = val; };
    set('pasPrenom', profil.prenom);
    set('pasNom',    profil.nom);
    set('pasDateNaissance', profil.ddn);
    set('pasTel',    profil.tel);
    set('pasEmail',  profil.email);
    set('cf1nom',    profil.cf1nom);
    set('cf1tel',    profil.cf1tel);
    set('cf1lien',   profil.cf1lien);
    // Contact 2 si présent
    if (profil.cf2nom) {
      ajouterContact();
      set('cf2nom',  profil.cf2nom);
      set('cf2tel',  profil.cf2tel);
      set('cf2lien', profil.cf2lien);
    }
    // Contact 3 si présent
    if (profil.cf3nom) {
      if (nbContacts < 3) ajouterContact();
      set('cf3nom',  profil.cf3nom);
      set('cf3tel',  profil.cf3tel);
      set('cf3lien', profil.cf3lien);
    }
  }

  // ── OUVERTURE MODAL ──
  function reserverBillet(dep, arr, heure, prix, chauffeur, partenaire, mode, pays, flag, frontiere, devise) {
    const isIntl = mode === 'intl';
    nbContacts = 1;
    const prixFmt     = Number(prix).toString().replace(/\B(?=(\d{3})+(?!\d))/g," ");
    const profilExist = chargerProfil();
    const statutBadge = partenaire === 'true'
      ? `<span class="badge-partenaire" style="font-size:11px;"><span class="bp-shield">🛡</span><span class="bp-check">✓</span> CTL Partenaire</span>`
      : `<span class="badge-occasionnel" style="font-size:11px;" data-fr="● Occasionnel" data-en="● Occasional">● Occasionnel</span>`;

    const banniereProfilHTML = profilExist ? `
      <div class="profil-banner" id="profilBanner">
        <span class="pb-ico">⚡</span>
        <div class="pb-text">
          <strong>Profil sauvegardé détecté</strong>
          <span>Formulaire prérempli avec vos informations — ${profilExist.prenom} ${profilExist.nom}</span>
        </div>
        <button class="pb-change" onclick="viderFormulaire()">Changer de profil</button>
      </div>` : '';

    document.getElementById('modalBox').innerHTML = `
      <div class="modal-header">
        <div>
          <div class="mh-title">Réservation du billet</div>
          <div class="mh-sub">Remplissez vos informations pour finaliser votre réservation</div>
        </div>
        <button class="modal-close" onclick="fermerModal()">✕</button>
      </div>

      <!-- Récap trajet -->
      <div class="modal-recap">
        <span>📍 <strong>${dep} → ${arr}</strong></span>
        <span class="mr-sep">|</span>
        <span>⏰ <strong>${heure}</strong></span>
        <span class="mr-sep">|</span>
        <span>👤 ${chauffeur} &nbsp;${statutBadge}</span>
        <span class="mr-sep">|</span>
        <span>💰 <strong style="color:var(--or)">${prixFmt} FCFA</strong></span>
      </div>

      ${banniereProfilHTML}

      ${isIntl ? `<div style="margin:0 28px;padding:14px 18px;background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.2);border-radius:8px;display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:rgba(255,255,255,0.65);">
        <span>${flag||'🌍'} <strong>Voyage international — ${pays||'CEMAC'}</strong></span>
        <span>🛂 Frontière : <strong style="color:var(--or)">${frontiere||'—'}</strong></span>
        <span>💱 Devise : <strong>${devise==='XAF'?'FCFA (zone CEMAC)':"NGN — change à l'arrivée"}</strong></span>
        <span>📍 GPS actif au-delà de la frontière</span>
        <span>🆘 SOS international disponible</span>
      </div>` : ''}

      <div class="modal-body">

        <!-- Passager -->
        <div class="modal-section-title">👤 Informations du passager</div>
        <div class="form-row">
          <div class="form-field">
            <label>Prénom <span class="req">*</span></label>
            <input type="text" id="pasPrenom" placeholder="Ex: Jean-Pierre">
          </div>
          <div class="form-field">
            <label>Nom <span class="req">*</span></label>
            <input type="text" id="pasNom" placeholder="Ex: Mbarga">
          </div>
        </div>
        <div class="form-row triple">
          <div class="form-field">
            <label>Date de naissance <span class="req">*</span></label>
            <input type="date" id="pasDateNaissance">
          </div>
          <div class="form-field">
            <label>Téléphone <span class="req">*</span></label>
            <input type="tel" id="pasTel" placeholder="6XX XXX XXX">
          </div>
          <div class="form-field">
            <label>Adresse e-mail <span class="req">*</span></label>
            <input type="email" id="pasEmail" placeholder="exemple@mail.com">
          </div>
        </div>

        <!-- Contacts famille -->
        <div class="modal-section-title">👨‍👩‍👧 Contacts famille & urgence</div>
        <p style="font-size:13px;color:rgba(255,255,255,0.4);margin-bottom:16px;line-height:1.5;">
          Ces personnes recevront des SMS automatiques à chaque étape de votre trajet
          (départ, pauses, arrivée) et seront contactées en cas d'urgence.
          Jusqu'à <strong style="color:var(--white)">3 contacts</strong> possibles.
        </p>
        <div id="contactsZone">
          <div class="contact-famille-block" id="contactBloc1">
            <div class="cfb-title">Contact 1 <span class="cfb-badge">Obligatoire</span></div>
            <div class="form-row">
              <div class="form-field">
                <label>Prénom & Nom <span class="req">*</span></label>
                <input type="text" placeholder="Ex: Marie Ngo" id="cf1nom">
              </div>
              <div class="form-field">
                <label>Téléphone <span class="req">*</span></label>
                <input type="tel" placeholder="Ex: 6XX XXX XXX" id="cf1tel">
              </div>
            </div>
            <div class="form-row single">
              <div class="form-field">
                <label>Lien de parenté <span class="req">*</span></label>
                <select id="cf1lien">
                  <option value="">-- Choisir --</option>
                  <option>Époux/Épouse</option><option>Père/Mère</option>
                  <option>Frère/Sœur</option><option>Enfant</option>
                  <option>Ami(e) proche</option><option>Autre</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        <button class="btn-add-contact" id="btnAjouterContact" onclick="ajouterContact()">
          ＋ Ajouter un 2ème contact (1/3)
        </button>

        <!-- Sauvegarde profil -->
        <div class="modal-section-title">💾 Sauvegarde du profil</div>
        <div class="save-profil-block" id="saveProfilBlock">
          <label class="save-toggle">
            <input type="checkbox" id="chkSaveProfil" ${profilExist ? 'checked' : ''} onchange="toggleSaveDetails()">
            <span class="save-toggle-box"></span>
            <div class="save-toggle-text">
              <strong>${profilExist ? 'Mettre à jour mon profil sauvegardé' : 'Sauvegarder mes informations pour mes prochains trajets'}</strong>
              <span>${profilExist
                ? 'Vos nouvelles informations remplaceront le profil existant.'
                : 'Préremplissage automatique à votre prochaine réservation. Données stockées uniquement sur cet appareil.'
              }</span>
            </div>
          </label>
          <div class="save-details" id="saveDetails" style="display:${profilExist ? 'block' : 'none'}">
            <div class="save-what">
              <span>✓ Nom & Prénom</span>
              <span>✓ Date de naissance</span>
              <span>✓ Téléphone & Email</span>
              <span>✓ Contacts famille</span>
            </div>
            ${profilExist ? `
            <button class="btn-delete-profil" onclick="demanderSuppressionProfil()">
              🗑 Supprimer mon profil sauvegardé
            </button>` : ''}
          </div>
        </div>

      </div>

      <!-- Infos légales pleine largeur -->
      <div class="disclaimer-block" style="border-radius:0;border-left:none;border-right:none;border-bottom:none;border-top:1px solid rgba(255,255,255,0.07);margin:0;">
        <div class="disclaimer-header" onclick="(function(el){var b=el.querySelector('#dc-resa-body');var t=el.querySelector('.dh-toggle');var open=b.style.display!=='none';b.style.display=open?'none':'';t.style.transform=open?'':' rotate(180deg)';})( this.closest('.disclaimer-block'))">
          <span class="dh-ico">ℹ️</span>
          <span class="dh-title">Informations légales — À lire avant de confirmer</span>
          <span class="dh-toggle" style="transition:transform 0.2s;display:inline-block;">▼</span>
        </div>
        <div id="dc-resa-body" class="disclaimer-body">
          <p>En confirmant, vous reconnaissez que <strong>CTL est une plateforme de mise en relation</strong> et n'est pas partie au contrat de transport.</p>
          <ul class="db-points"><li>📍 <strong>GPS temps réel</strong> partagé avec vos contacts famille${isIntl?' (actif au-delà de la frontière)':''}</li><li>🚨 <strong>SOS multi-alertes</strong> disponible pour le chauffeur${isIntl?' — couverture internationale':''}</li><li>📲 <strong>SMS automatiques</strong> à chaque étape du trajet${isIntl?' (SMS internationaux inclus)':''}</li><li>🔒 <strong>Données protégées</strong> — loi n°2024/017 du 23 décembre 2024</li>${isIntl?'<li>🛂 <strong>Documents requis</strong> : passeport valide'+(devise!=='XAF'?' + visa':'')+'</li><li>💱 <strong>Devise</strong> : '+(devise==='XAF'?'FCFA — zone CEMAC, pas de change':'Naira nigérian — change proposé à l&#39;arrivée')+'</li>':''}</ul>
          <p style="margin-top:8px;padding-top:8px;border-top:1px solid rgba(224,80,80,0.2);color:rgba(224,80,80,0.85);font-size:11.5px;">En cas d'incident, CTL communique les données aux autorités compétentes (loi n°2010/012).</p>
        </div>
      </div>
      <div class="modal-footer">
        <div>
          <div class="mf-price">${prixFmt} FCFA<small>Total à payer / personne</small></div>
        </div>
        <div class="mf-actions">
          <button class="btn-cancel-modal" onclick="fermerModal()">Annuler</button>
          <button class="btn-confirm-resa" onclick="confirmerReservation('${dep}','${arr}','${heure}','${prixFmt}','${chauffeur}')">
            Confirmer & Payer →
          </button>
        </div>
      </div>`;

    document.getElementById('modalResa').classList.add('open');
    document.body.style.overflow = 'hidden';

    // Préremplir si profil existant
    if (profilExist) {
      setTimeout(() => preremplirFormulaire(profilExist), 50);
    }
  }

  function toggleSaveDetails() {
    const checked = document.getElementById('chkSaveProfil').checked;
    document.getElementById('saveDetails').style.display = checked ? 'block' : 'none';
  }

  function viderFormulaire() {
    ['pasPrenom','pasNom','pasDateNaissance','pasTel','pasEmail',
     'cf1nom','cf1tel','cf1lien'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    const banner = document.getElementById('profilBanner');
    if (banner) banner.remove();
  }

  function demanderSuppressionProfil() {
    if (confirm('Voulez-vous vraiment supprimer votre profil sauvegardé ? Cette action est irréversible.')) {
      supprimerProfil();
      fermerModal();
      alert('✓ Votre profil sauvegardé a été supprimé.');
    }
  }

  function fermerModal() {
    document.getElementById('modalResa').classList.remove('open');
    document.body.style.overflow = '';
    nbContacts = 1;
  }

  document.getElementById('modalResa').addEventListener('click', function(e) {
    if (e.target === this) fermerModal();
  });

  // ══════════════════════════════════════════════════════════
  //  TUNNEL DE PAIEMENT — Phase 2
  //  Étape 1 : récap + choix mode paiement
  //  Étape 2 : saisie numéro + spinner PIN
  //  Étape 3 : confirmation + e-billet
  // ══════════════════════════════════════════════════════════

  let _paiData = {};   // stocke les données inter-étapes

  function confirmerReservation(dep, arr, heure, prix, chauffeur) {
    const get = id => (document.getElementById(id)?.value||'').trim();
    const prenom=get('pasPrenom'), nom=get('pasNom'), ddn=get('pasDateNaissance'),
          tel=get('pasTel'), email=get('pasEmail'),
          cf1nom=get('cf1nom'), cf1tel=get('cf1tel'), cf1lien=get('cf1lien');

    if (!prenom||!nom||!ddn||!tel||!email){alert('⚠️ Veuillez remplir tous les champs obligatoires.');return;}
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){alert('⚠️ Adresse e-mail invalide. Format attendu : exemple@domaine.com');return;}
    var telResa=tel.replace(/[\s\-\.]/g,'');
    if(!/^(\+237)?[26][0-9]{7,8}$/.test(telResa)){alert('⚠️ Numéro de téléphone invalide. Format attendu : 6XX XXX XXX');return;}
    var ddnDate=new Date(ddn),ageR=new Date().getFullYear()-ddnDate.getFullYear();
    if(isNaN(ageR)||ageR<0||ageR>120){alert('⚠️ Date de naissance invalide.');return;}
    if (!cf1nom||!cf1tel||!cf1lien){alert('⚠️ Veuillez renseigner au moins un contact famille.');return;}
    var cf1telClean=cf1tel.replace(/[\s\-\.]/g,'');
    if(!/^(\+237)?[26][0-9]{7,8}$/.test(cf1telClean)){alert('⚠️ Numéro de téléphone du contact famille invalide.');return;}

    const doSave = document.getElementById('chkSaveProfil')?.checked;
    if(doSave) sauvegarderProfil({prenom,nom,ddn,tel,email,cf1nom,cf1tel,cf1lien,
      cf2nom:get('cf2nom'),cf2tel:get('cf2tel'),cf2lien:get('cf2lien'),
      cf3nom:get('cf3nom'),cf3tel:get('cf3tel'),cf3lien:get('cf3lien'),
      savedAt:new Date().toLocaleDateString('fr-FR')});

    const ref = 'CTL-'+Math.random().toString(36).substr(2,6).toUpperCase();
    _paiData = {dep,arr,heure,prix,chauffeur,prenom,nom,tel,email,ref,doSave};
    _afficherEtape1();
  }

  // ─── ÉTAPE 1 : Récap + choix mode paiement ───────────────
  function _afficherEtape1() {
    const d = _paiData;
    document.getElementById('modalBox').innerHTML = `
      <div class="modal-header">
        <div>
          <div class="mh-title">💳 Choisissez votre mode de paiement</div>
          <div class="mh-sub">Étape 1 / 2 — Trajet ${d.dep} → ${d.arr}</div>
        </div>
        <button class="modal-close" onclick="fermerModal()">✕</button>
      </div>
      <div class="modal-body">

        <!-- Récap billet -->
        <div style="background:rgba(26,107,58,0.08);border:1px solid rgba(26,107,58,0.22);border-radius:10px;padding:16px 18px;margin-bottom:22px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
          <div>
            <div style="font-size:11px;color:rgba(255,255,255,0.45);letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;">Récapitulatif</div>
            <div style="font-size:18px;font-weight:800;color:#fff;">${d.dep} <span style="color:var(--or)">→</span> ${d.arr}</div>
            <div style="font-size:13px;color:rgba(255,255,255,0.5);margin-top:3px;">Départ ${d.heure} · ${d.prenom} ${d.nom}</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:11px;color:rgba(255,255,255,0.45);letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;">Montant à payer</div>
            <div style="font-size:28px;font-weight:900;color:var(--or);font-family:'Playfair Display',serif;">${d.prix} <small style="font-size:14px;font-weight:500;font-family:'Outfit',sans-serif;">FCFA</small></div>
          </div>
        </div>

        <!-- Choix paiement -->
        <div style="font-size:11px;color:rgba(255,255,255,0.4);letter-spacing:2px;text-transform:uppercase;margin-bottom:14px;">Mode de paiement</div>
        <div id="paiChoix" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:24px;">

          <div class="pai-card selected" id="paiMTN" onclick="_selectPai('mtn')" style="background:rgba(255,204,0,0.07);border:2px solid rgba(255,204,0,0.5);border-radius:12px;padding:18px 12px;text-align:center;cursor:pointer;transition:all 0.2s;">
            <div style="font-size:30px;margin-bottom:8px;">📱</div>
            <div style="font-weight:700;font-size:14px;color:#ffcc00;">MTN MoMo</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:4px;">Instantané</div>
            <div id="paiMTN-check" style="font-size:18px;margin-top:8px;color:#ffcc00;">✓</div>
          </div>

          <div class="pai-card" id="paiOrange" onclick="_selectPai('orange')" style="background:rgba(255,102,0,0.07);border:2px solid rgba(255,255,255,0.08);border-radius:12px;padding:18px 12px;text-align:center;cursor:pointer;transition:all 0.2s;">
            <div style="font-size:30px;margin-bottom:8px;">🟠</div>
            <div style="font-weight:700;font-size:14px;color:#ff6600;">Orange Money</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:4px;">Instantané</div>
            <div id="paiOrange-check" style="font-size:18px;margin-top:8px;color:transparent;">✓</div>
          </div>

          <div class="pai-card" id="paiCarte" onclick="_selectPai('carte')" style="background:rgba(100,150,255,0.07);border:2px solid rgba(255,255,255,0.08);border-radius:12px;padding:18px 12px;text-align:center;cursor:pointer;transition:all 0.2s;">
            <div style="font-size:30px;margin-bottom:8px;">💳</div>
            <div style="font-weight:700;font-size:14px;color:#6a9fff;">Carte bancaire</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:4px;">Visa / Mastercard</div>
            <div id="paiCarte-check" style="font-size:18px;margin-top:8px;color:transparent;">✓</div>
          </div>
        </div>

        <!-- Champ numéro dynamique -->
        <div id="paiInputZone" style="margin-bottom:22px;">
          <label style="font-size:11px;color:var(--or);font-weight:700;text-transform:uppercase;letter-spacing:1.5px;display:block;margin-bottom:8px;">Numéro MTN MoMo</label>
          <div style="display:flex;gap:10px;align-items:center;">
            <span style="font-size:14px;color:rgba(255,255,255,0.4);padding:10px 14px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:6px;">+237</span>
            <input type="tel" id="paiNumero" maxlength="9" placeholder="6XX XXX XXX"
              style="flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:11px 14px;color:#fff;font-family:'Outfit',sans-serif;font-size:16px;outline:none;letter-spacing:2px;"
              oninput="this.value=this.value.replace(/[^0-9]/g,'')">
          </div>
          <div id="paiNumeroHint" style="font-size:11px;color:rgba(255,255,255,0.3);margin-top:6px;">📲 Un SMS de confirmation vous sera envoyé à ce numéro.</div>
        </div>

        <!-- Garanties -->
        <div style="display:flex;gap:20px;margin-bottom:22px;flex-wrap:wrap;">
          <span style="font-size:11px;color:rgba(255,255,255,0.35);display:flex;align-items:center;gap:6px;">🔒 Paiement 100% sécurisé</span>
          <span style="font-size:11px;color:rgba(255,255,255,0.35);display:flex;align-items:center;gap:6px;">⚡ Confirmation instantanée</span>
          <span style="font-size:11px;color:rgba(255,255,255,0.35);display:flex;align-items:center;gap:6px;">📩 Reçu par SMS & email</span>
        </div>

        <div style="display:flex;gap:10px;">
          <button onclick="fermerModal()" style="flex:1;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);padding:13px;border-radius:8px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">Annuler</button>
          <button onclick="_lancerPaiement()" style="flex:2;background:linear-gradient(135deg,var(--vert),var(--vert2));border:none;color:#fff;padding:13px;border-radius:8px;font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;">Payer ${_paiData.prix} FCFA →</button>
        </div>
      </div>`;

    _paiData.mode = 'mtn';
  }

  let _paiMode = 'mtn';
  function _selectPai(mode) {
    _paiMode = mode;
    _paiData.mode = mode;
    ['mtn','orange','carte'].forEach(m => {
      const card = document.getElementById('pai'+m.charAt(0).toUpperCase()+m.slice(1));
      const check = document.getElementById('pai'+m.charAt(0).toUpperCase()+m.slice(1)+'-check');
      if(!card) return;
      if(m===mode){
        card.style.borderColor = m==='mtn'?'rgba(255,204,0,0.6)':m==='orange'?'rgba(255,102,0,0.6)':'rgba(100,150,255,0.6)';
        card.style.background  = m==='mtn'?'rgba(255,204,0,0.1)':m==='orange'?'rgba(255,102,0,0.1)':'rgba(100,150,255,0.1)';
        if(check) check.style.color = m==='mtn'?'#ffcc00':m==='orange'?'#ff6600':'#6a9fff';
      } else {
        card.style.borderColor = 'rgba(255,255,255,0.08)';
        card.style.background  = 'rgba(255,255,255,0.03)';
        if(check) check.style.color = 'transparent';
      }
    });
    const lbl = document.querySelector('#paiInputZone label');
    const hint = document.getElementById('paiNumeroHint');
    const inp  = document.getElementById('paiNumero');
    if(mode==='mtn'){
      if(lbl) lbl.textContent='Numéro MTN MoMo';
      if(hint) hint.textContent='📲 Un SMS de confirmation vous sera envoyé à ce numéro.';
      if(inp)  inp.placeholder='6XX XXX XXX';
    } else if(mode==='orange'){
      if(lbl) lbl.textContent='Numéro Orange Money';
      if(hint) hint.textContent='📲 Composez #150# après validation pour confirmer.';
      if(inp)  inp.placeholder='6XX XXX XXX';
    } else {
      if(lbl) lbl.textContent='Numéro de carte (simulation)';
      if(hint) hint.textContent='🔒 Vos données bancaires sont chiffrées (SSL/TLS).';
      if(inp)  inp.placeholder='4XXX XXXX XXXX XXXX';
    }
  }

  // ─── ÉTAPE 2 : Spinner + simulation traitement ─────────────
  function _lancerPaiement() {
    const num = (document.getElementById('paiNumero')?.value||'').trim();
    if(!num || num.length < 8){alert('⚠️ Veuillez saisir un numéro valide.');return;}
    _paiData.numero = num;

    const modeLabel = _paiData.mode==='mtn'?'MTN MoMo':_paiData.mode==='orange'?'Orange Money':'Carte bancaire';
    const modeColor = _paiData.mode==='mtn'?'#ffcc00':_paiData.mode==='orange'?'#ff6600':'#6a9fff';
    const modeEmoji = _paiData.mode==='mtn'?'📱':_paiData.mode==='orange'?'🟠':'💳';

    document.getElementById('modalBox').innerHTML = `
      <div style="padding:40px 28px;text-align:center;">
        <div style="font-size:48px;margin-bottom:20px;">${modeEmoji}</div>
        <div style="font-size:18px;font-weight:700;color:#fff;margin-bottom:8px;">Traitement en cours…</div>
        <div style="font-size:13px;color:rgba(255,255,255,0.45);margin-bottom:28px;">Connexion à <span style="color:${modeColor};font-weight:700;">${modeLabel}</span> en cours</div>

        <!-- Barre de progression animée -->
        <div style="background:rgba(255,255,255,0.06);border-radius:100px;height:6px;margin-bottom:28px;overflow:hidden;">
          <div id="paiProgressBar" style="height:6px;border-radius:100px;background:linear-gradient(90deg,var(--vert),${modeColor});width:0%;transition:width 0.4s ease;"></div>
        </div>

        <div id="paiStep" style="font-size:12px;color:rgba(255,255,255,0.35);letter-spacing:1px;min-height:18px;"></div>

        ${_paiData.mode!=='carte'?`
        <div style="margin-top:24px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:16px 18px;text-align:left;">
          <div style="font-size:11px;color:rgba(255,255,255,0.35);letter-spacing:2px;text-transform:uppercase;margin-bottom:8px;">Instructions</div>
          <div style="font-size:13px;color:rgba(255,255,255,0.55);line-height:1.7;">
            ${_paiData.mode==='mtn'
              ? '1. Un push notification a été envoyé au <strong style="color:#fff">+237 '+num+'</strong><br>2. Saisissez votre code PIN MoMo sur votre téléphone<br>3. Validez pour confirmer le paiement de <strong style="color:#ffcc00">'+_paiData.prix+' FCFA</strong>'
              : '1. Composez <strong style="color:#ff6600">#150#</strong> sur votre téléphone<br>2. Sélectionnez <em>Paiement marchand</em><br>3. Code marchand : <strong style="color:#ff6600">CTL-237</strong> — Montant : <strong>'+_paiData.prix+' FCFA</strong>'
            }
          </div>
        </div>`:``}
      </div>`;

    // Simulation progression
    const steps = [
      [8,  'Connexion sécurisée…'],
      [25, 'Vérification du compte…'],
      [45, 'Envoi de la demande de paiement…'],
      [65, 'En attente de confirmation PIN…'],
      [82, 'Validation du paiement…'],
      [95, 'Génération du billet…'],
    ];
    let i=0;
    function next(){
      if(i>=steps.length){setTimeout(_confirmerSucces,600);return;}
      const bar=document.getElementById('paiProgressBar');
      const lbl=document.getElementById('paiStep');
      if(bar) bar.style.width=steps[i][0]+'%';
      if(lbl) lbl.textContent=steps[i][1];
      i++;
      setTimeout(next, 600+(Math.random()*400));
    }
    next();
  }

  // ─── ÉTAPE 3 : Succès + e-billet ──────────────────────────
  function _confirmerSucces() {
    const d = _paiData;
    const modeLabel = d.mode==='mtn'?'MTN MoMo':d.mode==='orange'?'Orange Money':'Carte bancaire';
    const modeColor = d.mode==='mtn'?'#ffcc00':d.mode==='orange'?'#ff6600':'#6a9fff';

    // Sauvegarder dans Mon Espace
    const billets = getBillets();
    var qrData = genQRData(d.ref, d.dep, d.arr, d.prix, d.prenom+' '+d.nom, new Date().toLocaleDateString('fr-FR'), d.heure);
    var billetHash = genBilletHash(d.ref, d.dep, d.arr, d.prix);
    // Attribution automatique du siège
    var billetsExistants = billets.filter(function(b){return b.chauffeur===d.chauffeur && b.dep===d.dep && b.arr===d.arr && b.heure===d.heure && b.date===new Date().toLocaleDateString('fr-FR');});
    var siege = billetsExistants.length + 1;
    // Récupérer les contacts famille
    var cf1tel=(document.getElementById('cf1tel')?.value||'').trim().replace(/[\s\-\.]/g,'');
    var cf2tel=(document.getElementById('cf2tel')?.value||'').trim().replace(/[\s\-\.]/g,'');
    var cf3tel=(document.getElementById('cf3tel')?.value||'').trim().replace(/[\s\-\.]/g,'');
    var cf1nom=(document.getElementById('cf1nom')?.value||'').trim();
    var cf2nom=(document.getElementById('cf2nom')?.value||'').trim();
    var cf3nom=(document.getElementById('cf3nom')?.value||'').trim();
    // Récupérer l'immatriculation du véhicule du chauffeur
    var chauffeurData = typeof CHAUFFEURS!=='undefined' ? CHAUFFEURS.find(function(c){return c.nom===d.chauffeur;}) : null;
    var immatriculation = chauffeurData ? chauffeurData.vehicule : 'CTL-'+d.chauffeur.replace(/\s/g,'').substring(0,6).toUpperCase();
    billets.unshift({
      ref:d.ref, dep:d.dep, arr:d.arr, heure:d.heure,
      prix:d.prix, mode:d.mode, date:new Date().toLocaleDateString('fr-FR'),
      statut:'Confirmé', nomPassager:d.prenom+' '+d.nom,
      email:d.email, tel:d.tel, chauffeur:d.chauffeur,
      qrData:qrData, hash:billetHash, scanne:false,
      siege:siege, immatriculation:immatriculation,
      contactsFamille:[
        cf1tel?{nom:cf1nom,tel:cf1tel}:null,
        cf2tel?{nom:cf2nom,tel:cf2tel}:null,
        cf3tel?{nom:cf3nom,tel:cf3tel}:null
      ].filter(Boolean)
    });
    saveBillets(billets);
    addNotif('🎫','Billet '+d.ref+' confirmé — '+d.dep+' → '+d.arr+' · '+d.heure);

    document.getElementById('modalBox').innerHTML = `
      <div class="resa-success">
        
        <div style="font-size:40px;margin-bottom:4px;">✅</div>
        <h3>Paiement accepté !</h3>
        <div class="rs-ref">${d.ref}</div>
        <div id="qrCodeConfirm" style="margin:16px 0;"></div>

        <!-- Badge paiement -->
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:100px;padding:6px 16px;margin:12px 0 20px;font-size:12px;color:rgba(255,255,255,0.6);">
          <span style="color:${modeColor};font-weight:700;">${modeLabel}</span>
          <span>·</span>
          <span style="color:var(--or);font-weight:700;">${d.prix} FCFA</span>
          <span>·</span>
          <span>✓ Débité</span>
        </div>

        <p style="text-align:left;">
          <strong style="color:var(--white)">${d.prenom} ${d.nom}</strong>, votre billet pour
          <strong style="color:var(--white)">${d.dep} → ${d.arr}</strong> (départ <strong style="color:var(--or)">${d.heure}</strong>) est confirmé.<br><br>
          📩 Récapitulatif et e-billet envoyés à <strong style="color:var(--or)">${d.email}</strong><br>
          📲 SMS de confirmation au <strong style="color:var(--white)">+237 ${d.tel}</strong><br>
          👨‍👩‍👧 Vos contacts famille recevront des notifications GPS à chaque étape.
          ${d.doSave?'<br><br>✓ <strong style="color:var(--vert2)">Profil sauvegardé</strong> pour vos prochains trajets.':''}
        </p>

        <!-- Actions -->
        <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:22px;">
          <button onclick="genererBilletPDF('${d.ref}')"
            style="background:var(--vert);border:none;color:#fff;padding:12px 22px;border-radius:8px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;">
            🖨️ Télécharger en PDF
          </button>
          <button onclick="envoyerBilletWhatsApp('${d.ref}')"
            style="background:rgba(37,211,102,0.15);border:1px solid rgba(37,211,102,0.4);color:#25d366;padding:12px 22px;border-radius:8px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;">
            💬 Envoyer par WhatsApp
          </button>
          <button onclick="fermerModal();setTimeout(function(){ouvrirDashboard();},100)"
            style="background:rgba(212,168,0,0.15);border:1px solid rgba(212,168,0,0.4);color:var(--or);padding:12px 22px;border-radius:8px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;">
            🎫 Voir mon e-billet
          </button>
          <button onclick="fermerModal()"
            style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);padding:12px 22px;border-radius:8px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;">
            Fermer
          </button>
        </div>
        <div style="margin-top:16px;background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.2);border-radius:8px;padding:12px 16px;font-size:12px;color:rgba(255,255,255,0.55);line-height:1.6;text-align:left;">
          📸 <strong style="color:var(--or);">Conseil :</strong> Faites une <strong>capture d'écran</strong> de votre billet et du QR Code maintenant. En cas de perte de connexion, vous aurez toujours votre preuve de paiement.
        </div>
      </div>`;
    // Générer le vrai QR code scannable
    setTimeout(function(){ genQRElement('qrCodeConfirm', qrData); }, 100);
  }

  // ── PATCH: enregistrer flux financier au succès du paiement ──
  var __origCS = _confirmerSucces;
  _confirmerSucces = function() {
    if (_paiData && typeof enregistrerFluxFinancier === 'function') {
      enregistrerFluxFinancier(_paiData.ref, parseInt(_paiData.prix)||0, _paiData.chauffeur||'Chauffeur CTL', _paiData.arr && _paiData.arr.indexOf('(')!==-1);
    }
    __origCS();
  };


  // ── CARROUSEL PHOTOS CAMEROUN ──
  const CAROUSEL_CAPTIONS = [
    'Forêt tropicale du Cameroun',
    'Côte Atlantique — Kribi',
    'Montagnes de l\'Adamaoua',
    'Savane du Grand Nord',
    'Lac Nyos — Nord-Ouest',
  ];
  let carouselIdx = 0;
  const slides     = document.querySelectorAll('.carousel-slide');
  const dotsWrap   = document.getElementById('carouselDots');
  const captionEl  = document.getElementById('carouselCaption');

  // Créer les indicateurs
  slides.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'carousel-dot' + (i === 0 ? ' active' : '');
    d.addEventListener('click', () => goToSlide(i));
    dotsWrap.appendChild(d);
  });

  function goToSlide(idx) {
    slides[carouselIdx].classList.remove('active');
    dotsWrap.children[carouselIdx].classList.remove('active');
    carouselIdx = idx;
    // Lazy load : charger l'image de fond au premier affichage
    var slide = slides[carouselIdx];
    if (slide.dataset.bg && !slide.style.backgroundImage) {
      slide.style.backgroundImage = "url('" + slide.dataset.bg + "')";
    }
    slide.classList.add('active');
    dotsWrap.children[carouselIdx].classList.add('active');
    captionEl.textContent = CAROUSEL_CAPTIONS[carouselIdx];
  }

  captionEl.textContent = CAROUSEL_CAPTIONS[0];
  setInterval(() => goToSlide((carouselIdx + 1) % slides.length), 5000);

  // ── MAP DOTS ANIMATION ──
  const mapContainer = document.getElementById('mapDots');
  const cities = [
    {name:'Douala',      x:14, y:54, big:true},
    {name:'Yaoundé',     x:62, y:44, big:true},
    {name:'Bafoussam',   x:34, y:29, big:true},
    {name:'Bamenda',     x:24, y:18, big:false},
    {name:'Garoua',      x:68, y:13, big:false},
    {name:'Maroua',      x:76, y:3,  big:false},
    {name:'Kribi',       x:19, y:72, big:false},
    {name:'Ebolowa',     x:50, y:70, big:false},
    {name:'Bertoua',     x:78, y:51, big:false},
    {name:'Ngaoundéré',  x:66, y:28, big:false},
    {name:'Kumbo',       x:29, y:13, big:false},
    {name:'Buéa',        x:11, y:47, big:false},
  ];
  const connections = [[0,1],[0,2],[1,2],[1,3],[4,5],[0,7],[1,7],[4,9],[1,8],[8,7],[2,3],[0,11],[2,9],[3,9]];

  // Tracer les lignes d'abord
  connections.forEach(([a,b])=>{
    const c1 = cities[a], c2 = cities[b];
    const dx = (c2.x - c1.x) * 6.2;
    const dy = (c2.y - c1.y) * 4.8;
    const len = Math.sqrt(dx*dx+dy*dy);
    const angle = Math.atan2(dy,dx)*180/Math.PI;
    const line = document.createElement('div');
    line.className = 'map-line';
    line.style.cssText = `left:${c1.x}%;top:${c1.y}%;width:${len}px;transform:rotate(${angle}deg);`;
    mapContainer.insertBefore(line, mapContainer.firstChild);
  });

  // Points et labels
  cities.forEach((c,i)=>{
    const dot = document.createElement('div');
    dot.className = 'map-dot';
    const size = c.big ? 14 : 9;
    dot.style.cssText = `width:${size}px;height:${size}px;left:${c.x}%;top:${c.y}%;animation-delay:${i*0.35}s;margin-left:-${size/2}px;margin-top:-${size/2}px;`;
    mapContainer.appendChild(dot);

    const label = document.createElement('div');
    label.className = 'map-city-label';
    label.style.cssText = `
      left:${c.x + 1.8}%;
      top:${c.y - 5.5}%;
      font-size:${c.big ? 13 : 10}px;
      color:${c.big ? 'rgba(212,168,0,0.95)' : 'rgba(212,168,0,0.7)'};
      font-weight:${c.big ? 700 : 500};
      letter-spacing:0.5px;
    `;
    label.textContent = c.name;
    mapContainer.appendChild(label);
  });

  // ── SCROLL REVEAL ──
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach((e,i)=>{
      if(e.isIntersecting){
        setTimeout(()=>e.target.classList.add('visible'), i*80);
      }
    });
  },{threshold:0.1});
  reveals.forEach(r=>observer.observe(r));

  // ── DATE INPUT DEFAULT ──
  document.getElementById('dateVoyage').value = new Date().toISOString().split('T')[0];

  // ── ENTER KEY on search ──
  document.getElementById('departInput').addEventListener('keydown', e => { if(e.key==='Enter') rechercherTrajet(); });
  document.getElementById('arriveeInput').addEventListener('keydown', e => { if(e.key==='Enter') rechercherTrajet(); });

  // ══════════════════════════════════════════════════════════
  // SÉLECTEUR DE THÈME
  // ══════════════════════════════════════════════════════════
  function setTheme(t) {
    document.body.classList.remove('theme-vert','theme-rouge','theme-blanc');
    if (t !== 'vert') document.body.classList.add('theme-' + t);
    // Mettre à jour visuellement les boutons
    ['vert','rouge','blanc'].forEach(name => {
      const btn = document.getElementById('btn-t-' + name);
      if (btn) btn.style.borderColor = (name === t) ? 'var(--or)' : 'transparent';
    });
    localStorage.setItem('ctl_theme', t);
  }
  // Restaurer thème au chargement
  const savedTheme = localStorage.getItem('ctl_theme') || 'vert';
  setTheme(savedTheme);

  // ══════════════════════════════════════════════════════════
  // SÉLECTEUR DE LANGUE FR / EN
  // ══════════════════════════════════════════════════════════
  // ═══════════════════════════════════════════════════
  // SYSTÈME DE TRADUCTION UNIFIÉ — data-fr/data-en ONLY
  // ═══════════════════════════════════════════════════
  let currentLang = localStorage.getItem('ctl_lang') || 'fr';

  function setLang(lang) {
    currentLang = lang;
    localStorage.setItem('ctl_lang', lang);

    // Boutons langue
    const btnFr = document.getElementById('btn-lang-fr');
    const btnEn = document.getElementById('btn-lang-en');
    if (btnFr && btnEn) {
      btnFr.style.background = lang==='fr' ? 'var(--or)' : 'transparent';
      btnFr.style.color      = lang==='fr' ? '#0f1a13'  : 'rgba(255,255,255,0.45)';
      btnEn.style.background = lang==='en' ? 'var(--or)' : 'transparent';
      btnEn.style.color      = lang==='en' ? '#0f1a13'  : 'rgba(255,255,255,0.45)';
    }

    // Traduire tous les éléments portant data-fr / data-en
    document.querySelectorAll('[data-fr]').forEach(el => {
      const txt = el.getAttribute('data-' + lang);
      if (txt !== null) el.innerHTML = txt;
    });

    // Placeholders
    document.querySelectorAll('[data-ph-fr]').forEach(el => {
      const ph = el.getAttribute('data-ph-' + lang);
      if (ph) el.placeholder = ph;
    });
  }

  // Appliquer la langue sauvegardée au chargement
  setLang(currentLang);

  // ══════════════════════════════════════════════════════════════════
  // FRET — PROCESSUS DE COMMANDE COMPLET
  // ══════════════════════════════════════════════════════════════════
  function commanderFret(dep, arr, typeId, typeLabel, poids, prix, delai, isIntl) {
    const prixNum = parseInt(prix) || 0;
    const ref = 'FRET-' + Math.random().toString(36).substr(2,6).toUpperCase();
    const modal = document.getElementById('modalResa');
    const box = document.getElementById('modalBox');
    if (!modal || !box) return;

    box.innerHTML = `
      <div class="modal-header">
        <div>
          <div class="mh-title">📦 Commande d'envoi — ${ref}</div>
          <div class="mh-sub">${dep} → ${arr} · ${typeLabel} · ${poids} kg</div>
        </div>
        <button class="modal-close" onclick="fermerModal()">✕</button>
      </div>
      <div class="modal-recap">
        <span>📦 <strong>${typeLabel}</strong></span>
        <span class="mr-sep">|</span>
        <span>📍 <strong>${dep} → ${arr}</strong></span>
        <span class="mr-sep">|</span>
        <span>⚖ <strong>${poids} kg</strong></span>
        <span class="mr-sep">|</span>
        <span>⏱ <strong>${delai}</strong></span>
        <span class="mr-sep">|</span>
        <span>💰 <strong style="color:var(--or)">${formatPrix(prixNum)} FCFA</strong></span>
      </div>
      ${isIntl==='true' ? '<div style="margin:0 28px;padding:10px 16px;background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.2);border-radius:8px;font-size:12px;color:rgba(255,255,255,0.6);">🌍 <strong>Envoi international</strong> — Suivi GPS transfrontalier · Douane incluse · Assurance internationale</div>' : ''}
      <div class="modal-body">
        <div class="modal-section-title">👤 Expéditeur</div>
        <div class="form-row">
          <div class="form-field"><label>Nom complet <span class="req">*</span></label><input type="text" id="fretExpNom" placeholder="Votre nom"></div>
          <div class="form-field"><label>Téléphone <span class="req">*</span></label><input type="tel" id="fretExpTel" placeholder="6XX XXX XXX"></div>
        </div>
        <div class="modal-section-title">📬 Destinataire</div>
        <div class="form-row">
          <div class="form-field"><label>Nom complet <span class="req">*</span></label><input type="text" id="fretDestNom" placeholder="Nom du destinataire"></div>
          <div class="form-field"><label>Téléphone <span class="req">*</span></label><input type="tel" id="fretDestTel" placeholder="6XX XXX XXX"></div>
        </div>
        <div class="form-row single">
          <div class="form-field"><label>Description du colis</label><input type="text" id="fretDesc" placeholder="Ex: carton de vêtements, 2 valises..."></div>
        </div>
        <div class="modal-section-title">🛡 Services inclus</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
          <span style="font-size:11px;padding:4px 12px;border-radius:100px;background:rgba(26,107,58,0.12);border:1px solid rgba(26,107,58,0.3);color:var(--vert2);">📍 Suivi GPS temps réel</span>
          <span style="font-size:11px;padding:4px 12px;border-radius:100px;background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);">📲 SMS expéditeur & destinataire</span>
          <span style="font-size:11px;padding:4px 12px;border-radius:100px;background:rgba(171,73,1,0.12);border:1px solid rgba(171,73,1,0.3);color:#e07830;">🛡 Assurance transport</span>
          <span style="font-size:11px;padding:4px 12px;border-radius:100px;background:rgba(175,2,11,0.1);border:1px solid rgba(175,2,11,0.3);color:#ff6b6b;">🆘 SOS en cas d'incident</span>
        </div>
      </div>
      <div class="modal-footer">
        <div><div class="mf-price">${formatPrix(prixNum)} FCFA<small>Total · ${typeLabel} · ${delai}</small></div></div>
        <div class="mf-actions">
          <button class="btn-cancel-modal" onclick="fermerModal()">Annuler</button>
          <button class="btn-confirm-resa" style="background:var(--cuivre);" onclick="validerFret('${ref}','${dep}','${arr}','${typeId}','${poids}','${prixNum}','${delai}','${isIntl}')">📦 Confirmer & Payer →</button>
        </div>
      </div>`;

    modal.classList.add('open');
    document.body.style.overflow = 'hidden';

    // Préremplir si connecté
    const sess = typeof getSession==='function' ? getSession() : null;
    if (sess) {
      const el = document.getElementById('fretExpNom');
      if (el) el.value = sess.prenom + ' ' + sess.nom;
      const tel = document.getElementById('fretExpTel');
      if (tel) tel.value = sess.tel || '';
    }
  }

  function validerFret(ref, dep, arr, typeId, poids, prix, delai, isIntl) {
    const expNom = (document.getElementById('fretExpNom')?.value||'').trim();
    const expTel = (document.getElementById('fretExpTel')?.value||'').trim();
    const destNom = (document.getElementById('fretDestNom')?.value||'').trim();
    const destTel = (document.getElementById('fretDestTel')?.value||'').trim();
    const desc = (document.getElementById('fretDesc')?.value||'').trim();

    if (!expNom||!expTel||!destNom||!destTel) { alert('⚠️ Veuillez remplir tous les champs obligatoires.'); return; }
    var fretTelExp=expTel.replace(/[\s\-\.]/g,'');
    if(!/^(\+237)?[26][0-9]{7,8}$/.test(fretTelExp)){alert('⚠️ Numéro expéditeur invalide. Format : 6XX XXX XXX');return;}
    var fretTelDest=destTel.replace(/[\s\-\.]/g,'');
    if(!/^(\+237)?[26][0-9]{7,8}$/.test(fretTelDest)){alert('⚠️ Numéro destinataire invalide. Format : 6XX XXX XXX');return;}

    // Sauvegarder l'envoi
    const envois = JSON.parse(localStorage.getItem('ctl_fret')||'[]');
    envois.unshift({ref,dep,arr,typeId,poids:parseInt(poids),prix:parseInt(prix),delai,isIntl:isIntl==='true',
      expNom,expTel,destNom,destTel,desc,date:new Date().toLocaleDateString('fr-FR'),
      statut:'prise_en_charge',gps:true});
    localStorage.setItem('ctl_fret',JSON.stringify(envois));

    if(typeof addNotif==='function') addNotif('📦','Envoi '+ref+' confirmé — '+dep+' → '+arr+' · '+poids+' kg');

    // Succès
    document.getElementById('modalBox').innerHTML = `
      <div class="resa-success">
        <div style="font-size:40px;margin-bottom:4px;">📦✅</div>
        <h3>Envoi confirmé !</h3>
        <div class="rs-ref">${ref}</div>
        <p style="text-align:left;">
          <strong style="color:var(--white)">📦 ${escapeHtml(dep)} → ${escapeHtml(arr)}</strong> · ${escapeHtml(poids)} kg · ${escapeHtml(delai)}<br><br>
          👤 Expéditeur : <strong>${escapeHtml(expNom)}</strong> (${escapeHtml(expTel)})<br>
          📬 Destinataire : <strong>${escapeHtml(destNom)}</strong> (${escapeHtml(destTel)})<br><br>
          📍 <strong style="color:var(--vert2)">Suivi GPS activé</strong> — Vous et le destinataire recevrez des SMS à chaque étape.<br>
          🛡 Assurance transport incluse<br>
          🆘 SOS disponible en cas d'incident${isIntl==='true'?' (couverture internationale)':''}
        </p>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:22px;">
          <button onclick="fermerModal()" style="background:var(--cuivre);border:none;color:#fff;padding:12px 22px;border-radius:8px;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;">Fermer</button>
        </div>
      </div>`;
  }

  // ══════════════════════════════════════════════════════════════════
  // VOYAGES INTERNATIONAUX — MOTEUR DE RECHERCHE
  // ══════════════════════════════════════════════════════════════════
  let selectedIntlDepart = null;
  setupAutocomplete('intlDepartInput','intlDepartDropdown', v => { selectedIntlDepart = v; });

  function updateIntlVilles() {
    const pays = document.getElementById('intlPaysSelect').value;
    const sel  = document.getElementById('intlVilleSelect');
    sel.innerHTML = '<option value="">-- Choisir une ville --</option>';
    if (!pays || !INTERNATIONAL[pays]) return;
    INTERNATIONAL[pays].villes.forEach(v => {
      sel.innerHTML += '<option value="'+escapeHtml(v.ville)+'">'+escapeHtml(v.ville)+' ('+escapeHtml(v.region)+')</option>';
    });
  }

  function rechercherIntl() {
    if (!selectedIntlDepart) {
      const v = ALL_VILLES.find(x => normalize(x.ville) === normalize(document.getElementById('intlDepartInput').value));
      if (v) selectedIntlDepart = v;
    }
    const pays = document.getElementById('intlPaysSelect').value;
    const dest = document.getElementById('intlVilleSelect').value;
    const results = document.getElementById('intlResults');

    if (!selectedIntlDepart) { results.innerHTML='<div class="no-direct-route"><p>⚠️ Veuillez saisir une ville de départ.</p></div>'; results.classList.add('open'); return; }
    if (!pays) { results.innerHTML='<div class="no-direct-route"><p>⚠️ Veuillez sélectionner un pays de destination.</p></div>'; results.classList.add('open'); return; }
    if (!dest) { results.innerHTML='<div class="no-direct-route"><p>⚠️ Veuillez sélectionner une ville d\'arrivée.</p></div>'; results.classList.add('open'); return; }

    const paysData = INTERNATIONAL[pays];
    const villeData = paysData.villes.find(v => v.ville === dest);
    if (!villeData) return;

    // Calculer km et tarifs
    let km = getKmIntl(selectedIntlDepart.ville, dest);
    if (!km) {
      const kmNational = getKmDistance(selectedIntlDepart.region, 'Centre');
      const kmIntl = villeData.km;
      km = kmNational + kmIntl;
    }
    const tarifs = getTarifsIntl(selectedIntlDepart.ville, dest, km);
    const duree = villeData.duree;

    let html = `
      <div class="results-header">
        <div class="rh-title">${selectedIntlDepart.ville} 🇨🇲 <span style="color:var(--or)">→</span> ${paysData.flag} ${dest} (${pays})</div>
        <div class="rh-count">Trajet international · ~${km} km · ${duree}</div>
      </div>
      <div style="background:rgba(212,168,0,0.06);border:1px solid rgba(212,168,0,0.18);border-radius:8px;padding:14px 18px;margin-bottom:16px;">
        <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center;">
          <span style="font-size:11px;color:rgba(255,255,255,0.45);letter-spacing:1px;">TARIFS ESTIMATIFS</span>
          <span style="font-size:13px;">🚌 Classique <strong style="color:var(--or)">${formatPrix(tarifs.classique)} FCFA</strong></span>
          <span style="font-size:13px;">🌟 VIP <strong style="color:var(--or)">${formatPrix(tarifs.vip)} FCFA</strong></span>
          <span style="font-size:10px;color:rgba(255,255,255,0.3);">Devise : ${paysData.devise === 'XAF' ? 'FCFA (zone CEMAC)' : 'FCFA → NGN à l\'arrivée'}</span>
        </div>
      </div>`;

    // Infos frontière
    html += `
      <div style="background:rgba(171,73,1,0.08);border:1px solid rgba(171,73,1,0.25);border-radius:10px;padding:16px 20px;margin-bottom:16px;">
        <div style="font-size:12px;font-weight:700;color:var(--cuivre);margin-bottom:8px;">🛂 INFORMATIONS FRONTALIÈRES</div>
        <div style="font-size:13px;color:rgba(255,255,255,0.6);line-height:1.7;">
          <strong>Passage frontière :</strong> ${paysData.frontiere.join(', ')}<br>
          <strong>Documents :</strong> Passeport valide${paysData.code==='NG'?' + Visa Nigeria':' (zone CEMAC — libre circulation)'}<br>
          <strong>Suivi GPS :</strong> ✅ Actif pendant tout le trajet, y compris en territoire étranger<br>
          <strong>Family Space :</strong> ✅ Notifications SMS internationales incluses
        </div>
      </div>`;

    // Résultats
    const horaires = ['06h00','08h00','14h00','20h00'];
    horaires.slice(0,3).forEach(h => {
      const isVip = h === '08h00';
      const prix = isVip ? tarifs.vip : tarifs.classique;
      html += `
        <div class="result-card is-partenaire" style="border-color:rgba(212,168,0,0.3);">
          <div>
            <div class="rc-route">${selectedIntlDepart.ville} 🇨🇲 <span class="arr">→</span> ${paysData.flag} ${dest}
              <span style="font-size:10px;font-weight:700;background:rgba(212,168,0,0.15);border:1px solid rgba(212,168,0,0.4);color:var(--or);padding:2px 8px;border-radius:100px;margin-left:8px;">${isVip?'🌟 VIP':'🚌 Classique'}</span>
            </div>
            <div class="rc-meta" style="margin-top:6px;">⏰ Départ ${h} · ⏱ ${duree} · 📍 ~${km} km · 🛂 ${paysData.frontiere[0]}</div>
            <div class="driver-row"><div class="driver-avatar partenaire">AG</div><div class="driver-info"><div class="driver-name">Agence CTL Partenaire <span style="font-size:10px;color:var(--vert2);">● Certifié international</span></div><div class="driver-meta">Bus climatisé · Trajets réguliers ${pays}</div></div></div>
          </div>
          <div class="rc-price">${formatPrix(prix)} <small>FCFA / pers.</small></div>
          <button class="btn-book" onclick="reserverBillet('${selectedIntlDepart.ville}','${dest} (${pays})','${h}','${prix}','Agence CTL International','true','intl','${pays}','${paysData.flag}','${paysData.frontiere[0]}','${paysData.devise}')">Réserver</button>
        </div>`;
    });

    results.innerHTML = html;
    results.classList.add('open');
    results.scrollIntoView({behavior:'smooth',block:'nearest'});
  }

  // ══════════════════════════════════════════════════════════════════
  // TRANSPORT MARCHANDISES — MOTEUR DE RECHERCHE
  // ══════════════════════════════════════════════════════════════════
  let fretMode = 'national';
  let selectedFretExp = null;
  let selectedFretDest = null;

  setupAutocomplete('fretExpInput','fretExpDropdown', v => { selectedFretExp = v; });
  setupAutocomplete('fretDestInput','fretDestDropdown', v => { selectedFretDest = v; });

  function switchFretMode(mode) {
    fretMode = mode;
    const btnNat = document.getElementById('fretNational');
    const btnIntl = document.getElementById('fretIntl');
    if (mode === 'national') {
      btnNat.style.borderColor = 'var(--vert2)';
      btnNat.style.background = 'rgba(26,107,58,0.15)';
      btnNat.style.color = 'var(--white)';
      btnIntl.style.borderColor = 'rgba(255,255,255,0.12)';
      btnIntl.style.background = 'rgba(255,255,255,0.03)';
      btnIntl.style.color = 'rgba(255,255,255,0.6)';
    } else {
      btnIntl.style.borderColor = 'var(--or)';
      btnIntl.style.background = 'rgba(212,168,0,0.1)';
      btnIntl.style.color = 'var(--white)';
      btnNat.style.borderColor = 'rgba(255,255,255,0.12)';
      btnNat.style.background = 'rgba(255,255,255,0.03)';
      btnNat.style.color = 'rgba(255,255,255,0.6)';
    }
    document.getElementById('fretDestInput').placeholder = mode === 'national' ? 'Ville d\'arrivée (Cameroun)' : 'Ville d\'arrivée (international)';
  }

  function rechercherFret() {
    if (!selectedFretExp) {
      const v = ALL_VILLES.find(x => normalize(x.ville) === normalize(document.getElementById('fretExpInput').value));
      if (v) selectedFretExp = v;
    }
    if (!selectedFretDest) {
      const v = ALL_VILLES.find(x => normalize(x.ville) === normalize(document.getElementById('fretDestInput').value));
      if (v) selectedFretDest = v;
    }

    const results = document.getElementById('fretResults');
    const typeId = document.getElementById('fretType').value;
    const poids = parseInt(document.getElementById('fretPoids').value) || 10;
    const typeData = TYPES_MARCHANDISES.find(t => t.id === typeId) || TYPES_MARCHANDISES[0];

    if (!selectedFretExp) { results.innerHTML='<div class="no-direct-route"><p>⚠️ Veuillez saisir une ville d\'expédition.</p></div>'; results.classList.add('open'); return; }
    if (!selectedFretDest) {
      // Chercher dans international
      const destInput = document.getElementById('fretDestInput').value.trim();
      const intlMatch = ALL_DESTINATIONS_INTL.find(d => normalize(d.ville) === normalize(destInput));
      if (intlMatch) {
        const km = intlMatch.km + 100;
        const prixBase = Math.max(2000, Math.round(km * typeData.prixKm * (1 + poids/200) / 500) * 500);
        afficherResultatsFret(results, selectedFretExp.ville, intlMatch.ville+' '+intlMatch.flag, km, prixBase, typeData, poids, intlMatch.duree, true);
        return;
      }
      results.innerHTML='<div class="no-direct-route"><p>⚠️ Veuillez saisir une ville de destination.</p></div>'; results.classList.add('open'); return;
    }

    const tarifs = getTarifs(selectedFretExp, selectedFretDest);
    if (!tarifs) return;
    const km = tarifs.km;
    const prixBase = Math.max(1500, Math.round(km * typeData.prixKm * (1 + poids/200) / 500) * 500);

    afficherResultatsFret(results, selectedFretExp.ville, selectedFretDest.ville, km, prixBase, typeData, poids, getDuree(km), false);
  }

  function afficherResultatsFret(results, dep, arr, km, prixBase, typeData, poids, duree, isIntl) {
    const prixExpress = Math.round(prixBase * 1.5 / 500) * 500;
    const prixAssurance = Math.max(500, Math.round(prixBase * 0.08 / 100) * 100);

    let html = `
      <div class="results-header">
        <div class="rh-title">📦 ${dep} <span style="color:var(--cuivre)">→</span> ${arr}</div>
        <div class="rh-count">${isIntl?'🌍 International':'🇨🇲 National'} · ~${km} km · ${typeData.label} · ${poids} kg</div>
      </div>
      <div style="background:rgba(171,73,1,0.06);border:1px solid rgba(171,73,1,0.2);border-radius:8px;padding:14px 18px;margin-bottom:16px;">
        <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center;">
          <span style="font-size:11px;color:rgba(255,255,255,0.45);letter-spacing:1px;">ESTIMATION FRET</span>
          <span style="font-size:13px;">📦 Standard <strong style="color:var(--or)">${formatPrix(prixBase)} FCFA</strong></span>
          <span style="font-size:13px;">⚡ Express <strong style="color:var(--cuivre)">${formatPrix(prixExpress)} FCFA</strong></span>
          <span style="font-size:13px;">🛡 Assurance <strong style="color:var(--vert2)">${formatPrix(prixAssurance)} FCFA</strong></span>
        </div>
      </div>`;

    // Options de livraison
    [{label:'📦 Standard',prix:prixBase,delai:'3-5 jours',desc:'Livraison groupée économique'},
     {label:'⚡ Express',prix:prixExpress,delai:'24-48h',desc:'Livraison prioritaire'},
    ].forEach(opt => {
      html += `
        <div class="result-card" style="border-color:rgba(171,73,1,0.2);">
          <div>
            <div class="rc-route">${opt.label} — ${dep} → ${arr}</div>
            <div class="rc-meta" style="margin-top:6px;">
              📦 ${typeData.label} · ⚖ ${poids} kg · 📍 ~${km} km · ⏱ ${opt.delai}
            </div>
            <div style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:4px;">${opt.desc}</div>
            <div style="display:flex;gap:8px;margin-top:8px;">
              <span style="font-size:10px;padding:2px 8px;border-radius:100px;background:rgba(26,107,58,0.12);border:1px solid rgba(26,107,58,0.3);color:var(--vert2);">📍 GPS temps réel</span>
              <span style="font-size:10px;padding:2px 8px;border-radius:100px;background:rgba(212,168,0,0.1);border:1px solid rgba(212,168,0,0.3);color:var(--or);">📲 SMS suivi</span>
              <span style="font-size:10px;padding:2px 8px;border-radius:100px;background:rgba(171,73,1,0.12);border:1px solid rgba(171,73,1,0.3);color:#e07830;">🛡 Assurance</span>
            </div>
          </div>
          <div class="rc-price">${formatPrix(opt.prix)} <small>FCFA</small></div>
          <button class="btn-book" style="background:var(--cuivre);" onclick="commanderFret('${dep}','${arr}','${typeData.id}','${typeData.label}','${poids}','${opt.prix}','${opt.delai}','${isIntl}')">Expédier</button>
        </div>`;
    });

    results.innerHTML = html;
    results.classList.add('open');
    results.scrollIntoView({behavior:'smooth',block:'nearest'});
  }

  // ══════════════════════════════════════════════════════════════════
  // ASSISTANT IA CTL
  // ══════════════════════════════════════════════════════════════════
  // ── MOTEUR IA CONTEXTUEL CTL ──
  const iaHistory = [];
  const iaCloseLink = ' style="color:var(--or);cursor:pointer" onclick="document.getElementById(\'modalIA\').classList.remove(\'open\');document.body.style.overflow=\'\'"';

  function iaDetectVilles(msg) {
    const m = normalize(msg);
    const found = [];
    const allNames = ALL_VILLES.map(v=>v.ville).concat(ALL_DESTINATIONS_INTL.map(d=>d.ville));
    const unique = [...new Set(allNames)];
    unique.sort((a,b)=>b.length-a.length);
    unique.forEach(v => { if(m.includes(normalize(v)) && !found.includes(v)) found.push(v); });
    return found;
  }

  function iaDetectType(msg) {
    const m = msg.toLowerCase();
    const mots = {
      fret:['colis','marchandise','envoyer','envoi','fret','livr','expéd','palette','paquet','carton','meuble','transport de','kilo','kg'],
      intl:['international','étranger','nigeria','lagos','calabar','tchad','ndjamena','n\'djamena','bangui','centrafrique','gabon','libreville','bata','guinée','equatoriale','congo','ouesso','brazzaville','cemac','frontière','visa','passeport'],
      trajet:['trajet','voyage','aller','billet','réserv','départ','arrivée','bus','car','voyager','route'],
      prix:['prix','tarif','combien','coût','coûte','cher','moins cher','budget','payer combien'],
      paiement:['paiement','payer','momo','mobile money','orange money','carte bancaire','visa','mastercard','portefeuille'],
      gps:['gps','suivi','position','localisation','où est','tracker','temps réel','géolocalisation'],
      sos:['sos','urgence','danger','accident','panne','alerte','secours','police','pompier'],
      annul:['annul','rembours','supprimer billet'],
      compte:['compte','inscription','inscrire','connecter','connexion','mot de passe','profil','mon espace'],
      famille:['famille','family','contact de confiance','proche','notification sms'],
      horaire:['horaire','heure','départ à','part à','matin','soir','nuit','programme'],
      agence:['agence','partenaire','chauffeur','conducteur','devenir partenaire'],
      confidentialite:['confidentialit','données personnelles','vie privée','rgpd','antic','protection des données','cookie','donnée','collecte','traitement'],
      cgu:['cgu','conditions générales','conditions d\'utilisation','mention','légal','juridique','contrat'],
      securite:['sécurité','sûreté','fiable','confiance','vérif','certif','kyc','identité','sécurisé'],
      loi:['loi','législation','réglementation','camerounais','ohada','2010/012','2024/017','droit','tribunal','litige','plainte','réclamation'],
      support:['support','aide','assist','problème','contacter','joindre','service client','réclamation','plainte'],
      edik:['edik','entreprise','société','qui êtes','c\'est quoi ctl','fondateur','créateur','à propos','siège'],
      qrcode:['qr','qr code','scanner','scan','billet électronique','e-billet'],
      label:['label','certifié','bronze','argent','premium','gold','classement','note','notation','étoile','avis'],
      fidelite:['fidéli','récompense','prix de l\'année','grand voyageur','bonus'],
      wallet:['portefeuille','wallet','recharge','retrait','transfert','solde'],
    };
    let best=null, bestScore=0;
    for(const [type, keywords] of Object.entries(mots)) {
      let score=0;
      keywords.forEach(k => { if(m.includes(k)) score += k.length; });
      if(score > bestScore) { bestScore=score; best=type; }
    }
    return best;
  }

  function iaRepondre(msg) {
    const villes = iaDetectVilles(msg);
    const type = iaDetectType(msg);
    const m = msg.toLowerCase();
    const sess = typeof getSession==='function' ? getSession() : null;
    const prenom = sess ? sess.prenom : '';

    // Humanisation — variations de réponses
    var _h = function(arr){ return arr[Math.floor(Math.random()*arr.length)]; };
    var _nom = prenom ? ' <strong>'+prenom+'</strong>' : '';

    // Salutations — chaleureuses et variées
    if(m.match(/^(bonjour|salut|bonsoir|hello|hi|hey|coucou|yo|bjr)/)) {
      var heure = new Date().getHours();
      var salut = heure<12 ? 'Bonjour' : heure<18 ? 'Bon après-midi' : 'Bonsoir';
      return salut+_nom+' ! 😊 Ravie de vous retrouver sur Cameroon Terre Line.<br><br>Je suis votre assistante personnelle CTL. Je connais <strong>les 360 arrondissements du Cameroun</strong>, les <strong>6 pays voisins</strong>, les <strong>tarifs officiels</strong>, et toutes les <strong>lois camerounaises</strong> qui encadrent notre activité.<br><br>Quelques idées :<br>• 🚌 <em>"Combien coûte Douala → Yaoundé ?"</em><br>• 📦 <em>"Envoyer un colis de 15 kg à Bamenda"</em><br>• 🔒 <em>"Quelle est votre politique de confidentialité ?"</em><br>• ⚖️ <em>"Quels sont mes droits en tant que passager ?"</em><br>• 💬 <em>"Je veux contacter le support"</em>';
    }
    if(m.match(/^(merci|thanks|ok merci|c'est gentil|super|parfait|génial|cool)/)) {
      return _h(['Avec grand plaisir'+_nom+' ! Je suis là pour vous à tout moment. 😊','Tout le plaisir est pour moi'+_nom+' ! N\'hésitez surtout pas si vous avez d\'autres questions. 🙏','De rien'+_nom+' ! C\'est exactement pour ça que je suis là. Bon voyage ! 🚌','Je vous en prie'+_nom+' ! CTL est à votre service 24h/24. À très bientôt ! ✨']);
    }
    if(m.match(/^(au revoir|bye|à bientôt|bonne nuit|à plus|ciao)/)) {
      return _h(['Au revoir'+_nom+' ! Passez une excellente journée. À très bientôt sur CTL ! 👋','À bientôt'+_nom+' ! N\'oubliez pas : CTL est là pour vous 24h/24. Bon voyage ! 🚌','Au plaisir de vous retrouver'+_nom+' ! Prenez soin de vous. 😊']);
    }
    // Questions sur le bot lui-même
    if(m.match(/qui es.tu|tu es qui|comment tu t'appelles|c'est quoi ctl|ton nom/)) {
      return 'Je suis <strong>l\'assistante virtuelle de Cameroon Terre Line</strong> (CTL), la première plateforme numérique de transport interurbain au Cameroun. 🚌<br><br>Je suis développée par <strong>EDIK SARL</strong>, entreprise camerounaise basée à Yaoundé. Je peux vous aider sur :<br>• Les trajets et tarifs (360 arrondissements + 6 pays)<br>• Le transport de marchandises<br>• Les questions juridiques (lois camerounaises)<br>• La sécurité, le GPS, le Family Space<br>• Votre compte, vos billets, vos paiements<br><br>Posez-moi n\'importe quelle question ! 😊';
    }
    if(m.match(/tu parles|langue|english|anglais|speak/)) {
      return 'Je parle <strong>français</strong> et <strong>anglais</strong> ! 🇨🇲<br><br>Pour changer la langue de la plateforme, utilisez le sélecteur <strong>FR / EN</strong> en haut à droite de la page. Toute la plateforme se traduit automatiquement (298 éléments traduits). 🌍';
    }

    // TRAJET avec 2 villes détectées
    if(villes.length >= 2) {
      const dep=villes[0], arr=villes[1];
      // Vérifier si international
      const intlDest = ALL_DESTINATIONS_INTL.find(d=>d.ville===arr);
      if(intlDest) {
        const t = getTarifsIntl(dep, arr, intlDest.km);
        const paysData = INTERNATIONAL[intlDest.pays];
        return `🌍 <strong>${dep} 🇨🇲 → ${intlDest.flag} ${arr} (${intlDest.pays})</strong><br><br>📍 Distance : ~${intlDest.km} km<br>⏱ Durée estimée : ${intlDest.duree}<br>💰 Classique : <strong style="color:var(--or)">${formatPrix(t.classique)} FCFA</strong><br>🌟 VIP : <strong style="color:var(--or)">${formatPrix(t.vip)} FCFA</strong><br>🛂 Frontière : ${paysData?paysData.frontiere[0]:'—'}<br>💱 Devise : ${intlDest.devise==='XAF'?'FCFA (zone CEMAC, pas de change)':'Naira (change possible à l\'arrivée)'}<br><br>${type==='fret'?'📦 Pour un <strong>envoi de marchandise</strong> sur ce trajet, précisez le type et le poids.<br><br>':''}👉 <a href="#international"${iaCloseLink}>Réserver ce trajet international</a>`;
      }
      // National
      const d = ALL_VILLES.find(v=>v.ville===dep);
      const a = ALL_VILLES.find(v=>v.ville===arr);
      if(d && a) {
        const t = getTarifs(d, a);
        if(type==='fret') {
          const poidsMatch = msg.match(/(\d+)\s*(kg|kilo)/i);
          const poids = poidsMatch ? parseInt(poidsMatch[1]) : 10;
          const prixFret = Math.max(1500, Math.round(t.km*8*(1+poids/200)/500)*500);
          return `📦 <strong>Envoi ${dep} → ${arr}</strong><br><br>📍 Distance : ~${t.km} km · ⏱ ${getDuree(t.km)}<br>⚖ Poids estimé : ${poids} kg<br>💰 Colis standard : <strong style="color:var(--or)">${formatPrix(prixFret)} FCFA</strong><br>⚡ Express (24-48h) : <strong style="color:var(--cuivre)">${formatPrix(Math.round(prixFret*1.5/500)*500)} FCFA</strong><br>🛡 Assurance : ${formatPrix(Math.max(500,Math.round(prixFret*0.08/100)*100))} FCFA<br>📍 Suivi GPS en temps réel inclus<br><br>👉 <a href="#marchandises"${iaCloseLink}>Commander cet envoi</a>`;
        }
        return `🚌 <strong>${dep} → ${arr}</strong><br><br>📍 Distance : ~${t.km} km<br>⏱ Durée estimée : ${getDuree(t.km)}<br>💰 Classique : <strong style="color:var(--or)">${formatPrix(t.classique)} FCFA</strong> (base 16 F/km)<br>🌟 VIP : <strong style="color:var(--or)">${formatPrix(t.vip)} FCFA</strong> (bus climatisé + collation)<br>📍 Suivi GPS + Family Space inclus<br><br>👉 <a href="#corridors"${iaCloseLink}>Réserver ce trajet</a>`;
      }
    }

    // 1 seule ville détectée
    if(villes.length === 1) {
      const v = villes[0];
      const intlDest = ALL_DESTINATIONS_INTL.find(d=>d.ville===v);
      if(intlDest) return `🌍 <strong>${v}</strong> est au <strong>${intlDest.pays}</strong> ${intlDest.flag}.<br>Depuis ${intlDest.depuis} : ~${intlDest.km} km · ${intlDest.duree}<br><br>D'où souhaitez-vous partir ? Par exemple : <em>"Douala vers ${v}"</em>`;
      const nat = ALL_VILLES.find(x=>x.ville===v);
      if(nat) return `🇨🇲 <strong>${v}</strong> est dans la région <strong>${nat.region}</strong> (département : ${nat.dept}).<br><br>Où souhaitez-vous aller depuis ${v} ? Ou bien arriver à ${v} depuis quelle ville ?`;
    }

    // Par type de question détecté
    if(type==='fret') {
      const poidsMatch = msg.match(/(\d+)\s*(kg|kilo)/i);
      return `📦 <strong>Transport de marchandises CTL</strong><br><br>Nos tarifs par km selon le type :<br>• 📦 Colis standard : <strong>8 F/km</strong> (≤30 kg)<br>• 📐 Volumineux : <strong>14 F/km</strong><br>• 🏗 Palette : <strong>22 F/km</strong><br>• 🔮 Fragile : <strong>18 F/km</strong><br>• 🥬 Alimentaire : <strong>12 F/km</strong><br>• 🚗 Véhicule : <strong>35 F/km</strong><br><br>${poidsMatch?'J\'ai noté '+poidsMatch[1]+' kg. ':''}Précisez le trajet pour un devis exact, par ex : <em>"envoyer 20 kg de Douala à Bafoussam"</em><br><br>👉 <a href="#marchandises"${iaCloseLink}>Formulaire d'envoi</a>`;
    }
    if(type==='intl') return `🌍 <strong>Destinations internationales CTL</strong><br><br>🇳🇬 <strong>Nigeria</strong> : Calabar, Enugu, Lagos, Abuja<br>🇹🇩 <strong>Tchad</strong> : N'Djamena, Moundou<br>🇨🇫 <strong>Centrafrique</strong> : Bangui, Bouar<br>🇬🇦 <strong>Gabon</strong> : Libreville, Oyem, Bitam<br>🇬🇶 <strong>Guinée Éq.</strong> : Bata, Ebebiyín<br>🇨🇬 <strong>Congo</strong> : Ouesso<br><br>Dites-moi votre destination, par ex : <em>"Yaoundé vers Libreville"</em><br><br>👉 <a href="#international"${iaCloseLink}>Recherche internationale</a>`;
    if(type==='prix') return `💰 <strong>Comment fonctionnent les tarifs CTL ?</strong><br><br>🚌 <strong>Voyageurs</strong> :<br>• Classique : <strong>16 FCFA/km</strong> (tarif réglementé)<br>• VIP : <strong>27 FCFA/km</strong> (climatisé + collation)<br>• International : <strong>18–30 FCFA/km</strong><br><br>📦 <strong>Marchandises</strong> : de <strong>8 à 35 FCFA/km</strong> selon le type<br><br>Pour un calcul précis, dites-moi : <em>"Douala vers Yaoundé"</em> ou <em>"colis 10 kg Douala Bamenda"</em>`;
    if(type==='paiement') return `💳 <strong>Moyens de paiement CTL</strong><br><br>• 📱 <strong>MTN Mobile Money</strong> — paiement instantané, push notification sur votre téléphone<br>• 🟠 <strong>Orange Money</strong> — composez #150# pour confirmer<br>• 💳 <strong>Visa / Mastercard</strong> — passerelle sécurisée SSL<br>• 💰 <strong>Portefeuille CTL</strong> — rechargez et payez en 1 clic, transferts entre utilisateurs<br><br>Tous les paiements sont <strong>100% sécurisés</strong> avec confirmation instantanée par SMS et email.${sess?'<br><br>Votre moyen préféré : <strong>'+(sess.paiementPrefere||'MTN MoMo')+'</strong>':''}`;
    if(type==='gps') return `📍 <strong>Suivi GPS CTL en détail</strong><br><br>• Position mise à jour <strong>toutes les 30 secondes</strong><br>• Visible par vous <strong>et</strong> vos contacts famille (jusqu'à 3)<br>• Fonctionne en <strong>2G, 3G, 4G</strong> — 97% du Cameroun couvert<br>• <strong>Alertes automatiques</strong> : départ, chaque pause, arrivée<br>• <strong>Alerte vitesse</strong> : SMS au chauffeur si >90 km/h<br>• Actif aussi pour les <strong>marchandises</strong> et les <strong>trajets internationaux</strong><br>• Historique conservé <strong>90 jours</strong> puis supprimé`;
    if(type==='sos') return `🆘 <strong>Système SOS CTL</strong><br><br>7 types d'alertes disponibles :<br>🔴 <strong>Danger général</strong><br>🔧 <strong>Panne du véhicule</strong><br>💥 <strong>Accident</strong><br>🚨 <strong>Excès de vitesse</strong><br>😴 <strong>Chauffeur somnolent</strong><br>🍺 <strong>Chauffeur en état d'ébriété</strong><br>😡 <strong>Passager perturbateur</strong><br><br>Quand activé : position GPS envoyée <strong>instantanément</strong> à vos 3 contacts famille + équipe CTL. Données conservées 5 ans (loi n°2010/012).`;
    if(type==='annul') return `Bien sûr${_nom}, je comprends. Voici les conditions d'annulation chez CTL :<br><br>📅 <strong>Avant le jour du voyage</strong> → remboursement de <strong style="color:var(--or)">50%</strong> du prix<br>⏰ <strong>Le jour du voyage</strong> → remboursement de <strong style="color:var(--rouge2)">10% seulement</strong> (le chauffeur a mobilisé son véhicule)<br>🚌 <strong>Après le départ</strong> → <strong style="color:var(--rouge2)">aucun remboursement</strong><br><br>💡 <em>Mon conseil : si possible, modifiez plutôt la date du voyage — c'est gratuit jusqu'à 24h avant le départ !</em><br><br>Pour annuler, rendez-vous dans <strong>Mon Espace → Mes Billets</strong>.${sess?'<br><br>👉 Vous êtes connecté, je peux vous y rediriger.':'<br><br>👉 Connectez-vous d\'abord pour accéder à vos billets.'}`;
    if(type==='compte') return `${sess?'Vous êtes connecté en tant que <strong>'+escapeHtml(sess.prenom)+' '+escapeHtml(sess.nom)+'</strong> ('+escapeHtml(sess.email)+'), catégorie : <strong>'+(sess.categorie||'Passager')+'</strong>. 😊<br><br>Depuis <strong>Mon Espace</strong>, vous pouvez :<br>• 🎫 Voir et gérer vos billets<br>• 👤 Modifier votre profil<br>• 👨‍👩‍👧 Configurer vos contacts famille<br>• 💰 Gérer votre portefeuille CTL<br>• 📦 Suivre vos envois de marchandises<br><br>Que souhaitez-vous faire ?':'Pour rejoindre CTL, c\'est simple ! 😊<br><br>Cliquez sur <strong>"Créer un compte"</strong> en haut à droite. 5 catégories disponibles :<br>• 🧳 <strong>Passager</strong> — réserver et voyager<br>• 🚗 <strong>Chauffeur</strong> — proposer des trajets<br>• 🏢 <strong>Agence</strong> — gérer une flotte<br>• 👔 <strong>Employé</strong> — service client CTL<br>• 🔐 <strong>Admin</strong> — gestion de la plateforme<br><br>L\'inscription est gratuite et prend moins de 2 minutes. Vous devez avoir <strong>au moins 18 ans</strong> (conformément à nos CGU).'}`;
    if(type==='famille') return `Le <strong>CTL Family Space</strong>, c'est l'une de nos innovations dont je suis le plus fière ! 👨‍👩‍👧<br><br>Voici comment ça marche :<br>• Vous désignez jusqu'à <strong>3 contacts de confiance</strong> (parents, conjoint, amis...)<br>• Ils reçoivent des <strong>SMS automatiques</strong> à chaque étape :<br>&nbsp;&nbsp;✅ Départ confirmé (lieu + heure)<br>&nbsp;&nbsp;🛑 Chaque pause (lieu + durée estimée)<br>&nbsp;&nbsp;🏁 Arrivée à destination<br>&nbsp;&nbsp;🆘 Alertes SOS en temps réel si urgence<br><br>Le plus beau ? <strong>Ça fonctionne sans application</strong> — par SMS classiques. Même un téléphone basique reçoit les notifications. Compatible <strong>2G</strong>, donc ça marche dans 97% du Cameroun. 📶<br><br>Pour configurer vos contacts : <strong>Mon Espace → CTL Family</strong>.`;
    if(type==='horaire') return `Les horaires varient selon le trajet et le chauffeur, mais voici les créneaux habituels 🕐 :<br><br>🌅 <strong>Tôt le matin</strong> : 05h30, 06h00 — pour les longs trajets (Douala→Maroua, Yaoundé→Garoua...)<br>☀️ <strong>Matinée</strong> : 07h30, 08h00, 10h00 — les plus populaires<br>🌤️ <strong>Après-midi</strong> : 11h30, 14h00, 15h30<br>🌆 <strong>Soir</strong> : 16h00, 20h00 — trajets de nuit disponibles sur certains corridors<br><br>💡 <em>Les horaires exacts avec les places disponibles s'affichent quand vous recherchez un trajet.</em><br><br>Quel trajet vous intéresse ? Je vous donne les détails ! 😊`;
    if(type==='agence') return `Vous souhaitez rejoindre l'aventure CTL ? Excellent choix ! 🤝<br><br>🚗 <strong>En tant que chauffeur</strong> :<br>Fournissez 5 pièces : CNI, permis de conduire, carte grise, assurance et visite technique. Après vérification (48h), vous recevez votre badge CTL et pouvez publier des trajets.<br><br>🏢 <strong>En tant qu'agence</strong> :<br>Inscrivez votre agence avec votre RCCM, patente, et la liste de vos véhicules. Un responsable CTL vous contacte sous 48h.<br><br>📈 <strong>3 niveaux de certification</strong> :<br>🟫 Partenaire (≥3.5/5, 1-49 trajets) → commission 8%<br>🩶 Certifié (≥4.0/5, 50-199 trajets) → commission 6%<br>🏆 Premium (≥4.7/5, 200+ trajets) → commission 4% + bonus trimestriel<br><br>👉 Cliquez sur <strong>"Proposer un trajet"</strong> ou <strong>"Devenir agence partenaire"</strong> en bas de page.`;

    // ══ NOUVEAUX SUJETS — Confidentialité, CGU, Lois, EDIK, etc. ══
    if(type==='confidentialite') return `Excellente question${_nom} ! La protection de vos données est au cœur de nos engagements. 🔒<br><br>Notre politique est conforme à :<br>• <strong>Loi n°2024/017 du 23 décembre 2024</strong> — protection des données à caractère personnel au Cameroun<br>• <strong>Loi n°2010/012 du 21 décembre 2010</strong> — cybersécurité et cybercriminalité<br>• Recommandations de l'<strong>ANTIC</strong> (Agence Nationale des TIC)<br>• Principes du <strong>RGPD européen</strong> (bonnes pratiques)<br><br><strong>Vos droits</strong> : accès, rectification, effacement, opposition, portabilité, limitation. Délai de réponse : <strong>30 jours</strong>.<br><br><strong>Ce que nous collectons</strong> : nom, téléphone, email, données GPS (pendant le trajet uniquement, conservées 90 jours).<br><br>⛔ <strong>CTL ne vend JAMAIS vos données à des tiers.</strong><br><br>DPO : <strong>privacy@cameroonterreline.cm</strong><br><br>👉 Consultez notre politique complète en cliquant sur "Confidentialité" en bas de page.`;

    if(type==='cgu') return `Bien sûr${_nom} ! Voici un résumé de nos Conditions Générales d'Utilisation : 📜<br><br>• <strong>CTL est une plateforme de mise en relation</strong> entre passagers et transporteurs. CTL n'est pas transporteur et n'est pas partie au contrat de transport.<br>• <strong>Inscription</strong> : ouverte à toute personne de <strong>18 ans et plus</strong>.<br>• <strong>Tarifs</strong> : base réglementée de <strong>16 FCFA/km</strong> (Arrêté Mincommerce du 26 fév. 2024).<br>• <strong>Annulation</strong> : 50% de frais avant le jour du voyage, 90% le jour même.<br>• <strong>Chauffeurs</strong> : vérification KYC obligatoire (5 pièces), suivi GPS, alerte vitesse >90 km/h.<br>• <strong>Droit applicable</strong> : droit camerounais, tribunaux de <strong>Yaoundé</strong>.<br><br>Pour lire les CGU complètes, cliquez sur <strong>"Conditions générales"</strong> en bas de page. 📄`;

    if(type==='securite') return `La sécurité est notre <strong>priorité n°1</strong>${_nom} ! Voici tout ce qu'on met en place 🛡 :<br><br><strong>Pour les passagers :</strong><br>• 📍 Suivi GPS temps réel (toutes les 30 secondes)<br>• 👨‍👩‍👧 Family Space — 3 contacts notifiés par SMS<br>• 🆘 Bouton SOS multi-alertes (7 types)<br>• 📷 Photo du chauffeur visible avant embarquement<br>• ⭐ Système de notation à 5 critères<br><br><strong>Pour la vérification des chauffeurs :</strong><br>• 🪪 KYC obligatoire : CNI, permis, carte grise, assurance, visite technique<br>• 🚨 Alerte automatique si vitesse >90 km/h<br>• 📊 Suspension automatique si note <3/5<br><br><strong>Sécurité informatique :</strong><br>• 🔐 HTTPS/SSL sur toutes les connexions<br>• 🛡 Protection XSS (injection de code)<br>• 🔒 Mots de passe hashés (bcrypt)<br>• 💳 Aucune donnée bancaire stockée par CTL<br><br>Conformément à la <strong>loi n°2010/012</strong>, en cas d'incident grave, les données peuvent être communiquées aux autorités camerounaises compétentes.`;

    if(type==='loi') return `Excellente question ! Voici le cadre juridique de CTL 🇨🇲 :<br><br>⚖️ <strong>Lois applicables :</strong><br>• <strong>Loi n°2024/017 du 23 décembre 2024</strong> — protection des données à caractère personnel<br>• <strong>Loi n°2010/012 du 21 décembre 2010</strong> — cybersécurité et cybercriminalité<br>• <strong>Loi n°2010/013 du 21 décembre 2010</strong> — communications électroniques<br>• <strong>Loi n°96/07 du 8 avril 1996</strong> — Code de la Route camerounais<br>• <strong>Décret n°2012/1637/PM</strong> — conservation des données électroniques<br>• <strong>Acte Uniforme OHADA</strong> (art. 82 AUDCG) — valeur juridique des engagements électroniques<br>• Textes de l'<strong>ANTIC</strong> (Agence Nationale des TIC)<br><br>🏛️ <strong>Autorité de contrôle</strong> : ANTIC — Yaoundé, Cameroun<br>⚖️ <strong>Juridiction compétente</strong> : Tribunaux de Yaoundé<br><br>CTL respecte intégralement la réglementation camerounaise. Pour toute question juridique spécifique, contactez notre DPO : <strong>privacy@cameroonterreline.cm</strong>`;

    if(type==='support') return `Notre équipe support est disponible <strong>24h/24, 7 jours sur 7</strong>${_nom} ! 💬<br><br>📞 <strong>Téléphone</strong> : +237 693 000 000 (appel direct)<br>💬 <strong>WhatsApp</strong> : +237 693 000 000 (réponse rapide)<br>📧 <strong>Email</strong> : support@cameroonterreline.cm (réponse sous 2h)<br>🆘 <strong>Urgence SOS</strong> : +237 690 000 000 (priorité absolue)<br><br>Vous pouvez aussi me poser votre question directement ici et j'essaierai de vous aider immédiatement ! 😊<br><br>Quel est votre problème ? Je suis là pour vous. 🙏`;

    if(type==='edik') return `<strong>EDIK SARL</strong> est l'entreprise camerounaise qui a créé Cameroon Terre Line. 🏢<br><br>• <strong>Forme juridique</strong> : Société à Responsabilité Limitée (SARL) de droit OHADA<br>• <strong>Siège social</strong> : Yaoundé, Cameroun<br>• <strong>Présence</strong> : Représentée dans plusieurs régions du Cameroun<br>• <strong>Activité</strong> : Société multiservices — l'une de ses activités est le développement de solutions numériques pour le transport interurbain<br>• <strong>Plateforme</strong> : CAMEROON TERRE LINE (CTL) — première plateforme numérique de transport interurbain au Cameroun<br>• <strong>Couverture</strong> : 360 arrondissements + 6 pays CEMAC & Nigeria<br><br>Pour en savoir plus, consultez la section <strong>"À propos"</strong> en bas de page. 😊`;

    if(type==='qrcode') return `Le système de QR Code CTL est très avancé${_nom} ! 🎫<br><br>• Chaque billet contient un <strong>QR Code unique chiffré</strong> (format : CTL-2025-XXXXXX)<br>• Le QR contient : référence, trajet, passager, prix + un <strong>hash anti-falsification</strong><br>• Le chauffeur scanne le QR avec la <strong>caméra de son téléphone</strong> directement depuis son espace CTL<br>• Vérification en <strong>moins d'1 seconde</strong> : existence du billet, date, statut, anti-duplication<br>• Résultat : <strong style="color:var(--vert2)">✅ VALIDE</strong> (nom du passager affiché) ou <strong style="color:var(--rouge2)">❌ INVALIDE</strong> (raison affichée)<br>• Une fois scanné, le billet est marqué <strong>"Utilisé"</strong> — impossible de le réutiliser<br><br>C'est un système de sécurité qui protège contre la fraude et la duplication de billets. 🔒`;

    if(type==='label') return `Le système de certification CTL récompense les meilleurs chauffeurs et agences ! 🏆<br><br>🟫 <strong>Partenaire CTL</strong> (Bronze)<br>• Note ≥ 3.5/5, 1-49 trajets, respect horaires ≥70%<br>• Commission : 8% · Badge visible · Reversement hebdomadaire<br><br>🩶 <strong>Partenaire Certifié</strong> (Argent)<br>• Note ≥ 4.0/5, 50-199 trajets, respect horaires ≥85%<br>• Commission réduite à 6% · Mise en avant dans les résultats · Support prioritaire<br><br>🏆 <strong>Partenaire Premium</strong> (Or)<br>• Note ≥ 4.7/5, 200+ trajets, ≥12 mois d'ancienneté<br>• Commission 4% · Bonus trimestriel EDIK · Invitation Gala CTL<br><br>Les notes sont basées sur 5 critères : ponctualité, conduite, propreté, accueil, GPS/suivi. Tout est transparent pour les passagers ! ⭐`;

    if(type==='fidelite') return `Vous voyagez souvent ? Le programme de fidélité CTL vous récompense ! 🎉<br><br>🥉 <strong>Bronze</strong> (5-14 trajets/an)<br>→ Réduction de 5% sur le prochain billet<br><br>🥈 <strong>Argent</strong> (15-29 trajets/an)<br>→ 1 billet offert + accès prioritaire VIP<br><br>🏆 <strong>Grand Voyageur CTL</strong> (30+ trajets/an)<br>→ 3 billets offerts + surclassement VIP systématique + invitation au Gala annuel CTL<br><br>📅 Le compteur se réinitialise chaque 1er janvier. Seuls les billets achetés sur la plateforme CTL comptent. En cas d'égalité, c'est le voyageur avec le plus de kilomètres qui est classé premier.<br><br>Règlement complet dans la section <strong>"Prix de l'année CTL"</strong>. 🏅`;

    if(type==='wallet') return `Le <strong>Portefeuille CTL</strong>, c'est votre compte prépayé sur la plateforme ! 💰<br><br>• 💰 <strong>Recharger</strong> via MTN MoMo, Orange Money ou carte bancaire<br>• 🏦 <strong>Retirer</strong> vers votre compte MoMo/Orange (frais : 100 FCFA)<br>• ↔️ <strong>Transférer</strong> vers un autre utilisateur CTL<br>• 🎫 <strong>Payer</strong> vos billets directement depuis le solde<br><br>Avantages :<br>• Paiement en <strong>1 clic</strong> (pas besoin de saisir le numéro à chaque fois)<br>• Transactions <strong>atomiques</strong> (pas de débit sans crédit correspondant)<br>• Historique complet de toutes vos opérations<br><br>${sess?'Accédez à votre portefeuille depuis <strong>Mon Espace</strong>. 😊':'Créez un compte pour accéder au portefeuille. 😊'}`;

    // Fallback intelligent et chaleureux
    return `Hmm${_nom}, je n'ai pas trouvé de réponse exacte pour "<em>${escapeHtml(msg)}</em>", mais ne vous inquiétez pas ! 😊<br><br>Voici ce que je sais faire :<br>• 🚌 Trajets et tarifs : <em>"Douala vers Yaoundé"</em><br>• 📦 Marchandises : <em>"envoyer un colis de 15 kg à Bamenda"</em><br>• 🔒 Confidentialité : <em>"politique de confidentialité"</em><br>• ⚖️ Lois : <em>"quelles lois camerounaises s'appliquent ?"</em><br>• 🛡 Sécurité : <em>"comment fonctionne la sécurité CTL ?"</em><br>• 💬 Support : <em>"je veux contacter le support"</em><br>• 🏢 EDIK SARL : <em>"c'est quoi CTL ?"</em><br><br>Et si ma réponse ne vous suffit pas, notre support humain est disponible <strong>24h/24</strong> au <strong>+237 693 000 000</strong> (WhatsApp). 🙏`;
  }

  function envoyerIA() {
    const input = document.getElementById('iaInput');
    const chat = document.getElementById('iaChatBody');
    if (!input || !chat || !input.value.trim()) return;
    const msg = input.value.trim();
    iaHistory.push({role:'user',text:msg});
    chat.innerHTML += '<div class="sc-msg user">' + escapeHtml(msg) + '</div>';
    input.value = '';
    chat.scrollTop = chat.scrollHeight;
    setTimeout(() => {
      const rep = iaRepondre(msg);
      iaHistory.push({role:'bot',text:rep});
      chat.innerHTML += '<div class="sc-msg bot">' + rep + '</div>';
      chat.scrollTop = chat.scrollHeight;
    }, 300 + Math.random() * 400);
  }

</script>

<!-- ══ MODAL AGENCE PARTENAIRE ══ -->
