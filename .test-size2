        <button class="btn-cancel-modal" onclick="document.getElementById('modalAgence').classList.remove('open');document.body.style.overflow=''">Annuler</button>
        <button class="btn-confirm-resa" onclick="validerInscriptionAgence()">Soumettre ma candidature →</button>
      </div>
    </div>`;
  document.getElementById('modalAgence').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function marquerUpload(id, input) {
  if (input.files && input.files.length > 0) {
    const zone = document.getElementById(id);
    if (zone) { zone.classList.add('uploaded'); zone.querySelector('.uz-label').textContent = '✓ ' + input.files[0].name; }
  }
}

function validerInscriptionAgence() {
  const nom = document.getElementById('ag-nom')?.value.trim();
  const tel = document.getElementById('ag-tel')?.value.trim();
  const email = document.getElementById('ag-email')?.value.trim();
  const ville = document.getElementById('ag-ville')?.value.trim();
  if (!nom||!tel||!email||!ville) { alert('⚠️ Veuillez remplir tous les champs obligatoires.'); return; }
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){alert('⚠️ Adresse e-mail de l\'agence invalide.');return;}
  var agTelClean=tel.replace(/[\s\-\.]/g,'');
  if(!/^(\+237)?[26][0-9]{7,8}$/.test(agTelClean)){alert('⚠️ Numéro de téléphone de l\'agence invalide.');return;}
  document.getElementById('modalAgenceBox').innerHTML = `
    <div class="resa-success">
      <div class="rs-icon">🏢</div>
      <h3>Candidature soumise !</h3>
      <p>Le dossier de <strong style="color:var(--white)">${escapeHtml(nom)}</strong> a bien été transmis à l'équipe CTL.<br><br>
      Un responsable vous contactera à <strong style="color:var(--or)">${escapeHtml(email)}</strong> sous 48h pour finaliser votre partenariat.</p>
      <div style="margin-top:24px;"><button class="btn-confirm-resa" onclick="document.getElementById('modalAgence').classList.remove('open');document.body.style.overflow=''">Fermer</button></div>
    </div>`;
}

